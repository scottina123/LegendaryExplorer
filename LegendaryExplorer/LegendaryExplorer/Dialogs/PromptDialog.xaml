<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    x:Class="LegendaryExplorer.Dialogs.PromptDialog"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowStartupLocation="CenterOwner" 
    SizeToContent="WidthAndHeight"
    MinWidth="300"
    MinHeight="100"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanMinimize"
    DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <StackPanel Margin="5">
        <TextBlock Name="txtQuestion" Margin="5" TextWrapping="Wrap"/>
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="txtResponse" TextChanged="OnTextChanged"/>
            <Button Name="btnTlkPicker" Grid.Column="1" Content="..." Width="28" Margin="6,0,0,0"
                    Visibility="Collapsed" Click="TlkPicker_Click" AutomationProperties.Name="Pick TLK string reference"
                    ToolTip="Find a StringRef by ID or text in the loaded TLKs"/>
        </Grid>
        <ScrollViewer Name="tlkPreviewPanel" Margin="5" MaxHeight="180" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Name="txtTlkPreview" TextWrapping="Wrap" FontStyle="Italic"/>
        </ScrollViewer>
        <TextBlock Name="txtValidation" Margin="5" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Button Content="_OK" IsDefault="True" Margin="5" Width="40" Height="25" Name="btnOk" Click="ok_Click" />
            <Button Content="_Cancel" IsCancel="True" Margin="5" Width="50" Height="25" Name="btnCancel" Click="btnCancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
