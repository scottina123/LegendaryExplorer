<Window x:Class="LegendaryExplorer.Dialogs.CameraPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LegendaryExplorer.Dialogs"
        Title="Generate Camera Presets" Width="820" Height="760"
        MinWidth="760" MinHeight="680" WindowStartupLocation="CenterOwner" StateChanged="CameraPresetDialog_StateChanged">
    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="MulticamPresetItemTemplate">
                <StackPanel Margin="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TypeDisplay}" Opacity="0.7" FontSize="11"/>
                </StackPanel>
            </DataTemplate>
            <Style x:Key="MulticamPresetListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                <Setter Property="ItemTemplate" Value="{StaticResource MulticamPresetItemTemplate}"/>
            </Style>
            <Style x:Key="ParameterScrubThumbStyle" TargetType="Thumb">
                <Setter Property="Height" Value="20"/>
                <Setter Property="Cursor" Value="SizeWE"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1"/>
                                <Ellipse x:Name="Ellipse" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Fill="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                         Stroke="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                         StrokeThickness="1"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ellipse" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Ellipse" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Ellipse" Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="820"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Camera Anchor" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="3,0,3,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Anchor mode" VerticalAlignment="Center"/>
                    <ComboBox x:Name="AnchorModeComboBox" Grid.Column="1" SelectedIndex="0"
                              SelectionChanged="AnchorModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Manual Origin" Tag="ManualOrigin"/>
                        <ComboBoxItem Content="Single Actor" Tag="SingleActor"/>
                        <ComboBoxItem Content="Multiple Actors" Tag="MultipleActors"/>
                    </ComboBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="ApplyActorOriginButton" Content="Apply Actor Origin"
                                Click="ApplyActorOriginButton_Click" Padding="8,4" Margin="0,0,8,0"
                                IsEnabled="False"
                                ToolTip="Copy the resolved actor anchor into Manual Origin for further adjustment"/>
                        <TextBlock x:Name="AnchorModeAvailabilityText" VerticalAlignment="Center"
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="SingleActorPanel" Visibility="Collapsed" Margin="3,0,3,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Actor tag" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SingleActorComboBox" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True"
                              SelectionChanged="AnchorSelection_Changed" LostKeyboardFocus="AnchorSelection_LostKeyboardFocus"
                              ToolTip="Select a conversation speaker or type an exact actor tag"/>
                </Grid>
                <Grid x:Name="MultipleActorsPanel" Visibility="Collapsed" Margin="3,0,3,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Scene speakers" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <ListBox x:Name="MultipleActorListBox" Grid.Column="1" Height="72" SelectionMode="Extended"
                             SelectionChanged="AnchorSelection_Changed"
                             ToolTip="Select two or more speakers; Ctrl-click to select multiple"/>
                    <TextBlock Grid.Row="1" Text="Additional tags" VerticalAlignment="Center"/>
                    <TextBox x:Name="MultipleActorTagsTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Padding="4"
                             TextChanged="AnchorSelection_Changed"
                             ToolTip="Optional exact actor tags separated by commas, semicolons, or new lines"/>
                    <TextBlock Grid.Row="2" Text="Primary actor" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PrimaryActorComboBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                              IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="AnchorSelection_Changed"
                              LostKeyboardFocus="AnchorSelection_LostKeyboardFocus"
                              ToolTip="Used to choose the preferred side for asymmetric group shots"/>
                </Grid>
                <StackPanel x:Name="ManualOriginPanel">
                <UniformGrid x:Name="OriginFieldsPanel" Columns="6" Margin="0,0,0,8">
                    <StackPanel Margin="3">
                        <TextBlock Text="Origin X"/>
                        <TextBox x:Name="OriginXTextBox" Padding="4"/>
                    </StackPanel>
                    <StackPanel Margin="3">
                        <TextBlock Text="Origin Y"/>
                        <TextBox x:Name="OriginYTextBox" Padding="4"/>
                    </StackPanel>
                    <StackPanel Margin="3">
                        <TextBlock Text="Origin Z"/>
                        <TextBox x:Name="OriginZTextBox" Padding="4"/>
                    </StackPanel>
                    <StackPanel Margin="3">
                        <TextBlock Text="Roll (X)"/>
                        <TextBox x:Name="OriginRollTextBox" Padding="4"/>
                    </StackPanel>
                    <StackPanel Margin="3">
                        <TextBlock Text="Pitch (Y)"/>
                        <TextBox x:Name="OriginPitchTextBox" Padding="4"/>
                    </StackPanel>
                    <StackPanel Margin="3">
                        <TextBlock Text="Yaw (Z)"/>
                        <TextBox x:Name="OriginYawTextBox" Padding="4"/>
                    </StackPanel>
                </UniformGrid>
                <Grid Margin="3,0,3,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Move camera origin" FontWeight="SemiBold"/>
                        <UniformGrid Rows="1" Columns="4" Margin="0,4">
                            <RadioButton Content="X" Tag="X" GroupName="CameraOriginLocationScrubAxis" IsChecked="True" HorizontalContentAlignment="Center" Checked="CameraOriginLocationScrubAxis_Checked"/>
                            <RadioButton Content="Y" Tag="Y" GroupName="CameraOriginLocationScrubAxis" HorizontalContentAlignment="Center" Checked="CameraOriginLocationScrubAxis_Checked"/>
                            <RadioButton Content="Z" Tag="Z" GroupName="CameraOriginLocationScrubAxis" HorizontalContentAlignment="Center" Checked="CameraOriginLocationScrubAxis_Checked"/>
                            <RadioButton Content="All" Tag="All" GroupName="CameraOriginLocationScrubAxis" HorizontalContentAlignment="Center" Checked="CameraOriginLocationScrubAxis_Checked"/>
                        </UniformGrid>
                        <Grid Height="24" ToolTip="Drag left or right to move the camera origin by one Unreal unit per step">
                            <Border Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                            <Border Width="2" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" IsHitTestVisible="False"/>
                            <Thumb Width="24" Height="20" HorizontalAlignment="Center" DragStarted="CameraOriginLocationScrub_DragStarted" DragDelta="CameraOriginLocationScrub_DragDelta"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Rotate camera origin" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <UniformGrid Rows="1" Columns="4" Margin="0,4">
                            <RadioButton Content="Roll" Tag="Roll" GroupName="CameraOriginRotationDialAxis" IsChecked="True" HorizontalContentAlignment="Center" Checked="CameraOriginRotationDialAxis_Checked"/>
                            <RadioButton Content="Pitch" Tag="Pitch" GroupName="CameraOriginRotationDialAxis" HorizontalContentAlignment="Center" Checked="CameraOriginRotationDialAxis_Checked"/>
                            <RadioButton Content="Yaw" Tag="Yaw" GroupName="CameraOriginRotationDialAxis" HorizontalContentAlignment="Center" Checked="CameraOriginRotationDialAxis_Checked"/>
                            <RadioButton Content="All" Tag="All" GroupName="CameraOriginRotationDialAxis" HorizontalContentAlignment="Center" Checked="CameraOriginRotationDialAxis_Checked"/>
                        </UniformGrid>
                        <Grid x:Name="CameraOriginRotationDial" Width="90" Height="90" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CameraOriginRotationDial_MouseLeftButtonDown" MouseMove="CameraOriginRotationDial_MouseMove" MouseLeftButtonUp="CameraOriginRotationDial_MouseLeftButtonUp" LostMouseCapture="CameraOriginRotationDial_LostMouseCapture">
                            <Ellipse Margin="4" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="2"/>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                            <Line x:Name="CameraOriginRotationDialIndicator" X1="45" Y1="45" X2="45" Y2="8" Stroke="Orange" StrokeThickness="3">
                                <Line.RenderTransform><RotateTransform CenterX="45" CenterY="45"/></Line.RenderTransform>
                            </Line>
                        </Grid>
                    </StackPanel>
                </Grid>
                <WrapPanel x:Name="ManualOriginButtonsPanel">
                    <Button Content="Enter Coordinates Manually" Click="EnterManually_Click" Margin="3" Padding="8,4"/>
                    <Button x:Name="UseTrackKeyButton" Content="Use Selected TrackMove Key" Click="UseTrackKey_Click" Margin="3" Padding="8,4"/>
                    <Button x:Name="UseOtherTrackKeyButton" Content="Choose TrackMove Key from PCC" Click="UseOtherTrackKey_Click" Margin="3" Padding="8,4"/>
                    <Button x:Name="UseViewportLocationButton" Content="Use Current Viewport Camera Location" Click="UseViewportLocation_Click" Margin="3" Padding="8,4"/>
                    <Button x:Name="UseViewportTransformButton" Content="Use Current Viewport Camera Location and Rotation" Click="UseViewportTransform_Click" Margin="3" Padding="8,4"/>
                    <Button Content="Use Selected Preview Actor Transform" Click="UseSelectedPreviewActorLocation_Click" Margin="3" Padding="8,4"/>
                    <Button Content="Copy Origin" Click="CopyOrigin_Click" Margin="3" Padding="8,4"/>
                    <Button Content="Paste Origin" Click="PasteOrigin_Click" Margin="3" Padding="8,4"/>
                    <Button Content="Reset Origin to Zero" Click="ResetOrigin_Click" Margin="3" Padding="8,4"/>
                </WrapPanel>
                <TextBlock Text="The preset is generated in the origin's local forward/right/up space; no world coordinates are built into a preset."
                           Margin="3,6,3,0" Opacity="0.75" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Preset" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PresetSearchTextBox" Margin="0,0,0,8" Padding="6,4"
                             TextChanged="PresetSearchTextBox_TextChanged"
                             ToolTip="Search presets in the selected camera mode"/>
                    <TabControl x:Name="CameraModeTabs" Grid.Row="1" SelectionChanged="CameraModeTabs_SelectionChanged">
                        <TabItem x:Name="SingleCamTab" Header="Single Cam">
                            <Grid>
                                <TabControl x:Name="PresetTabs">
                                    <TabItem Header="Static Shots">
                                        <ListBox x:Name="StaticPresetList" DisplayMemberPath="Name" SelectionChanged="PresetList_SelectionChanged"/>
                                    </TabItem>
                                    <TabItem Header="Dynamic Shots">
                                        <ListBox x:Name="DynamicPresetList" DisplayMemberPath="Name" SelectionChanged="PresetList_SelectionChanged"/>
                                    </TabItem>
                                    <TabItem Header="Reaction Shots">
                                        <ListBox x:Name="ReactionPresetList" DisplayMemberPath="Name" SelectionChanged="PresetList_SelectionChanged"/>
                                    </TabItem>
                                    <TabItem Header="Saved Presets">
                                        <DockPanel>
                                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                <Button x:Name="SaveTrackMovePresetButton" Content="Save Current" Click="SaveTrackMovePreset_Click"
                                                        Margin="2" Padding="7,4" ToolTip="Save the selected TrackMove relative to the current origin"/>
                                                <Button x:Name="DeleteSavedPresetButton" Content="Delete" Click="DeleteSavedPreset_Click"
                                                        Margin="2" Padding="7,4" IsEnabled="False"/>
                                                <Button Content="Import List" Click="ImportSavedPresets_Click" Margin="2" Padding="7,4"/>
                                                <Button Content="Export List" Click="ExportSavedPresets_Click" Margin="2" Padding="7,4"/>
                                            </WrapPanel>
                                            <ListBox x:Name="SavedPresetList" DisplayMemberPath="Name"
                                                     SelectionChanged="PresetList_SelectionChanged"/>
                                        </DockPanel>
                                    </TabItem>
                                </TabControl>
                                <ListBox x:Name="PresetSearchResultsList" Visibility="Collapsed"
                                         SelectionChanged="PresetSearchResultsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CategoryDisplay}" Opacity="0.7" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="MulticamTab" Header="Multicam">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Button x:Name="SaveMulticamPresetButton" Content="Save Current Director" Click="SaveMulticamPreset_Click"
                                            Margin="2" Padding="7,4" ToolTip="Save the complete selected Director sequence"/>
                                    <Button x:Name="DeleteMulticamPresetButton" Content="Delete" Click="DeleteMulticamPreset_Click"
                                            Margin="2" Padding="7,4" IsEnabled="False"/>
                                    <Button Content="Import List" Click="ImportMulticamPresets_Click" Margin="2" Padding="7,4"/>
                                    <Button Content="Export List" Click="ExportMulticamPresets_Click" Margin="2" Padding="7,4"/>
                                </WrapPanel>
                                <TabControl x:Name="MulticamPresetTabs" SelectionChanged="MulticamPresetTabs_SelectionChanged">
                                    <TabItem Header="Static → Static">
                                        <ListBox x:Name="StaticToStaticPresetList" Style="{StaticResource MulticamPresetListStyle}" SelectionChanged="MulticamPresetList_SelectionChanged"/>
                                    </TabItem>
                                    <TabItem Header="Static → Dynamic">
                                        <ListBox x:Name="StaticToDynamicPresetList" Style="{StaticResource MulticamPresetListStyle}" SelectionChanged="MulticamPresetList_SelectionChanged"/>
                                    </TabItem>
                                    <TabItem Header="Dynamic → Static">
                                        <ListBox x:Name="DynamicToStaticPresetList" Style="{StaticResource MulticamPresetListStyle}" SelectionChanged="MulticamPresetList_SelectionChanged"/>
                                    </TabItem>
                                    <TabItem Header="Dynamic → Dynamic">
                                        <ListBox x:Name="DynamicToDynamicPresetList" Style="{StaticResource MulticamPresetListStyle}" SelectionChanged="MulticamPresetList_SelectionChanged"/>
                                    </TabItem>
                                    <TabItem Header="Custom">
                                        <ListBox x:Name="CustomMulticamPresetList" Style="{StaticResource MulticamPresetListStyle}" SelectionChanged="MulticamPresetList_SelectionChanged"/>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="PresetDetailsGroup" Grid.Column="1" Header="Local Composition and Movement" Padding="10">
                <Grid>
                <ScrollViewer x:Name="SingleCamParametersPanel" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Forward distance" Margin="3,6"/>
                        <StackPanel Grid.Column="1" Margin="3"><TextBox x:Name="ForwardDistanceTextBox" Padding="4"/><Thumb Style="{StaticResource ParameterScrubThumbStyle}" Tag="ForwardDistanceTextBox|1" IsEnabled="{Binding IsEnabled, ElementName=ForwardDistanceTextBox}" DragStarted="ParameterScrub_DragStarted" DragDelta="ParameterScrub_DragDelta" ToolTip="Drag horizontally to adjust"/></StackPanel>
                        <TextBlock Grid.Row="1" Text="Distance scale (%)" Margin="3,6"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="DistanceScaleSlider" Minimum="10" Maximum="200" Value="100"
                                    TickFrequency="10" SmallChange="1" LargeChange="10"
                                    VerticalAlignment="Center" ValueChanged="DistanceScaleSlider_ValueChanged"
                                    ToolTip="Scales every preset's forward distance; 100% uses the original value"/>
                            <TextBox x:Name="DistanceScaleTextBox" Grid.Column="1" Text="100" Margin="8,0,4,0" Padding="4"
                                     HorizontalContentAlignment="Right" TextChanged="DistanceScaleTextBox_TextChanged"
                                     ToolTip="Enter a distance scale from 10% to 200%"/>
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="Side offset (local right)" Margin="3,6"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="3"><TextBox x:Name="SideOffsetTextBox" Padding="4"/><Thumb Style="{StaticResource ParameterScrubThumbStyle}" Tag="SideOffsetTextBox|1" IsEnabled="{Binding IsEnabled, ElementName=SideOffsetTextBox}" DragStarted="ParameterScrub_DragStarted" DragDelta="ParameterScrub_DragDelta" ToolTip="Drag horizontally to adjust"/></StackPanel>
                        <TextBlock Grid.Row="3" Text="Height offset (local up)" Margin="3,6"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="3"><TextBox x:Name="HeightOffsetTextBox" Padding="4"/><Thumb Style="{StaticResource ParameterScrubThumbStyle}" Tag="HeightOffsetTextBox|1" IsEnabled="{Binding IsEnabled, ElementName=HeightOffsetTextBox}" DragStarted="ParameterScrub_DragStarted" DragDelta="ParameterScrub_DragDelta" ToolTip="Drag horizontally to adjust"/></StackPanel>
                        <TextBlock Grid.Row="4" Text="Look-at height" Margin="3,6"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="3"><TextBox x:Name="LookAtHeightTextBox" Padding="4"/><Thumb Style="{StaticResource ParameterScrubThumbStyle}" Tag="LookAtHeightTextBox|1" IsEnabled="{Binding IsEnabled, ElementName=LookAtHeightTextBox}" DragStarted="ParameterScrub_DragStarted" DragDelta="ParameterScrub_DragDelta" ToolTip="Drag horizontally to adjust"/></StackPanel>
                        <TextBlock Grid.Row="5" Text="Local roll (X)" Margin="3,6"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="3"><TextBox x:Name="LocalRollTextBox" Padding="4"/><Thumb Style="{StaticResource ParameterScrubThumbStyle}" Tag="LocalRollTextBox|1" IsEnabled="{Binding IsEnabled, ElementName=LocalRollTextBox}" DragStarted="ParameterScrub_DragStarted" DragDelta="ParameterScrub_DragDelta" ToolTip="Drag horizontally to adjust"/></StackPanel>
                        <TextBlock Grid.Row="6" Text="Local pitch (Y)" Margin="3,6"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="3"><TextBox x:Name="LocalPitchTextBox" Padding="4"/><Thumb Style="{StaticResource ParameterScrubThumbStyle}" Tag="LocalPitchTextBox|1" IsEnabled="{Binding IsEnabled, ElementName=LocalPitchTextBox}" DragStarted="ParameterScrub_DragStarted" DragDelta="ParameterScrub_DragDelta" ToolTip="Drag horizontally to adjust"/></StackPanel>
                        <TextBlock Grid.Row="7" Text="Local yaw (Z)" Margin="3,6"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="3"><TextBox x:Name="LocalYawTextBox" Padding="4"/><Thumb Style="{StaticResource ParameterScrubThumbStyle}" Tag="LocalYawTextBox|1" IsEnabled="{Binding IsEnabled, ElementName=LocalYawTextBox}" DragStarted="ParameterScrub_DragStarted" DragDelta="ParameterScrub_DragDelta" ToolTip="Drag horizontally to adjust"/></StackPanel>
                        <TextBlock Grid.Row="8" Text="Duration (seconds)" Margin="3,6"/>
                        <StackPanel Grid.Row="8" Grid.Column="1" Margin="3"><TextBox x:Name="DurationTextBox" Padding="4"/><Thumb Style="{StaticResource ParameterScrubThumbStyle}" Tag="DurationTextBox|0.1" IsEnabled="{Binding IsEnabled, ElementName=DurationTextBox}" DragStarted="ParameterScrub_DragStarted" DragDelta="ParameterScrub_DragDelta" ToolTip="Drag horizontally to adjust by 0.1 seconds"/></StackPanel>
                        <TextBlock Grid.Row="9" Text="Movement speed" Margin="3,6"/>
                        <Grid Grid.Row="9" Grid.Column="1" Margin="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="CameraSpeedSlider" Minimum="0.1" Maximum="2" Value="1"
                                    TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5"
                                    VerticalAlignment="Center" ValueChanged="CameraSpeedSlider_ValueChanged"
                                    ToolTip="Lower values slow the movement by extending its duration"/>
                            <TextBox x:Name="CameraSpeedTextBox" Grid.Column="1" Text="1" Margin="8,0,4,0" Padding="4"
                                     HorizontalContentAlignment="Right" TextChanged="CameraSpeedTextBox_TextChanged"
                                     ToolTip="Enter a speed multiplier from 0.1 to 2.0"/>
                            <TextBlock Grid.Column="2" Text="x" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Grid.Row="10" Text="Generated key count" Margin="3,6"/>
                        <TextBox x:Name="KeyCountTextBox" Grid.Row="10" Grid.Column="1" Margin="3" Padding="4" IsReadOnly="True"/>
                        <TextBlock Grid.Row="11" Text="Movement amount" Margin="3,6"/>
                        <StackPanel Grid.Row="11" Grid.Column="1" Margin="3"><TextBox x:Name="MovementAmountTextBox" Padding="4"/><Thumb Style="{StaticResource ParameterScrubThumbStyle}" Tag="MovementAmountTextBox|1" IsEnabled="{Binding IsEnabled, ElementName=MovementAmountTextBox}" DragStarted="ParameterScrub_DragStarted" DragDelta="ParameterScrub_DragDelta" ToolTip="Drag horizontally to adjust"/></StackPanel>
                        <TextBlock Grid.Row="12" Text="Start time (seconds)" Margin="3,6"/>
                        <StackPanel Grid.Row="12" Grid.Column="1" Margin="3"><TextBox x:Name="StartTimeTextBox" Padding="4"/><Thumb Style="{StaticResource ParameterScrubThumbStyle}" Tag="StartTimeTextBox|0.1" IsEnabled="{Binding IsEnabled, ElementName=StartTimeTextBox}" DragStarted="ParameterScrub_DragStarted" DragDelta="ParameterScrub_DragDelta" ToolTip="Drag horizontally to adjust by 0.1 seconds"/></StackPanel>
                    </Grid>
                </ScrollViewer>
                <ScrollViewer x:Name="MulticamDetailsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="MulticamNameTextBlock" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MulticamTypeTextBlock" Margin="0,6,0,0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MulticamDescriptionTextBlock" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Director sequence" Margin="0,16,0,4" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="MulticamCutsItemsControl"/>
                        <TextBlock Text="Camera groups" Margin="0,16,0,4" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="MulticamGroupsItemsControl"/>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left" VerticalAlignment="Center" Opacity="0.75"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton x:Name="TogglePreviewButton" Content="3D Preview" Checked="TogglePreviewButton_Checked"
                              Unchecked="TogglePreviewButton_Unchecked" Width="100" Height="30" Margin="4"/>
                <Button x:Name="PreviewButton" Content="Preview" Click="Preview_Click" Width="90" Height="30" Margin="4"/>
                <Button x:Name="GenerateButton" Content="Generate" Click="Generate_Click" Width="110" Height="30" Margin="4" IsDefault="True"/>
                <Button Content="Cancel" Width="90" Height="30" Margin="4" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
        </Grid>
        <Border x:Name="PreviewPanel" Grid.Column="1" Visibility="Collapsed" Margin="0,16,16,16"
                BorderBrush="#555" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Margin="8,8,8,0">
                    <Button Content="Open Level" Click="OpenPreviewLevel_Click" Padding="7,3" Margin="2"
                            ToolTip="Replace the level backdrop"/>
                    <Button Content="Add Level" Click="AddPreviewLevel_Click" Padding="7,3" Margin="2"
                            ToolTip="Add another level file to the backdrop"/>
                    <Button Content="Unload Level" Click="UnloadPreviewLevel_Click" Padding="7,3" Margin="2"
                            ToolTip="Unload all level backdrop files"/>
                    <Button x:Name="PreviewRecentLevelsButton" Content="Recent Levels" Click="PreviewRecentLevelsButton_Click"
                            Padding="7,3" Margin="2" ToolTip="Open a recent level backdrop">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="PreviewRecentLevelsMenu" Opened="PreviewRecentLevelsMenu_Opened"/>
                        </Button.ContextMenu>
                    </Button>
                    <TextBlock x:Name="PreviewLevelStatusTextBlock" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                </WrapPanel>
                <Expander Grid.Row="1" Header="Preview Actors" IsExpanded="True" Margin="8">
                    <Grid MaxHeight="520">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Add" Click="AddPreviewActor_Click" Padding="8,3" Margin="2"/>
                                <Button x:Name="RemovePreviewActorButton" Content="Remove" Click="RemovePreviewActor_Click" Padding="8,3" Margin="2"/>
                                <Button Content="Clear" Click="ClearPreviewActors_Click" Padding="8,3" Margin="2"/>
                            </StackPanel>
                            <ListBox x:Name="PreviewActorListBox" Height="62" DisplayMemberPath="DisplayName"
                                     SelectionChanged="PreviewActorListBox_SelectionChanged"
                                     MouseDoubleClick="PreviewActorListBox_MouseDoubleClick"/>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PreviewActorComboBox" Grid.Column="1" IsEditable="True"
                                      IsTextSearchEnabled="True" DisplayMemberPath="DisplayString"
                                      SelectionChanged="PreviewActorModel_SelectionChanged"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Anchor mode" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PreviewActorAnchorModeComboBox" Grid.Column="1" SelectedIndex="0"
                                      SelectionChanged="PreviewActorAnchorMode_SelectionChanged">
                                <ComboBoxItem Content="Manual Origin" Tag="ManualOrigin"/>
                                <ComboBoxItem Content="Single Actor" Tag="SingleActor"/>
                                <ComboBoxItem Content="Multiple Actors" Tag="MultipleActors"/>
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="PreviewActorSingleAnchorPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Actor tag" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PreviewActorSingleTagComboBox" Grid.Column="1" IsEditable="True"
                                      IsTextSearchEnabled="True" SelectionChanged="PreviewActorAnchorValue_Changed"
                                      LostKeyboardFocus="PreviewActorAnchorValue_Changed"/>
                        </Grid>
                        <Grid x:Name="PreviewActorMultipleAnchorPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Actor tags" VerticalAlignment="Center"/>
                            <TextBox x:Name="PreviewActorTagsTextBox" Grid.Column="1" Padding="3"
                                     ToolTip="Actor tags separated by commas, semicolons, or new lines"
                                     TextChanged="PreviewActorAnchorValue_Changed"/>
                            <TextBlock Grid.Row="1" Text="Primary actor" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <ComboBox x:Name="PreviewActorPrimaryTagComboBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                      IsEditable="True" IsTextSearchEnabled="True"
                                      SelectionChanged="PreviewActorAnchorValue_Changed"
                                      LostKeyboardFocus="PreviewActorAnchorValue_Changed"/>
                        </Grid>
                        <UniformGrid Grid.Row="4" Columns="3" Margin="0,0,0,4">
                            <StackPanel Margin="2"><TextBlock Text="Origin X"/><TextBox x:Name="PreviewActorXTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                            <StackPanel Margin="2"><TextBlock Text="Origin Y"/><TextBox x:Name="PreviewActorYTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                            <StackPanel Margin="2"><TextBlock Text="Origin Z"/><TextBox x:Name="PreviewActorZTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                            <StackPanel Margin="2"><TextBlock Text="Roll (X)"/><TextBox x:Name="PreviewActorRollTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                            <StackPanel Margin="2"><TextBlock Text="Pitch (Y)"/><TextBox x:Name="PreviewActorPitchTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                            <StackPanel Margin="2"><TextBlock Text="Yaw (Z)"/><TextBox x:Name="PreviewActorYawTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                        </UniformGrid>
                        <Grid Grid.Row="5" Margin="2,0,2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Move actor" FontWeight="SemiBold"/>
                                <UniformGrid Rows="1" Columns="4" Margin="0,4">
                                    <RadioButton Content="X" Tag="X" GroupName="PreviewActorLocationScrubAxis" IsChecked="True" HorizontalContentAlignment="Center" Checked="PreviewActorLocationScrubAxis_Checked"/>
                                    <RadioButton Content="Y" Tag="Y" GroupName="PreviewActorLocationScrubAxis" HorizontalContentAlignment="Center" Checked="PreviewActorLocationScrubAxis_Checked"/>
                                    <RadioButton Content="Z" Tag="Z" GroupName="PreviewActorLocationScrubAxis" HorizontalContentAlignment="Center" Checked="PreviewActorLocationScrubAxis_Checked"/>
                                    <RadioButton Content="All" Tag="All" GroupName="PreviewActorLocationScrubAxis" HorizontalContentAlignment="Center" Checked="PreviewActorLocationScrubAxis_Checked"/>
                                </UniformGrid>
                                <Grid Height="24" ToolTip="Drag left or right to move the selected actor along the selected axes">
                                    <Border Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                    <Border Width="2" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" IsHitTestVisible="False"/>
                                    <Thumb Width="24" Height="20" HorizontalAlignment="Center" DragStarted="PreviewActorLocationScrub_DragStarted" DragDelta="PreviewActorLocationScrub_DragDelta" DragCompleted="PreviewActorLocationScrub_DragCompleted"/>
                                </Grid>
                                <WrapPanel Margin="0,4,0,0">
                                    <TextBlock Text="Gizmo:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <RadioButton Content="Move" GroupName="PreviewActorGizmoMode" IsChecked="True" Checked="PreviewActorMoveGizmo_Checked" Margin="2"/>
                                    <RadioButton Content="Rotate" GroupName="PreviewActorGizmoMode" Checked="PreviewActorRotateGizmo_Checked" Margin="2"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Rotate actor" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <UniformGrid Rows="1" Columns="4" Margin="0,4">
                                    <RadioButton Content="Roll" Tag="Roll" GroupName="PreviewActorRotationDialAxis" IsChecked="True" HorizontalContentAlignment="Center" Checked="PreviewActorRotationDialAxis_Checked"/>
                                    <RadioButton Content="Pitch" Tag="Pitch" GroupName="PreviewActorRotationDialAxis" HorizontalContentAlignment="Center" Checked="PreviewActorRotationDialAxis_Checked"/>
                                    <RadioButton Content="Yaw" Tag="Yaw" GroupName="PreviewActorRotationDialAxis" HorizontalContentAlignment="Center" Checked="PreviewActorRotationDialAxis_Checked"/>
                                    <RadioButton Content="All" Tag="All" GroupName="PreviewActorRotationDialAxis" HorizontalContentAlignment="Center" Checked="PreviewActorRotationDialAxis_Checked"/>
                                </UniformGrid>
                                <Grid x:Name="PreviewActorRotationDial" Width="90" Height="90" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="PreviewActorRotationDial_MouseLeftButtonDown" MouseMove="PreviewActorRotationDial_MouseMove" MouseLeftButtonUp="PreviewActorRotationDial_MouseLeftButtonUp" LostMouseCapture="PreviewActorRotationDial_LostMouseCapture">
                                    <Ellipse Margin="4" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="2"/>
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                    <Line x:Name="PreviewActorRotationDialIndicator" X1="45" Y1="45" X2="45" Y2="8" Stroke="Orange" StrokeThickness="3">
                                        <Line.RenderTransform><RotateTransform CenterX="45" CenterY="45"/></Line.RenderTransform>
                                    </Line>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="6">
                            <WrapPanel>
                                <Button Content="Apply Actor Origin" Click="ApplyPreviewActorOrigin_Click" Padding="7,3" Margin="2"/>
                                <Button Content="Use Camera Anchor" Click="UseCameraAnchorForPreviewActor_Click" Padding="7,3" Margin="2"/>
                                <Button Content="Use Viewport Location" Click="UseViewportLocationForPreviewActor_Click" Padding="7,3" Margin="2"/>
                                <Button Content="Use Viewport Transform" Click="UseViewportTransformForPreviewActor_Click" Padding="7,3" Margin="2"/>
                                <Button Content="Reset Actor" Click="ResetPreviewActor_Click" Padding="7,3" Margin="2"/>
                            </WrapPanel>
                            <TextBlock x:Name="PreviewActorStatusTextBlock" Margin="2,2,0,0" Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Expander>
                <local:CameraPresetPreview x:Name="CameraPreviewControl" Grid.Row="2"/>
            </Grid>
        </Border>
    </Grid>
</Window>
