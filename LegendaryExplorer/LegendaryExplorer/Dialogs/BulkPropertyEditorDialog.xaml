<Window x:Class="LegendaryExplorer.Dialogs.BulkPropertyEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Bulk Add / Edit / Remove Properties"
        Width="850" Height="520" MinWidth="700" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="200"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="2*" MinWidth="350"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Classes" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock x:Name="PropertiesHeader" Grid.Column="2" Text="Properties"
                   FontWeight="Bold" Margin="0,0,0,6"/>
        <ListBox x:Name="ClassesListBox" Grid.Row="1"
                 DisplayMemberPath="DisplayName" SelectionMode="Single"
                 SelectionChanged="ClassesListBox_SelectionChanged"/>
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center"/>
        <Grid Grid.Row="1" Grid.Column="2">
            <ListBox x:Name="PropertiesListBox" SelectionMode="Single"
                     IsTextSearchEnabled="True" TextSearch.TextPath="PropertyName"
                     SelectionChanged="PropertiesListBox_SelectionChanged"
                     MouseDoubleClick="PropertiesListBox_MouseDoubleClick"
                     KeyDown="PropertiesListBox_KeyDown"
                     ToolTip="Select a property to edit or remove. Brackets identify its static-array slot; the count shows how many exports contain it.">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Property.PropType}"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            <TextBlock Text="{Binding PropertyName}" Margin="5,0,0,0"/>
                            <TextBlock Text="{Binding ExportCount, StringFormat='({0})'}" Margin="8,0,0,0"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyPropertiesText" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                       IsHitTestVisible="False"/>
        </Grid>

        <xctk:WatermarkTextBox x:Name="ClassFilterBox" Grid.Row="2" Margin="0,6,0,0"
                               Watermark="Filter classes" TextChanged="ClassFilterBox_TextChanged"/>
        <xctk:WatermarkTextBox x:Name="PropertyFilterBox" Grid.Row="2" Grid.Column="2" Margin="0,6,0,0"
                               Watermark="Filter properties by name or type" TextChanged="PropertyFilterBox_TextChanged"/>
        <TextBlock x:Name="ScopeText" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,8" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" MinWidth="75" Padding="10,4" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="AddButton" Content="Add Property..." MinWidth="105" Padding="10,4" Margin="0,0,8,0"
                    IsEnabled="False" Click="AddButton_Click"/>
            <Button x:Name="EditButton" Content="Edit Property..." MinWidth="105" Padding="10,4" Margin="0,0,8,0"
                    IsEnabled="False" Click="EditButton_Click"/>
            <Button x:Name="RemoveButton" Content="Remove Property" MinWidth="115" Padding="10,4"
                    IsEnabled="False" Click="RemoveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
