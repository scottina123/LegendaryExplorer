<misc:NotifyPropertyChangedWindowBase x:Class="LegendaryExplorer.Dialogs.LevelPresetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        Title="Level Presets" Width="1050" Height="760" MinWidth="900" MinHeight="660"
        WindowStartupLocation="CenterOwner" DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Level presets" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <Button x:Name="NewPresetButton" Content="New preset…" Click="NewPreset_Click"
                        Padding="10,5" Margin="0,0,8,0"
                        ToolTip="Choose level files with Windows Explorer and save them as a named preset"/>
                <Button x:Name="SaveCurrentLevelsButton" Content="Save current levels…" Click="SaveCurrentLevels_Click"
                        Padding="10,5" IsEnabled="False"
                        ToolTip="Save the levels currently loaded in this editor as a new preset"/>
            </WrapPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <Label Content="Search presets" Target="{Binding ElementName=PresetSearchTextBox}" Padding="0,0,0,5"/>
                <TextBox x:Name="PresetSearchTextBox" Padding="7,5"
                         Text="{Binding PresetSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search preset names, games, or level file paths"/>
            </StackPanel>
            <ListBox x:Name="PresetsList" Grid.Row="3" ItemsSource="{Binding PresetView}"
                     SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                     IsSynchronizedWithCurrentItem="False"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5,6" Background="Transparent" ToolTip="{Binding TooltipText}" ContextMenuOpening="PresetContextMenu_Opening">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy file name"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Summary}" Margin="0,3,0,0" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Selected level preset" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Label Grid.Row="1" Content="Preset name" Target="{Binding ElementName=PresetNameTextBox}" Padding="0,0,0,5"/>
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PresetNameTextBox" Padding="7,5" Margin="0,0,8,0"
                         Text="{Binding EditorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Edit the name, then choose Save name"/>
                <Button x:Name="SaveNameButton" Grid.Column="1" Content="Save name" Click="SaveName_Click"
                        Padding="10,5" IsEnabled="False"/>
            </Grid>
            <TabControl Grid.Row="3">
                <TabItem Header="Files">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="PresetFilesList" ItemsSource="{Binding PresetFiles}"
                                 SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTip="Select one or more files to remove them from this preset">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,6" Background="Transparent" ToolTip="{Binding Path}" ContextMenuOpening="FileContextMenu_Opening">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy file name"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="10,0,0,0" Opacity="0.72"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Path}"
                                                   Margin="0,3,0,0" Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                            <Button x:Name="AddFilesButton" Content="Add files…" Click="AddFiles_Click"
                                    Padding="10,5" Margin="0,0,8,0" IsEnabled="False"
                                    ToolTip="Choose additional level files with Windows Explorer"/>
                            <Button x:Name="RemoveFilesButton" Content="Remove selected" Click="RemoveFiles_Click"
                                    Padding="10,5" IsEnabled="False"
                                    ToolTip="Remove selected files from the preset"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="2" Margin="0,9,0,0" Opacity="0.72" TextWrapping="Wrap"
                                   Text="Adding or removing files saves the preset immediately."/>
                    </Grid>
                </TabItem>
                <TabItem x:Name="CameraLocationsTab" Header="Camera locations">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="130"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="NewCameraButton" Content="New camera location" Click="NewCamera_Click"
                                    Padding="10,5" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button x:Name="DefaultCameraButton" Content="Use default location" Click="DefaultCamera_Click"
                                    Padding="10,5" IsEnabled="False"
                                    ToolTip="Clear the camera selection and open levels at their usual location"/>
                        </WrapPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <Label Content="Search camera locations" Target="{Binding ElementName=CameraSearchTextBox}" Padding="0,0,0,4"/>
                            <TextBox x:Name="CameraSearchTextBox" Padding="7,4"
                                     Text="{Binding CameraSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search camera location names in this level preset"/>
                        </StackPanel>
                        <ListBox x:Name="CameraPresetsList" Grid.Row="2" ItemsSource="{Binding CameraPresetView}"
                                 SelectedItem="{Binding SelectedCameraPreset, Mode=TwoWay}"
                                 IsSynchronizedWithCurrentItem="False"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="5,6" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid x:Name="CameraEditorFields" Grid.Row="3" Margin="0,9,0,0" IsEnabled="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,6">
                                <Label Content="Camera location name" Target="{Binding ElementName=CameraNameTextBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="CameraNameTextBox" Padding="7,4"
                                         Text="{Binding CameraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,8,6">
                                <Label Content="X" Target="{Binding ElementName=CameraXTextBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="CameraXTextBox" Padding="7,4" Text="{Binding CameraX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,6">
                                <Label Content="Y" Target="{Binding ElementName=CameraYTextBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="CameraYTextBox" Padding="7,4" Text="{Binding CameraY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                                <Label Content="Z" Target="{Binding ElementName=CameraZTextBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="CameraZTextBox" Padding="7,4" Text="{Binding CameraZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,8,0">
                                <Label Content="Roll (degrees)" Target="{Binding ElementName=CameraRollTextBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="CameraRollTextBox" Padding="7,4" Text="{Binding CameraRoll, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                                <Label Content="Pitch (degrees)" Target="{Binding ElementName=CameraPitchTextBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="CameraPitchTextBox" Padding="7,4" Text="{Binding CameraPitch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <Label Content="Yaw (degrees)" Target="{Binding ElementName=CameraYawTextBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="CameraYawTextBox" Padding="7,4" Text="{Binding CameraYaw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Grid.Row="4" Margin="0,9,0,0">
                            <Button x:Name="SaveCameraButton" Content="Save camera" Click="SaveCamera_Click" Padding="10,5" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button x:Name="UseCurrentCameraButton" Content="Use current camera" Click="UseCurrentCamera_Click" Padding="10,5" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button x:Name="DeleteCameraButton" Content="Delete camera" Click="DeleteCamera_Click" Padding="10,5" IsEnabled="False"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="5" Text="{Binding CameraEditorStatus}" TextWrapping="Wrap" Margin="0,9,0,0" Opacity="0.72"/>
                    </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding StatusText}" TextWrapping="Wrap"
                   Margin="0,12,0,0" Opacity="0.8" MinHeight="18"/>
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DeletePresetButton" Content="Delete preset" Click="DeletePreset_Click"
                    Padding="12,6" HorizontalAlignment="Left" IsEnabled="False"/>
            <Button x:Name="OpenPresetButton" Grid.Column="1" Content="Open preset" Click="OpenPreset_Click"
                    Padding="16,6" Margin="0,0,8,0" IsDefault="True" IsEnabled="False"
                    ToolTip="Open every level in the selected preset"/>
            <Button Grid.Column="2" Content="Close" IsCancel="True" MinWidth="80" Padding="12,6"/>
        </Grid>
    </Grid>
</misc:NotifyPropertyChangedWindowBase>
