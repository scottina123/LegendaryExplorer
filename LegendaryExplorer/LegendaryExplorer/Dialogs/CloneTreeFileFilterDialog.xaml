<Window x:Class="LegendaryExplorer.Dialogs.CloneTreeFileFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="350"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Title="Clone Tree to Folder"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <StackPanel Margin="15">
        <TextBlock Text="Which files should receive the cloned export tree?"
                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <Button Content="LOC files only (localization)" Click="LocOnly_Click" Padding="10,8" Margin="0,3"
                ToolTip="Only clone into files containing _LOC_ in their name"
                Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
        <Button Content="Base files only (non-LOC)" Click="BaseOnly_Click" Padding="10,8" Margin="0,3"
                ToolTip="Only clone into files that do NOT contain _LOC_ in their name"
                Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
        <Button Content="All PCC files" Click="AllFiles_Click" Padding="10,8" Margin="0,3"
                ToolTip="Clone into every package file in the folder"
                Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
        <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="10,8" Margin="0,12,0,0"
                Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
    </StackPanel>
</Window>
