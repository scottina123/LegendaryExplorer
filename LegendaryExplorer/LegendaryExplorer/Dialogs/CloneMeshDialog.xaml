<Window x:Class="LegendaryExplorer.Dialogs.CloneMeshDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone Mesh" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
    <StackPanel Margin="18">
        <TextBlock x:Name="QuestionText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock x:Name="AssetDetailsText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="ImportedAssetsText" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
        <Label Content="Mesh, material and texture name _suffix (optional):" Target="{Binding ElementName=SuffixTextBox}"
               Padding="0" Margin="0,0,0,5"/>
        <TextBox x:Name="SuffixTextBox" TextChanged="SuffixTextBox_TextChanged" Padding="5"/>
        <TextBlock Text="Enter xxxx or _xxxx to create OriginalName_xxxx for the mesh and its cloned materials and textures. Renamed meshes and materials use instance index 0. Leave blank to use new instance numbers."
                   TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock Text="If a mesh or material name already exists, a number is added to its name (OriginalName_xxxx_2), keeping instance index 0."
                   TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock x:Name="SuffixValidationText" Text="Use letters, numbers, and underscores for the suffix."
                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CloneMeshOnlyButton" Content="Clone mesh _only" Click="CloneMeshOnly_Click" Padding="12,7" Margin="0,0,8,0"/>
            <Button x:Name="CloneWithAssetsButton" Content="Clone mesh, materials and _textures" Click="CloneWithAssets_Click" Padding="12,7" Margin="0,0,8,0"/>
            <Button Content="_Cancel" IsCancel="True" Padding="12,7"/>
        </StackPanel>
    </StackPanel>
</Window>
