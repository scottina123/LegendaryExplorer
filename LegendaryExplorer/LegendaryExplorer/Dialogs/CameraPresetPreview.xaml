<UserControl x:Class="LegendaryExplorer.Dialogs.CameraPresetPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:scene3D="clr-namespace:LegendaryExplorer.Tools.LevelEditor.Scene3D">
    <Grid Background="#181818">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Padding="4" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <xctk:DropDownButton Content="View options" MaxDropDownHeight="220" CloseOnFocusLoss="False"
                                 HorizontalAlignment="Right"
                                 BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                <xctk:DropDownButton.DropDownContent>
                    <scene3D:SceneControlOptionsControl x:Name="PreviewOptionsControl"/>
                </xctk:DropDownButton.DropDownContent>
            </xctk:DropDownButton>
        </Border>
        <scene3D:SceneRenderControl x:Name="SceneViewer" Grid.Row="1"/>
        <Border Grid.Row="1" VerticalAlignment="Bottom" Background="#A0000000" Padding="8">
            <TextBlock x:Name="PreviewStatusTextBlock" Foreground="White" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
