<misc:NotifyPropertyChangedWindowBase
    x:Class="LegendaryExplorer.Dialogs.EntrySelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:dialogs="clr-namespace:LegendaryExplorer.Dialogs"
    xmlns:packages="clr-namespace:LegendaryExplorerCore.Packages;assembly=LegendaryExplorerCore"
    xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
    xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
    xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
    xmlns:treeHelpers="clr-namespace:LegendaryExplorer.SharedUI.PeregrineTreeView"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:fa5="http://schemas.fontawesome.com/icons/"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d"
    d:DataContext="{Binding RelativeSource={RelativeSource Self}}"
        ResizeMode="CanResizeWithGrip"
        Title="Entry Selector" Width="780" Height="520" MinWidth="520" MinHeight="360">
    <misc:NotifyPropertyChangedWindowBase.Resources>
        <dialogs:EntrySelectorSubtitleConverter x:Key="EntrySelectorSubtitleConverter"/>
        <converters:BoolToIndexConverter x:Key="BoolToIndexConverter"/>
        <converters:EntryFileTypeIconPathConverter x:Key="EntryFileTypeIconPathConverter"/>
        <converters:EntryFileTypeConverter x:Key="EntryFileTypeConverter"/>
        <Style x:Key="EntrySubtitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="35,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="ToolTip" Value="{Binding SubText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SubText, FallbackValue={x:Null}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SubText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type packages:ImportEntry}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Path=UIndex}" Foreground="Gray"/>
                    <TextBlock Text="{Binding Path=InstancedFullPath}" Margin="5,0,0,0" Foreground="Gray"/>
                    <TextBlock Text="{Binding ClassName, StringFormat='({0})'}" Margin="5,0,0,0" Foreground="Gray"/>
                </StackPanel>
                <TextBlock Style="{StaticResource EntrySubtitleStyle}" Text="{Binding SubText}">
                    <TextBlock.DataContext>
                        <MultiBinding Converter="{StaticResource EntrySelectorSubtitleConverter}">
                            <Binding/>
                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type dialogs:EntrySelector}}"/>
                        </MultiBinding>
                    </TextBlock.DataContext>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type packages:ExportEntry}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Path=UIndex}" Foreground="Gray"/>
                    <TextBlock Text="{Binding InstancedFullPath}" Margin="5,0,0,0"/>
                    <TextBlock Text="{Binding ClassName, StringFormat='({0})'}" Margin="5,0,0,0" Foreground="Gray"/>
                </StackPanel>
                <TextBlock Style="{StaticResource EntrySubtitleStyle}" Text="{Binding SubText}">
                    <TextBlock.DataContext>
                        <MultiBinding Converter="{StaticResource EntrySelectorSubtitleConverter}">
                            <Binding/>
                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type dialogs:EntrySelector}}"/>
                        </MultiBinding>
                    </TextBlock.DataContext>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </misc:NotifyPropertyChangedWindowBase.Resources>
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" LastChildFill="True">
        <DockPanel.Resources>
            <Style x:Key="CustomListViewItemStyle" TargetType="{x:Type ListViewItem}">
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                    </Trigger>
                </Style.Triggers>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            </Style>
            <ItemsPanelTemplate x:Key="Vsp">
                <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
        </DockPanel.Resources>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding DirectionsText, FallbackValue=Select an export or import}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
            <DockPanel Margin="0,8,0,0" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Search"
                        Margin="5,0,0,0"
                        Padding="10,2"
                        Visibility="{Binding ItemSearchVisibility}"
                        Click="SearchButton_Click"/>
                <TextBox x:Name="EntrySearchTextBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="EntrySearchTextBox_KeyDown"
                         ToolTip="{Binding SearchHelpText}"/>
            </DockPanel>
            <TextBlock Margin="0,4,0,8" Foreground="Gray" Text="{Binding SearchHelpText}"/>
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ClassFilterVisibility}" Value="Collapsed"/>
                                    <Condition Binding="{Binding ViewSelectionVisibility}" Value="Collapsed"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <DockPanel DockPanel.Dock="Right" Margin="12,0,0,0" Visibility="{Binding ViewSelectionVisibility}">
                    <TextBlock Text="View:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="EntryViewComboBox"
                              MinWidth="160"
                              SelectedIndex="{Binding UseTreeView, Mode=TwoWay, Converter={StaticResource BoolToIndexConverter}}"
                              ToolTip="Choose a list or the Package Editor tree. This choice is remembered for the next entry selector.">
                        <ComboBoxItem Content="List"/>
                        <ComboBoxItem Content="Package Editor tree"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel Visibility="{Binding ClassFilterVisibility}">
                    <TextBlock DockPanel.Dock="Left" Text="Class:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ClassFilterComboBox"
                              MinWidth="110"
                              ItemsSource="{Binding AvailableClasses}"
                              SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                              sharedUi:ComboBoxSearchBehavior.IsEnabled="True"
                              ToolTip="Filter objects by class"/>
                </DockPanel>
            </DockPanel>
            <CheckBox Content="{Binding ShowAllEntriesOptionLabel}"
                      IsChecked="{Binding ShowAllEntries, Mode=TwoWay}"
                      Visibility="{Binding ShowAllEntriesOptionVisibility}"
                      Margin="0,0,0,8"/>
            <StackPanel Visibility="{Binding ItemSearchVisibility}">
                <TextBox x:Name="EntryFilterTextBox"
                         Text="{Binding ItemFilterText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="EntryFilterTextBox_KeyDown"
                         ToolTip="{Binding ItemFilterHelpText}"/>
                <TextBlock Margin="0,4,0,8" Foreground="Gray" Text="{Binding ItemFilterHelpText}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="OK" Width="60" Command="{Binding OKCommand}"/>
            <Button Content="Cancel" Padding="8,3" Margin="5,0,0,0" Click="CancelButton_Click"/>
        </StackPanel>

        <Grid>
        <ListView x:Name="EntrySelectorListView"
                  Visibility="{Binding ListViewVisibility}"
                  AlternationCount="2"
                  ItemsSource="{Binding FilteredEntriesList}"
                  SelectedItem="{Binding SelectedEntryItem, Mode=TwoWay}"
                  ItemsPanel="{StaticResource Vsp}"
                  ItemContainerStyle="{StaticResource CustomListViewItemStyle}"
                  MouseDoubleClick="EntrySelectorListView_MouseDoubleClick"
                  KeyDown="EntrySelectorListView_KeyDown"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.Resources>
                <DataTemplate DataType="{x:Type sys:String}">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListView.Resources>
        </ListView>
        <TreeView x:Name="EntrySelectorTreeView"
                  Visibility="{Binding TreeViewVisibility}"
                  ItemsSource="{Binding TreeEntries}"
                  SelectedItemChanged="EntrySelectorTreeView_SelectedItemChanged"
                  MouseDoubleClick="EntrySelectorTreeView_MouseDoubleClick"
                  KeyDown="EntrySelectorTreeView_KeyDown"
                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Standard">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Padding" Value="2"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type dialogs:EntrySelectorTreeNode}" ItemsSource="{Binding Children}">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="ToolTip" Value="{Binding Entry.InstancedFullPath}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanSelect}" Value="False">
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="ToolTip" Value="Expand this branch to find selectable objects."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,3,0" Visibility="{Binding Entry, Converter={StaticResource EntryFileTypeConverter}}">
                                <Image x:Name="EntryTypeIcon" Source="{Binding Entry, Converter={StaticResource EntryFileTypeIconPathConverter}}"/>
                                <fa5:ImageAwesome x:Name="MeshTypeIcon" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Metadata.IsImport}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ImportIndexBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Metadata.SubText}" MaxWidth="480" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="19,0,0,0"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="ToolTip" Value="{Binding Metadata.SubText}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Metadata.SubText, FallbackValue={x:Null}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Metadata.SubText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Entry, Converter={StaticResource EntryFileTypeIconPathConverter}}" Value="/Tools/PackageEditor/ExportIcons/icon_mesh.png">
                            <Setter TargetName="EntryTypeIcon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MeshTypeIcon" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Entry.ClassName}" Value="SkeletalMesh">
                            <Setter TargetName="MeshTypeIcon" Property="Icon" Value="Solid_Skull"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Entry.ClassName}" Value="StaticMesh">
                            <Setter TargetName="MeshTypeIcon" Property="Icon" Value="Solid_Archway"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Entry.ClassName}" Value="FracturedStaticMesh">
                            <Setter TargetName="MeshTypeIcon" Property="Icon" Value="Solid_Archway"/>
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <i:Interaction.Behaviors>
                <treeHelpers:TreeSelectionBehavior SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"/>
            </i:Interaction.Behaviors>
        </TreeView>
        </Grid>
        </DockPanel>
        <GridSplitter x:Name="PreviewSplitter"
                      Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Visibility="Collapsed"/>
        <ContentControl x:Name="PreviewHost"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"/>
    </Grid>
</misc:NotifyPropertyChangedWindowBase>
