<misc:NotifyPropertyChangedWindowBase
    x:Class="LegendaryExplorer.Dialogs.StringSelectorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d"
    d:DataContext="{Binding RelativeSource={RelativeSource Self}}"
    ResizeMode="CanResizeWithGrip"
    Title="String Selector"
    Width="720"
    Height="420"
    MinWidth="480"
    MinHeight="320">
    <DockPanel Margin="5" LastChildFill="True">
        <DockPanel.Resources>
            <Style x:Key="CustomListViewItemStyle" TargetType="{x:Type ListViewItem}">
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                    </Trigger>
                </Style.Triggers>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            </Style>
            <ItemsPanelTemplate x:Key="Vsp">
                <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
        </DockPanel.Resources>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding DirectionsText}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBox x:Name="SearchTextBox"
                     Margin="0,8,0,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SearchTextBox_KeyDown"
                     ToolTip="Search values"/>
            <TextBlock Margin="0,4,0,8" Foreground="Gray" Text="Search the available values"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="OK" Width="60" Command="{Binding OKCommand}"/>
            <Button Content="Cancel" Padding="8,3" Margin="5,0,0,0" Click="CancelButton_Click"/>
        </StackPanel>

        <ListView x:Name="SelectionListView"
                  AlternationCount="2"
                  ItemsSource="{Binding FilteredItems}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  ItemsPanel="{StaticResource Vsp}"
                  ItemContainerStyle="{StaticResource CustomListViewItemStyle}"
                  MouseDoubleClick="SelectionListView_MouseDoubleClick"
                  KeyDown="SelectionListView_KeyDown"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Subtitle}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</misc:NotifyPropertyChangedWindowBase>
