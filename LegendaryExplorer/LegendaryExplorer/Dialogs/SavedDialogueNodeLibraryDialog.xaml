<Window x:Class="LegendaryExplorer.Dialogs.SavedDialogueNodeLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saved Dialogue Nodes" Width="760" Height="560"
        MinWidth="580" MinHeight="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="SearchTextBox" Padding="7,5" Margin="0,0,0,10"
                 ToolTip="Search saved node names, games, node types, or dialogue text"
                 TextChanged="SearchTextBox_TextChanged"/>
        <ListBox x:Name="NodeListBox" Grid.Row="1" SelectionChanged="NodeListBox_SelectionChanged"
                 MouseDoubleClick="NodeListBox_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Details}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Opacity="0.75"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RenameButton" Content="Rename" Click="RenameButton_Click" IsEnabled="False" MinWidth="80" Margin="4" Padding="8,4"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" IsEnabled="False" MinWidth="80" Margin="4" Padding="8,4"/>
                <Button x:Name="ApplyButton" Content="Apply Node" Click="ApplyButton_Click" IsDefault="True" IsEnabled="False" MinWidth="100" Margin="4" Padding="8,4"/>
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="4" Padding="8,4"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
