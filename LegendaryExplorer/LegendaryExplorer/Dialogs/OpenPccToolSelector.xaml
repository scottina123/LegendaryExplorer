<Window x:Class="LegendaryExplorer.Dialogs.OpenPccToolSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open PCC With" Height="260" Width="360" MinHeight="260" MinWidth="360"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <DockPanel Margin="12">
        <TextBlock x:Name="DirectionsTextBlock"
                   DockPanel.Dock="Top"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Padding="12,4" IsCancel="True"/>
        </StackPanel>

        <UniformGrid Columns="1" Rows="4">
            <Button Tag="Package Editor" Click="ToolButton_Click" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource iconPackageEditor}" Width="32" Height="32"/>
                    <TextBlock Text="Package Editor" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Tag="Dialogue Editor" Click="ToolButton_Click" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource iconDialogueEditor}" Width="32" Height="32"/>
                    <TextBlock Text="Dialogue Editor" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Tag="Sequence Editor" Click="ToolButton_Click" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource iconSequenceEditor}" Width="32" Height="32"/>
                    <TextBlock Text="Sequence Editor" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Tag="Level Editor" Click="ToolButton_Click" HorizontalContentAlignment="Left" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource iconLevelEditor}" Width="32" Height="32"/>
                    <TextBlock Text="Level Editor" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </DockPanel>
</Window>
