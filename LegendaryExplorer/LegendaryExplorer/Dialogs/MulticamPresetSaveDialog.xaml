<Window x:Class="LegendaryExplorer.Dialogs.MulticamPresetSaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Multicam Director Preset" Width="460" SizeToContent="Height"
        MinHeight="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Preset name" Margin="0,5,8,5"/>
        <TextBox x:Name="PresetNameTextBox" Grid.Column="1" Margin="0,3" Padding="5" TextChanged="Input_Changed"/>
        <TextBlock Grid.Row="1" Text="Description" Margin="0,5,8,5"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Padding="5"
                 Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Grid.Row="2" Text="Category" Margin="0,5,8,5"/>
        <ComboBox x:Name="TypeComboBox" Grid.Row="2" Grid.Column="1" Margin="0,3" SelectedIndex="0">
            <ComboBoxItem Content="Static → Dynamic" Tag="StaticToDynamic"/>
            <ComboBoxItem Content="Dynamic → Static" Tag="DynamicToStatic"/>
        </ComboBox>
        <TextBlock x:Name="ValidationTextBlock" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0"
                   Foreground="IndianRed" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="85" Margin="4" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="85" Margin="4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
