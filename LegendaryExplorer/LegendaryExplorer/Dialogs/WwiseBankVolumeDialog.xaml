<Window x:Class="LegendaryExplorer.Dialogs.WwiseBankVolumeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust Bank Settings" Width="500" Height="330"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Set the volume and audio processing applied to this bank."
                   TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Margin="0,0,0,4">
            <Run Text="Current volume: "/>
            <Run x:Name="CurrentVolumeRun" FontWeight="Bold"/>
        </TextBlock>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="VolumeSlider" Minimum="-96" Maximum="12" TickFrequency="1"
                    SmallChange="0.5" LargeChange="5" VerticalAlignment="Center"
                    ToolTip="Bank volume in decibels" ValueChanged="VolumeSlider_ValueChanged"/>
            <TextBox x:Name="VolumeTextBox" Grid.Column="1" Margin="8,0,4,0" Padding="4,2"
                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                     TextChanged="VolumeTextBox_TextChanged" ToolTip="Enter the bank volume manually"/>
            <TextBlock Grid.Column="2" Text="dB" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <CheckBox x:Name="LoopAudioCheckBox" Margin="0,4"
                      Content="Loop imported audio infinitely" IsThreeState="True"
                      ToolTip="Checked applies infinite looping to all sounds. An indeterminate value preserves mixed loop settings."/>
            <CheckBox x:Name="RadioEffectCheckBox" Margin="0,4"
                      Content="Apply Dual_Filters_Radio_Comm effect"
                      ToolTip="Applies the imported Wwise Parametric EQ radio communication filter to the root ActorMixer."/>
            <TextBlock x:Name="RadioEffectUnavailableText" Margin="24,0,0,0" Opacity="0.7"
                       Text="This bank does not contain the imported radio effect data, so the effect cannot be enabled."
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="ValidationText" Foreground="Red" Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ApplyButton" Grid.Column="1" Content="Apply" Width="80" Margin="0,0,8,0"
                    IsDefault="True" Click="ApplyButton_Click"/>
            <Button Grid.Column="2" Content="Cancel" Width="80" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
