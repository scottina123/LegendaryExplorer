<Window x:Class="LegendaryExplorer.Dialogs.GestureAnimationImporterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sharedToolControls="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls"
        xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
        Title="Gesture Animation Importer" Width="1250" Height="700"
        WindowStartupLocation="CenterOwner"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: Target Info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Import animations into Gesture Track" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="{Binding TargetExportInfo}" Opacity="0.7" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Middle: Split between animation list and gesture editor -->
        <TabControl Grid.Row="1">
            <!-- Tab 1: Import Animation -->
            <TabItem Header="Import Animation">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Animation Preview -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Animation Preview" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Mesh: " VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <ComboBox x:Name="PreviewMeshComboBox" DisplayMemberPath="MeshName" SelectionChanged="PreviewMesh_SelectionChanged"/>
                        </DockPanel>
                        <sharedToolControls:AnimationPreviewControl x:Name="AnimPreviewControl"/>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                    <!-- Middle: Animation List -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Animations from Asset Database" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Source Game: " VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <ComboBox x:Name="SourceGameComboBox" SelectionChanged="SourceGameComboBox_SelectionChanged" Width="80" DockPanel.Dock="Left"/>
                            <TextBlock Text="  Search: " VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Source Package: " VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <ComboBox x:Name="SourcePackageComboBox"
                                      ItemsSource="{Binding AvailableAnimationSources}"
                                      SelectedItem="{Binding SelectedAnimationSource}"
                                      DisplayMemberPath="DisplayName"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding AnimationStatusText}" Opacity="0.6" Margin="0,0,0,4"/>
                        <ListBox x:Name="AnimationListBox" 
                                 ItemsSource="{Binding FilteredAnimations}"
                                 SelectedItem="{Binding SelectedAnimation}"
                                 SelectionChanged="AnimationListBox_SelectionChanged"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AnimSequence}" FontWeight="DemiBold"/>
                                        <TextBlock Opacity="0.7" FontSize="10">
                                            <Run Text="{Binding SeqName, Mode=OneWay}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding AnimData, Mode=OneWay}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Length, StringFormat={}{0:F2}s, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

                    <!-- Right: Import Settings -->
                    <DockPanel Grid.Column="4" Margin="5,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Import Settings" FontWeight="Bold" Margin="0,0,0,8"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox x:Name="GbGestureImportTarget" Header="Target BioGestureData" Padding="8" Margin="0,0,0,8">
                                    <ComboBox ItemsSource="{Binding GestureImportTargets}"
                                              SelectedItem="{Binding SelectedGestureImportTarget}"
                                              DisplayMemberPath="DisplayName"/>
                                </GroupBox>
                                <!-- Group Selection -->
                                <GroupBox x:Name="GbPropertyGroups" Header="Animation Property Groups" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Select which property groups this animation should be assigned to:" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7"/>
                                        <CheckBox x:Name="CbPoseGroup" Content="Pose (nmPoseSet / nmPoseAnim)" Margin="0,2" IsChecked="True"/>
                                        <CheckBox x:Name="CbGestureGroup" Content="Gesture (nmGestureSet / nmGestureAnim)" Margin="0,2"/>
                                        <CheckBox x:Name="CbTransitionGroup" Content="Transition (nmTransitionSet / nmTransitionAnim)" Margin="0,2"/>
                                        <CheckBox x:Name="CbStartingPoseGroup" Content="Starting Pose (nmStartingPoseSet / nmStartingPoseAnim)" Margin="0,2"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Gesture Key Settings -->
                                <GroupBox x:Name="GbGestureKeySettings" Header="Gesture Key Settings" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="Key Time: " VerticalAlignment="Center" DockPanel.Dock="Left" Width="80"/>
                                            <xctk:SingleUpDown x:Name="KeyTimeUpDown" Value="0" Minimum="0" Increment="0.1" FormatString="F2"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="Play Rate: " VerticalAlignment="Center" DockPanel.Dock="Left" Width="80"/>
                                            <xctk:SingleUpDown x:Name="PlayRateUpDown" Value="1" Minimum="0" Increment="0.1" FormatString="F2"/>
                                        </DockPanel>
                                        <CheckBox x:Name="CbOneShotAnim" Content="One-Shot Animation" Margin="0,4"/>
                                        <CheckBox x:Name="CbSnapToPose" Content="Snap To Pose" Margin="0,2"/>
                                        <CheckBox x:Name="CbPlayUntilNext" Content="Play Until Next" Margin="0,2"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Selected Animation Info -->
                                <GroupBox Header="Selected Animation Details" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedAnimationDetails}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </GroupBox>

                                <Button Content="Import Animation and Add Gesture" 
                                        Padding="8,4" Margin="0,4"
                                        Click="ImportAnimation_Click"
                                        IsEnabled="{Binding CanImport}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Edit Existing Gestures -->
            <TabItem x:Name="EditGesturesTab" Header="Edit Existing Gestures">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Gesture list -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Gestures (m_aGestures)" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button DockPanel.Dock="Bottom" Content="Remove Selected Gesture" Margin="0,4,0,0" Click="RemoveGesture_Click"/>
                        <ListBox x:Name="GestureListBox" 
                                 ItemsSource="{Binding GestureEntries}"
                                 SelectedItem="{Binding SelectedGestureEntry}"
                                 SelectionChanged="GestureListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                    <!-- Right: Gesture property editor + Starting Pose -->
                    <DockPanel Grid.Column="2" Margin="5,0,0,0">
                        <!-- Starting Pose: track-level property, always editable, docked to bottom -->
                        <GroupBox DockPanel.Dock="Bottom" Header="Starting Pose (Track-Level)" Padding="8" Margin="0,5,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="nmStartingPoseSet:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EditStartingPoseSet}" VerticalAlignment="Center" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="nmStartingPoseAnim:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditStartingPoseAnim}" VerticalAlignment="Center" Margin="0,2"/>
                                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="Browse..." Margin="4,2" Padding="6,2" VerticalAlignment="Center" Click="BrowseStartingPoseAnim_Click"/>
                                <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Content="Clear" Margin="2,2" Padding="6,2" VerticalAlignment="Center" Click="ClearStartingPoseAnim_Click"/>
                            </Grid>
                        </GroupBox>

                        <!-- Per-gesture properties in scrollable area -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel IsEnabled="{Binding HasSelectedGesture}">
                            <TextBlock Text="Gesture Properties" FontWeight="Bold" Margin="0,0,0,8"/>

                            <GroupBox Header="Pose" Padding="8" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="nmPoseSet:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EditPoseSet}" VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="nmPoseAnim:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditPoseAnim}" VerticalAlignment="Center" Margin="0,2"/>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="Browse..." Margin="4,2" Padding="6,2" VerticalAlignment="Center" Click="BrowsePoseAnim_Click"/>
                                    <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Content="Clear" Margin="2,2" Padding="6,2" VerticalAlignment="Center" Click="ClearPoseAnim_Click"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Gesture" Padding="8" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="nmGestureSet:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EditGestureSet}" VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="nmGestureAnim:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditGestureAnim}" VerticalAlignment="Center" Margin="0,2"/>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="Browse..." Margin="4,2" Padding="6,2" VerticalAlignment="Center" Click="BrowseGestureAnim_Click"/>
                                    <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Content="Clear" Margin="2,2" Padding="6,2" VerticalAlignment="Center" Click="ClearGestureAnim_Click"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Transition" Padding="8" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="nmTransitionSet:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EditTransitionSet}" VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="nmTransitionAnim:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditTransitionAnim}" VerticalAlignment="Center" Margin="0,2"/>
                                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="Browse..." Margin="4,2" Padding="6,2" VerticalAlignment="Center" Click="BrowseTransitionAnim_Click"/>
                                    <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Content="Clear" Margin="2,2" Padding="6,2" VerticalAlignment="Center" Click="ClearTransitionAnim_Click"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Playback" Padding="8" Margin="0,0,0,5">
                                <StackPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="fPlayRate:" VerticalAlignment="Center" DockPanel.Dock="Left" Width="120"/>
                                        <TextBox Text="{Binding EditPlayRate, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="fStartOffset:" VerticalAlignment="Center" DockPanel.Dock="Left" Width="120"/>
                                        <TextBox Text="{Binding EditStartOffset, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="fEndOffset:" VerticalAlignment="Center" DockPanel.Dock="Left" Width="120"/>
                                        <TextBox Text="{Binding EditEndOffset, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="fStartBlendDuration:" VerticalAlignment="Center" DockPanel.Dock="Left" Width="120"/>
                                        <TextBox Text="{Binding EditStartBlendDuration, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="fEndBlendDuration:" VerticalAlignment="Center" DockPanel.Dock="Left" Width="120"/>
                                        <TextBox Text="{Binding EditEndBlendDuration, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="fWeight:" VerticalAlignment="Center" DockPanel.Dock="Left" Width="120"/>
                                        <TextBox Text="{Binding EditWeight, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <CheckBox Content="bOneShotAnim" IsChecked="{Binding EditOneShotAnim}" Margin="0,4"/>
                                    <CheckBox Content="bSnapToPose" IsChecked="{Binding EditSnapToPose}" Margin="0,2"/>
                                    <CheckBox Content="bPlayUntilNext" IsChecked="{Binding EditPlayUntilNext}" Margin="0,2"/>
                                    <CheckBox Content="bUseDynAnimSets" IsChecked="{Binding EditUseDynAnimSets}" Margin="0,2"/>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="Save Changes to Selected Gesture" Padding="8,4" Margin="0,4" Click="SaveGesture_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Tab 3: Track Gestures -->
            <TabItem x:Name="TrackGesturesTab" Header="Track Gestures">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="300"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="2*" MinWidth="300"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="3*" MinWidth="450"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Gesture Tracks from Asset Database" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ScrollViewer DockPanel.Dock="Top" MaxHeight="250" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                            <StackPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Starting Pose Set:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <xctk:WatermarkTextBox Width="140" Margin="0,0,8,0"
                                                           Watermark="Any value"
                                                           Text="{Binding GestureTrackStartingPoseSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="..." Padding="5,1" Margin="-4,0,8,0" Tag="StartingPoseSet" Click="BrowseGestureTrackFilterValue_Click" ToolTip="Browse starting pose set names"/>
                                    <TextBlock Text="Starting Pose Anim:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <xctk:WatermarkTextBox Width="140" Margin="0,0,8,0"
                                                           Watermark="Any value"
                                                           Text="{Binding GestureTrackStartingPoseAnim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="..." Padding="5,1" Margin="-4,0,8,0" Tag="StartingPoseAnim" Click="BrowseGestureTrackFilterValue_Click" ToolTip="Browse starting pose animation names"/>
                                    <TextBlock Text="Node TLK:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <xctk:WatermarkTextBox Width="180" Margin="0,0,8,0"
                                                           Watermark="Text or StrRef"
                                                           Text="{Binding GestureTrackNodeTlkFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Add Gesture Group" Padding="8,2" Click="AddGestureTrackCriterion_Click"
                                            ToolTip="Require another BioGestureData entry to match."/>
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding GestureTrackCriteria}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2,0,4">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding GroupLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Content="Remove" Padding="8,2" Margin="8,0,0,0" HorizontalAlignment="Right"
                                                            Tag="{Binding}" IsEnabled="{Binding CanRemove}" Click="RemoveGestureTrackCriterion_Click"/>
                                                </DockPanel>
                                                <WrapPanel Margin="0,2,0,0">
                                                    <TextBlock Text="Pose Set:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="125" Margin="0,0,6,0" Watermark="Any" Text="{Binding PoseSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-2,0,6,0" Tag="PoseSet" CommandParameter="{Binding}" Click="BrowseGestureTrackCriterionValue_Click" ToolTip="Browse pose set names"/>
                                                    <TextBlock Text="Pose Anim:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="125" Margin="0,0,6,0" Watermark="Any" Text="{Binding PoseAnim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-2,0,6,0" Tag="PoseAnim" CommandParameter="{Binding}" Click="BrowseGestureTrackCriterionValue_Click" ToolTip="Browse pose animation names"/>
                                                    <TextBlock Text="Gesture Set:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="125" Margin="0,0,6,0" Watermark="Any" Text="{Binding GestureSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-2,0,6,0" Tag="GestureSet" CommandParameter="{Binding}" Click="BrowseGestureTrackCriterionValue_Click" ToolTip="Browse gesture set names"/>
                                                    <TextBlock Text="Gesture Anim:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="125" Margin="0,0,6,0" Watermark="Any" Text="{Binding GestureAnim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-2,0,6,0" Tag="GestureAnim" CommandParameter="{Binding}" Click="BrowseGestureTrackCriterionValue_Click" ToolTip="Browse gesture animation names"/>
                                                    <TextBlock Text="Transition Set:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="125" Margin="0,0,6,0" Watermark="Any" Text="{Binding TransitionSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-2,0,6,0" Tag="TransitionSet" CommandParameter="{Binding}" Click="BrowseGestureTrackCriterionValue_Click" ToolTip="Browse transition set names"/>
                                                    <TextBlock Text="Transition Anim:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="125" Watermark="Any" Text="{Binding TransitionAnim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="4,0,0,0" Tag="TransitionAnim" CommandParameter="{Binding}" Click="BrowseGestureTrackCriterionValue_Click" ToolTip="Browse transition animation names"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding GestureTrackStatusText}" Opacity="0.6" Margin="0,0,0,4"/>
                        <ListBox ItemsSource="{Binding FilteredGestureTracks}"
                                 SelectedItem="{Binding SelectedGestureTrack}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding TrackName}" FontWeight="DemiBold"/>
                                        <TextBlock Text="{Binding NodeTlkString}" Opacity="0.7" FontSize="10" TextWrapping="Wrap"/>
                                        <TextBlock Opacity="0.7" FontSize="10">
                                            <Run Text="Starting pose: "/>
                                            <Run Text="{Binding StartingPoseSet}"/>
                                            <Run Text="."/>
                                            <Run Text="{Binding StartingPoseAnim}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                    <DockPanel Grid.Column="2" Margin="5,0">
                        <TextBlock DockPanel.Dock="Top" Text="Gesture Data" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Source Package: " VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <ComboBox ItemsSource="{Binding AvailableGestureTrackSources}"
                                      SelectedItem="{Binding SelectedGestureTrackSource}"
                                      DisplayMemberPath="DisplayName"/>
                        </DockPanel>
                        <Button DockPanel.Dock="Bottom"
                                Content="Replace Current Gesture Track"
                                Padding="8,4"
                                Margin="0,6,0,0"
                                IsEnabled="{Binding CanImportGestureTrack}"
                                Click="ImportGestureTrack_Click"/>
                        <ListBox ItemsSource="{Binding SelectedGestureTrack.Gestures}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock FontWeight="DemiBold">
                                            <Run Text="Gesture: "/>
                                            <Run Text="{Binding GestureSet}"/>
                                            <Run Text="."/>
                                            <Run Text="{Binding GestureAnim}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Opacity="0.7">
                                            <Run Text="Pose: "/>
                                            <Run Text="{Binding PoseSet}"/>
                                            <Run Text="."/>
                                            <Run Text="{Binding PoseAnim}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Opacity="0.7">
                                            <Run Text="Transition: "/>
                                            <Run Text="{Binding TransitionSet}"/>
                                            <Run Text="."/>
                                            <Run Text="{Binding TransitionAnim}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

                    <exportLoaderControls:GesturePreviewExportLoader x:Name="GestureTrackPreviewControl" Grid.Column="4" Margin="5,0,0,0"/>
                </Grid>
            </TabItem>

            <!-- Tab 4: Ambient Performances (SFXModule_Gestures only) -->
            <TabItem x:Name="AmbPerfTab" Header="Ambient Performances" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Ambient Performance Preview -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Ambient Performance Preview" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Mesh: " VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <ComboBox x:Name="AmbPerfMeshComboBox" DisplayMemberPath="MeshName" SelectionChanged="AmbPerfMesh_SelectionChanged"/>
                        </DockPanel>
                        <sharedToolControls:AnimationPreviewControl x:Name="AmbPerfPreviewControl"/>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                    <!-- Right: Ambient Performance List -->
                    <DockPanel Grid.Column="2" Margin="5,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Ambient Performances from Asset Database" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Source Package: " VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <ComboBox x:Name="AmbPerfSourcePackageComboBox"
                                      ItemsSource="{Binding AvailableAmbPerfSources}"
                                      SelectedItem="{Binding SelectedAmbPerfSource}"
                                      DisplayMemberPath="DisplayName"/>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Search: " VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBox x:Name="AmbPerfSearchBox" TextChanged="AmbPerfSearchBox_TextChanged"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding AmbPerfStatusText}" Opacity="0.6" Margin="0,0,0,4"/>

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentAmbPerfInfo}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Button Content="Import Ambient Performance" 
                                    Padding="8,4"
                                    Click="ImportAmbPerf_Click"
                                    IsEnabled="{Binding CanImportAmbPerf}"/>
                        </DockPanel>

                        <ListBox x:Name="AmbPerfListBox" 
                                 ItemsSource="{Binding FilteredAmbPerfs}"
                                 SelectedItem="{Binding SelectedAmbPerf}"
                                 SelectionChanged="AmbPerfListBox_SelectionChanged"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AnimSequence}" FontWeight="DemiBold"/>
                                        <TextBlock Opacity="0.7" FontSize="10">
                                            <Run Text="{Binding SeqName, Mode=OneWay}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Length, StringFormat={}{0:F2}s, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Content="Close" DockPanel.Dock="Right" Padding="16,4" Click="Close_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="{Binding StatusMessage}" Opacity="0.7"/>
        </DockPanel>
    </Grid>
</Window>
