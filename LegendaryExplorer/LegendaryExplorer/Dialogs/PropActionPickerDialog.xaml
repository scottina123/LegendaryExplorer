<misc:NotifyPropertyChangedWindowBase x:Class="LegendaryExplorer.Dialogs.PropActionPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        Title="Select Prop Action" Width="720" Height="760"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Search nmProp" Margin="0,0,0,3" />
            <TextBox x:Name="PropFilterTextBox" ToolTip="Search the available nmProp values"
                     TextChanged="PropFilterTextBox_TextChanged" KeyDown="PropFilterTextBox_KeyDown" />
            <ListBox x:Name="PropListBox" Height="140" Margin="0,4,0,0"
                     ItemsSource="{Binding PropNamesView}" SelectionChanged="PropListBox_SelectionChanged"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" />
            <TextBlock Text="Filter actions" Margin="0,8,0,3" />
            <TextBox x:Name="FilterTextBox" ToolTip="Filter the actions available for the selected nmProp"
                     TextChanged="FilterTextBox_TextChanged" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="80" Margin="0,0,8,0" IsDefault="True" Content="Select" Click="SelectButton_Click" />
            <Button Width="80" IsCancel="True" Content="Cancel" />
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="ChoicesGrid" Grid.Row="0" ItemsSource="{Binding ChoicesView}" IsReadOnly="True"
                      AutoGenerateColumns="False" SelectionMode="Single" MouseDoubleClick="ChoicesGrid_MouseDoubleClick"
                      SelectionChanged="ChoicesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="nmAction" Binding="{Binding Action}" Width="*" />
                    <DataGridCheckBoxColumn Header="Effects" Binding="{Binding HasEffects, Mode=OneWay}" Width="Auto" />
                    <DataGridCheckBoxColumn Header="Weapon class" Binding="{Binding HasWeaponClass, Mode=OneWay}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="Search compatible pActionClientEffect" Margin="0,8,0,3" />
            <TextBox x:Name="ClientEffectFilterTextBox" Grid.Row="2" ToolTip="Search client effects compatible with the selected nmProp"
                     TextChanged="ClientEffectFilterTextBox_TextChanged" KeyDown="ClientEffectFilterTextBox_KeyDown" />
            <ListBox x:Name="ClientEffectListBox" Grid.Row="3" Margin="0,4,0,0"
                     ItemsSource="{Binding ClientEffectChoicesView}" DisplayMemberPath="DisplayName"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" />
        </Grid>
    </DockPanel>
</misc:NotifyPropertyChangedWindowBase>
