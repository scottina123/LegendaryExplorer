<Window x:Class="LegendaryExplorer.Dialogs.DialogueCachePresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialogue Cache Presets" Width="880" Height="620"
        MinWidth="680" MinHeight="460" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchTextBox" Padding="7,5" Margin="0,0,0,10"
                 ToolTip="Search labels, PCC names, dialogue names, dates, or file locations"
                 TextChanged="SearchTextBox_TextChanged"/>

        <ListBox x:Name="PresetListBox" Grid.Row="1" SelectionChanged="PresetListBox_SelectionChanged"
                 MouseDoubleClick="PresetListBox_MouseDoubleClick"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5" ToolTip="{Binding SourceFilePath}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding PccName}" Margin="14,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding DialogueName}" Margin="14,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding SavedDisplay}" Margin="18,0,4,0" Opacity="0.75"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="9"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Source PCC:" FontWeight="SemiBold" Margin="0,0,10,3"/>
                <TextBlock x:Name="SourcePathTextBlock" Grid.Column="1" Margin="0,0,0,3"
                           TextWrapping="Wrap" Text="Select a cache preset to see its source file."/>
                <TextBlock Grid.Row="1" Text="Dialogue:" FontWeight="SemiBold" Margin="0,0,10,3"/>
                <TextBlock x:Name="DialogueTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,0,0,3"/>
                <TextBlock Grid.Row="2" Text="Saved:" FontWeight="SemiBold" Margin="0,0,10,3"/>
                <TextBlock x:Name="SavedTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,0,0,3"/>
                <TextBlock Grid.Row="3" Text="Cache file:" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <TextBlock x:Name="CachePathTextBlock" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Opacity="0.75"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveCurrentButton" Content="Save Current Cache..." Click="SaveCurrentButton_Click"
                        MinWidth="140" Margin="4" Padding="8,4"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click"
                        IsEnabled="False" MinWidth="80" Margin="4" Padding="8,4"/>
                <Button x:Name="LoadButton" Content="Load Cache" Click="LoadButton_Click"
                        IsDefault="True" IsEnabled="False" MinWidth="100" Margin="4" Padding="8,4"/>
                <Button x:Name="CloseButton" Content="Close" IsCancel="True" MinWidth="80" Margin="4" Padding="8,4"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
