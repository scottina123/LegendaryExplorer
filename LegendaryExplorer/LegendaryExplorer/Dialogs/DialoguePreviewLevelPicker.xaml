<bases:TrackingNotifyPropertyChangedWindowBase x:Class="LegendaryExplorer.Dialogs.DialoguePreviewLevelPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        Title="Dialogue Preview Options" Width="900" Height="800" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="CacheRow" Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.ColumnSpan="3" Header="Player actor" Margin="0,0,0,10">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Left" Text="Player:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="PlayerGenderComboBox" Width="180" HorizontalAlignment="Left" SelectedIndex="0"
                          SelectionChanged="PlayerGenderComboBox_SelectionChanged">
                    <ComboBoxItem Content="Female" Tag="Female"/>
                    <ComboBoxItem Content="Male" Tag="Male"/>
                </ComboBox>
                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Opacity="0.72" TextWrapping="Wrap"
                           Text="Female uses the existing Shepard body, head, hair, and human-female FaceFX. Male uses the base-game HMM body and Shepard head, no hair, and human-male FaceFX."/>
            </DockPanel>
        </GroupBox>

        <GroupBox x:Name="HenchmanGroupBox" Grid.Row="1" Grid.ColumnSpan="3"
                  Header="Squad assignment" Margin="0,0,0,10" Visibility="Collapsed">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,7" Opacity="0.72" TextWrapping="Wrap"
                           Text="This cutscene uses dynamic squad variables. Choose the squadmate represented by each authored slot. Real BioPawn/SFXPawn actors are preferred over stunt actors; equivalent candidates use base-game packages before DLC and mod packages."/>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HenchmanItemsControl"
                                  ItemsSource="{Binding HenchmanSlots, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Slot.SlotTag}" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Slot.Description}" Opacity="0.72"
                                               Margin="8,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}"
                                              DisplayMemberPath="DisplayName" SelectedValuePath="ActorTag"
                                              SelectedValue="{Binding SelectedHenchmanTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="HenchmanComboBox_SelectionChanged"
                                              ToolTip="Choose the squadmate used for this cutscene slot"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Recent level sets">
            <DockPanel Margin="6">
                <Button DockPanel.Dock="Bottom" Content="Add Selected Set" Margin="0,8,0,0" Padding="12,4"
                        Click="AddRecentSet_Click"/>
                <ListBox x:Name="RecentSetsList" MouseDoubleClick="RecentSetsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2" ToolTip="{Binding TooltipText}">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FileCountText}" Opacity="0.7" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Grid.Column="2" Header="Levels to load">
            <DockPanel Margin="6">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add Files..." Padding="12,4" Click="AddFiles_Click"/>
                    <Button Content="Remove" Padding="12,4" Margin="8,0,0,0" Click="RemoveFiles_Click"/>
                </StackPanel>
                <ListBox x:Name="SelectedFilesList" ItemsSource="{Binding SelectedFiles, RelativeSource={RelativeSource AncestorType=Window}}"
                         SelectionMode="Extended" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <GroupBox x:Name="CacheGroupBox" Grid.Row="3" Grid.ColumnSpan="3" Header="Conversation cache" Margin="0,10,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Text="Search:" VerticalAlignment="Center"
                                   Margin="0,0,7,0"/>
                        <TextBox x:Name="CacheSearchTextBox" Padding="5,3"
                                 ToolTip="Search compatible cache preset labels, dates, or file names"
                                 TextChanged="CacheSearchTextBox_TextChanged"/>
                    </DockPanel>
                    <ListBox x:Name="CachePresetList" Grid.Row="1"
                             SelectionChanged="CachePresetList_SelectionChanged"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2" ToolTip="{Binding CacheFilePath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SavedDisplay}" Margin="10,0,2,0"
                                               Opacity="0.72" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="DeleteCachePresetButton" Grid.Row="2" Content="Delete selected preset"
                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3" IsEnabled="False"
                            Click="DeleteCachePresetButton_Click"/>
                </Grid>
                <StackPanel Grid.Column="2">
                    <RadioButton x:Name="UseSelectedCacheRadio" Content="Load selected cache"
                                 GroupName="CacheChoice" Checked="CacheChoice_Changed"/>
                    <TextBlock x:Name="CacheDetailsText" Margin="22,4,0,8" TextWrapping="Wrap" Opacity="0.72"/>
                    <RadioButton x:Name="BuildNewCacheRadio" Content="Build a new cache"
                                 GroupName="CacheChoice" Checked="CacheChoice_Changed"/>
                    <CheckBox x:Name="SaveNewCacheCheckBox" Content="Save the new cache" IsChecked="True"
                              Margin="22,6,0,0" Checked="CacheChoice_Changed" Unchecked="CacheChoice_Changed"/>
                    <TextBox x:Name="NewCacheLabelTextBox" Margin="22,5,0,0" Padding="5,3"
                             ToolTip="Name for the new cache"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="LoadPreviewButton" Content="Load Preview" IsDefault="True" Padding="16,5"
                    Click="Confirm_Click"/>
            <Button Content="Cancel" IsCancel="True" Padding="16,5" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</bases:TrackingNotifyPropertyChangedWindowBase>
