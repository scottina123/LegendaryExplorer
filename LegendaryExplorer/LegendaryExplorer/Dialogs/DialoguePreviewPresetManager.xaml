<Window x:Class="LegendaryExplorer.Dialogs.DialoguePreviewPresetManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialogue Preview Presets" Width="760" Height="520"
        MinWidth="620" MinHeight="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Select a saved BioConversation snapshot, or save the current conversation and selected levels as a new preset."
                   TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ListBox x:Name="PresetListBox" Grid.Row="1" SelectionChanged="PresetListBox_SelectionChanged"
                 MouseDoubleClick="PresetListBox_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Details}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Current..." Click="SaveCurrentButton_Click" MinWidth="105" Margin="4" Padding="8,4"/>
                <Button x:Name="RenameButton" Content="Rename" Click="RenameButton_Click" IsEnabled="False" MinWidth="80" Margin="4" Padding="8,4"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" IsEnabled="False" MinWidth="80" Margin="4" Padding="8,4"/>
                <Button x:Name="LoadButton" Content="Load Preset" Click="LoadButton_Click" IsDefault="True" IsEnabled="False" MinWidth="100" Margin="4" Padding="8,4"/>
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="4" Padding="8,4"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
