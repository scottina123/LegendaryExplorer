<Window x:Class="LegendaryExplorer.Dialogs.PackageReferenceSaveWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reference issues before saving" Width="600" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding WarningMessage}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="Saving to" FontWeight="SemiBold"/>
        <TextBox Text="{Binding DestinationPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,4,0,12"/>
        <TextBlock Text="You can save the file with these issues, or cancel to review them before saving."
                   TextWrapping="Wrap" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveAnywayButton" Content="Save anyway" Click="SaveAnyway_Click" Padding="12,8" MinWidth="110" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Padding="12,8" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
