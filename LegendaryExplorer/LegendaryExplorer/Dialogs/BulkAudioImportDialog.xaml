<Window x:Class="LegendaryExplorer.Dialogs.BulkAudioImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Audio Import (LE2/LE3)" Width="700" Height="550"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Bulk import WAV files into the current LE2/LE3 package via Wwise CLI." 
                   TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.8"/>

        <GroupBox Grid.Row="1" Header="Bank Settings" Padding="8" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Bank Name:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="BankNameTextBox" Text="NewBank" Padding="4" Margin="5,2"/>
                <Label Grid.Row="1" Grid.Column="0" Content="Volume (dB):" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="VolumeTextBox" Text="-10" Padding="4" Margin="5,2"
                         ToolTip="Volume offset in dB applied to the ActorMixer. Typical dialogue value is -10."/>
                <Label Grid.Row="2" Grid.Column="0" Content="Output Bus:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="OutputBusComboBox" IsEditable="False" Margin="5,2" Padding="4"
                          ItemsSource="{Binding OutputBuses}" SelectedItem="{Binding SelectedOutputBus}"
                          ToolTip="The Wwise output bus for the ActorMixer. Non-default buses will be injected into the template project automatically."/>
                <Label Grid.Row="3" Grid.Column="0" Content="Dialogue Bank:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="IsDialogueBankCheckBox" IsChecked="True" VerticalAlignment="Center" Margin="5,4"
                          Content="Audio filenames contain TLK refs (e.g. VO_123456_m)" ToolTip="When checked, events and stream links will be set up using the VO dialogue naming convention."/>
                <Label Grid.Row="4" Grid.Column="0" Content="Gendered Events:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="4" Grid.Column="1" x:Name="GenerateGenderedEventsCheckBox" IsChecked="True" VerticalAlignment="Center" Margin="5,4"
                          Content="Create both _m and _f event variants" ToolTip="When checked, two WwiseEvents are created per audio file (e.g. VO_123456_m_Play and VO_123456_f_Play), both pointing to the same audio. If the filename already ends with _m or _f, it will be replaced for each variant."/>
                <Label Grid.Row="5" Grid.Column="0" Content="Loop Audio:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="5" Grid.Column="1" x:Name="LoopAudioCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                          Content="Loop imported audio infinitely" ToolTip="When checked, each Sound node will have looping enabled with an infinite loop count."/>
                <Label Grid.Row="6" Grid.Column="0" Content="Radio Effect:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="6" Grid.Column="1" x:Name="RadioEffectCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                          Content="Apply Dual_Filters_Radio_Comm effect" ToolTip="When checked, applies the Wwise Parametric EQ radio communication filter to the ActorMixer, simulating audio heard through a radio."/>
            </Grid>
        </GroupBox>

        <ListBox Grid.Row="2" x:Name="WavFilesListBox" ItemsSource="{Binding WavFiles}"
                 SelectionMode="Extended" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,10">
            <Button x:Name="AddFilesButton" Content="Add WAV Files..." Width="120" Height="28" Click="AddFilesButton_Click" Margin="0,0,5,0"/>
            <Button x:Name="RemoveSelectedButton" Content="Remove Selected" Width="120" Height="28" Click="RemoveSelectedButton_Click" Margin="0,0,5,0"/>
            <Button x:Name="ClearAllButton" Content="Clear All" Width="90" Height="28" Click="ClearAllButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="StatusTextBlock" Text="" TextWrapping="Wrap" Margin="0,0,0,5" Opacity="0.8"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ImportButton" Content="Import Audio" Width="110" Height="30" Click="ImportButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
