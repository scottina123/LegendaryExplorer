<Window x:Class="LegendaryExplorer.Dialogs.BulkAudioImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Audio Import (LE2/LE3)" Width="600" Height="450"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="WAV Files to Import" FontWeight="Bold" Margin="0,0,0,5"/>

        <ListBox Grid.Row="1" x:Name="WavFilesListBox" ItemsSource="{Binding WavFiles}"
                 SelectionMode="Extended" Margin="0,0,0,5"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 Foreground="{DynamicResource WindowForegroundBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,10">
            <Button x:Name="AddFilesButton" Content="Add WAV Files..." Width="120" Height="28" Click="AddFilesButton_Click" Margin="0,0,5,0"/>
            <Button x:Name="RemoveSelectedButton" Content="Remove Selected" Width="120" Height="28" Click="RemoveSelectedButton_Click" Margin="0,0,5,0"/>
            <Button x:Name="ClearAllButton" Content="Clear All" Width="90" Height="28" Click="ClearAllButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ImportButton" Content="Import Audio" Width="110" Height="30" Click="ImportButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
