<Window x:Class="LegendaryExplorer.Dialogs.BulkAudioImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Audio Import (LE2/LE3)" Width="800" Height="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Bulk import WAV or MP3 files into the current LE2/LE3 package via Wwise CLI."
                   TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.8"/>

        <TabControl Grid.Row="1" x:Name="GameAudioTabControl" Margin="0,0,0,5">
            <TabItem x:Name="Le2AudioTab" Header="LE2 Bank-wide Effects"
                     ToolTip="These settings apply to every imported audio file unless that file selects an individual effect below.">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,5" TextWrapping="Wrap"
                               Text="LE2 imports streamed audio into an AFC and creates *_Play/Stop_* events. These presets use shipped data from BioD_JnkKgA_100Landing_LOC_INT, profre_illusive_d, and BioS_OmgHub."/>
                    <Label Grid.Row="1" Grid.Column="0" Content="Radio Effect:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="Le2RadioEffectCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                              Checked="Le2RadioEffectCheckBox_CheckedChanged" Unchecked="Le2RadioEffectCheckBox_CheckedChanged"
                              Content="Apply the shipped LE2 radio filter"
                              ToolTip="Applies the exact two-stage radio filter chain from BioD_JnkKgA_100Landing_LOC_INT."/>
                    <Label Grid.Row="2" Grid.Column="0" Content="Helmet Effect:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="Le2HelmetEffectCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                              Checked="Le2HelmetEffectCheckBox_CheckedChanged" Unchecked="Le2HelmetEffectCheckBox_CheckedChanged"
                              Content="Filter voices when helmets are equipped"
                              ToolTip="Adds the shipped LE2 helmet filter and the game parameter named Helmet (ShortID 0x9D4305AE). Selected by default for the Conversation bus."/>
                    <Label Grid.Row="3" Grid.Column="0" Content="Hologram Effect:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="3" Grid.Column="1" x:Name="Le2HologramEffectCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                              Checked="Le2HologramEffectCheckBox_CheckedChanged" Unchecked="Le2HologramEffectCheckBox_CheckedChanged"
                              Content="Apply the ME2 Illusive Man hologram voice effect"
                              ToolTip="Adds the exact two-stage Parametric EQ and filter chain from the hologram dialogue actor mixers in profre_illusive_d."/>
                    <Label Grid.Row="4" Grid.Column="0" Content="Duck Audio:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="4" Grid.Column="1" x:Name="Le2DuckAudioCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                              Content="Apply shipped LE2 Omega music ducking (-12 dB)"
                              ToolTip="Adds the exact duck and reset events from wwise_omghub_streaming in BioS_OmgHub. Available when an LE2 music output bus is selected."/>
                    <Label Grid.Row="5" Grid.Column="0" Content="Attenuation:" VerticalAlignment="Top" Padding="5,8,5,5"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="5,4">
                        <CheckBox x:Name="Le2AttenuationCheckBox" IsChecked="False" VerticalAlignment="Center"
                                  Content="Apply shipped LE2 dialogue attenuation"
                                  ToolTip="Adds the exact five-curve, 70-unit attenuation from BioD_JnkKgA_100Landing_LOC_INT."/>
                        <Grid Margin="20,4,0,0" IsEnabled="{Binding ElementName=Le2AttenuationCheckBox, Path=IsChecked}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Distance scale:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Grid.Column="1" x:Name="Le2AttenuationScaleSlider" Minimum="10" Maximum="500" Value="100"
                                    TickFrequency="25" SmallChange="5" LargeChange="25" Margin="0,0,8,0"
                                    AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"
                                    ValueChanged="Le2AttenuationScaleSlider_ValueChanged"
                                    ToolTip="Scales every distance point together. 100% preserves the shipped curve, whose maximum distance is 70."/>
                            <TextBlock Grid.Column="2" x:Name="Le2AttenuationScaleValueTextBlock" Text="100% (70 max)"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    <Label Grid.Row="6" Grid.Column="0" Content="Loop Audio:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="6" Grid.Column="1" x:Name="Le2LoopAudioCheckBox" IsChecked="False"
                              VerticalAlignment="Center" Margin="5,4"
                              Content="Loop every imported audio file infinitely"
                              ToolTip="Enables the LE2-authored IsLoopingEnabled property on every imported streamed Sound."/>
                    <Label Grid.Row="7" Grid.Column="0" Content="Shared Stop Event:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="7" Grid.Column="1" x:Name="Le2CreateSharedStopEventCheckBox"
                              IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                              Content="Create one Stop event for all imported audio"
                              ToolTip="Creates one WwiseEvent named Stop with a stop action for every imported Sound object."/>
                </Grid>
            </TabItem>
            <TabItem x:Name="Le3AudioTab" Header="LE3 Bank-wide Effects"
                     ToolTip="These settings apply to every imported audio file unless that file selects an individual effect below.">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="Radio Effect:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" x:Name="RadioEffectCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                              Checked="RadioEffectCheckBox_CheckedChanged" Unchecked="RadioEffectCheckBox_CheckedChanged"
                              Content="Apply BioWare radio communication effect" ToolTip="Applies the exact BioWare FutzBox and Parametric EQ radio chain used in cit001_postbridge_lovei_b_dlg."/>
                    <Label Grid.Row="1" Grid.Column="0" Content="QEC Effect:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="QecEffectCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                              Checked="QecEffectCheckBox_CheckedChanged" Unchecked="QecEffectCheckBox_CheckedChanged"
                              Content="Apply Hackett QEC transmission effect"
                              ToolTip="Applies the McDSP FutzBox and Wwise Flanger settings used for Admiral Hackett over the QEC."/>
                    <Label Grid.Row="2" Grid.Column="0" Content="Helmet Effect:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="HelmetEffectCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                              Checked="HelmetEffectCheckBox_CheckedChanged" Unchecked="HelmetEffectCheckBox_CheckedChanged"
                              Content="Filter player and henchman voices when helmets are equipped"
                              ToolTip="Adds the LE3 helmet FutzBox and the Helmet RTPC (0xAA2B753F). RTPC value 0 bypasses the filter; value 1 enables it."/>
                    <Label Grid.Row="3" Grid.Column="0" Content="Duck Audio:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="3" Grid.Column="1" x:Name="DuckAudioCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                              Content="Apply shipped LE3 music ducking state (-3 dB)"
                              ToolTip="Adds the music Volume state used by wwise_cithub_streaming in BioSnd_CitHub. Available when an LE3 music output bus is selected."/>
                    <Label Grid.Row="4" Grid.Column="0" Content="Attenuation:" VerticalAlignment="Top" Padding="5,8,5,5"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="5,4">
                        <CheckBox x:Name="AttenuationCheckBox" IsChecked="False" VerticalAlignment="Center"
                                  Content="Apply standard BioWare distance attenuation"
                                  ToolTip="Adds the standard four-curve voice attenuation used in BioD_KroGar_300Tower_LOC_INT."/>
                        <Grid Margin="20,4,0,0" IsEnabled="{Binding ElementName=AttenuationCheckBox, Path=IsChecked}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Distance scale:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Grid.Column="1" x:Name="AttenuationScaleSlider" Minimum="10" Maximum="500" Value="100"
                                    TickFrequency="25" SmallChange="5" LargeChange="25" Margin="0,0,8,0"
                                    AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"
                                    ValueChanged="AttenuationScaleSlider_ValueChanged"
                                    ToolTip="Scales every distance point in the preset together. 100% preserves the shipped curve, whose maximum distance is 70."/>
                            <TextBlock Grid.Column="2" x:Name="AttenuationScaleValueTextBlock" Text="100% (70 max)"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    <Label Grid.Row="5" Grid.Column="0" Content="Loop Audio:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="5" Grid.Column="1" x:Name="Le3LoopAudioCheckBox" IsChecked="False"
                              VerticalAlignment="Center" Margin="5,4"
                              Content="Loop every imported audio file infinitely"
                              ToolTip="Enables infinite looping on every imported LE3 Sound."/>
                    <Label Grid.Row="6" Grid.Column="0" Content="Shared Stop Event:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="6" Grid.Column="1" x:Name="Le3CreateSharedStopEventCheckBox"
                              IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                              Content="Create one Stop event for all imported audio"
                              ToolTip="Creates one WwiseEvent named Stop with a stop action for every imported Sound object."/>
                </Grid>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="2" Header="Bank Settings" Padding="8" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Bank Name:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="BankNameTextBox" Text="NewBank" Padding="4" Margin="5,2"/>
                <Label Grid.Row="1" Grid.Column="0" Content="Volume (dB):" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="VolumeTextBox" Text="-10" Padding="4" Margin="5,2"
                         ToolTip="Volume offset in dB applied to the ActorMixer. Typical dialogue value is -10."/>
                <Label Grid.Row="2" Grid.Column="0" Content="Output Bus:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="OutputBusComboBox" IsEditable="False" Margin="5,2" Padding="4"
                          ItemsSource="{Binding OutputBuses}" SelectedItem="{Binding SelectedOutputBus}"
                          SelectionChanged="OutputBusComboBox_SelectionChanged"
                          ToolTip="The game-specific Wwise output bus for the ActorMixer. The selected bus is injected into the temporary project automatically."/>
                <Label Grid.Row="3" Grid.Column="0" Content="Dialogue Bank:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="IsDialogueBankCheckBox" IsChecked="True" VerticalAlignment="Center" Margin="5,4"
                          Content="Audio filenames contain TLK refs (e.g. VO_123456_m)" ToolTip="When checked, Wwise object names are retained for dialogue and FaceFX matching."/>
                <Label Grid.Row="4" Grid.Column="0" Content="Gendered Events:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="4" Grid.Column="1" x:Name="GenerateGenderedEventsCheckBox" IsChecked="True" VerticalAlignment="Center" Margin="5,4"
                          Content="Create both _m and _f event variants"/>
                <Label Grid.Row="5" Grid.Column="0" x:Name="CreateFaceFXAssetsLabel" Content="FaceFX Assets:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="5" Grid.Column="1" x:Name="CreateFaceFXAssetsCheckBox" IsChecked="False" VerticalAlignment="Center" Margin="5,4"
                           Content="Create male and female FaceFX assets and generate lines" ToolTip="When checked, imported audio is placed under the top folder's audio package, and matching male/female FaceFXAnimSet assets are created under the top folder."/>
                <Label Grid.Row="6" Grid.Column="0" x:Name="TopFolderLabel" Content="Top Folder:"
                       VerticalAlignment="Center"
                       IsEnabled="{Binding IsChecked, ElementName=CreateFaceFXAssetsCheckBox}"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="TopFolderTextBox" Text="NewAudioImport" Padding="4" Margin="5,2" TextChanged="TopFolderTextBox_TextChanged"
                         IsEnabled="{Binding IsChecked, ElementName=CreateFaceFXAssetsCheckBox}"
                         ToolTip="Package folder to create at the top level. The audio folder will be created under this folder, and generated FaceFX assets will be created directly under this folder."/>
                <Label Grid.Row="7" Grid.Column="0" x:Name="FemaleFaceFXAssetNameLabel" Content="Female FaceFX:"
                       VerticalAlignment="Center"
                       IsEnabled="{Binding IsChecked, ElementName=CreateFaceFXAssetsCheckBox}"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="FemaleFaceFXAssetNameTextBox" Text="NewAudioImport_F" Padding="4" Margin="5,2" TextChanged="FaceFXAssetNameTextBox_TextChanged"
                         IsEnabled="{Binding IsChecked, ElementName=CreateFaceFXAssetsCheckBox}"
                         ToolTip="Name of the generated female FaceFXAnimSet asset under the top folder."/>
                <Label Grid.Row="8" Grid.Column="0" x:Name="MaleFaceFXAssetNameLabel" Content="Male FaceFX:"
                       VerticalAlignment="Center"
                       IsEnabled="{Binding IsChecked, ElementName=CreateFaceFXAssetsCheckBox}"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="MaleFaceFXAssetNameTextBox" Text="NewAudioImport_M" Padding="4" Margin="5,2" TextChanged="FaceFXAssetNameTextBox_TextChanged"
                         IsEnabled="{Binding IsChecked, ElementName=CreateFaceFXAssetsCheckBox}"
                         ToolTip="Name of the generated male FaceFXAnimSet asset under the top folder."/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Audio Files (individual effects and settings)"
                  Padding="4" Margin="0,0,0,5">
            <ListBox x:Name="WavFilesListBox" ItemsSource="{Binding WavFileItems}"
                     SelectionMode="Extended">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip="{Binding FilePath}" Margin="2,0,10,0"/>
                            <CheckBox Grid.Column="1" Content="Create stop event" IsChecked="{Binding CreateStopEvent}"
                                      VerticalAlignment="Center" Margin="5,2"
                                      ToolTip="Creates one stop event for this audio input. If gendered events are enabled, it stops every generated event variant for that input."/>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="2,2,0,2">
                                <TextBlock Text="Effect:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox Width="180" ItemsSource="{Binding DataContext.IndividualEffectOptions,
                                                   RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          DisplayMemberPath="Name" SelectedValuePath="Preset"
                                          SelectedValue="{Binding EffectPreset}" Margin="0,0,10,0" Padding="3"
                                          ToolTip="Select an effect for only this audio file, or inherit the bank-wide effect selected above."/>
                                <CheckBox Content="Loop" IsChecked="{Binding LoopAudio}" VerticalAlignment="Center"
                                          Margin="0,0,10,0" ToolTip="Loops only this audio file when bank-wide looping is disabled."/>
                                <CheckBox Content="Duck" IsChecked="{Binding DuckAudio}" VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          IsEnabled="{Binding DataContext.IsIndividualMusicDuckingAvailable,
                                              RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          ToolTip="Applies the shipped music ducking behavior only to this audio file. Available for music output buses."/>
                                <CheckBox x:Name="IndividualAttenuationCheckBox" Content="Attenuation"
                                          IsChecked="{Binding ApplyAttenuation}"
                                          VerticalAlignment="Center"
                                          ToolTip="Applies the game-specific attenuation preset only to this audio file. Its distance overrides the bank-wide distance when both are enabled."/>
                            </StackPanel>
                            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="235,0,0,4"
                                  IsEnabled="{Binding ElementName=IndividualAttenuationCheckBox, Path=IsChecked}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="105"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Distance scale:" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Slider Grid.Column="1" Minimum="10" Maximum="500"
                                        Value="{Binding AttenuationScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="25"
                                        SmallChange="5" LargeChange="25" Margin="0,0,8,0"
                                        AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"
                                        ToolTip="Scales this audio file's attenuation distances. 100% preserves the shipped curve."/>
                                <TextBlock Grid.Column="2" Text="{Binding AttenuationScaleDisplay}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="0,5,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="AddFilesButton" Content="Add Audio Files..." Width="130" Height="28" Click="AddFilesButton_Click" Margin="0,0,5,0"/>
                <Button x:Name="RemoveSelectedButton" Content="Remove Selected" Width="120" Height="28" Click="RemoveSelectedButton_Click" Margin="0,0,5,0"/>
                <Button x:Name="ClearAllButton" Content="Clear All" Width="90" Height="28" Click="ClearAllButton_Click"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="5" x:Name="StatusTextBlock" Text="" TextWrapping="Wrap" Margin="0,0,0,5" Opacity="0.8"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ImportButton" Content="Import Audio" Width="110" Height="30" Click="ImportButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
