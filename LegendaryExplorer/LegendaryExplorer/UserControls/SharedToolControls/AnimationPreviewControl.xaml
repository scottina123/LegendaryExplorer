<misc:NotifyPropertyChangedControlBase x:Class="LegendaryExplorer.UserControls.SharedToolControls.AnimationPreviewControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:scene3D="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls.LegacyScene3D"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        mc:Ignorable="d"
        d:DesignHeight="400" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Row 0: 3D viewport -->
        <scene3D:LegacySceneRenderControl x:Name="SceneViewer" Grid.Row="0" />
        <!-- Row 1: Playback controls -->
        <WrapPanel Grid.Row="1" Margin="2">
            <Button Command="{Binding PlayPauseCommand}" Padding="6,4" Margin="0,0,5,0"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
                <fa:ImageAwesome Icon="{Binding PlayPauseIcon}" Height="16" Width="16"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Slider Width="200"
                    Minimum="{Binding AnimSliderMin}"
                    Maximum="{Binding AnimSliderMax}"
                    Value="{Binding AnimSliderValue}"
                    VerticalAlignment="Center" Margin="0,0,5,0">
                <Slider.Style>
                    <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                        <Setter Property="IsSnapToTickEnabled" Value="True" />
                        <Setter Property="TickFrequency" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTimeMode}" Value="True">
                                <Setter Property="IsSnapToTickEnabled" Value="False" />
                                <Setter Property="TickFrequency" Value="0.01" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Slider.Style>
            </Slider>
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                       Text="{Binding AnimPositionText}" />
            <Border Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Label>Remove Animation Offset</Label>
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding RemoveOffset}" />
                </StackPanel>
            </Border>
            <Border>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox Width="60" SelectedItem="{Binding PlaybackSpeed}" VerticalAlignment="Center">
                        <ComboBox.Items>
                            <system:Double>0.1</system:Double>
                            <system:Double>0.25</system:Double>
                            <system:Double>0.5</system:Double>
                            <system:Double>1</system:Double>
                            <system:Double>2</system:Double>
                        </ComboBox.Items>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,0"/>
            <xctk:DropDownButton Content="View options" Margin="0,3">
                <xctk:DropDownButton.DropDownContent>
                    <scene3D:SceneControlOptionsControl/>
                </xctk:DropDownButton.DropDownContent>
            </xctk:DropDownButton>
        </WrapPanel>
    </Grid>
</misc:NotifyPropertyChangedControlBase>
