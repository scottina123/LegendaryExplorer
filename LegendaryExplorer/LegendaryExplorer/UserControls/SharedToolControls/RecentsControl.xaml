<misc:NotifyPropertyChangedControlBase x:Class="LegendaryExplorer.UserControls.SharedToolControls.RecentsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls"
             xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
             xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
             mc:Ignorable="d"
             d:DesignWidth="560"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <converters:FilePathToFileNameConverter x:Key="FilePathToFileNameConverter"/>
        <converters:GameToImageIconConverter x:Key="GameToImageIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <ContextMenu x:Key="RecentItemContextMenu"
                     x:Shared="False"
                     Opened="RecentItemContextMenu_Opened"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Pin file" Click="TogglePinnedItem_Click" />
            <Separator />
            <MenuItem Header="Open file location" Click="OpenRecentItemLocation_Click" />
            <MenuItem Header="Copy file path" Click="CopyRecentItemPath_Click" />
            <MenuItem Header="Copy file name" Click="CopyRecentItemName_Click" />
        </ContextMenu>
        <DataTemplate x:Key="RecentItemTemplate">
            <Button Margin="3" Padding="3" MinHeight="26" ToolTip="{Binding Path}"
                    ContextMenuService.ShowOnDisabled="True" ToolTipService.ShowOnDisabled="True"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding RecentFileOpenCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RecentsControl}}}" CommandParameter="{Binding Path}"
                    ContextMenu="{StaticResource RecentItemContextMenu}">
                <Button.Content>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPinned, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Game, Converter={StaticResource GameToImageIconConverter}}" Height="16" VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAfc}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <local:StatusBarGameIDIndicator Grid.Column="1" GameType="AFC" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="{Binding IsAfc, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Path, Converter={StaticResource FilePathToFileNameConverter}}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </Button.Content>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="EmptyGroupMessageTemplate">
            <TextBlock Text="{Binding EmptyMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="RecentGroupTemplate">
            <Grid MinHeight="40">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource EmptyGroupMessageTemplate}"/>
                <ScrollViewer x:Name="ItemsScrollViewer" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                              PreviewMouseWheel="RecentsScrollViewer_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RecentItemTemplate}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:RecentItemsPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PinnedGroupTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="3,0,3,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding PinBrowseLabel, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RecentsControl}}}" Padding="8,3"
                            Command="{Binding BrowsePinnedItemsCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RecentsControl}}}"/>
                    <Grid Grid.Column="1" Margin="12,0,0,0"
                          Visibility="{Binding ShowPinnedSearch, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RecentsControl}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Search pinned files" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" MinWidth="80" Padding="4,2" VerticalContentAlignment="Center"
                                 ToolTip="Search pinned files" AutomationProperties.Name="Search pinned files"
                                 Text="{Binding PinnedSearchText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RecentsControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" MinHeight="40">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource EmptyGroupMessageTemplate}"/>
                    <ScrollViewer x:Name="PinnedItemsScrollViewer" MaxHeight="288" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                  PreviewMouseWheel="RecentsScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RecentItemTemplate}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    <Setter Property="Height" Value="32"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid>
            <TabControl x:Name="RecentTabs" ItemsSource="{Binding RecentGroups}" SelectedItem="{Binding SelectedRecentGroup, Mode=TwoWay}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="8">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Header}" Margin="8,2"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding}">
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="ContentTemplate" Value="{StaticResource RecentGroupTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource PinnedGroupTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </ScrollViewer>
</misc:NotifyPropertyChangedControlBase>
