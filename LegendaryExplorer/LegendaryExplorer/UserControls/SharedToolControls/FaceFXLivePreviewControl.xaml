<misc:NotifyPropertyChangedControlBase x:Class="LegendaryExplorer.UserControls.SharedToolControls.FaceFXLivePreviewControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:scene3D="clr-namespace:LegendaryExplorer.Tools.LevelEditor.Scene3D"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DesignHeight="400" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Row 0: Mesh selection -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2">
            <TextBlock Text="Mesh:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox x:Name="MeshComboBox" Width="300" 
                      DisplayMemberPath="ObjectName.Instanced"
                      SelectionChanged="MeshComboBox_SelectionChanged"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Content="Browse..." Click="BrowseMesh_Click" 
                    VerticalAlignment="Center" Margin="0,0,10,0" Padding="5,2" />
        </StackPanel>
        <!-- Row 1: 3D viewport -->
        <scene3D:SceneRenderControl x:Name="SceneViewer" Grid.Row="1" />
        <!-- Row 2: Playback info -->
        <WrapPanel Grid.Row="2" Margin="2">
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}FaceFX Time: {0:F2}s">
                        <Binding Path="CurrentFaceFXTime" RelativeSource="{RelativeSource AncestorType=misc:NotifyPropertyChangedControlBase}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Border Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox Width="60" SelectedItem="{Binding PlaybackSpeed, RelativeSource={RelativeSource AncestorType=misc:NotifyPropertyChangedControlBase}}"
                              VerticalAlignment="Center">
                        <ComboBox.Items>
                            <system:Double>0.1</system:Double>
                            <system:Double>0.25</system:Double>
                            <system:Double>0.5</system:Double>
                            <system:Double>1</system:Double>
                            <system:Double>2</system:Double>
                        </ComboBox.Items>
                    </ComboBox>
                </StackPanel>
            </Border>
            <TextBlock Text="Status: " VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="No mesh loaded" VerticalAlignment="Center" Foreground="Gray" />
        </WrapPanel>
    </Grid>
</misc:NotifyPropertyChangedControlBase>
