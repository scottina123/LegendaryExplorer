<exportLoaderControls:ExportLoaderControl x:Class="LegendaryExplorer.UserControls.ExportLoaderControls.GesturePreviewExportLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
             xmlns:sharedToolControls="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Body:"/>
            <DockPanel Grid.Column="1" Margin="5,0,12,0"><Button DockPanel.Dock="Right" Content="Select..." Tag="Body" Click="PreviewMeshSelect_Click"/><TextBox x:Name="PreviewMeshTextBox" IsReadOnly="True" Margin="0,0,3,0"/></DockPanel>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Head:"/>
            <DockPanel Grid.Column="3" Margin="5,0,12,0"><Button DockPanel.Dock="Right" Content="Select..." Tag="Head" Click="PreviewMeshSelect_Click"/><TextBox x:Name="PreviewHeadMeshTextBox" IsReadOnly="True" Margin="0,0,3,0"/></DockPanel>
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Hair:"/>
            <DockPanel Grid.Column="5" Margin="5,0,12,0"><Button DockPanel.Dock="Right" Content="Select..." Tag="Hair" Click="PreviewMeshSelect_Click"/><TextBox x:Name="PreviewHairMeshTextBox" IsReadOnly="True" Margin="0,0,3,0"/></DockPanel>
            <Button Grid.Column="6" Padding="8,2" Margin="0,0,5,0"
                    Click="ResetPreviewModels_Click" Content="Reset Models"/>
            <Button Grid.Column="7"
                    Padding="8,2"
                    Click="PlayAll_Click"
                    Content="Play All"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,6">
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       Opacity="0.7"/>
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding TrackPropertiesText}"
                       TextWrapping="Wrap"
                       Opacity="0.7"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="AnimationListBox"
                     SelectedItem="{Binding SelectedAnimation}"
                     MouseDoubleClick="AnimationListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock FontWeight="DemiBold" Text="{Binding DisplayName}"/>
                            <TextBlock FontSize="10" Opacity="0.6" Text="{Binding TimelineText}"/>
                            <TextBlock FontSize="11" Opacity="0.7" Text="{Binding ReferenceText}" TextWrapping="Wrap"/>
                            <TextBlock FontSize="10" Opacity="0.65" Text="{Binding TimingText}" TextWrapping="Wrap"/>
                            <TextBlock FontSize="10" Opacity="0.65" Text="{Binding FlagsText}" TextWrapping="Wrap"/>
                            <TextBlock FontSize="10" Opacity="0.65" Text="{Binding FiltersText}" TextWrapping="Wrap"/>
                            <TextBlock FontSize="10" Opacity="0.6" Text="{Binding ResolutionText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            <sharedToolControls:AnimationPreviewControl x:Name="AnimPreviewControl" Grid.Column="2"/>
        </Grid>
    </Grid>
</exportLoaderControls:ExportLoaderControl>
