<exportLoaderControls:ExportLoaderControl x:Class="LegendaryExplorer.UserControls.ExportLoaderControls.ParticleSystemExportLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
             xmlns:vfxPreview="clr-namespace:LegendaryExplorer.Tools.AssetDatabase.VFXPreview"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CheckBox x:Name="VfxPreviewEnabledCheckBox"
                  Content="Enable preview"
                  IsChecked="False"
                  Margin="6,4"
                  Checked="VfxPreviewEnabled_Changed"
                  Unchecked="VfxPreviewEnabled_Changed"/>
        <vfxPreview:VfxPreviewControl x:Name="VfxPreview" Grid.Row="1"/>
    </Grid>
</exportLoaderControls:ExportLoaderControl>
