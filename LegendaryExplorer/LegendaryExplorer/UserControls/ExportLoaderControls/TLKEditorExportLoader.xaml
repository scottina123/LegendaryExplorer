<exportLoaderControls:FileExportLoaderControl
             x:Class="LegendaryExplorer.UserControls.ExportLoaderControls.TLKEditorExportLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
             xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
             mc:Ignorable="d" 
             d:DataContext="{Binding RelativeSource={RelativeSource Self}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <exportLoaderControls:FileExportLoaderControl.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding ShowFindReplaceCommand}" />
    </exportLoaderControls:FileExportLoaderControl.InputBindings>
    <exportLoaderControls:FileExportLoaderControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConveter"/>
        <Style x:Key="TlkStringIdEditorStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TlkIdTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TlkToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TlkToolbarIconStyle" TargetType="{x:Type Path}">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TlkEditorTabCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TlkEditorTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Background" Value="{StaticResource MenuPopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MenuPopupBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="0,0,2,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkAwareContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{StaticResource MenuPopupBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MenuPopupBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="2"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="InlineTextEditorContextMenu"
                     x:Shared="False"
                     Style="{StaticResource DarkAwareContextMenuStyle}">
            <MenuItem Command="ApplicationCommands.Cut"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Command="ApplicationCommands.Copy"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Command="ApplicationCommands.Paste"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Command="ApplicationCommands.SelectAll"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
        <ContextMenu x:Key="InlineTlkLineContextMenu"
                     x:Shared="False"
                     Style="{StaticResource DarkAwareContextMenuStyle}">
            <MenuItem Header="Change ID..." Click="ChangeIdMenuItem_Click"/>
            <MenuItem Header="Delete String" Click="DeleteStringMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Copy Line"
                      Click="CopyLineMenuItem_Click"/>
            <MenuItem Header="Paste Line"
                      Click="PasteLineMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Clone Line..."
                      Click="CloneLineMenuItem_Click"/>
            <Separator/>
            <MenuItem Command="ApplicationCommands.Cut"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Command="ApplicationCommands.Copy"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Command="ApplicationCommands.Paste"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Command="ApplicationCommands.SelectAll"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
        <ContextMenu x:Key="TlkRowContextMenu" x:Shared="False"
                     Style="{StaticResource DarkAwareContextMenuStyle}">
            <MenuItem Header="Change ID..." Click="ChangeIdMenuItem_Click"/>
            <MenuItem Header="Delete String" Click="DeleteStringMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Copy Line" Click="CopyLineMenuItem_Click"/>
            <MenuItem Header="Paste Line" Click="PasteLineMenuItem_Click"/>
            <MenuItem Header="Clone Line..." Click="CloneLineMenuItem_Click"/>
        </ContextMenu>
    </exportLoaderControls:FileExportLoaderControl.Resources>
    <DockPanel MinWidth="10" MinHeight="10">
        <TabControl DockPanel.Dock="Top"
                    ItemsSource="{Binding OpenTabs}"
                    SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                    AllowDrop="True"
                    Background="{StaticResource MenuPopupBackgroundBrush}"
                    BorderBrush="{StaticResource MenuPopupBorderBrush}"
                    BorderThickness="0,0,0,1"
                    PreviewMouseLeftButtonDown="TabControl_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="TabControl_PreviewMouseLeftButtonUp"
                    PreviewMouseMove="TabControl_PreviewMouseMove"
                    DragOver="TabControl_DragOver"
                    Drop="TabControl_Drop"
                    Visibility="{Binding HasOpenTabs, Converter={StaticResource BoolToVisibilityConverter}}">
            <TabControl.Template>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <DockPanel>
                            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
                                <StackPanel Orientation="Horizontal" IsItemsHost="True"
                                            KeyboardNavigation.TabNavigation="Once"/>
                            </ScrollViewer>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource TlkEditorTabItemStyle}">
                    <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding HeaderText}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"/>
                        <Button Content="×"
                                Width="16"
                                Height="16"
                                Padding="0"
                                Focusable="False"
                                Style="{StaticResource TlkEditorTabCloseButtonStyle}"
                                Click="CloseTabButton_Click"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid Height="0"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Padding="14,10">
            <WrapPanel VerticalAlignment="Center">
                <Button Name="btnCommit" Command="{Binding CommitCommand}" Content="Commit"
                        ToolTip="Commit changes to this TLK file back to the export"
                        Visibility="{Binding CurrentLoadedExport, Converter={StaticResource NullVisibilityConveter}}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TlkToolbarButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="Red"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Name="btnOpenTab" Command="{Binding OpenTabCommand}" Content="Open" ToolTip="Open TLK file">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TlkToolbarButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOpenTabs}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentLoadedExport, Converter={StaticResource NullVisibilityConveter}}" Value="Visible">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border Width="440" Height="36" Margin="0,0,18,0" CornerRadius="3"
                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Width="18" Height="18" Margin="10,0" Stretch="Uniform"
                              VerticalAlignment="Center" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" IsHitTestVisible="False"
                              Data="M 12,7 A 5,5 0 1 1 2,7 A 5,5 0 1 1 12,7 M 11,11 L 16,16"/>
                        <TextBox Name="boxSearch" FontSize="14" BorderThickness="0" Background="Transparent" Padding="2,0,8,0"
                                 VerticalContentAlignment="Center" KeyUp="Evt_KeyUp"
                                 ToolTip="Enter a TLK ID or string text; Enter repeats the last search type"
                                 ContextMenu="{StaticResource InlineTextEditorContextMenu}"/>
                    </DockPanel>
                </Border>
                <Button Name="btnSearchId" Command="{Binding SearchIdCommand}" ToolTip="Find an exact TLK ID" Style="{StaticResource TlkToolbarButtonStyle}">
                    <TextBlock Text="Search ID" FontSize="14" VerticalAlignment="Center"/>
                </Button>
                <Button Name="btnSearchText" Command="{Binding SearchTextCommand}" ToolTip="Find string text; click again for the next match" Style="{StaticResource TlkToolbarButtonStyle}">
                    <TextBlock Text="Search Text" FontSize="14" VerticalAlignment="Center"/>
                </Button>
                <Button Name="btnAddNew" Command="{Binding AddStringCommand}" ToolTip="Add a new string" Style="{StaticResource TlkToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TlkToolbarIconStyle}" Data="M 9,1 L 9,17 M 1,9 L 17,9"/>
                        <TextBlock Text="Add String" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="28" Margin="14,4" Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
                <Button Name="btnImportXML" Command="{Binding ImportXmlCommand}" ToolTip="Import from XML" Style="{StaticResource TlkToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TlkToolbarIconStyle}" Data="M 9,1 L 9,12 M 5,8 L 9,12 L 13,8 M 2,12 L 2,17 L 16,17 L 16,12"/>
                        <TextBlock Text="Import" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Name="btnExportXML" Command="{Binding ExportXmlCommand}" ToolTip="Export to XML" Style="{StaticResource TlkToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TlkToolbarIconStyle}" Data="M 9,12 L 9,1 M 5,5 L 9,1 L 13,5 M 2,12 L 2,17 L 16,17 L 16,12"/>
                        <TextBlock Text="Export" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Top" Margin="4,0,4,4" Padding="8"
                BorderBrush="Gray" BorderThickness="1"
                Visibility="{Binding IsFindReplaceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="FindTextBox" Grid.Column="1" Margin="0,0,8,0"
                             Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="180"
                             VerticalAlignment="Center"
                             PreviewKeyDown="FindReplaceTextBox_PreviewKeyDown"
                             ContextMenu="{StaticResource InlineTextEditorContextMenu}" />
                    <Button Grid.Column="2" Margin="0,0,8,0" Padding="10,2"
                            Content="Previous" Command="{Binding FindPreviousCommand}" />
                    <Button Grid.Column="3" Margin="0,0,8,0" Padding="10,2"
                            Content="Find Next" Command="{Binding FindNextCommand}" />
                    <Button Grid.Column="4" Padding="10,2"
                            Content="Close" Command="{Binding CloseFindReplaceCommand}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Replace:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="ReplaceTextBox" Grid.Column="1" Margin="0,0,8,0"
                             Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="180"
                             VerticalAlignment="Center"
                             PreviewKeyDown="FindReplaceTextBox_PreviewKeyDown"
                             ContextMenu="{StaticResource InlineTextEditorContextMenu}" />
                    <Button Grid.Column="2" Margin="0,0,8,0" Padding="10,2"
                            Content="Replace" Command="{Binding ReplaceCommand}" />
                    <Button Grid.Column="3" Padding="10,2"
                            Content="Replace All" Command="{Binding ReplaceAllCommand}" />
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                    <CheckBox Content="Match case" Margin="0,0,16,0"
                              IsChecked="{Binding FindMatchCase}" />
                    <CheckBox Content="Match whole word" Margin="0,0,16,0"
                              IsChecked="{Binding FindWholeWord}" />
                    <CheckBox Content="Regular expression" Margin="0,0,16,0"
                              IsChecked="{Binding FindUseRegex}" />
                    <CheckBox Content="Wrap around"
                              IsChecked="{Binding FindWrapAround}" />
                </WrapPanel>
                <TextBlock Margin="0,8,0,0" Text="{Binding SearchStatusText}" />
            </StackPanel>
        </Border>
        <Popup Name="popupDlg" Placement="Center" VerticalOffset="15" Width="640" Height="800" Margin="0,12,0,0" Closed="Evt_CloseXML" StaysOpen="false">
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="2" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" >
                <TextBox Name="popoutXmlBox" Text="No xml loaded" Margin="15,0,15,0" VerticalAlignment = "Center" FontFamily="{DynamicResource AudemusDataFont}" FontSize="14" Focusable = "True" ScrollViewer.CanContentScroll = "True" ScrollViewer.VerticalScrollBarVisibility = "Visible" IsReadOnly = "True" TextWrapping = "Wrap" LostFocus="CloseViewAsXml"/>
            </Border>
        </Popup>
        <Grid x:Name="EditorContentGrid">
            <DataGrid Name="DisplayedString_ListBox"
                      Visibility="{Binding ShouldShowRecentsController, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type exportLoaderControls:ExportLoaderHostedWindow}}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not, FallbackValue=Visible}"
                      ItemsSource="{Binding CleanedStrings}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                      BorderThickness="0"
                      FontSize="14"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="DisplayedString_ListBox_SelectionChanged"
                      PreviewMouseRightButtonDown="DisplayedString_ListBox_PreviewMouseRightButtonDown"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TlkIdTextBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        <Setter Property="MinHeight" Value="24"/>
                        <Setter Property="ContextMenu" Value="{StaticResource TlkRowContextMenu}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TlkSelectedRowBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ID" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                    <TextBox Text="{Binding StringID, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Style="{StaticResource TlkStringIdEditorStyle}"
                                             FontSize="14"
                                             Padding="8,2"
                                             Tag="IdColumnEditor"
                                             IsInactiveSelectionHighlightEnabled="True"
                                             HorizontalContentAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             ContextMenu="{StaticResource InlineTlkLineContextMenu}"
                                             PreviewTextInput="StringIdTextBox_PreviewTextInput"
                                             PreviewKeyDown="StringIdTextBox_PreviewKeyDown"
                                             LostKeyboardFocus="StringIdTextBox_LostKeyboardFocus"
                                             GotKeyboardFocus="StringIdTextBox_GotKeyboardFocus"
                                             DataObject.Pasting="StringIdTextBox_OnPasting" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Text" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Data, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                         FontSize="14"
                                         Padding="8,2"
                                         VerticalContentAlignment="Center"
                                         Tag="TextColumnEditor"
                                         IsInactiveSelectionHighlightEnabled="True"
                                         ContextMenu="{StaticResource InlineTlkLineContextMenu}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Disabled"
                                         TextChanged="StringDataTextBox_TextChanged"
                                         GotKeyboardFocus="InlineEditor_GotKeyboardFocus" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</exportLoaderControls:FileExportLoaderControl>
