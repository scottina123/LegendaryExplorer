<exportLoaderControls:ExportLoaderControl x:Class="LegendaryExplorer.UserControls.ExportLoaderControls.MeshRenderer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
             xmlns:scene3D="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls.LegacyScene3D"
             xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
             xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
             xmlns:legendaryExplorer="clr-namespace:LegendaryExplorer"
             mc:Ignorable="d" 
             Loaded="MeshRenderer_Loaded"
             Unloaded="MeshRenderer_Unloaded"
             d:DesignHeight="450" d:DesignWidth="800"
             KeyDown="MeshRendererWPF_OnKeyDown"
             KeyUp="MeshRendererWPF_OnKeyUp"
             d:DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Control.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <DataTemplate x:Key="MorphFeatureEditorItemTemplate">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Padding="2,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>
                        <TextBlock Text="Target found — slider deforms the stored face" Foreground="DarkSeaGreen" FontSize="11"
                                   Visibility="{Binding HasMorphTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="No target found — value is metadata only" Foreground="DarkOrange" FontSize="11"
                                   Visibility="{Binding HasMorphTarget, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}"/>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                            <xctk:SingleUpDown Grid.Column="1" Margin="5,0,0,0" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Increment="0.01" AllowInputSpecialValues="None"/>
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" ToolTip="Remove feature" Margin="5,0,0,0" Padding="5,1"
                            VerticalAlignment="Top" Click="RemoveMorphFeature_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="MaterialParameterScrubberStyle" TargetType="Thumb">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ToolTip" Value="Drag horizontally to adjust; Shift is faster and Ctrl is finer"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                    BorderThickness="1"/>
                            <Ellipse Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                     Stroke="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                     StrokeThickness="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Control.Resources>
    <xctk:BusyIndicator IsBusy="{Binding IsBusy}" BusyContent="{Binding BusyText}">
        <xctk:BusyIndicator.ProgressBarStyle>
            <Style TargetType="ProgressBar">
                <Setter Property="Maximum" Value="{Binding BusyProgressBarMax}"/>
                <Setter Property="Value" Value="{Binding BusyProgressBarValue}"/>
                <Setter Property="IsIndeterminate" Value="{Binding BusyProgressIndeterminate}"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Margin" Value="5,0,5,5"/>
            </Style>
        </xctk:BusyIndicator.ProgressBarStyle>
        <DockPanel>
            <StatusBar DockPanel.Dock="Bottom">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Name="Solid_Checkbox" IsChecked="{Binding RenderSolid}"  Content="Solid"  VerticalAlignment="Center"  Margin="2,0"
                                  Visibility="{Binding IsMorphEditorMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}"/>
                        <CheckBox Name="Wireframe_Checkbox" IsChecked="{Binding RenderWireframe}" Content="Wireframe"  VerticalAlignment="Center" Margin="2,0"/>
                        <CheckBox Name="CollisionMesh_Checkbox" IsChecked="{Binding ShowCollisionMesh}" Content="Collision Mesh"
                                  Visibility="{Binding IsStaticMesh, Converter={StaticResource BoolToVisibilityConverter}}"  VerticalAlignment="Center" Margin="2,0"/>
                        <CheckBox Name="Skeleton_Checkbox" IsChecked="{Binding ShowSkeleton}" Content="Skeleton"
                                  Visibility="{Binding IsSkeletalMesh, Converter={StaticResource BoolToVisibilityConverter}}"  VerticalAlignment="Center" Margin="2,0"/>
                        <CheckBox IsChecked="{Binding HideMorphHair}" Content="Hide hair"
                                  Visibility="{Binding IsMorphEditorMode, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="Hide the m_oHairMesh preview"/>
                        <CheckBox Name="Shader_Checkbox" IsChecked="{Binding RenderGameShader}" Content="In-Game Shader (Experimental)"
                                  VerticalAlignment="Center" Margin="2,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <ComboBox Name="LODPicker_ComboBox" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="11" Width="55" ItemsSource="{Binding LODPicker}" 
              SelectedIndex="{Binding CurrentLOD, Mode=TwoWay}" ToolTip="Change the visible LOD" Margin="2,0" FontStretch="UltraCondensed"/>
                        <CheckBox Name="FirstPerson_Checkbox" IsChecked="{Binding FirstPerson}"  Content="FirstPerson"  VerticalAlignment="Center" Margin="2,0"/>
                        <CheckBox Name="Rotating_Checkbox" IsChecked="{Binding Rotating}"  Content="Rotating"  VerticalAlignment="Center" Margin="2,0"/>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,0"/>

                        <xctk:DropDownButton Content="View options" Margin="0,3">
                            <xctk:DropDownButton.DropDownContent>
                                <scene3D:SceneControlOptionsControl/>
                            </xctk:DropDownButton.DropDownContent>
                        </xctk:DropDownButton>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,0"/>
                        <Button Command="{Binding UModelExportCommand}"  ToolTip="Export with umodel" Margin="2,0"
                                Visibility="{Binding IsMorphEditorMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}"
                                sharedUi:Bindings.VisibilityToEnabled="true">
                            <Image Source="/Resources/Images/umodel.ico" Width="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Button Command="{Binding GltfExportCommand}"  ToolTip="Export to glTF (Experimental)" Margin="2,0"
                                Visibility="{Binding IsMorphEditorMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}"
                                sharedUi:Bindings.VisibilityToEnabled="true">
                            glTF
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StatusBar>
            <DockPanel>
                <Border DockPanel.Dock="Right" Width="430" Padding="7" BorderThickness="1,0,0,0"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        Visibility="{Binding ShowMorphEditorPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Morph Editor" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{Binding MorphBaseHeadPath}" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,3"/>
                            <TextBlock Text="{Binding MorphHairMeshPath}" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding MorphTargetStatus}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding MorphEditorStatus}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="Unsaved live changes" Foreground="OrangeRed" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Visibility="{Binding HasUnsavedMorphChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,7,0,0">
                            <TextBlock Text="{Binding MorphSaveHelpText}"
                                       TextWrapping="Wrap" Opacity="0.72" Margin="0,0,0,5"/>
                            <UniformGrid Rows="1" Columns="2">
                                <Button Content="{Binding MorphOverrideLabel}" Padding="6,4" Margin="0,0,3,0"
                                        IsEnabled="{Binding CanOverrideMorph}" Click="OverrideMorph_Click"/>
                                <Button Content="{Binding MorphSaveAsNewLabel}" Padding="6,4" Margin="3,0,0,0"
                                        IsEnabled="{Binding HasMorphEditorData}" Click="SaveMorphAsNew_Click"/>
                            </UniformGrid>
                        </StackPanel>

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,5"
                              ToolTip="0% keeps the current values, 100% uses the generated BioWare variation, and values above 100% extrapolate beyond it.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="76"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Randomization strength" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="2"
                                    Value="{Binding MorphRandomizationStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TickFrequency="0.25" SmallChange="0.05" LargeChange="0.25"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center"/>
                            <xctk:SingleUpDown Grid.Column="2" Margin="7,0,0,0"
                                               Value="{Binding MorphRandomizationStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Minimum="0" Maximum="2" Increment="0.05" FormatString="P0"/>
                        </Grid>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <Button DockPanel.Dock="Right" Content="Randomize morph" Padding="7,3" Margin="6,0,0,0"
                                    IsEnabled="{Binding HasMorphEditorData}" Click="RandomizeMorphFeatures_Click"
                                    ToolTip="Randomize scalar and color overrides from same-species BioWare faces in this game's Asset Database, and blend geometry when compatible morph targets exist. Strength is measured from the current values; texture references are not changed."/>
                            <xctk:WatermarkTextBox Padding="6,4"
                                                   Watermark="Search features, skeleton, and material overrides"
                                                   Text="{Binding MorphEditorSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <Border DockPanel.Dock="Top" Padding="6" Margin="0,0,0,5" BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Select in viewport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding MorphViewportPickModes}"
                                              SelectedItem="{Binding MorphViewportPickMode, Mode=TwoWay}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MorphViewportPickHelp}" TextWrapping="Wrap" Opacity="0.75" Margin="0,3,0,3"/>
                                <DockPanel Visibility="{Binding HasMorphViewportSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button DockPanel.Dock="Right" Content="Clear" Click="ClearMorphViewportSelection_Click" Padding="5,1" Margin="5,0,0,0"/>
                                    <TextBlock Text="{Binding MorphViewportSelectionLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding MorphViewportSelectionLabel}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ComboBox Margin="0,4,0,0" ItemsSource="{Binding MorphViewportMatches}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedMorphViewportMatch, Mode=TwoWay}"
                                          Visibility="{Binding HasMorphViewportMatches, Converter={StaticResource BoolToVisibilityConverter}}"
                                          ToolTip="Matching controls, strongest influence first. Choose a different match to edit it."/>
                                <TextBlock Text="{Binding MorphViewportSelectionDetail}" TextWrapping="Wrap" MaxHeight="48" Margin="0,3,0,0"
                                           ToolTip="{Binding MorphViewportSelectionDetail}"/>
                                <CheckBox Content="Show selected controls only" IsChecked="{Binding FilterMorphViewportSelection}" Margin="0,4,0,0"
                                          Visibility="{Binding HasMorphViewportMatches, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="{Binding AddMorphViewportSelectionText}" Padding="5,3" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Click="AddMorphViewportSelection_Click"
                                        Visibility="{Binding CanAddMorphViewportSelection, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <TabControl x:Name="MorphEditorTabs" SelectionChanged="MorphEditorTabs_SelectionChanged">
                            <TabItem Header="Features" x:Name="MorphFeaturesTab">
                                <DockPanel Margin="4">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="Add feature…" HorizontalAlignment="Left" Padding="7,3"
                                                Click="AddMorphFeature_Click"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding MatchedMorphFeatureItems}"
                                                          ItemTemplate="{StaticResource MorphFeatureEditorItemTemplate}"/>
                                            <Expander Margin="0,5,0,0" IsExpanded="False"
                                                      Header="{Binding UnmatchedMorphFeatureCount, StringFormat=No target found ({0})}"
                                                      Visibility="{Binding HasUnmatchedMorphFeatures, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl ItemsSource="{Binding UnmatchedMorphFeatureItems}"
                                                              ItemTemplate="{StaticResource MorphFeatureEditorItemTemplate}"/>
                                            </Expander>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Skeleton" x:Name="MorphSkeletonTab">
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Top" Content="Add bone…" HorizontalAlignment="Left" Padding="7,3" Margin="0,0,0,4"
                                            Click="AddMorphBone_Click"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredMorphSkeletonItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander Margin="0,1">
                                                        <Expander.Style>
                                                            <Style TargetType="Expander">
                                                                <Setter Property="IsExpanded" Value="False"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsViewportSelected}" Value="True">
                                                                        <Setter Property="IsExpanded" Value="True"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Expander.Style>
                                                        <Expander.Header>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="×" ToolTip="Remove bone" Padding="5,1" Margin="7,0,0,0"
                                                                        Click="RemoveMorphBone_Click"/>
                                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="230" FontWeight="SemiBold"/>
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,3,3,6">
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="X" VerticalAlignment="Center"/>
                                                                <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True"/>
                                                                <xctk:SingleUpDown Grid.Column="2" Margin="5,0,0,0" Value="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.01"/>
                                                            </Grid>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Y" VerticalAlignment="Center"/>
                                                                <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True"/>
                                                                <xctk:SingleUpDown Grid.Column="2" Margin="5,0,0,0" Value="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.01"/>
                                                            </Grid>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Z" VerticalAlignment="Center"/>
                                                                <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True"/>
                                                                <xctk:SingleUpDown Grid.Column="2" Margin="5,0,0,0" Value="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.01"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Materials" x:Name="MorphMaterialsTab">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                                    <StackPanel>
                                        <GroupBox Header="Scalar parameters" Margin="0,0,0,6">
                                            <DockPanel Margin="4">
                                                <Button DockPanel.Dock="Top" Content="Add scalar…" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,3" Click="AddMorphScalar_Click"/>
                                                <ItemsControl ItemsSource="{Binding FilteredMorphScalarOverrides}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>
                                                                    <Grid Margin="0,2,0,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                                                                        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True"/>
                                                                        <xctk:SingleUpDown Grid.Column="1" Margin="5,0,0,0" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.01"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="×" Margin="5,0,0,0" VerticalAlignment="Top" Click="RemoveMorphScalar_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </GroupBox>

                                        <GroupBox Header="Color parameters" Margin="0,0,0,6">
                                            <DockPanel Margin="4">
                                                <Button DockPanel.Dock="Top" Content="Add color…" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,3" Click="AddMorphColor_Click"/>
                                                <ItemsControl ItemsSource="{Binding FilteredMorphColorOverrides}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>
                                                                    <xctk:ColorCanvas SelectedColor="{Binding PreviewColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UsingAlphaChannel="True" Margin="0,3,0,2"
                                                                                      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                                                    <UniformGrid Columns="4">
                                                                        <xctk:SingleUpDown Value="{Binding R, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.01" ToolTip="Red"/>
                                                                        <xctk:SingleUpDown Value="{Binding G, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.01" ToolTip="Green"/>
                                                                        <xctk:SingleUpDown Value="{Binding B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.01" ToolTip="Blue"/>
                                                                        <xctk:SingleUpDown Value="{Binding A, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.01" ToolTip="Alpha"/>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="×" Margin="5,0,0,0" VerticalAlignment="Top" Click="RemoveMorphColor_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </GroupBox>

                                        <GroupBox Header="Texture parameters">
                                            <DockPanel Margin="4">
                                                <Button DockPanel.Dock="Top" Content="Add texture…" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,3" Click="AddMorphTexture_Click"/>
                                                <ItemsControl ItemsSource="{Binding FilteredMorphTextureOverrides}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>
                                                                    <xctk:IntegerUpDown Value="{Binding EntryIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                                                                    <TextBlock Text="{Binding ResolvedPath}" TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="×" Margin="5,0,0,0" VerticalAlignment="Top" Click="RemoveMorphTexture_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Lip sync">
                                <DockPanel Margin="4">
                                    <StackPanel DockPanel.Dock="Top">
                                        <WrapPanel Margin="0,0,0,4">
                                            <Button Content="Load lines from PCC…" Padding="6,3" Margin="0,0,6,0"
                                                    IsEnabled="{Binding CanLoadMorphFaceFx}" Click="LoadMorphFaceFxPcc_Click"/>
                                            <Button Content="Load rigs…" Padding="6,3"
                                                    IsEnabled="{Binding CanLoadMorphFaceFx}" Click="LoadMorphFaceFxRig_Click"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding MorphFaceFxSource}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding MorphFaceFxSource}" Opacity="0.75"/>
                                        <TextBlock Text="FaceFX rig" Margin="0,4,0,2"/>
                                        <ComboBox ItemsSource="{Binding MorphFaceFxRigs}" DisplayMemberPath="Label"
                                                  SelectedItem="{Binding SelectedMorphFaceFxRig, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanLoadMorphFaceFx}"
                                                  ToolTip="Choose the rig matching the morph's species and gender."/>
                                        <xctk:WatermarkTextBox Margin="0,6,0,3" Padding="5,3"
                                                               Watermark="Search TLK ID, TLK text, or line name"
                                                               Text="{Binding MorphFaceFxSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding MorphFaceFxLineCount}" Margin="0,0,0,3" Opacity="0.75"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                                        <TextBox Text="{Binding SelectedMorphFaceFxLine.TLKString, Mode=OneWay}" IsReadOnly="True"
                                                 TextWrapping="Wrap" MinHeight="35" MaxHeight="75" VerticalScrollBarVisibility="Auto"/>
                                        <Slider Minimum="{Binding MorphFaceFxStart}" Maximum="{Binding MorphFaceFxEnd}" Margin="0,5,0,2"
                                                Value="{Binding MorphFaceFxPosition, Mode=TwoWay}" IsMoveToPointEnabled="True"
                                                IsEnabled="{Binding CanPlayMorphFaceFx}"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MorphFaceFxPositionText}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding MorphFaceFxPlayText}" MinWidth="60" Padding="6,3" Margin="0,0,5,0"
                                                        IsEnabled="{Binding CanPlayMorphFaceFx}" Click="PlayMorphFaceFx_Click"/>
                                                <Button Content="Stop" Padding="6,3" IsEnabled="{Binding CanPlayMorphFaceFx}"
                                                        ToolTip="Stop playback and restore the edited morph pose." Click="StopMorphFaceFx_Click"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="65" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding MorphFaceFxStatus}" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding FilteredMorphFaceFxLines}"
                                             SelectedItem="{Binding SelectedMorphFaceFxLine, Mode=TwoWay}"
                                             IsEnabled="{Binding CanLoadMorphFaceFx}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.CanContentScroll="True">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,3" ToolTip="{Binding SourceLabel}">
                                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TLKString}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SourceLabel}" FontSize="10" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Right" Width="360" Padding="6" BorderThickness="1,0,0,0"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        Visibility="{Binding ShowLiveMaterialEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Live Material Editor" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Margin="0,2,0,6" Text="Changes update the in-game shader preview immediately. Click a mesh region to detect and focus the vector parameter affecting that pixel." TextWrapping="Wrap"/>
                            <Button Content="Randomize tints" Margin="0,0,0,7" Padding="5,3"
                                    Visibility="{Binding ShowLiveMaterialTintRandomizationControl, Converter={StaticResource BoolToVisibilityConverter}}"
                                    IsEnabled="{Binding CanRandomizeSelectedLiveMaterialTints}"
                                    Click="RandomizeLiveMaterialTints_Click"
                                    ToolTip="Randomize the RGB values of every vector parameter whose name starts with TNT_. Alpha values are preserved."/>
                            <UniformGrid Rows="1" Columns="2" Margin="0,0,0,7"
                                         Visibility="{Binding ShowLiveMaterialRandomizationControls, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="Randomize scalars" Margin="0,0,3,0" Padding="5,3"
                                        IsEnabled="{Binding CanRandomizeSelectedLiveMaterialScalars}"
                                        Click="RandomizeLiveMaterialScalars_Click"
                                        ToolTip="Blend compatible scalar values from official BioPlanet profiles in the LE3 Asset Database."/>
                                <Button Content="Randomize vectors" Margin="3,0,0,0" Padding="5,3"
                                        IsEnabled="{Binding CanRandomizeSelectedLiveMaterialVectors}"
                                        Click="RandomizeLiveMaterialVectors_Click"
                                        ToolTip="Blend compatible vector/color values from official BioPlanet profiles in the LE3 Asset Database."/>
                            </UniformGrid>
                            <TextBlock Text="Material" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding LiveMaterials}" SelectedItem="{Binding SelectedLiveMaterial}"
                                      DisplayMemberPath="DisplayName" Margin="0,2,0,6"/>
                            <TextBlock Text="{Binding SelectedLiveMaterial.SourcePath}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="Unsaved preview changes" Foreground="OrangeRed" Margin="0,0,0,4"
                                       Visibility="{Binding SelectedLiveMaterial.HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <TextBlock Text="{Binding LiveMaterialSaveHelpText}"
                                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,5"/>
                            <UniformGrid Rows="1" Columns="2">
                                <Button Content="{Binding LiveMaterialSaveCurrentLabel}" Margin="0,0,3,0" Padding="5,3"
                                        IsEnabled="{Binding CanSaveSelectedLiveMaterialToCurrent}"
                                        Click="SaveLiveMaterialToCurrent_Click"/>
                                <Button Content="{Binding LiveMaterialSaveAsNewLabel}" Margin="3,0,0,0" Padding="5,3"
                                        IsEnabled="{Binding CanSaveSelectedLiveMaterialAsNew}"
                                        Click="SaveLiveMaterialAsNew_Click"/>
                            </UniformGrid>
                        </StackPanel>

                        <ScrollViewer x:Name="LiveMaterialEditorScrollViewer" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="Scalar parameters" Margin="0,2,0,6">
                                    <StackPanel>
                                        <Button Content="Add scalar parameter..." Margin="4,4,4,1" Padding="5,3"
                                                HorizontalAlignment="Stretch" Click="AddLiveMaterialScalar_Click"
                                                ToolTip="Choose from every scalar parameter supported by this material and its parent material."/>
                                        <xctk:WatermarkTextBox Watermark="Filter scalar parameters..." Margin="4,3,4,1"
                                                               Text="{Binding SelectedLiveMaterial.ScalarFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ListBox x:Name="LiveScalarParameterList"
                                                 ItemsSource="{Binding SelectedLiveMaterial.FilteredScalarParameters}"
                                                 SelectedItem="{Binding SelectedLiveScalarParameter}"
                                                 Background="Transparent" BorderThickness="0" MaxHeight="320"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                <StackPanel Margin="4,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ParameterName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="×" Width="22" Height="22" Margin="4,0,0,0" Padding="0"
                                                                ToolTip="Remove this scalar parameter. It remains available from the Add list."
                                                                Click="RemoveLiveMaterialScalar_Click"/>
                                                    </Grid>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Thumb Style="{StaticResource MaterialParameterScrubberStyle}"
                                                               DragDelta="MaterialParameterScrubber_DragDelta"/>
                                                        <xctk:SingleUpDown Grid.Column="1" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           Increment="0.01" AllowInputSpecialValues="None"/>
                                                    </Grid>
                                                </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Vector parameters" Margin="0,0,0,2">
                                    <StackPanel>
                                        <Button Content="Add vector parameter..." Margin="4,4,4,1" Padding="5,3"
                                                HorizontalAlignment="Stretch" Click="AddLiveMaterialVector_Click"
                                                ToolTip="Choose from every vector parameter supported by this material and its parent material."/>
                                        <xctk:WatermarkTextBox Watermark="Filter vector parameters..." Margin="4,3,4,1"
                                                               Text="{Binding SelectedLiveMaterial.VectorFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ListBox x:Name="LiveVectorParameterList"
                                                 ItemsSource="{Binding SelectedLiveMaterial.FilteredVectorParameters}"
                                                 SelectedItem="{Binding SelectedLiveVectorParameter}"
                                                 Background="Transparent" BorderThickness="0" MaxHeight="320"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                            </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Padding="4,5">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding ParameterName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="×" Width="22" Height="22" Margin="4,0,0,0" Padding="0"
                                                                    ToolTip="Remove this vector parameter. It remains available from the Add list."
                                                                    Click="RemoveLiveMaterialVector_Click"/>
                                                        </Grid>
                                                        <xctk:ColorCanvas Margin="0,3,0,0"
                                                                          HorizontalAlignment="Stretch"
                                                                          Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                                                          Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                                                          BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                                          Focusable="True"
                                                                          UsingAlphaChannel="True"
                                                                          SelectedColor="{Binding PreviewColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Grid>
                <Expander Canvas.ZIndex="3" VerticalAlignment="Top" HorizontalAlignment="Left" ExpandDirection="Down" IsExpanded="False" Background="Transparent" Header="Camera info" Padding="3">
                    <StackPanel Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                        <Grid Margin="3,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FOV:" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <xctk:DoubleUpDown Grid.Column="1" Value="{Binding CameraFOV}"
                                               Increment="1"
                                               Minimum="1"
                                               Maximum="170"/>
                        </Grid>
                        <Grid Margin="3,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ZNear:" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <xctk:DoubleUpDown Grid.Column="1" Value="{Binding CameraZNear}"
                                               Increment="0.01"
                                               Maximum="1"
                                               Minimum="0.00000001"/>
                        </Grid>
                        <Grid Margin="3,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ZFar:" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <xctk:DoubleUpDown Grid.Column="1" Value="{Binding CameraZFar}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Degrees" GroupName="UnitType" IsChecked="{Binding UseDegrees}"/>
                            <RadioButton Content="Radians" GroupName="UnitType"  IsChecked="{Binding UseRadians}" Margin="3,0"/>
                            <RadioButton Content="Unreal" GroupName="UnitType" IsChecked="{Binding UseUnreal}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CameraX, StringFormat='X: {0}'}" Margin="3,2" MouseDown="CameraPropsMouseDown" ToolTip="Double click to copy value"/>
                        <TextBlock Text="{Binding CameraY, StringFormat='Y: {0}'}" Margin="3,2" MouseDown="CameraPropsMouseDown" ToolTip="Double click to copy value"/>
                        <TextBlock Text="{Binding CameraZ, StringFormat='Z: {0}'}" Margin="3,2" MouseDown="CameraPropsMouseDown" ToolTip="Double click to copy value"/>
                        <TextBlock Text="{Binding CameraPitch, StringFormat='Pitch: {0}'}" Margin="3,2" MouseDown="CameraPropsMouseDown" ToolTip="Double click to copy value"/>
                        <TextBlock Text="{Binding CameraYaw, StringFormat='Yaw: {0}'}" Margin="3,2" MouseDown="CameraPropsMouseDown" ToolTip="Double click to copy value"/>

                    </StackPanel>
                </Expander>
                <!--<StackPanel Orientation="Vertical" Canvas.ZIndex="4" VerticalAlignment="Top" HorizontalAlignment="Right" Background="#99AAAAAA" Visibility="{Binding ShowMemoryUsage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Memory Information" FontWeight="Bold"/>
                    <ItemsControl ItemsSource="{Binding SceneViewerProperty}">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type scene3D:PreviewTextureCache+PreviewTextureEntry}">
                                    <TextBlock Text="{Binding InstanceFullPath}"/>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </StackPanel>-->
                <Canvas x:Name="MorphViewportMarker" Panel.ZIndex="2" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True">
                    <Ellipse x:Name="MorphViewportMarkerDot" Width="14" Height="14" Stroke="#FFFFC34D" StrokeThickness="2.5" Fill="#55352A10"/>
                    <Border x:Name="MorphViewportMarkerLabel" Background="#DD171D29" BorderBrush="#FFFFC34D" BorderThickness="1" Padding="6,3" CornerRadius="3">
                        <TextBlock Text="{Binding MorphViewportSelectionLabel}" Foreground="White" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Canvas>
                <scene3D:LegacySceneRenderControl Canvas.ZIndex="0"  x:Name="SceneViewer" />
                </Grid>
            </DockPanel>
        </DockPanel>
    </xctk:BusyIndicator>
</exportLoaderControls:ExportLoaderControl>
