<exportLoaderControls:ExportLoaderControl
    x:Class="LegendaryExplorer.UserControls.ExportLoaderControls.ActorPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:scene3D="clr-namespace:LegendaryExplorer.Tools.LevelEditor.Scene3D"
    xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
    xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="ActorMaterialParameterScrubberStyle" TargetType="Thumb">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ToolTip" Value="Drag horizontally to adjust; Shift is faster and Ctrl is finer"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                    BorderThickness="1"/>
                            <Ellipse Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                     Stroke="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                     StrokeThickness="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Control.Resources>
    <xctk:BusyIndicator IsBusy="{Binding IsBusy}" BusyContent="{Binding BusyText}">
        <DockPanel>
            <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True"
                     Visibility="{Binding IsMaterialEditorOnly, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}">
                <CheckBox Content="Wireframe" IsChecked="{Binding ShowWireframe}" VerticalAlignment="Center" Margin="4,0"/>
                <CheckBox Content="Collision" IsChecked="{Binding ShowCollision}" VerticalAlignment="Center" Margin="4,0"/>
                <Button Content="Snap to actor" Click="SnapCameraToActor_Click" Padding="6,2" Margin="4,0"
                        ToolTip="Recenter the camera in front of the actor"/>
                <Button Content="{Binding MorphModeButtonLabel}" Click="ToggleMorphEditor_Click" Padding="6,2" Margin="4,0"
                        Visibility="{Binding HasActorMorph, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Edit the actor's BioMorphFace in a head-focused viewport"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,0"/>
                <xctk:DropDownButton Content="View options" Margin="0,3">
                    <xctk:DropDownButton.DropDownContent>
                        <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="125"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Background color:" Grid.Column="0" VerticalAlignment="Center"/>
                            <xctk:ColorPicker Name="Background_ColorPicker"
                                              UsingAlphaChannel="False"
                                              SelectedColor="{Binding BackgroundColor}"
                                              Grid.Column="1"/>
                        </Grid>
                    </xctk:DropDownButton.DropDownContent>
                </xctk:DropDownButton>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,0"/>
                <TextBlock Text="WASD move • right-drag look • Q/E up/down" VerticalAlignment="Center" Opacity="0.7" Margin="4,0"/>
            </ToolBar>
            <Grid>
                <DockPanel Visibility="{Binding IsMorphEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}">
            <Border DockPanel.Dock="Right" Padding="7" BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    Visibility="{Binding ShowLiveMaterialEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="380"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMaterialEditorOnly}" Value="True">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Live Material Editor" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Ã—" Width="24" Height="24" Padding="0" Margin="5,0,0,0"
                                    Visibility="{Binding IsMaterialEditorOnly, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Click="CloseEmbeddedMaterialEditor_Click" ToolTip="Close live material editor"/>
                        </Grid>
                        <TextBlock Text="Changes update the actor immediately. Choose whether saves target the component MIC or its parent material."
                                   TextWrapping="Wrap" Margin="0,2,0,6"/>
                        <Button Content="Randomize tints" Padding="5,3" Margin="0,0,0,7"
                                IsEnabled="{Binding CanRandomizeSelectedLiveMaterialTints}"
                                Click="RandomizeActorMaterialTints_Click"
                                ToolTip="Randomize RGB for every vector parameter beginning with TNT_. Alpha is preserved."/>
                        <TextBlock Text="Component material" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding LiveMaterials}" SelectedItem="{Binding SelectedLiveMaterial}"
                                  DisplayMemberPath="DisplayName" Margin="0,2,0,4"/>
                        <TextBlock Text="{Binding SelectedMaterialTargetPath}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
                        <TextBlock Text="Edit level" FontWeight="SemiBold"/>
                        <ComboBox SelectedIndex="{Binding SelectedMaterialEditLevelIndex}" Margin="0,2,0,4">
                            <ComboBoxItem Content="MIC attached to component"/>
                            <ComboBoxItem Content="Parent material"/>
                        </ComboBox>
                        <TextBlock Text="{Binding SelectedParentMaterialPath}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,4"
                                   Visibility="{Binding IsEditingParentMaterial, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="Unsaved preview changes" Foreground="OrangeRed" Margin="0,0,0,4"
                                   Visibility="{Binding SelectedLiveMaterial.HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button Content="Apply component MIC overrides" Padding="5,4"
                                IsEnabled="{Binding CanApplyComponentMicOverrides}"
                                Visibility="{Binding IsEditingComponentMaterial, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="ApplyComponentMicOverrides_Click"
                                ToolTip="Writes the edited values to the attached MIC. If no MIC exists, one is created and linked through the component Materials property."/>
                        <StackPanel Visibility="{Binding IsEditingParentMaterial, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ParentMaterialSaveHelpText}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,5"/>
                            <UniformGrid Rows="1" Columns="2">
                                <Button Content="Overwrite parent" Margin="0,0,3,0" Padding="5,4"
                                        IsEnabled="{Binding CanOverwriteParentMaterial}"
                                        Click="OverwriteParentMaterial_Click"/>
                                <Button Content="Create parent MIC" Margin="3,0,0,0" Padding="5,4"
                                        IsEnabled="{Binding CanCreateParentMic}"
                                        Click="CreateParentMic_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="Scalar parameters" Margin="0,2,0,6">
                                <StackPanel>
                                    <Button Content="Add scalar parameter..." Margin="4,4,4,1" Padding="5,3"
                                            Click="AddActorMaterialScalar_Click"/>
                                    <xctk:WatermarkTextBox Watermark="Filter scalar parameters..." Margin="4,3,4,1"
                                                           Text="{Binding SelectedLiveMaterial.ScalarFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ListBox x:Name="LiveScalarParameterList"
                                             ItemsSource="{Binding SelectedLiveMaterial.FilteredScalarParameters}"
                                             SelectedItem="{Binding SelectedLiveScalarParameter}"
                                             Background="Transparent" BorderThickness="0" MaxHeight="320"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ParameterName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="×" Width="22" Height="22" Margin="4,0,0,0" Padding="0"
                                                                Click="RemoveActorMaterialScalar_Click" ToolTip="Remove this scalar override"/>
                                                    </Grid>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Thumb Style="{StaticResource ActorMaterialParameterScrubberStyle}"
                                                               DragDelta="ActorMaterialParameterScrubber_DragDelta"/>
                                                        <xctk:SingleUpDown Grid.Column="1" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           Increment="0.01" AllowInputSpecialValues="None"/>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Vector parameters" Margin="0,0,0,2">
                                <StackPanel>
                                    <Button Content="Add vector parameter..." Margin="4,4,4,1" Padding="5,3"
                                            Click="AddActorMaterialVector_Click"/>
                                    <xctk:WatermarkTextBox Watermark="Filter vector parameters..." Margin="4,3,4,1"
                                                           Text="{Binding SelectedLiveMaterial.VectorFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ListBox x:Name="LiveVectorParameterList"
                                             ItemsSource="{Binding SelectedLiveMaterial.FilteredVectorParameters}"
                                             SelectedItem="{Binding SelectedLiveVectorParameter}"
                                             Background="Transparent" BorderThickness="0" MaxHeight="320"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Padding="4,5">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding ParameterName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="×" Width="22" Height="22" Margin="4,0,0,0" Padding="0"
                                                                    Click="RemoveActorMaterialVector_Click" ToolTip="Remove this vector override"/>
                                                        </Grid>
                                                        <xctk:ColorCanvas Margin="0,3,0,0" HorizontalAlignment="Stretch"
                                                                          Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                                                          Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                                                          BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                                          Focusable="True" UsingAlphaChannel="True"
                                                                          SelectedColor="{Binding PreviewColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <scene3D:SceneRenderControl x:Name="SceneViewer"
                                        Visibility="{Binding IsMaterialEditorOnly, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}"
                                        PreviewMouseDown="SceneViewer_PreviewMouseDownForMaterialPicking"
                                        PreviewMouseUp="SceneViewer_PreviewMouseUpForMaterialPicking"/>
                </DockPanel>
                <ContentControl x:Name="ActorMorphEditorHost"
                                Visibility="{Binding IsMorphEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </DockPanel>
    </xctk:BusyIndicator>
</exportLoaderControls:ExportLoaderControl>
