<exportLoaderControls:ExportLoaderControl x:Class="LegendaryExplorer.UserControls.ExportLoaderControls.CurveEditor3D"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
        xmlns:scene3D="clr-namespace:LegendaryExplorer.Tools.LevelEditor.Scene3D"
        mc:Ignorable="d"
        d:DesignHeight="600" d:DesignWidth="1000"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="CurveEditor3D_Loaded"
        Unloaded="CurveEditor3D_Unloaded">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top">
            <ToolBar ToolBarTray.IsLocked="True" OverflowMode="Never">
                <Button Content="Open Level" Click="OpenLevel_Click" ToolTip="Replace the level backdrop"/>
                <Button Content="Add Level" Click="AddLevel_Click" ToolTip="Add another level file to the backdrop"/>
                <Button Content="Unload Level" Click="UnloadLevel_Click" ToolTip="Unload all level backdrop files"/>
                <Button x:Name="RecentLevelsButton" Content="Recent Levels" Click="RecentLevelsButton_Click" ToolTip="Open a recent level backdrop">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RecentLevelsMenu" Opened="RecentLevelsMenu_Opened"/>
                    </Button.ContextMenu>
                </Button>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Loc" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="X:" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="Red"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <TextBox x:Name="CameraPositionX_TextBox" Width="72"
                                 Text="{Binding CameraPositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyUp="CameraPositionBoxes_KeyUp"
                                 GotKeyboardFocus="CameraPositionBoxes_GotKeyboardFocus"
                                 LostKeyboardFocus="CameraPositionBoxes_LostKeyboardFocus"
                                 GotFocus="CoordinateEditor_GotFocus"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas"
                                 ToolTip="Camera X position"/>
                        <StackPanel Margin="2,0,0,0">
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                    Tag="X,1" Click="CameraPositionAdjustButton_Click" ToolTip="Increase X position"/>
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                    Tag="X,-1" Click="CameraPositionAdjustButton_Click" ToolTip="Decrease X position"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Y:" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#FF00C91D"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <TextBox x:Name="CameraPositionY_TextBox" Width="72"
                                 Text="{Binding CameraPositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyUp="CameraPositionBoxes_KeyUp"
                                 GotKeyboardFocus="CameraPositionBoxes_GotKeyboardFocus"
                                 LostKeyboardFocus="CameraPositionBoxes_LostKeyboardFocus"
                                 GotFocus="CoordinateEditor_GotFocus"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas"
                                 ToolTip="Camera Y position"/>
                        <StackPanel Margin="2,0,0,0">
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                    Tag="Y,1" Click="CameraPositionAdjustButton_Click" ToolTip="Increase Y position"/>
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                    Tag="Y,-1" Click="CameraPositionAdjustButton_Click" ToolTip="Decrease Y position"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Z:" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="Blue"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <TextBox x:Name="CameraPositionZ_TextBox" Width="72"
                                 Text="{Binding CameraPositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyUp="CameraPositionBoxes_KeyUp"
                                 GotKeyboardFocus="CameraPositionBoxes_GotKeyboardFocus"
                                 LostKeyboardFocus="CameraPositionBoxes_LostKeyboardFocus"
                                 GotFocus="CoordinateEditor_GotFocus"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas"
                                 ToolTip="Camera Z position"/>
                        <StackPanel Margin="2,0,0,0">
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                    Tag="Z,1" Click="CameraPositionAdjustButton_Click" ToolTip="Increase Z position"/>
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                    Tag="Z,-1" Click="CameraPositionAdjustButton_Click" ToolTip="Decrease Z position"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Step:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <xctk:SingleUpDown Width="70" Value="{Binding CameraPositionStep}" Minimum="0.01"
                                       ButtonSpinnerLocation="Left" FormatString="F2"
                                       VerticalContentAlignment="Center" ToolTip="Camera position adjustment step"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="Rot" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="X:" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="Red"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <TextBox x:Name="CameraRotationX_TextBox" Width="72"
                                 Text="{Binding CameraRotationX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyUp="CameraRotationBoxes_KeyUp"
                                 GotKeyboardFocus="CameraRotationBoxes_GotKeyboardFocus"
                                 LostKeyboardFocus="CameraRotationBoxes_LostKeyboardFocus"
                                 GotFocus="CoordinateEditor_GotFocus"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas"
                                 ToolTip="Camera X rotation (Roll, degrees)"/>
                        <StackPanel Margin="2,0,0,0">
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                    Tag="X,1" Click="CameraRotationAdjustButton_Click" ToolTip="Increase X rotation"/>
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                    Tag="X,-1" Click="CameraRotationAdjustButton_Click" ToolTip="Decrease X rotation"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Y:" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#FF00C91D"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <TextBox x:Name="CameraRotationY_TextBox" Width="72"
                                 Text="{Binding CameraRotationY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyUp="CameraRotationBoxes_KeyUp"
                                 GotKeyboardFocus="CameraRotationBoxes_GotKeyboardFocus"
                                 LostKeyboardFocus="CameraRotationBoxes_LostKeyboardFocus"
                                 GotFocus="CoordinateEditor_GotFocus"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas"
                                 ToolTip="Camera Y rotation (Pitch, degrees)"/>
                        <StackPanel Margin="2,0,0,0">
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                    Tag="Y,1" Click="CameraRotationAdjustButton_Click" ToolTip="Increase Y rotation"/>
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                    Tag="Y,-1" Click="CameraRotationAdjustButton_Click" ToolTip="Decrease Y rotation"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Z:" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="Blue"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <TextBox x:Name="CameraRotationZ_TextBox" Width="72"
                                 Text="{Binding CameraRotationZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyUp="CameraRotationBoxes_KeyUp"
                                 GotKeyboardFocus="CameraRotationBoxes_GotKeyboardFocus"
                                 LostKeyboardFocus="CameraRotationBoxes_LostKeyboardFocus"
                                 GotFocus="CoordinateEditor_GotFocus"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas"
                                 ToolTip="Camera Z rotation (Yaw, degrees)"/>
                        <StackPanel Margin="2,0,0,0">
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                    Tag="Z,1" Click="CameraRotationAdjustButton_Click" ToolTip="Increase Z rotation"/>
                            <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                    Tag="Z,-1" Click="CameraRotationAdjustButton_Click" ToolTip="Decrease Z rotation"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Step:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <xctk:SingleUpDown Width="70" Value="{Binding CameraRotationStep}" Minimum="0.1"
                                       ButtonSpinnerLocation="Left" FormatString="F2"
                                       VerticalContentAlignment="Center" ToolTip="Camera rotation adjustment step in degrees"/>
                </StackPanel>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <xctk:DropDownButton Content="View options" MaxDropDownHeight="220" CloseOnFocusLoss="False"
                                     BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                    <xctk:DropDownButton.DropDownContent>
                        <scene3D:SceneControlOptionsControl/>
                    </xctk:DropDownButton.DropDownContent>
                </xctk:DropDownButton>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <TextBlock Text="{Binding CurrentExportName}" VerticalAlignment="Center" Margin="4,0"/>
            </ToolBar>
        </WrapPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding SceneStatus}"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DialoguePreviewActorPanel" Grid.Column="0" Width="260" Padding="8"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Dialogue Actors" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="Audio" FontWeight="SemiBold"/>
                        <ComboBox x:Name="DialoguePreviewAudioGenderComboBox" Margin="0,4,0,8"
                                  SelectionChanged="DialoguePreviewAudioGender_SelectionChanged"/>
                        <TextBlock Text="FaceFX Asset" FontWeight="SemiBold"/>
                        <ComboBox x:Name="DialoguePreviewFaceFxAssetComboBox" Margin="0,4,0,0" IsEditable="True"
                                  IsTextSearchEnabled="True" SelectionChanged="DialoguePreviewFaceFxAsset_SelectionChanged"
                                  LostKeyboardFocus="DialoguePreviewFaceFxAsset_LostKeyboardFocus"/>
                        <exportLoaderControls:Soundpanel x:Name="DialoguePreviewSoundpanel" Margin="0,8,0,0"
                                                         MiniPlayerMode="True"/>
                    </StackPanel>
                    <ListBox x:Name="DialoguePreviewActorListBox" DisplayMemberPath="DisplayName"
                             SelectionChanged="DialoguePreviewActorListBox_SelectionChanged"/>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="DialoguePreviewActorPanelSplitter" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" Visibility="Collapsed"/>

            <scene3D:SceneRenderControl x:Name="SceneViewer" Grid.Column="2"/>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel>
                    <Expander Header="Preview Actors" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="0,6,0,0">
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Add" Click="AddPreviewActor_Click" Padding="8,3" Margin="2"/>
                                    <Button x:Name="RemovePreviewActorButton" Content="Remove" Click="RemovePreviewActor_Click" Padding="8,3" Margin="2"/>
                                    <Button Content="Clear" Click="ClearPreviewActors_Click" Padding="8,3" Margin="2"/>
                                </StackPanel>
                                <ListBox x:Name="PreviewActorListBox" Height="62" DisplayMemberPath="DisplayName"
                                         SelectionChanged="PreviewActorListBox_SelectionChanged"
                                         MouseDoubleClick="PreviewActorListBox_MouseDoubleClick"
                                         ToolTip="Double-click an actor to focus it in the viewport"/>
                            </DockPanel>
                            <StackPanel Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Body" VerticalAlignment="Center"/>
                                <DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Content="Select..." Tag="Body" Click="PreviewActorModel_Select_Click"/><TextBox x:Name="PreviewActorTextBox" IsReadOnly="True" Margin="0,0,3,0"/></DockPanel>
                            </Grid>
                            <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Head" VerticalAlignment="Center"/><DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Content="Select..." Tag="Head" Click="PreviewActorModel_Select_Click"/><TextBox x:Name="PreviewActorHeadTextBox" IsReadOnly="True" Margin="0,0,3,0"/></DockPanel></Grid>
                            <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Hair" VerticalAlignment="Center"/><DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Content="Select..." Tag="Hair" Click="PreviewActorModel_Select_Click"/><TextBox x:Name="PreviewActorHairTextBox" IsReadOnly="True" Margin="0,0,3,0"/></DockPanel></Grid>
                            <Button Content="Reset Models" HorizontalAlignment="Right" Click="ResetPreviewActorModels_Click" Padding="7,3" Margin="2"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gesture" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PreviewActorGestureComboBox" Grid.Column="1"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="PreviewActorGesture_SelectionChanged"
                                          ToolTip="Session-only gesture assignment for actor-on-track playback"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Track" VerticalAlignment="Center"/>
                                <DockPanel Grid.Column="1">
                                    <Button x:Name="PreviewActorTrackMoveButton" DockPanel.Dock="Right" Content="Attach..."
                                            Click="PreviewActorTrackMove_Click" Padding="7,3" Margin="4,0,0,0"/>
                                    <TextBlock x:Name="PreviewActorTrackMoveTextBlock" VerticalAlignment="Center"
                                               TextWrapping="Wrap" ToolTip="TrackMove used for actor playback"/>
                                </DockPanel>
                            </Grid>
                            <UniformGrid Columns="3" Margin="0,0,0,4">
                                <StackPanel Margin="2"><TextBlock Text="Origin X"/><TextBox x:Name="PreviewActorXTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                                <StackPanel Margin="2"><TextBlock Text="Origin Y"/><TextBox x:Name="PreviewActorYTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                                <StackPanel Margin="2"><TextBlock Text="Origin Z"/><TextBox x:Name="PreviewActorZTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                                <StackPanel Margin="2"><TextBlock Text="Roll (X)"/><TextBox x:Name="PreviewActorRollTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                                <StackPanel Margin="2"><TextBlock Text="Pitch (Y)"/><TextBox x:Name="PreviewActorPitchTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                                <StackPanel Margin="2"><TextBlock Text="Yaw (Z)"/><TextBox x:Name="PreviewActorYawTextBox" Padding="3" TextChanged="PreviewActorTransform_TextChanged"/></StackPanel>
                            </UniformGrid>
                            <Grid Margin="2,0,2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="145"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Move actor" FontWeight="SemiBold"/>
                                    <UniformGrid Rows="1" Columns="4" Margin="0,4">
                                        <RadioButton Content="X" Tag="X" GroupName="PreviewActorLocationScrubAxis" IsChecked="True" HorizontalContentAlignment="Center" Checked="PreviewActorLocationScrubAxis_Checked"/>
                                        <RadioButton Content="Y" Tag="Y" GroupName="PreviewActorLocationScrubAxis" HorizontalContentAlignment="Center" Checked="PreviewActorLocationScrubAxis_Checked"/>
                                        <RadioButton Content="Z" Tag="Z" GroupName="PreviewActorLocationScrubAxis" HorizontalContentAlignment="Center" Checked="PreviewActorLocationScrubAxis_Checked"/>
                                        <RadioButton Content="All" Tag="All" GroupName="PreviewActorLocationScrubAxis" HorizontalContentAlignment="Center" Checked="PreviewActorLocationScrubAxis_Checked"/>
                                    </UniformGrid>
                                    <Grid Height="24" ToolTip="Drag left or right to move the selected actor along the selected axes">
                                        <Border Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                        <Border Width="2" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" IsHitTestVisible="False"/>
                                        <Thumb Width="24" Height="20" HorizontalAlignment="Center" DragStarted="PreviewActorLocationScrub_DragStarted" DragDelta="PreviewActorLocationScrub_DragDelta" DragCompleted="PreviewActorLocationScrub_DragCompleted"/>
                                    </Grid>
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Text="Gizmo:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <RadioButton Content="Move" GroupName="PreviewActorGizmoMode" IsChecked="True" Checked="PreviewActorMoveGizmo_Checked" Margin="2"/>
                                        <RadioButton Content="Rotate" GroupName="PreviewActorGizmoMode" Checked="PreviewActorRotateGizmo_Checked" Margin="2"/>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Rotate actor" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <UniformGrid Rows="1" Columns="4" Margin="0,4">
                                        <RadioButton Content="Roll" Tag="Roll" GroupName="PreviewActorRotationDialAxis" IsChecked="True" HorizontalContentAlignment="Center" Checked="PreviewActorRotationDialAxis_Checked"/>
                                        <RadioButton Content="Pitch" Tag="Pitch" GroupName="PreviewActorRotationDialAxis" HorizontalContentAlignment="Center" Checked="PreviewActorRotationDialAxis_Checked"/>
                                        <RadioButton Content="Yaw" Tag="Yaw" GroupName="PreviewActorRotationDialAxis" HorizontalContentAlignment="Center" Checked="PreviewActorRotationDialAxis_Checked"/>
                                        <RadioButton Content="All" Tag="All" GroupName="PreviewActorRotationDialAxis" HorizontalContentAlignment="Center" Checked="PreviewActorRotationDialAxis_Checked"/>
                                    </UniformGrid>
                                    <Grid x:Name="PreviewActorRotationDial" Width="90" Height="90" HorizontalAlignment="Center" Cursor="Hand"
                                          MouseLeftButtonDown="PreviewActorRotationDial_MouseLeftButtonDown"
                                          MouseMove="PreviewActorRotationDial_MouseMove"
                                          MouseLeftButtonUp="PreviewActorRotationDial_MouseLeftButtonUp"
                                          LostMouseCapture="PreviewActorRotationDial_LostMouseCapture">
                                        <Ellipse Margin="4" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="2"/>
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                        <Line x:Name="PreviewActorRotationDialIndicator" X1="45" Y1="45" X2="45" Y2="8" Stroke="Orange" StrokeThickness="3">
                                            <Line.RenderTransform><RotateTransform CenterX="45" CenterY="45"/></Line.RenderTransform>
                                        </Line>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <WrapPanel>
                                <Button Content="Play Actors on Tracks" Click="PlayActor_Click" Loaded="PlayActorButton_Loaded"
                                        IsEnabled="False" Padding="7,3" Margin="2"
                                        ToolTip="Move the selected actor along this InterpTrackMove while leaving the viewport camera stationary"/>
                                <Button Content="Use Selected Key" Click="UseSelectedKeyframeForPreviewActor_Click" Padding="7,3" Margin="2"/>
                                <Button Content="Use Viewport Location" Click="UseViewportLocationForPreviewActor_Click" Padding="7,3" Margin="2"/>
                                <Button Content="Use Viewport Transform" Click="UseViewportTransformForPreviewActor_Click" Padding="7,3" Margin="2"/>
                                <Button Content="Reset Actor" Click="ResetPreviewActor_Click" Padding="7,3" Margin="2"/>
                            </WrapPanel>
                            <StackPanel Margin="2,2,0,0">
                                <CheckBox x:Name="ActorPlaybackTrackZCheckBox" Content="Use TrackMove Z for actor playback"
                                          Checked="ActorPlaybackZOption_Changed" Unchecked="ActorPlaybackZOption_Changed"
                                          ToolTip="Uses the TrackMove Z exactly during actor playback."/>
                                <CheckBox x:Name="ActorPlaybackShiftZCheckBox" Content="Shift actors down 90 units during playback"
                                          Checked="ActorPlaybackZOption_Changed" Unchecked="ActorPlaybackZOption_Changed"
                                          ToolTip="Applies a playback-only -90 Z offset without changing actor origins. Mutually exclusive with TrackMove Z."/>
                            </StackPanel>
                            <TextBlock x:Name="PreviewActorStatusTextBlock" Margin="2,2,0,0" Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="Keyframes" FontSize="18" FontWeight="SemiBold"/>
                    <ListBox x:Name="KeyframeTrackMoveTabs" Margin="0,4,0,8"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="KeyframeTrackMoveTabs_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,3,3"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TabDisplayName}" ToolTip="{Binding TrackMove.InstancedFullPath}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <GroupBox Header="Playback" Margin="0,4,0,8">
                        <StackPanel Margin="6">
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Play" Click="PlayMove_Click" Loaded="PlayMoveButton_Loaded" IsEnabled="False" Margin="0,0,4,4"
                                        ToolTip="Play the move through the scene camera using the track interpolation modes"/>
                                <Button x:Name="SnapToKeyButton" Content="Snap Camera to Key" Click="SnapCameraToKey_Click" IsEnabled="False" Margin="0,0,4,4"
                                        ToolTip="Move the camera to the selected keyframe and apply its rotation"/>
                                <Button Content="Add Keyframe..." Click="AddKeyframe_Click" Margin="0,0,4,4" ToolTip="Add a keyframe based on the selected keyframe"/>
                                <Button Content="Shift InterpTrack..." Click="ShiftInterpTrack_Click" Margin="0,0,4,4" ToolTip="Shift the entire interpolation track"/>
                            </WrapPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ExtraTrackMoveCheckBox" Content="Extra camera" VerticalAlignment="Center"
                                          Checked="MulticamPlaybackOption_Changed" Unchecked="MulticamPlaybackOption_Changed"
                                          ToolTip="Play one additional camera group TrackMove as a viewport camera actor"/>
                                <ComboBox x:Name="ExtraTrackMoveComboBox" Grid.Column="1" Margin="6,0,0,0"
                                          DisplayMemberPath="DisplayName" SelectionChanged="ExtraTrackMove_SelectionChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="DirectorMulticamCheckBox" Content="Director multicam" VerticalAlignment="Center"
                                          Checked="MulticamPlaybackOption_Changed" Unchecked="MulticamPlaybackOption_Changed"
                                          ToolTip="Follow this InterpData's Director cut track camera order during playback"/>
                                <ComboBox x:Name="DirectorTrackComboBox" Grid.Column="1" Margin="6,0,0,0"
                                          DisplayMemberPath="DisplayName" SelectionChanged="DirectorTrack_SelectionChanged"/>
                            </Grid>
                            <TextBlock Text="{Binding PlaybackKeyframeStatus}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                    <ListBox x:Name="KeyframeList" Margin="0,4,0,10" MaxHeight="220"
                             SelectionChanged="KeyframeList_SelectionChanged"
                             MouseDoubleClick="KeyframeList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Border Width="11" Height="11" Margin="0,0,7,0" BorderThickness="2"
                                            BorderBrush="#FFFFB21A" Background="#FF242424"/>
                                    <TextBlock Text="{Binding Time, StringFormat=InVal {0:0.###}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel DataContext="{Binding SelectedKeyframe}">
                        <TextBlock Text="Selected Keyframe" FontSize="18" FontWeight="SemiBold"/>

                        <GroupBox Header="Timing (InVal)" Margin="0,4,0,8">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SelectedKeyframeInVal, RelativeSource={RelativeSource AncestorType={x:Type exportLoaderControls:CurveEditor3D}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="KeyframeInVal_KeyDown"/>
                                <Button Grid.Column="1" Margin="4,0,0,0" Padding="6,0" Content="✓"
                                        Click="ApplyKeyframeInVal_Click" ToolTip="Apply the InVal change"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Location" Margin="0,0,0,8">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Increment" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown x:Name="LocationIncrementUpDown" Grid.Column="1" Value="1" Increment="0.1" Minimum="0.0001"
                                                   ToolTip="Amount added or subtracted by the location arrow buttons"/>
                                <TextBlock Grid.Row="1" Text="X" Foreground="#FFFF0000" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150, ValidatesOnExceptions=True}"
                                                   Increment="{Binding Value, ElementName=LocationIncrementUpDown}"/>
                                <TextBlock Grid.Row="2" Text="Y" Foreground="#FF00FF00" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150, ValidatesOnExceptions=True}"
                                                   Increment="{Binding Value, ElementName=LocationIncrementUpDown}"/>
                                <TextBlock Grid.Row="3" Text="Z" Foreground="#FF0000FF" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150, ValidatesOnExceptions=True}"
                                                   Increment="{Binding Value, ElementName=LocationIncrementUpDown}"/>
                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <UniformGrid Rows="1" Columns="5" Margin="0,0,0,4">
                                        <RadioButton Content="X" Tag="X" GroupName="LocationScrubAxis" IsChecked="True"
                                                     HorizontalContentAlignment="Center" Checked="LocationScrubAxis_Checked"/>
                                        <RadioButton Content="Y" Tag="Y" GroupName="LocationScrubAxis"
                                                     HorizontalContentAlignment="Center" Checked="LocationScrubAxis_Checked"/>
                                        <RadioButton Content="Z" Tag="Z" GroupName="LocationScrubAxis"
                                                     HorizontalContentAlignment="Center" Checked="LocationScrubAxis_Checked"/>
                                        <RadioButton Content="XY" Tag="XY" GroupName="LocationScrubAxis"
                                                     HorizontalContentAlignment="Center" Checked="LocationScrubAxis_Checked"/>
                                        <RadioButton Content="XYZ" Tag="XYZ" GroupName="LocationScrubAxis"
                                                     HorizontalContentAlignment="Center" Checked="LocationScrubAxis_Checked"/>
                                    </UniformGrid>
                                    <CheckBox x:Name="LocationScrubAllKeysCheckBox" Content="Apply location drag to all keys" Margin="0,0,0,4"
                                              ToolTip="Apply the same location delta to every keyframe while preserving the track shape"/>
                                    <Grid Height="24" ToolTip="Drag left or right to move keyframes continuously along the selected axes">
                                        <Border Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                        <Border Width="2" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Background="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" IsHitTestVisible="False"/>
                                        <Thumb x:Name="LocationScrubThumb" Width="24" Height="20" HorizontalAlignment="Center"
                                               DragStarted="LocationScrubThumb_DragStarted"
                                               DragDelta="LocationScrubThumb_DragDelta"
                                               DragCompleted="LocationScrubThumb_DragCompleted"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Rotation" Margin="0,0,0,8">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Increment" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown x:Name="RotationIncrementUpDown" Grid.Column="1" Value="1" Increment="0.1" Minimum="0.0001"
                                                   ToolTip="Amount added or subtracted by the rotation arrow buttons"/>
                                <TextBlock Grid.Row="1" Text="X (Roll)" Foreground="#FFFF0000" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Roll, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150, ValidatesOnExceptions=True}"
                                                   Increment="{Binding Value, ElementName=RotationIncrementUpDown}"/>
                                <TextBlock Grid.Row="2" Text="Y (Pitch)" Foreground="#FF00FF00" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Pitch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150, ValidatesOnExceptions=True}"
                                                   Increment="{Binding Value, ElementName=RotationIncrementUpDown}"/>
                                <TextBlock Grid.Row="3" Text="Z (Yaw)" Foreground="#FF0000FF" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Yaw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150, ValidatesOnExceptions=True}"
                                                   Increment="{Binding Value, ElementName=RotationIncrementUpDown}"/>
                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,4">
                                        <RadioButton Content="Pitch" Tag="Pitch" GroupName="RotationDialAxis" IsChecked="True"
                                                     HorizontalContentAlignment="Center" Checked="RotationDialAxis_Checked"/>
                                        <RadioButton Content="Roll" Tag="Roll" GroupName="RotationDialAxis"
                                                     HorizontalContentAlignment="Center" Checked="RotationDialAxis_Checked"/>
                                        <RadioButton Content="Yaw" Tag="Yaw" GroupName="RotationDialAxis"
                                                     HorizontalContentAlignment="Center" Checked="RotationDialAxis_Checked"/>
                                        <RadioButton Content="All" Tag="All" GroupName="RotationDialAxis"
                                                     HorizontalContentAlignment="Center" Checked="RotationDialAxis_Checked"/>
                                    </UniformGrid>
                                    <CheckBox x:Name="RotationDialAllKeysCheckBox" Content="Apply rotation drag to all keys" Margin="0,0,0,4"
                                              ToolTip="Apply the same rotation delta to every keyframe while preserving relative rotations"/>
                                    <Grid x:Name="RotationDial" Width="120" Height="120" HorizontalAlignment="Center" Cursor="Hand"
                                          MouseLeftButtonDown="RotationDial_MouseLeftButtonDown"
                                          MouseMove="RotationDial_MouseMove"
                                          MouseLeftButtonUp="RotationDial_MouseLeftButtonUp"
                                          LostMouseCapture="RotationDial_LostMouseCapture"
                                          ToolTip="Drag around the circle to rotate the selected keyframe on the selected axis">
                                        <Ellipse Margin="4" StrokeThickness="4"
                                                 Stroke="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                                 Fill="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                        <Line x:Name="RotationDialIndicator" X1="60" Y1="60" X2="60" Y2="10" StrokeThickness="3"
                                              Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" IsHitTestVisible="False">
                                            <Line.RenderTransform>
                                                <RotateTransform CenterX="60" CenterY="60"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" IsHitTestVisible="False"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Interp Mode Type">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="PosTrack" FontWeight="SemiBold"/>
                                    <ComboBox Margin="0,4,0,0" ItemsSource="{Binding DataContext.InterpModes, RelativeSource={RelativeSource AncestorType={x:Type exportLoaderControls:CurveEditor3D}}}"
                                              SelectedItem="{Binding PosTrackInterpMode, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Margin="0,6,0,0" Content="Apply Pos to all" Click="ApplyPosTrackInterpModeToAll_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="EulerTrack" FontWeight="SemiBold"/>
                                    <ComboBox Margin="0,4,0,0" ItemsSource="{Binding DataContext.InterpModes, RelativeSource={RelativeSource AncestorType={x:Type exportLoaderControls:CurveEditor3D}}}"
                                              SelectedItem="{Binding EulerTrackInterpMode, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Margin="0,6,0,0" Content="Apply Euler to all" Click="ApplyEulerTrackInterpModeToAll_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <TextBlock Margin="0,12,0,0" Text="Select a cube or list item, then edit values or use the Translate/Rotate gizmo." TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</exportLoaderControls:ExportLoaderControl>
