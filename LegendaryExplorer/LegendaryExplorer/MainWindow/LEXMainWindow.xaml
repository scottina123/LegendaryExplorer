<Window x:Class="LegendaryExplorer.MainWindow.LEXMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LegendaryExplorer"
        xmlns:mainWindow="clr-namespace:LegendaryExplorer.MainWindow"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        mc:Ignorable="d"
        d:DataContext="{Binding RelativeSource={RelativeSource Self}}"
        MaxWidth="790"
        Title="Legendary Explorer" Height="670" Width="790" Opacity="0"
        WindowStyle="None" Foreground="{x:Null}" AllowsTransparency="True"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        BorderBrush="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderThickness="2"
        Closing="MainWindow_Closing" PreviewMouseDown="MainWindow_PreviewMouseDown"
        PreviewKeyDown="MainWindow_PreviewKeyDown" Deactivated="MainWindow_Deactivated"
        AllowDrop="True" PreviewDragOver="MainWindow_PreviewDragOver" PreviewDrop="MainWindow_PreviewDrop">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" CanExecute="SystemCommand_CanExecute" Executed="CloseCommand_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" CanExecute="SystemCommand_CanExecute" Executed="MinimizeCommand_Executed" />
    </Window.CommandBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#7e8285"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#FF30343E"/>
        <SolidColorBrush x:Key="MouseOverBrush" Color="White"/>
        <SolidColorBrush x:Key="CheckedBrush" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="UncheckedBrush" Color="#BFBFBF" />
        <Style x:Key="MainWindowFocusVisualStyle">  
            <Setter Property="Control.Template">  
                <Setter.Value>  
                    <ControlTemplate>  
                        <Rectangle StrokeThickness="1"  
                                   Stroke="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                   StrokeDashArray="1 2"  
                                   SnapsToDevicePixels="true"/>  
                    </ControlTemplate>  
                </Setter.Value>  
            </Setter>  
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource MainWindowFocusVisualStyle}"/>
        </Style>
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource MainWindowFocusVisualStyle}"/>
        </Style>
        <Style x:Key="BottomBarButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource BorderlessButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MainWindowFocusVisualStyle}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <Grid>
        <Rectangle MouseDown="BackgroundMouseDown" Fill="#00000000"/>
        <DockPanel Background="Transparent">
            
            <!-- Window controls and drag area -->
            <Grid DockPanel.Dock="Top" Height="30" Background="Transparent" MouseDown="BackgroundMouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{x:Static SystemCommands.MinimizeWindowCommand}" Width="30" Height="30" TabIndex="0"
                            Style="{DynamicResource WindowManagementButton}" VerticalContentAlignment="Center">
                        <Image Source="/Resources/Images/minimize_icon.ico" Height="15" Width="15" />
                    </Button>
                    <Button Command="{x:Static SystemCommands.CloseWindowCommand}" Width="30" Height="30" TabIndex="1"
                            Style="{DynamicResource WindowManagementButton}" VerticalContentAlignment="Center">
                        <Image Source="/Resources/Images/close_icon.ico" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search, favorites and page navigation -->
            <Border DockPanel.Dock="Bottom" BorderThickness="0"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="8,7" Height="56">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SearchButton" Style="{StaticResource BottomBarButton}"
                                Click="SearchButton_Click" TabIndex="2" ToolTip="Search tools (Ctrl+F)"
                                AutomationProperties.Name="Search tools">
                            <fa5:ImageAwesome Icon="Solid_Search" Width="24" Height="24"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Border x:Name="SearchBorder" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1"
                                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" CornerRadius="6" Width="190" Visibility="Collapsed">
                            <TextBox x:Name="SearchBox" FontFamily="{StaticResource AudemusUiFont}"
                                     TabIndex="2" FontSize="15" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" VerticalContentAlignment="Center" CaretBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                     Padding="10,0" FocusVisualStyle="{x:Null}"
                                     AutomationProperties.Name="Search tools" ToolTip="Search names or abbreviations"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Border>
                        <Button x:Name="CloseSearchButton" Grid.Column="1" Width="28" Margin="2,0,0,0"
                                Style="{StaticResource BottomBarButton}" Click="CloseSearch_Click"
                                Visibility="{Binding Visibility, ElementName=SearchBorder}"
                                ToolTip="Close search (Esc)" AutomationProperties.Name="Close search">
                            <fa5:ImageAwesome Icon="Solid_Times" Width="14" Height="14"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </Grid>
                    <mainWindow:ToolTaskbar x:Name="pinnedToolTaskbar" Grid.Column="1" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="PreviousPageButton" Style="{StaticResource BottomBarButton}" Width="30"
                                Click="PreviousPage_Click" ToolTip="Previous page (Page Up)" AutomationProperties.Name="Previous tool page">
                            <fa5:ImageAwesome Icon="Solid_ChevronLeft" Width="12" Height="16"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <TextBlock x:Name="PageStatus" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" FontSize="12" MinWidth="42"
                                   TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Tool page"/>
                        <Button x:Name="NextPageButton" Style="{StaticResource BottomBarButton}" Width="30"
                                Click="NextPage_Click" ToolTip="Next page (Page Down)" AutomationProperties.Name="Next tool page">
                            <fa5:ImageAwesome Icon="Solid_ChevronRight" Width="12" Height="16"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource BottomBarButton}" Click="Settings_Click"
                            ToolTip="Settings" AutomationProperties.Name="Settings">
                        <Rectangle Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="28" Height="28">
                            <Rectangle.OpacityMask><ImageBrush ImageSource="/Resources/Images/LEX_Toolbar_Settings.ico"/></Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>
                    <TextBlock Grid.Column="4" Text="{Binding Source={x:Static misc:AppVersion.MainMenuBuildDateTime}}"
                               FontFamily="{StaticResource AudemusUiFont}" FontWeight="Normal" FontSize="12"
                               LineStackingStrategy="BlockLineHeight" LineHeight="16" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               VerticalAlignment="Center" TextAlignment="Right" Margin="8,0,5,0" ToolTip="Build date and time"/>
                </Grid>
            </Border>
            <Grid Background="Transparent" PreviewMouseWheel="ToolPanel_PreviewMouseWheel">
                <mainWindow:ToolPanel x:Name="mainToolPanel"/>
                <TextBlock x:Name="NoToolsHint" Text="No tools match your search." Visibility="Collapsed"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
