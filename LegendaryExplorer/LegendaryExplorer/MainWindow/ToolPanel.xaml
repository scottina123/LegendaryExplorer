<mainWindow:ToolListControl x:Class="LegendaryExplorer.MainWindow.ToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mainWindow="clr-namespace:LegendaryExplorer.MainWindow">
    <ItemsControl x:Name="ToolList" Margin="8,4" HorizontalContentAlignment="Stretch">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="4" Rows="3"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Padding="0" Margin="10,12" Style="{StaticResource BorderlessButton}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        FocusVisualStyle="{DynamicResource MainWindowFocusVisualStyle}"
                        Click="Button_Click" ToolTip="{Binding DisplayName}" ToolTipService.InitialShowDelay="250"
                        AutomationProperties.Name="{Binding DisplayName}">
                    <Button.ContextMenu><mainWindow:ToolContextMenu/></Button.ContextMenu>
                    <mainWindow:ToolTile IsFlat="True"/>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</mainWindow:ToolListControl>
