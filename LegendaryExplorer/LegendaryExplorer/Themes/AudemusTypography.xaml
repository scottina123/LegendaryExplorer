<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <!-- Typography is deliberately theme-independent. Colour themes consume these
         semantic resources without redefining them. -->
    <FontFamily x:Key="AudemusUiFont">/LegendaryExplorer;component/Resources/Fonts/LexendDeca-Regular.ttf#Lexend Deca</FontFamily>
    <FontFamily x:Key="AudemusDataFont">/LegendaryExplorer;component/Resources/Fonts/LexendDeca-Regular.ttf#Lexend Deca</FontFamily>
    <FontFamily x:Key="AudemusGraphFont">/LegendaryExplorer;component/Resources/Fonts/LexendDeca-Regular.ttf#Lexend Deca</FontFamily>

    <!-- Preserve the script editor's established monospace face independently. -->
    <FontFamily x:Key="AudemusScriptFont">Lucida Console</FontFamily>

    <system:Double x:Key="AudemusUiFontSize">12</system:Double>
    <!-- Preserve the established tool density and sizes. -->
    <system:Double x:Key="AudemusDataFontSize">12</system:Double>
    <system:Double x:Key="AudemusGraphFontSize">14</system:Double>

    <!-- Compatibility aliases retained for existing workstation styles. -->
    <system:Double x:Key="AudemusBodyFontSize">12</system:Double>
    <system:Double x:Key="AudemusMetadataFontSize">10</system:Double>
</ResourceDictionary>
