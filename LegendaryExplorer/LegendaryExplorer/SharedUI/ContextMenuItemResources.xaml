<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A context action keeps its check state and action icon in separate columns.
         System brush keys are supplied by Windows in Light and overridden by both dark themes. -->
    <ControlTemplate x:Key="ContextMenuActionItemTemplate" TargetType="{x:Type MenuItem}">
        <Border x:Name="ItemBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="2"
                SnapsToDevicePixels="True">
            <Grid Background="Transparent" MinHeight="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ContextMenuCheckColumn"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ContextMenuGestureColumn"/>
                    <ColumnDefinition Width="14"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="CheckmarkHost" Grid.Column="0" Width="20"
                        Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path x:Name="Checkmark" Width="10" Height="10" Visibility="Hidden"
                          Fill="{TemplateBinding Foreground}" FlowDirection="LeftToRight"
                          Data="M 0,5.1 L 1.7,5.2 L 3.4,7.1 L 8,0.4 L 9.2,0 L 3.3,10.8 Z"/>
                </Border>

                <ContentPresenter x:Name="ActionIcon" Grid.Column="1" ContentSource="Icon"
                                  Width="16" Height="16" Margin="3,0"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ContentPresenter x:Name="HeaderHost" Grid.Column="2" ContentSource="Header"
                                  RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                <TextBlock x:Name="GestureText" Grid.Column="3" Text="{TemplateBinding InputGestureText}"
                           Foreground="{TemplateBinding Foreground}" Opacity="0.75" Margin="20,0,2,0"
                           VerticalAlignment="Center"/>
                <Path x:Name="SubmenuArrow" Grid.Column="4" Visibility="Collapsed"
                      Fill="{TemplateBinding Foreground}" Opacity="0.75" Data="M 0,0 L 0,7 L 4,3.5 Z"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Right" HorizontalOffset="-2" PopupAnimation="Fade">
                    <Border Background="{DynamicResource MenuPopupBackgroundBrush}"
                            BorderBrush="{DynamicResource MenuPopupBorderBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="2">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
                            <ItemsPresenter Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                            KeyboardNavigation.TabNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="ActionIcon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="CheckmarkHost" Property="Visibility" Value="Visible"/>
            </Trigger>
            <!-- Some existing actions manage IsChecked themselves without IsCheckable. -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckmarkHost" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <Setter TargetName="ActionIcon" Property="Opacity" Value="0.45"/>
                <Setter TargetName="GestureText" Property="Opacity" Value="1"/>
                <Setter TargetName="SubmenuArrow" Property="Opacity" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
