<bases:TrackingNotifyPropertyChangedWindowBase x:Class="LegendaryExplorer.Tools.CoalescedEditor.CoalescedEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        mc:Ignorable="d"
        Icon="pack://application:,,,/Tools/Icons/16x16/CoalescedCompiler_Icon_16.ico"
        Title="Coalesced Editor" Height="700" Width="1100" MinHeight="400" MinWidth="700"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        AllowDrop="True"
        Closed="Root_Closed">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Export to _Folder..." Command="{Binding ExportToFolderCommand}" />
                <Separator />
                <MenuItem Header="_Close Tab" Command="{Binding CloseTabCommand}" InputGestureText="Ctrl+W" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom" Height="23">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- TabControl for open coalesced files (horizontal tabs at top) -->
            <TabControl ItemsSource="{Binding OpenFiles}"
                        SelectedItem="{Binding SelectedFile}"
                        x:Name="FilesTabControl">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TabHeader}" VerticalAlignment="Center" />
                            <Button Content="✕" Margin="6,0,0,0" Padding="2,0"
                                    FontSize="10" VerticalAlignment="Center"
                                    Click="CloseTab_Click" Tag="{Binding}"
                                    BorderThickness="0" Background="Transparent" Cursor="Hand" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" MinWidth="120" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Left: file list within the coalesced -->
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="Files in Coalesced" FontWeight="Bold" Margin="4" />
                                <ListBox ItemsSource="{Binding FileNames}"
                                         SelectedItem="{Binding SelectedFileName}"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                            </DockPanel>
                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                            <!-- Right: text editor for the selected file -->
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedFileName, TargetNullValue='(no file selected)'}"
                                           FontWeight="Bold" Margin="4" />
                                <TextBox Text="{Binding CurrentContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="13"
                                         TextWrapping="NoWrap" />
                            </DockPanel>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            <!-- Startup text shown when no files are open -->
            <TextBlock x:Name="WelcomeText" Text="Drag and drop a Coalesced.bin file here, or use File → Open to get started."
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Gray"
                       Visibility="Collapsed" />
        </Grid>
    </DockPanel>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
    </Window.InputBindings>
</bases:TrackingNotifyPropertyChangedWindowBase>
