<bases:TrackingNotifyPropertyChangedWindowBase x:Class="LegendaryExplorer.Tools.CoalescedEditor.CoalescedEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.CoalescedEditor"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Icon="pack://application:,,,/Tools/Icons/16x16/CoalescedCompiler_Icon_16.ico"
        Title="Coalesced Editor" Height="700" Width="1100" MinHeight="400" MinWidth="700"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        AllowDrop="True"
        Closed="Root_Closed">
    <Window.Resources>
        <local:IndentedPathDisplayConverter x:Key="IndentedPathDisplayConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ContextMenu x:Key="EditorContextMenu">
            <MenuItem Header="Cut" Click="EditorContextMenu_Cut_Click" />
            <MenuItem Header="Copy" Click="EditorContextMenu_Copy_Click" />
            <MenuItem Header="Paste" Click="EditorContextMenu_Paste_Click" />
        </ContextMenu>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Export to _Folder..." Command="{Binding ExportToFolderCommand}" />
                <Separator />
                <MenuItem Header="_Close Tab" Command="{Binding CloseTabCommand}" InputGestureText="Ctrl+W" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Find / Replace..." Command="{Binding ShowFindReplaceCommand}" InputGestureText="Ctrl+F" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom" Height="23">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding SelectedFile.FilePath, TargetNullValue=''}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SelectedFile.FilePath}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedFile.LastSavedDisplay, TargetNullValue=''}" />
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Tab headers only (content area removed; editor is managed in code-behind) -->
            <TabControl Grid.Row="0" ItemsSource="{Binding OpenFiles}"
                        SelectedItem="{Binding SelectedFile}"
                        x:Name="FilesTabControl">
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabControl">
                                    <TabPanel IsItemsHost="True" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Style>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TabHeader}" VerticalAlignment="Center" />
                            <Button Content="✕" Margin="6,0,0,0" Padding="2,0"
                                    FontSize="10" VerticalAlignment="Center"
                                    Click="CloseTab_Click" Tag="{Binding}"
                                    BorderThickness="0" Background="Transparent" Cursor="Hand" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
            <!-- Main content area -->
            <Grid Grid.Row="1" x:Name="ContentArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="120" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Left: file list within the coalesced -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Files in Coalesced" FontWeight="Bold" Margin="4" />
                    <ListBox x:Name="FileListBox"
                             SelectionChanged="FileListBox_SelectionChanged"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="4,2"
                                           FontFamily="Consolas"
                                           xml:space="preserve"
                                           Text="{Binding Converter={StaticResource IndentedPathDisplayConverter}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                <!-- Right: syntax-highlighted text editor -->
                <DockPanel Grid.Column="2">
                    <TextBlock x:Name="SelectedFileHeader" DockPanel.Dock="Top"
                               Text="(no file selected)" FontWeight="Bold" Margin="4" />
                    <Border DockPanel.Dock="Top" Margin="4,0,4,4" Padding="8"
                            BorderBrush="Gray" BorderThickness="1"
                            Visibility="{Binding IsFindReplaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="FindTextBox" Grid.Column="1" Margin="0,0,8,0"
                                         Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="180"
                                         VerticalAlignment="Center"
                                         PreviewKeyDown="FindReplaceTextBox_PreviewKeyDown" />
                                <Button Grid.Column="2" Margin="0,0,8,0" Padding="10,2"
                                        Content="Previous" Command="{Binding FindPreviousCommand}" />
                                <Button Grid.Column="3" Margin="0,0,8,0" Padding="10,2"
                                        Content="Find Next" Command="{Binding FindNextCommand}" />
                                <Button Grid.Column="4" Padding="10,2"
                                        Content="Close" Command="{Binding CloseFindReplaceCommand}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Replace:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="ReplaceTextBox" Grid.Column="1" Margin="0,0,8,0"
                                         Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="180"
                                         VerticalAlignment="Center"
                                         PreviewKeyDown="FindReplaceTextBox_PreviewKeyDown" />
                                <Button Grid.Column="2" Margin="0,0,8,0" Padding="10,2"
                                        Content="Replace" Command="{Binding ReplaceCommand}" />
                                <Button Grid.Column="3" Padding="10,2"
                                        Content="Replace All" Command="{Binding ReplaceAllCommand}" />
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox Content="Match case" Margin="0,0,16,0"
                                          IsChecked="{Binding FindMatchCase}" />
                                <CheckBox Content="Match whole word" Margin="0,0,16,0"
                                          IsChecked="{Binding FindWholeWord}" />
                                <CheckBox Content="Regular expression" Margin="0,0,16,0"
                                          IsChecked="{Binding FindUseRegex}" />
                                <CheckBox Content="Wrap around"
                                          IsChecked="{Binding FindWrapAround}" />
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,0" Text="{Binding SearchStatusText}" />
                        </StackPanel>
                    </Border>
                    <avalonedit:TextEditor x:Name="TextEditor"
                                            FontFamily="Consolas" FontSize="13"
                                            ShowLineNumbers="True"
                                             WordWrap="False"
                                             ContextMenu="{StaticResource EditorContextMenu}" />
                </DockPanel>
            </Grid>
            <!-- Startup text shown when no files are open -->
            <TextBlock x:Name="WelcomeText" Grid.RowSpan="2"
                       Text="Drag and drop a Coalesced.bin file here, or use File → Open to get started."
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Gray"
                       Visibility="Collapsed" />
        </Grid>
    </DockPanel>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding ShowFindReplaceCommand}" />
    </Window.InputBindings>
</bases:TrackingNotifyPropertyChangedWindowBase>
