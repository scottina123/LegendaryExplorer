<UserControl x:Class="LegendaryExplorer.Tools.ConditionalsEditor.GraphView.ConditionGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:LegendaryExplorer.Tools.ConditionalsEditor.GraphView"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <UserControl.Resources>
        <!-- Converters -->
        <local:PlotVarTypeListConverter x:Key="PlotVarTypeListConverter"/>
        <local:ComparisonOperatorListConverter x:Key="ComparisonOperatorListConverter"/>
        <local:LogicalOperatorListConverter x:Key="LogicalOperatorListConverter"/>
        <local:ArithmeticOperatorListConverter x:Key="ArithmeticOperatorListConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <local:TreeLineVisibilityConverter x:Key="TreeLineVisConverter"/>

        <!-- Tree-branch connector wrapping each child item -->
        <DataTemplate x:Key="TreeBranchItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Vertical connector segments -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Top segment (always visible) -->
                    <Rectangle Grid.Row="0" Width="2" HorizontalAlignment="Center"
                               Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                               Opacity="0.5"/>
                    <!-- Bottom segment (hidden for last item) -->
                    <Rectangle Grid.Row="1" Width="2" HorizontalAlignment="Center"
                               Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                               Opacity="0.5">
                        <Rectangle.Visibility>
                            <MultiBinding Converter="{StaticResource TreeLineVisConverter}">
                                <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}"
                                         Path="(ItemsControl.AlternationIndex)"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                                         Path="Items.Count"/>
                            </MultiBinding>
                        </Rectangle.Visibility>
                    </Rectangle>
                </Grid>
                <!-- Horizontal branch tick -->
                <Rectangle Grid.Column="0" Height="2" Width="7"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                           Opacity="0.5"/>
                <!-- Item content (resolved via implicit DataTemplate by type) -->
                <ContentPresenter Grid.Column="1" Content="{Binding}"/>
            </Grid>
        </DataTemplate>

        <!-- Shared styles -->
        <Style x:Key="SmallComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="55"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="SmallTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="ToolTip" Value="Delete"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <!-- Leaf condition template -->
        <DataTemplate DataType="{x:Type local:ConditionLeafViewModel}">
            <Border Margin="4,2" Padding="3,2" CornerRadius="2"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    local:ConditionDragDropBehavior.EnableDrag="True">
                <StackPanel Orientation="Horizontal">
                    <!-- Plot type dropdown -->
                    <ComboBox Style="{StaticResource SmallComboBox}"
                              ItemsSource="{Binding Source={StaticResource PlotVarTypeListConverter}, Converter={StaticResource PlotVarTypeListConverter}}"
                              SelectedItem="{Binding PlotType, Mode=TwoWay}"/>

                    <!-- Plot index -->
                    <TextBlock Text="[" VerticalAlignment="Center" Margin="2,0,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <TextBox Style="{StaticResource SmallTextBox}" MinWidth="50"
                             Text="{Binding PlotIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="]" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>

                    <!-- Plot path display -->
                    <TextBlock Text="{Binding PlotPath}" VerticalAlignment="Center" Margin="4,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               TextWrapping="Wrap"
                               ToolTip="{Binding PlotPath}"/>

                    <!-- Operator dropdown -->
                    <ComboBox Style="{StaticResource SmallComboBox}"
                              ItemsSource="{Binding Source={StaticResource ComparisonOperatorListConverter}, Converter={StaticResource ComparisonOperatorListConverter}}"
                              SelectedItem="{Binding Operator, Mode=TwoWay}"/>

                    <!-- Bool value (dropdown) — shown only for Bool type -->
                    <ComboBox Style="{StaticResource SmallComboBox}" MinWidth="70"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding BoolValue, Mode=TwoWay}"
                              Visibility="{Binding IsBoolType, Converter={StaticResource BoolToVisConverter}}">
                        <ComboBoxItem Content="True" Tag="True" />
                        <ComboBoxItem Content="False" Tag="False" />
                    </ComboBox>

                    <!-- Numeric value — shown only for Int/Float type -->
                    <TextBox Style="{StaticResource SmallTextBox}" MinWidth="70"
                             Text="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsNumericType, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- Delete button -->
                    <Button Style="{StaticResource DeleteButton}" Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Plot reference expression (inline: type dropdown + index + path) -->
        <DataTemplate DataType="{x:Type local:PlotRefExpressionViewModel}">
            <StackPanel Orientation="Horizontal" Margin="2,1">
                <ComboBox Style="{StaticResource SmallComboBox}"
                          ItemsSource="{Binding Source={StaticResource PlotVarTypeListConverter}, Converter={StaticResource PlotVarTypeListConverter}}"
                          SelectedItem="{Binding PlotType, Mode=TwoWay}"/>
                <TextBlock Text="[" VerticalAlignment="Center" Margin="2,0,0,0"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <TextBox Style="{StaticResource SmallTextBox}" MinWidth="50"
                         Text="{Binding PlotIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="]" VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <TextBlock Text="{Binding PlotPath}" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           TextWrapping="Wrap"
                           ToolTip="{Binding PlotPath}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Literal expression (editable text: i5, f3.5, a0, Bool true, etc.) -->
        <DataTemplate DataType="{x:Type local:LiteralExpressionViewModel}">
            <TextBox Style="{StaticResource SmallTextBox}" MinWidth="40"
                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas"/>
        </DataTemplate>

        <!-- Arithmetic expression (group-like: + or * with nested operands) -->
        <DataTemplate DataType="{x:Type local:ArithmeticExpressionViewModel}">
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="2" Padding="4,2" Margin="2,1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <ComboBox Style="{StaticResource SmallComboBox}" MinWidth="55"
                                  ItemsSource="{Binding Source={StaticResource ArithmeticOperatorListConverter}, Converter={StaticResource ArithmeticOperatorListConverter}}"
                                  SelectedItem="{Binding Operator, Mode=TwoWay}"/>
                        <TextBlock Text="Expression" VerticalAlignment="Center" Margin="4,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Operands}" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Comparison condition with expression sides -->
        <DataTemplate DataType="{x:Type local:ConditionComparisonViewModel}">
            <Border Margin="4,2" Padding="4,3" CornerRadius="2"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    local:ConditionDragDropBehavior.EnableDrag="True">
                <StackPanel>
                    <ContentPresenter Content="{Binding LeftSide}" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <ComboBox Style="{StaticResource SmallComboBox}"
                                  ItemsSource="{Binding Source={StaticResource ComparisonOperatorListConverter}, Converter={StaticResource ComparisonOperatorListConverter}}"
                                  SelectedItem="{Binding Operator, Mode=TwoWay}"/>
                        <Button Style="{StaticResource DeleteButton}" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                    <ContentPresenter Content="{Binding RightSide}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Function call condition -->
        <DataTemplate DataType="{x:Type local:ConditionFunctionViewModel}">
            <Border Margin="4,2" Padding="3,2" CornerRadius="2"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    local:ConditionDragDropBehavior.EnableDrag="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Function" VerticalAlignment="Center" Margin="2,0,4,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,2,0"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <TextBox Style="{StaticResource SmallTextBox}" MinWidth="100"
                             Text="{Binding FunctionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Function name"/>
                    <TextBlock Text="Value:" VerticalAlignment="Center" Margin="4,0,2,0"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <TextBox Style="{StaticResource SmallTextBox}" MinWidth="50"
                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Function value"/>
                    <Button Style="{StaticResource DeleteButton}" Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Complex expression fallback (editable inline text) -->
        <DataTemplate DataType="{x:Type local:ConditionComplexLeafViewModel}">
            <Border Margin="4,2" Padding="3,2" CornerRadius="2"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    local:ConditionDragDropBehavior.EnableDrag="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙" VerticalAlignment="Center" Margin="2,0,4,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               ToolTip="Complex expression"/>
                    <TextBox Text="{Binding RawExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" Margin="2,1" Padding="4,2"
                             MinWidth="200"
                             FontFamily="Consolas"
                             AcceptsReturn="False"
                             ToolTip="Complex expression — edit directly or switch to text view"/>
                    <Button Style="{StaticResource DeleteButton}" Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Group template (recursive) -->
        <DataTemplate DataType="{x:Type local:ConditionGroupViewModel}">
            <Border Style="{StaticResource GroupBorder}"
                    local:ConditionDragDropBehavior.EnableDrag="True">
                <StackPanel>
                    <!-- Group header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <!-- Collapse indicator -->
                        <TextBlock Text="▼" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="10"
                                   Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>

                        <!-- Logical operator dropdown -->
                        <ComboBox Style="{StaticResource SmallComboBox}" MinWidth="50"
                                  ItemsSource="{Binding Source={StaticResource LogicalOperatorListConverter}, Converter={StaticResource LogicalOperatorListConverter}}"
                                  SelectedItem="{Binding LogicalOperator, Mode=TwoWay}"/>

                        <TextBlock Text="Group" VerticalAlignment="Center" Margin="4,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>

                        <!-- Add condition button -->
                        <Button Style="{StaticResource LinkButton}" Content="+ Condition"
                                Command="{Binding AddConditionCommand}"/>

                        <!-- Add expression button -->
                        <Button Style="{StaticResource LinkButton}" Content="+ Expression"
                                Command="{Binding AddExpressionCommand}"/>

                        <!-- Add function button -->
                        <Button Style="{StaticResource LinkButton}" Content="+ Function"
                                Command="{Binding AddFunctionCommand}"/>

                        <!-- Add group button -->
                        <Button Style="{StaticResource LinkButton}" Content="+ Group"
                                Command="{Binding AddGroupCommand}"/>

                        <!-- Delete group button -->
                        <Button Style="{StaticResource LinkButton}" Content="✕ Delete Group"
                                Command="{Binding DeleteGroupCommand}"/>
                    </StackPanel>

                    <!-- Children (recursive via tree-branch connectors) -->
                    <ItemsControl ItemsSource="{Binding Children}" Margin="6,0,0,0"
                                  AlternationCount="1000"
                                  ItemTemplate="{StaticResource TreeBranchItemTemplate}"
                                  local:ConditionDragDropBehavior.EnableDrop="True"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Read-only raw text for expressions too complex for the graph editor -->
        <TextBox Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 Margin="4" Padding="4"
                 VerticalScrollBarVisibility="Auto"
                 Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                 Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                 Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- Editable graph for fully-parsed expressions -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Visibility="{Binding IsFullyParsed, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel>
                <!-- Root toolbar -->
                <StackPanel Orientation="Horizontal" Margin="4">
                    <ComboBox Style="{StaticResource SmallComboBox}" MinWidth="50"
                              ItemsSource="{Binding Source={StaticResource LogicalOperatorListConverter}, Converter={StaticResource LogicalOperatorListConverter}}"
                              SelectedItem="{Binding RootGroup.LogicalOperator, Mode=TwoWay}"/>
                    <TextBlock Text="Group" VerticalAlignment="Center" Margin="4,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <Button Style="{StaticResource LinkButton}" Content="+ Condition"
                            Command="{Binding AddConditionCommand}"/>
                    <Button Style="{StaticResource LinkButton}" Content="+ Expression"
                            Command="{Binding AddExpressionCommand}"/>
                    <Button Style="{StaticResource LinkButton}" Content="+ Function"
                            Command="{Binding AddFunctionCommand}"/>
                    <Button Style="{StaticResource LinkButton}" Content="+ Group"
                            Command="{Binding AddGroupCommand}"/>
                </StackPanel>

                <!-- Root children -->
                <ItemsControl ItemsSource="{Binding RootGroup.Children}" Margin="6,0,0,0"
                              AlternationCount="1000"
                              ItemTemplate="{StaticResource TreeBranchItemTemplate}"
                              local:ConditionDragDropBehavior.EnableDrop="True"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
