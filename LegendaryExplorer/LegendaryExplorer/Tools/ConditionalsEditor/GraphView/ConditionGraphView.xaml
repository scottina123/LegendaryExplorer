<UserControl x:Class="LegendaryExplorer.Tools.ConditionalsEditor.GraphView.ConditionGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:LegendaryExplorer.Tools.ConditionalsEditor.GraphView"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <UserControl.Resources>
        <!-- Converters -->
        <local:PlotVarTypeListConverter x:Key="PlotVarTypeListConverter"/>
        <local:ComparisonOperatorListConverter x:Key="ComparisonOperatorListConverter"/>
        <local:LogicalOperatorListConverter x:Key="LogicalOperatorListConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>

        <!-- Shared styles -->
        <Style x:Key="SmallComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="55"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="SmallTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="ToolTip" Value="Delete"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <!-- Leaf condition template -->
        <DataTemplate DataType="{x:Type local:ConditionLeafViewModel}">
            <Border Margin="4,2" Padding="3,2" CornerRadius="2"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    local:ConditionDragDropBehavior.EnableDrag="True">
                <StackPanel Orientation="Horizontal">
                    <!-- Plot type dropdown -->
                    <ComboBox Style="{StaticResource SmallComboBox}"
                              ItemsSource="{Binding Source={StaticResource PlotVarTypeListConverter}, Converter={StaticResource PlotVarTypeListConverter}}"
                              SelectedItem="{Binding PlotType, Mode=TwoWay}"/>

                    <!-- Plot index -->
                    <TextBlock Text="[" VerticalAlignment="Center" Margin="2,0,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <TextBox Style="{StaticResource SmallTextBox}" MinWidth="50"
                             Text="{Binding PlotIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="]" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>

                    <!-- Plot path display -->
                    <TextBlock Text="{Binding PlotPath}" VerticalAlignment="Center" Margin="4,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               TextWrapping="Wrap"
                               ToolTip="{Binding PlotPath}"/>

                    <!-- Operator dropdown -->
                    <ComboBox Style="{StaticResource SmallComboBox}"
                              ItemsSource="{Binding Source={StaticResource ComparisonOperatorListConverter}, Converter={StaticResource ComparisonOperatorListConverter}}"
                              SelectedItem="{Binding Operator, Mode=TwoWay}"/>

                    <!-- Bool value (dropdown) — shown only for Bool type -->
                    <ComboBox Style="{StaticResource SmallComboBox}" MinWidth="70"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding BoolValue, Mode=TwoWay}"
                              Visibility="{Binding IsBoolType, Converter={StaticResource BoolToVisConverter}}">
                        <ComboBoxItem Content="True" Tag="True" />
                        <ComboBoxItem Content="False" Tag="False" />
                    </ComboBox>

                    <!-- Numeric value — shown only for Int/Float type -->
                    <TextBox Style="{StaticResource SmallTextBox}" MinWidth="70"
                             Text="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsNumericType, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- Delete button -->
                    <Button Style="{StaticResource DeleteButton}" Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Group template (recursive) -->
        <DataTemplate DataType="{x:Type local:ConditionGroupViewModel}">
            <Border Style="{StaticResource GroupBorder}"
                    local:ConditionDragDropBehavior.EnableDrag="True">
                <StackPanel>
                    <!-- Group header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <!-- Collapse indicator -->
                        <TextBlock Text="▼" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="10"
                                   Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>

                        <!-- Logical operator dropdown -->
                        <ComboBox Style="{StaticResource SmallComboBox}" MinWidth="50"
                                  ItemsSource="{Binding Source={StaticResource LogicalOperatorListConverter}, Converter={StaticResource LogicalOperatorListConverter}}"
                                  SelectedItem="{Binding LogicalOperator, Mode=TwoWay}"/>

                        <TextBlock Text="Group" VerticalAlignment="Center" Margin="4,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>

                        <!-- Add condition button -->
                        <Button Style="{StaticResource LinkButton}" Content="+ Condition"
                                Command="{Binding AddConditionCommand}"/>

                        <!-- Add group button -->
                        <Button Style="{StaticResource LinkButton}" Content="+ Group"
                                Command="{Binding AddGroupCommand}"/>

                        <!-- Delete group button -->
                        <Button Style="{StaticResource LinkButton}" Content="✕ Delete Group"
                                Command="{Binding DeleteGroupCommand}"/>
                    </StackPanel>

                    <!-- Children (recursive via ContentPresenter auto-template) -->
                    <ItemsControl ItemsSource="{Binding Children}" Margin="16,0,0,0"
                                  local:ConditionDragDropBehavior.EnableDrop="True"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Read-only raw text for expressions too complex for the graph editor -->
        <TextBox Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 Margin="4" Padding="4"
                 VerticalScrollBarVisibility="Auto"
                 Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                 Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                 Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- Editable graph for fully-parsed expressions -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Visibility="{Binding IsFullyParsed, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel>
                <!-- Root toolbar -->
                <StackPanel Orientation="Horizontal" Margin="4">
                    <ComboBox Style="{StaticResource SmallComboBox}" MinWidth="50"
                              ItemsSource="{Binding Source={StaticResource LogicalOperatorListConverter}, Converter={StaticResource LogicalOperatorListConverter}}"
                              SelectedItem="{Binding RootGroup.LogicalOperator, Mode=TwoWay}"/>
                    <TextBlock Text="Group" VerticalAlignment="Center" Margin="4,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <Button Style="{StaticResource LinkButton}" Content="+ Condition"
                            Command="{Binding AddConditionCommand}"/>
                    <Button Style="{StaticResource LinkButton}" Content="+ Group"
                            Command="{Binding AddGroupCommand}"/>
                </StackPanel>

                <!-- Root children -->
                <ItemsControl ItemsSource="{Binding RootGroup.Children}" Margin="4,0"
                              local:ConditionDragDropBehavior.EnableDrop="True"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
