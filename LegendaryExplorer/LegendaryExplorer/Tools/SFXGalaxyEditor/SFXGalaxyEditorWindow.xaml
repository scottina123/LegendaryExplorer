<bases:WPFBase x:Class="LegendaryExplorer.Tools.SFXGalaxyEditor.SFXGalaxyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.SFXGalaxyEditor"
        xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
        xmlns:exportLoaders="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
        xmlns:sharedToolControls="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        AllowDrop="True"
        Title="SFXGalaxy Editor (LE3)" Height="900" Width="1450" MinHeight="650" MinWidth="1050">
    <Window.Resources>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter" />
        <HierarchicalDataTemplate DataType="{x:Type local:SFXGalaxyNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding ExportLabel}">
                <TextBlock Width="20" Text="{Binding Glyph}" Foreground="{Binding KindBrush}" FontWeight="Bold" />
                <TextBlock Text="{Binding DisplayName}" />
                <TextBlock Margin="7,0,0,0" Foreground="Gray" FontSize="10" Text="{Binding KindLabel}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="Back" Command="{Binding BackCommand}" />
    </Window.InputBindings>

    <xctk:BusyIndicator IsBusy="{Binding IsBusy}" BusyContent="{Binding BusyText}">
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File" Padding="4">
                    <MenuItem Header="Open highest-mounted LE3 galaxy map" Click="OpenVanilla_Click" />
                    <MenuItem Header="_Open package…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                    <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                    <MenuItem Header="Save _as…" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                    <Separator />
                    <MenuItem Header="Open file location" Command="{Binding OpenCurrentFileLocationCommand}" />
                    <MenuItem Header="Copy file name" Command="{Binding CopyCurrentFileNameCommand}" />
                    <MenuItem x:Name="Recents_MenuItem" Header="Recent" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="_Create" Padding="4">
                    <MenuItem Header="Cluster" Click="AddCluster_Click" />
                    <MenuItem Header="System (includes its central star)" Click="AddSystem_Click" />
                    <Separator />
                    <MenuItem Header="Planet" Click="AddPlanet_Click" />
                    <MenuItem Header="Asteroid belt" Click="AddAsteroidBelt_Click" />
                    <MenuItem Header="Anomaly / object" Click="AddAnomaly_Click" />
                    <MenuItem Header="Mass relay" Click="AddMassRelay_Click" />
                    <MenuItem Header="Fuel depot" Click="AddFuelDepot_Click" />
                    <MenuItem Header="Reaper" Click="AddReaper_Click" />
                    <MenuItem Header="Scannable planet feature" Click="AddFeature_Click" />
                    <MenuItem Header="War asset" Click="AddWarAsset_Click" />
                    <Separator />
                    <MenuItem Header="Clone selected" Command="{Binding DuplicateCommand}" />
                    <MenuItem Header="Delete selected…" Command="{Binding DeleteCommand}" InputGestureText="Delete" />
                </MenuItem>
                <MenuItem Header="_View" Padding="4">
                    <MenuItem Header="Back" Command="{Binding BackCommand}" InputGestureText="Backspace" />
                    <MenuItem Header="Navigate into selected" Command="{Binding NavigateIntoCommand}" />
                    <MenuItem Header="Show coordinate grid" IsCheckable="True" IsChecked="{Binding ShowCoordinateGrid}" />
                </MenuItem>
            </Menu>

            <StatusBar DockPanel.Dock="Bottom" Height="24">
                <sharedToolControls:StatusBarGameIDIndicator GameType="{Binding Pcc.Game}" Margin="0,-4" />
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusText}" />
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock Foreground="Gray" Text="{Binding Pcc.LastSaved, StringFormat='Last saved at {0}'}" />
                </StatusBarItem>
            </StatusBar>

            <Grid>
                <Grid Visibility="{Binding Pcc, Converter={StaticResource NullVisibilityConverter}, ConverterParameter=Reversed}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="60" VerticalAlignment="Center">
                        <TextBlock Text="SFXGalaxy Editor" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="Open BioD_Nor_203aGalaxyMap.pcc from LE3 to explore and edit its SFXGalaxy hierarchy. This editor only accepts Legendary Edition 3 packages." />
                        <Button Margin="0,20,0,0" Padding="14,8" HorizontalAlignment="Left" Content="Open highest-mounted LE3 galaxy map" Click="OpenVanilla_Click" />
                    </StackPanel>
                    <sharedToolControls:RecentsControl x:Name="RecentsController" Grid.Column="1" Margin="50" />
                </Grid>

                <Grid Margin="5" Visibility="{Binding Pcc, Converter={StaticResource NullVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" MinWidth="220" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="370" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="5,3,5,8">
                            <TextBlock Text="HIERARCHY" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Padding="8,3" Content="Add…" Click="AddForSelection_Click" />
                        </DockPanel>
                        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="5" Padding="7,5"
                                 ToolTip="Search resolved names, descriptions, tags, classes, and export paths"
                                 TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                        <ListBox x:Name="SearchResultsList" Grid.Row="2" Margin="5,0,5,5" MaxHeight="190"
                                 Visibility="Collapsed" MouseDoubleClick="SearchResultsList_MouseDoubleClick"
                                 SelectionChanged="SearchResultsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SFXGalaxyNode}">
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Foreground="Gray" FontSize="10" Text="{Binding Export.InstancedFullPath}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="Gray" FontSize="10" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TreeView x:Name="HierarchyTree" Grid.Row="3" Margin="5" ItemsSource="{Binding HierarchyRoots}"
                                  SelectedItemChanged="HierarchyTree_SelectedItemChanged"
                                  MouseDoubleClick="HierarchyTree_MouseDoubleClick"
                                  MouseRightButtonUp="HierarchyTree_MouseRightButtonUp" />
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="8,2,8,7">
                            <Button DockPanel.Dock="Left" Margin="0,0,8,0" Padding="10,4" Content="‹ Back" Command="{Binding BackCommand}" />
                            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                            <CheckBox DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                      Content="Coordinate grid" IsChecked="{Binding ShowCoordinateGrid}" />
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="8,0,8,4" LastChildFill="True">
                            <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Foreground="Gray" Text="Loaded package:" />
                            <TextBox Padding="4,2" IsReadOnly="True" Text="{Binding Pcc.FilePath, Mode=OneWay}" ToolTip="{Binding Pcc.FilePath}" />
                        </DockPanel>
                        <Border Grid.Row="2" Margin="5" BorderBrush="#335E7B8C" BorderThickness="1" Background="#FF02070D">
                            <Grid>
                                <Viewbox Stretch="Uniform">
                                    <Canvas x:Name="MapCanvas" Width="1024" Height="1024" Background="Transparent"
                                            MouseMove="MapCanvas_MouseMove" MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                                            MouseLeave="MapCanvas_MouseLeave" MouseRightButtonUp="MapCanvas_MouseRightButtonUp" />
                                </Viewbox>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,8"
                                        Background="#D0121B25" BorderBrush="#665FAECF" BorderThickness="1" CornerRadius="3"
                                        IsHitTestVisible="False">
                                    <StackPanel>
                                        <TextBlock Foreground="#FF55C7F4" FontWeight="Bold" Text="{Binding CurrentViewLabel}" />
                                        <TextBlock Margin="0,3,0,0" Foreground="White" FontSize="16" Text="{Binding CurrentNode.DisplayName}" />
                                        <TextBlock Margin="0,3,0,0" Foreground="#FFB3C1CA" Text="{Binding CurrentObjectCountText}" />
                                    </StackPanel>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Padding="8,4"
                                        Background="#C0121B25" IsHitTestVisible="False">
                                    <TextBlock Foreground="#FFB3C1CA" FontSize="10"
                                               Text="Drag objects to reposition • Drag a cluster's red handle to connect • Double-click to enter" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

                    <Grid Grid.Column="4" Margin="5,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="5,3,5,7">
                            <TextBlock Text="PROPERTIES" FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding SelectedNode.DisplayName}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0" Foreground="Gray" Text="{Binding SelectedNode.ExportLabel}" />
                            <TextBlock Margin="0,5,0,0" MaxHeight="72" Foreground="Gray" Text="{Binding SelectedNode.Description}" TextWrapping="Wrap" />
                        </StackPanel>
                        <DockPanel Grid.Row="1" Margin="5,0,5,5">
                            <ComboBox x:Name="EditableExportCombo" ItemsSource="{Binding EditableExports}"
                                      SelectionChanged="EditableExportCombo_SelectionChanged" MinWidth="180" />
                            <Button DockPanel.Dock="Right" Margin="5,0,0,0" Padding="8,3" Content="Enter" Command="{Binding NavigateIntoCommand}" />
                        </DockPanel>
                        <TabControl Grid.Row="2">
                            <TabItem Header="Properties">
                                <exportLoaders:InterpreterExportLoader x:Name="PropertiesInterpreter" HideHexBox="True" />
                            </TabItem>
                            <TabItem Header="Metadata">
                                <exportLoaders:EntryMetadataExportLoader x:Name="MetadataLoader" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>
    </xctk:BusyIndicator>
</bases:WPFBase>
