<Window x:Class="LegendaryExplorer.Tools.SFXGalaxyEditor.SFXGalaxyAddObjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        MinHeight="250"
        MaxHeight="520"
        SizeToContent="Height"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,6"
                   Text="Custom object name:" />
        <TextBox x:Name="ObjectNameTextBox"
                 Grid.Row="1"
                 Margin="0,0,0,12" />

        <StackPanel x:Name="TlkInputPanel"
                    Grid.Row="2"
                    Margin="0,0,0,6">
            <TextBlock Margin="0,0,0,6"
                       Text="DisplayName TLK StringRef ID:" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TlkTextBox"
                         VerticalContentAlignment="Center"
                         TextChanged="TlkTextBox_TextChanged" />
                <Button Grid.Column="1"
                        Width="32"
                        Height="24"
                        Margin="6,0,0,0"
                        Click="FindTlkText_Click"
                        Content="..."
                        ToolTip="Find a StringRef by text in the loaded TLKs" />
            </Grid>
        </StackPanel>

        <StackPanel x:Name="TlkPreviewPanel"
                    Grid.Row="3">
            <TextBlock Margin="0,0,0,4"
                       FontWeight="SemiBold"
                       Text="TLK preview:" />
            <Border MinHeight="48"
                    MaxHeight="160"
                    Padding="6"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TlkPreviewTextBlock"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="80"
                    Margin="0,0,8,0"
                    Click="Add_Click"
                    Content="Add"
                    IsDefault="True" />
            <Button MinWidth="80"
                    Click="Cancel_Click"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
