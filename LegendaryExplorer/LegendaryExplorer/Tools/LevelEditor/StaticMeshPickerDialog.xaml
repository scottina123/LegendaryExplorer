<misc:NotifyPropertyChangedWindowBase
        x:Class="LegendaryExplorer.Tools.LevelEditor.StaticMeshPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Import Static Mesh" Height="640" Width="900"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <xctk:BusyIndicator IsBusy="{Binding IsLoading}" BusyContent="{Binding LoadingText}">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <!-- Left: filterable mesh list -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Static Meshes" FontWeight="Bold" Margin="0,0,0,2"/>
                    <xctk:WatermarkTextBox DockPanel.Dock="Top" x:Name="FilterBox" Watermark="Filter meshes..."
                                           Margin="0,0,0,3" Height="22" VerticalContentAlignment="Center"
                                           TextChanged="FilterBox_TextChanged"/>
                    <ListBox ItemsSource="{Binding FilteredMeshRecords}"
                             SelectedItem="{Binding SelectedMesh}"
                             DisplayMemberPath="MeshName"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
                <!-- Right: source file list (top) + mesh preview (bottom) -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="2*" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Source File" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="1" Text="Select which file to import the mesh from:"
                               TextWrapping="Wrap" Margin="0,0,0,3"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding UsageItems}"
                             SelectedItem="{Binding SelectedUsage}"
                             DisplayMemberPath="DisplayName"/>
                    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                    <exportLoaderControls:MeshRenderer Grid.Row="4" x:Name="MeshPreview"/>
                </Grid>
            </Grid>
            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="Import" Width="70" Command="{Binding OKCommand}" IsDefault="True"/>
                <Button Content="Cancel" Width="70" Margin="6,0,0,0" Click="CancelButton_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </xctk:BusyIndicator>
</misc:NotifyPropertyChangedWindowBase>
