<misc:NotifyPropertyChangedWindowBase
        x:Class="LegendaryExplorer.Tools.LevelEditor.ParticleSystemPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:vfxPreview="clr-namespace:LegendaryExplorer.Tools.AssetDatabase.VFXPreview"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Choose Particle System" Height="700" Width="1100"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1.7*"/>
            </Grid.ColumnDefinitions>
            <TabControl Grid.Column="0" SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem Header="Package Particle Systems">
                    <DockPanel>
                        <xctk:WatermarkTextBox DockPanel.Dock="Top" x:Name="LocalFilterBox" Watermark="Filter particle systems..."
                                               Margin="0,4,0,3" Height="22" VerticalContentAlignment="Center"
                                               TextChanged="LocalFilterBox_TextChanged"/>
                        <ListBox ItemsSource="{Binding FilteredLocalParticleSystems}"
                                 SelectedItem="{Binding SelectedLocalParticleSystem}"
                                 DisplayMemberPath="DisplayName"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Asset Database">
                    <xctk:BusyIndicator IsBusy="{Binding IsLoading}" BusyContent="{Binding LoadingText}">
                        <DockPanel>
                            <xctk:WatermarkTextBox DockPanel.Dock="Top" x:Name="DbFilterBox" Watermark="Filter particle systems..."
                                                   Margin="0,4,0,3" Height="22" VerticalContentAlignment="Center"
                                                   TextChanged="DbFilterBox_TextChanged"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox Grid.Row="0" ItemsSource="{Binding FilteredParticleRecords}"
                                         SelectedItem="{Binding SelectedParticleRecord}"
                                         DisplayMemberPath="PSName"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                                <TextBlock Grid.Row="1" Text="Source File:" FontWeight="Bold" Margin="0,4,0,2"/>
                                <ListBox Grid.Row="2" ItemsSource="{Binding UsageItems}"
                                         SelectedItem="{Binding SelectedUsage}"
                                         DisplayMemberPath="DisplayName"
                                         MaxHeight="120"/>
                            </Grid>
                        </DockPanel>
                    </xctk:BusyIndicator>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Particle System Preview" FontWeight="Bold" VerticalAlignment="Center"/>
                    <CheckBox x:Name="VfxPreviewEnabledCheckBox"
                              Content="Enable preview"
                              IsChecked="True"
                              IsHitTestVisible="False"
                              Focusable="False"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              ToolTip="VFX preview is always enabled in this picker."/>
                </StackPanel>
                <vfxPreview:VfxPreviewControl Grid.Row="1" x:Name="VfxPreview"/>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="70" Command="{Binding OKCommand}" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Margin="6,0,0,0" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</misc:NotifyPropertyChangedWindowBase>
