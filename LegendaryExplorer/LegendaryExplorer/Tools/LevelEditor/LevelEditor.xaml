<misc:NotifyPropertyChangedWindowBase
        x:Class="LegendaryExplorer.Tools.LevelEditor.LevelEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.LevelEditor"
        xmlns:scene3D="clr-namespace:LegendaryExplorer.Tools.LevelEditor.Scene3D"
        xmlns:lightmass="clr-namespace:LegendaryExplorer.Lightmaps.Lightmass"
        xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
        xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sharedToolControls="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
        Icon="pack://application:,,,/Tools/Icons/16x16/LiveLevelEditor_Icon_16.ico"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        AllowDrop="True"
        Loaded="LevelEditor_Loaded"
        Closing="LevelEditor_Closing"
        PreviewKeyDown="LevelEditor_PreviewKeyDown"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Level Editor" Height="800" Width="1000">
    <Window.Resources>
        <ResourceDictionary>
            <!--fork theme adapter for the upstream panels' style keys (aliases the fork theme's brushes; no implicit styles)-->
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="LevelEditorStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:NullEnabledConverter x:Key="NullEnabledConverter"/>
            <converters:BoolEnabledConverter x:Key="BoolEnabledConverter"/>
            <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
            <converters:GameToImageIconConverter x:Key="GameToImageIconConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <sharedUi:BindingProxy x:Key="bindingProxy" Data="{Binding}"/>
            <local:OutlinerGroupStateConverter x:Key="OutlinerGroupStateConverter"/>
            <Style x:Key="LevelFileReferenceMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="Header" Value="{Binding FileName}"/>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate><TextBlock Text="{Binding}"/></DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                <Setter Property="CommandParameter" Value="{Binding FilePath}"/>
            </Style>
            <TextDecorationCollection x:Key="XTextDeco">
                <TextDecoration Location="Underline" PenOffset="2">
                    <TextDecoration.Pen>
                        <Pen Brush="Red" Thickness="3"/>
                    </TextDecoration.Pen>
                </TextDecoration>
            </TextDecorationCollection>
            <TextDecorationCollection x:Key="YTextDeco">
                <TextDecoration Location="Underline" PenOffset="2">
                    <TextDecoration.Pen>
                        <Pen Brush="#00C91D" Thickness="3"/>
                    </TextDecoration.Pen>
                </TextDecoration>
            </TextDecorationCollection>
            <TextDecorationCollection x:Key="ZTextDeco">
                <TextDecoration Location="Underline" PenOffset="2">
                    <TextDecoration.Pen>
                        <Pen Brush="Blue" Thickness="3"/>
                    </TextDecoration.Pen>
                </TextDecoration>
            </TextDecorationCollection>
            <!--outliner group headers: a level (the fork's per-file buttons) and, grouped by category, a category with its viewport eye toggle (upstream)-->
            <DataTemplate x:Key="OutlinerLevelHeader">
                <DockPanel x:Name="FileGroupHeader" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="0,2,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Data.CanEditScene, Source={StaticResource bindingProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ToggleButton Padding="2,0" Margin="2,0"
                                      IsEnabled="{Binding Name.CanChangeReadOnly}"
                                      IsChecked="{Binding Name.IsReadOnly, Mode=TwoWay}" ToolTipService.ShowOnDisabled="True"
                                      AutomationProperties.Name="Read-only package">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                    <Setter Property="ToolTip" Value="Toggle read-only — actors cannot be edited when enabled"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Name.CanChangeReadOnly}" Value="False"><Setter Property="ToolTip" Value="Read-only is unavailable while the file has new or deleted actors to commit"/></DataTrigger></Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <Grid Width="12" Height="12">
                                <fa:ImageAwesome Icon="Solid_Lock" Width="12" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                                 Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <fa:ImageAwesome Icon="Solid_LockOpen" Width="12" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                                 Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Not'}"/>
                            </Grid>
                        </ToggleButton>
                        <Button Content="Commit" Padding="4,0" Margin="2,0"
                                Command="{Binding Data.CommitSingleFileCommand, Source={StaticResource bindingProxy}}"
                                CommandParameter="{Binding Name}" ToolTip="Commit Level Editor changes for this file" FontSize="10"/>
                        <Button Content="Save" Padding="4,0" Margin="2,0"
                                Command="{Binding Data.SaveSingleFileCommand, Source={StaticResource bindingProxy}}"
                                CommandParameter="{Binding Name}" ToolTip="Save this file" FontSize="10"/>
                        <Button Content="X" Padding="4,0" Margin="2,0"
                                Command="{Binding Data.CloseFileCommand, Source={StaticResource bindingProxy}}"
                                CommandParameter="{Binding Name}" ToolTip="Close this file" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Name.FileName, Mode=OneTime}" ToolTip="{Binding Name.FilePath, Mode=OneTime}" FontWeight="Bold" Padding="4,2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="OutlinerCategoryHeader">
                <Border Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Padding="6,3" Margin="0,4,0,1">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Padding="4,0" Margin="6,0,0,0"
                                      IsChecked="{Binding DataContext.Category.IsVisible, RelativeSource={RelativeSource AncestorType=Expander}, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in viewport'}" ToolTip="Show or hide this category in the viewport">
                            <Grid Width="13" Height="13">
                                <fa:ImageAwesome Icon="Regular_Eye" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <fa:ImageAwesome Icon="Regular_EyeSlash" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}"/>
                            </Grid>
                        </ToggleButton>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding AddFilesCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>
    <xctk:BusyIndicator IsBusy="{Binding Path=IsBusy}" BusyContent="{Binding BusyText}">
        <xctk:BusyIndicator.ProgressBarStyle>
            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="IsIndeterminate" Value="{Binding BusyProgressIsIndeterminate}"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="{Binding BusyProgressMaximum}"/>
                <Setter Property="Value" Value="{Binding BusyProgressValue}"/>
                <Setter Property="Height" Value="15"/>
                <Setter Property="Margin" Value="8,0,8,8"/>
            </Style>
        </xctk:BusyIndicator.ProgressBarStyle>
        <DockPanel>
            <Menu DockPanel.Dock="Top" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuItem Header="File" Padding="4" >
                    <MenuItem Header="Open" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" ToolTip="Open a level file (replaces current)"/>
                    <MenuItem Header="Add File..." Command="{Binding AddFilesCommand}" InputGestureText="Ctrl+Shift+O" ToolTip="Add another level file to the scene"/>
                    <MenuItem Header="Load Related Levels" Command="{Binding LoadRelatedLevelsCommand}" ToolTip="Load all related level files for the current level" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <MenuItem Header="Level presets..." Click="LevelPresets_Click" ToolTip="Create, edit, search, or open named groups of level files"/>
                    <MenuItem Header="Save levels as preset..." Click="SaveLevelPreset_Click" IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Save the currently loaded levels as a named preset"/>
                    <Separator />
                    <MenuItem Header="Save All" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+S" ToolTip="Commit and save all open files in-place" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <MenuItem Header="Save Individual File" ItemsSource="{Binding OpenFiles}" IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Commit and save a selected open file">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding FileName}"/>
                                <Setter Property="Command" Value="{Binding Data.SaveSingleFileCommand, Source={StaticResource bindingProxy}}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" ToolTip="Save selected file to another location" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <MenuItem Header="Open file location" ItemsSource="{Binding OpenFiles}" IsEnabled="{Binding HasAnyFileOpen}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource LevelFileReferenceMenuItemStyle}">
                                <Setter Property="Command" Value="{x:Static misc:FileReferenceMenu.OpenFileLocationCommand}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="Copy file name" ItemsSource="{Binding OpenFiles}" IsEnabled="{Binding HasAnyFileOpen}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource LevelFileReferenceMenuItemStyle}">
                                <Setter Property="Command" Value="{x:Static misc:FileReferenceMenu.CopyFileNameCommand}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="Copy file path" ItemsSource="{Binding OpenFiles}" IsEnabled="{Binding HasAnyFileOpen}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource LevelFileReferenceMenuItemStyle}">
                                <Setter Property="Command" Value="{x:Static misc:FileReferenceMenu.CopyFilePathCommand}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Capture Viewport..." Command="{Binding CaptureViewportCommand}" ToolTip="Save the current viewport as a PNG image"/>
                    <Separator />
                    <MenuItem x:Name="Recents_MenuItem" Header="Recent" IsEnabled="false"/>
                </MenuItem>
                <MenuItem Header="Edit" Padding="4">
                    <MenuItem Header="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo, Converter={StaticResource BoolEnabledConverter}}" InputGestureText="Ctrl+Z"/>
                    <MenuItem Header="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo, Converter={StaticResource BoolEnabledConverter}}" InputGestureText="Ctrl+Y"/>
                    <Separator/>
                    <MenuItem Header="Delete Selected Actor" Command="{Binding DeleteActorCommand}" InputGestureText="Delete"/>
                    <MenuItem Header="Duplicate Selected Actor" Command="{Binding DuplicateActorCommand}" ToolTip="Alt-drag a gizmo axis to duplicate while moving"/>
                    <Separator/>
                    <MenuItem Header="Commit Changes" Command="{Binding CommitChangesCommand}" IsEnabled="{Binding IsDirty, Converter={StaticResource BoolEnabledConverter}}"/>
                    <MenuItem Header="Reset Uncommitted Changes..." Click="ResetUncommittedChanges_Click" IsEnabled="{Binding IsDirty}"/>
                </MenuItem>
                <MenuItem Header="View" Padding="4">
                    <MenuItem Header="Focus Selected Actor" Command="{Binding FocusSelectedCommand}" InputGestureText="F"/>
                    <MenuItem Header="Top Down" IsCheckable="True" IsChecked="{Binding IsOrthographicView}" InputGestureText="Numpad 5"/>
                    <MenuItem Header="Local Coordinates" IsCheckable="True" IsChecked="{Binding UseLocalCoordsForWidget}" InputGestureText="L"/>
                    <Separator/>
                    <MenuItem Header="Open Selected Actor in Package Editor" Command="{Binding OpenInPackageEditorCommand}"/>
                </MenuItem>
                <MenuItem Header="Build" Padding="4" IsEnabled="{Binding CanEditScene}">
                    <MenuItem Header="Bake Lighting in Lightmass Baker..." Click="OpenInLightmassBaker_Click"
                              ToolTip="Opens the UDK Lightmass Baker with the open files (read-only ones only cast shadows). It bakes the files as saved on disk."/>
                    <MenuItem Header="Scottina's Lightmass Baker..." Click="ScottinaLightmassBaker_Click" IsEnabled="{Binding HasAnyFileOpen}"
                              ToolTip="Bake static lighting with the Level Editor's own baker (C# or native backend): choose the target levels and every setting, then Create Lightmass"/>
                    <Separator/>
                    <MenuItem Header="Generate Navigation" Command="{Binding GenerateNavigationCommand}"
                              ToolTip="Generate pathing and cover with the settings in the toolbar's Navigation dropdown"/>
                </MenuItem>
                <MenuItem Header="Help" Padding="4">
                    <MenuItem Header="Level Editor Help" Click="Help_Click"/>
                </MenuItem>
            </Menu>
            <WrapPanel DockPanel.Dock="Top" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                <ToolBar ToolBarTray.IsLocked="True" OverflowMode="Never">
                    <Button Content="Edit volume" Click="EditVolume_Click" IsEnabled="{Binding CanEditSelectedVolume}"
                            ToolTip="Edit the selected actor's volume vertices. Commit creates new vanilla Model geometry and updates only this actor."/>
                    <ToggleButton Content="Draw volume" Click="DrawVolume_Click" IsChecked="{Binding IsDrawingVolume, Mode=OneWay}"
                                  IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Draw a volume directly in the loaded level viewport."/>
                    <Button Content="Commit Changes" ToolTip="Commit changes made in Level Editor (does not save the file to disk!)" Command="{Binding CommitChangesCommand}"
                            IsEnabled="{Binding IsDirty, Converter={StaticResource BoolEnabledConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="true">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Save All" Command="{Binding SaveAllCommand}" IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Commit and save all open files in-place (Ctrl+S)"/>
                    <Button x:Name="UndoMenuItem" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl-Z)" IsEnabled="{Binding CanUndo, Converter={StaticResource BoolEnabledConverter}, Mode=OneWay}">
                        <fa:ImageAwesome Icon="Solid_Undo" Width="16" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    </Button>
                    <Button x:Name="RedoMenuItem" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl-Y)" IsEnabled="{Binding CanRedo, Converter={StaticResource BoolEnabledConverter}, Mode=OneWay}">
                        <fa:ImageAwesome Icon="Solid_Redo" Width="16" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    </Button>
                    <xctk:DropDownButton x:Name="HistoryDropDown" Opened="HistoryDropDown_Opened" CloseOnFocusLoss="True" MaxDropDownHeight="640"
                                         ToolTip="History and uncommitted changes: double-click a step to go back or forward to it"
                                         BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                         DropDownContentBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Solid_History" Width="15" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                            <TextBlock Text="{Binding PendingChangeCount, StringFormat=' {0}'}" VerticalAlignment="Center"
                                       Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <xctk:DropDownButton.DropDownContent>
                            <DockPanel Width="560" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                <TextBlock DockPanel.Dock="Top" Text="History" FontWeight="SemiBold" Margin="8,6,8,2"/>
                                <TextBlock DockPanel.Dock="Top" Text="Double-click a step to go back or forward to it." FontSize="11" Margin="8,0,8,4"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding HistoryEntries}" MaxHeight="220" Margin="6,0,6,6"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="2,1" MouseLeftButtonDown="HistoryEntryBorder_MouseLeftButtonDown">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Position}" Width="34" TextAlignment="Right" Margin="0,0,8,0"
                                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <local:ChangesPanel Height="200"/>
                            </DockPanel>
                        </xctk:DropDownButton.DropDownContent>
                    </xctk:DropDownButton>
                    <Separator x:Name="SaveToggle_Separator" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Loc" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="X:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraPositionX_TextBox" Width="72"
                                     Text="{Binding CameraPositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraPositionBoxes_KeyUp"
                                     GotKeyboardFocus="CameraPositionBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraPositionBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="{DynamicResource AudemusDataFont}" FontSize="{DynamicResource AudemusDataFontSize}"
                                     ToolTip="Camera X position"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="X,1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase X position"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="X,-1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease X position"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Y:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraPositionY_TextBox" Width="72"
                                     Text="{Binding CameraPositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraPositionBoxes_KeyUp"
                                     GotKeyboardFocus="CameraPositionBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraPositionBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="{DynamicResource AudemusDataFont}" FontSize="{DynamicResource AudemusDataFontSize}"
                                     ToolTip="Camera Y position"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="Y,1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase Y position"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="Y,-1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease Y position"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Z:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraPositionZ_TextBox" Width="72"
                                     Text="{Binding CameraPositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraPositionBoxes_KeyUp"
                                     GotKeyboardFocus="CameraPositionBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraPositionBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="{DynamicResource AudemusDataFont}" FontSize="{DynamicResource AudemusDataFontSize}"
                                     ToolTip="Camera Z position"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="Z,1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase Z position"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="Z,-1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease Z position"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Step:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <xctk:SingleUpDown Width="70" Value="{Binding CameraPositionStep}" Minimum="0.01"
                                           ButtonSpinnerLocation="Left" FormatString="F2"
                                           VerticalContentAlignment="Center" ToolTip="Camera position adjustment step"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="Rot" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="X:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraRotationX_TextBox" Width="72"
                                     Text="{Binding CameraRotationX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraRotationBoxes_KeyUp"
                                     GotKeyboardFocus="CameraRotationBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraRotationBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="{DynamicResource AudemusDataFont}" FontSize="{DynamicResource AudemusDataFontSize}"
                                     ToolTip="Camera X rotation (Roll, degrees)"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="X,1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase X rotation"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="X,-1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease X rotation"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Y:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraRotationY_TextBox" Width="72"
                                     Text="{Binding CameraRotationY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraRotationBoxes_KeyUp"
                                     GotKeyboardFocus="CameraRotationBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraRotationBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="{DynamicResource AudemusDataFont}" FontSize="{DynamicResource AudemusDataFontSize}"
                                     ToolTip="Camera Y rotation (Pitch, degrees)"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="Y,1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase Y rotation"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="Y,-1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease Y rotation"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Z:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraRotationZ_TextBox" Width="72"
                                     Text="{Binding CameraRotationZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraRotationBoxes_KeyUp"
                                     GotKeyboardFocus="CameraRotationBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraRotationBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="{DynamicResource AudemusDataFont}" FontSize="{DynamicResource AudemusDataFontSize}"
                                     ToolTip="Camera Z rotation (Yaw, degrees)"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="Z,1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase Z rotation"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="Z,-1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease Z rotation"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Step:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <xctk:SingleUpDown Width="70" Value="{Binding CameraRotationStep}" Minimum="0.1"
                                           ButtonSpinnerLocation="Left" FormatString="F2"
                                           VerticalContentAlignment="Center" ToolTip="Camera rotation adjustment step in degrees"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Light Icons:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Radius:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <xctk:SingleUpDown Width="90" Value="{Binding LightIconRadius}" Minimum="0" Increment="100" FormatString="F0" ButtonSpinnerLocation="Left" VerticalContentAlignment="Center" ToolTip="Max distance to show light icons (world units)"/>
                        <TextBlock Text="Max:" Margin="8,0,4,0" VerticalAlignment="Center"/>
                        <xctk:IntegerUpDown Width="60" Value="{Binding MaxLightIcons}" Minimum="0" Maximum="2000" ButtonSpinnerLocation="Left" VerticalContentAlignment="Center" ToolTip="Maximum number of light icons to display"/>
                    </StackPanel>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <xctk:DropDownButton Content="View options" MaxDropDownHeight="620" CloseOnFocusLoss="False"
                                         BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                        <xctk:DropDownButton.DropDownContent>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                            <StackPanel Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                <Button Content="Copy viewport issues" Margin="4,4,4,0" Padding="6,3"
                                        Command="{Binding CopyViewportIssuesCommand}"
                                        ToolTip="Copy viewport errors, exception details, and the current actor or navigation issues to the clipboard."/>
                                <Separator Margin="0,4,0,4"/>
                                <CheckBox Content="Show FPS and location" Margin="4,1,4,5"
                                          IsChecked="{Binding ShowStatsOverlay}"
                                          ToolTip="Show the FPS counter and camera location in the viewport. Clear to hide both."/>
                                <!--the fork's scene options (its SceneControlOptionsControl), bound to this window-->
                                <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" MinWidth="270" Margin="4,0,4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton GroupName="ViewOptionsWidgetMode" Content="Translate" IsChecked="{Binding IsTranslateMode}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,1,12,1" ToolTip="Translate"/>
                                    <RadioButton GroupName="ViewOptionsWidgetMode" Content="Rotate" IsChecked="{Binding IsRotateMode}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,1" ToolTip="Rotate"/>
                                    <RadioButton GroupName="ViewOptionsWidgetMode" Content="Scale" IsChecked="{Binding IsScaleMode}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,1,12,1" ToolTip="Scale"/>
                                    <RadioButton GroupName="ViewOptionsWidgetMode" Content="Uniform Scale" IsChecked="{Binding IsUniformScaleMode}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,1" ToolTip="Uniform Scale"/>
                                    <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,6"/>
                                    <CheckBox Content="Local coords" IsChecked="{Binding UseLocalCoordsForWidget}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,1,12,1"
                                              ToolTip="Use local coordinates for the transform widget"/>
                                    <CheckBox Content="Show collision" IsChecked="{Binding ShowCollision}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,1"
                                              ToolTip="Show collision meshes"/>
                                    <CheckBox Content="Show light icons" IsChecked="{Binding ShowLightIcons}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,1,12,1"
                                              ToolTip="Show selection icons for light actors (the outliner's Lights category)"/>
                                    <CheckBox Content="Volumes / models" IsChecked="{Binding ShowVolumes}" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,1"
                                              ToolTip="Show volumes and actors that reference Model geometry (the outliner's Volumes category). Level Editor remembers this choice."/>
                                    <CheckBox Content="Show volumetric meshes" IsChecked="{Binding ShowVolumetrics}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,1,12,1"
                                              ToolTip="Volumetrics are large spheroids used for fog, dust, etc. Since LEX can't display those effects, they just get in the way."/>
                                    <CheckBox Content="Unlit" IsChecked="{Binding Unlit}" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,1"
                                              ToolTip="Display the scene without lighting (the Lighting menu's Unlit mode)"/>
                                    <Separator Grid.Row="6" Grid.ColumnSpan="2" Margin="0,4,0,6"/>
                                    <CheckBox Content="Red channel" IsChecked="{Binding ShowRedChannel}" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0,1,12,1"/>
                                    <CheckBox Content="Green channel" IsChecked="{Binding ShowGreenChannel}" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,1"/>
                                    <CheckBox Content="Blue channel" IsChecked="{Binding ShowBlueChannel}" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Margin="0,1,12,1"/>
                                    <CheckBox Content="Alpha channel" IsChecked="{Binding ShowAlphaChannel}" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,1"/>
                                    <CheckBox Content="Alpha as black" IsChecked="{Binding SetAlphaToBlack}" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Margin="0,1,12,1"/>
                                    <TextBlock Text="Background color:" Grid.Column="0" Grid.Row="10" VerticalAlignment="Center" Margin="0,2,12,0"/>
                                    <xctk:ColorPicker UsingAlphaChannel="False" SelectedColor="{Binding BackgroundColor}" Grid.Row="10" Grid.Column="1" Margin="0,2,0,0"/>
                                </Grid>

                                <Separator Margin="0,4,0,4"/>
                                <TextBlock Text="Show" FontWeight="SemiBold" Margin="4,0,4,2"/>
                                <CheckBox Content="Hidden actors" Margin="4,1" IsChecked="{Binding ShowHidden}"
                                          ToolTip="Show actors and components that are hidden in game (bHidden, HiddenGame)"/>
                                <CheckBox Content="Collision" Margin="4,1" IsChecked="{Binding ShowCollision}"
                                          ToolTip="Draw collision geometry"/>
                                <CheckBox Content="Selection outline" Margin="4,1" IsChecked="{Binding ShowSelectionOutline}"
                                          ToolTip="Outline the selected actor, as well as tinting it"/>
                                <CheckBox Content="Selected light's reach" Margin="4,1,4,5" IsChecked="{Binding ShowLightReach}"
                                          ToolTip="Tint and outline the meshes the selected light is eligible to light"/>

                                <Separator Margin="0,4,0,4"/>
                                <CheckBox Content="Use in-game mesh shaders" Margin="4,1,4,5"
                                          IsChecked="{Binding UseGameMeshShaders}"
                                          ToolTip="Use the game's shaders for mesh materials. Clear to use the editor's diffuse texture preview. Emitter, decal, and lens flare VFX shaders are unchanged."/>
                                <CheckBox Content="Show selected light wireframe" Margin="4,1"
                                          IsChecked="{Binding ShowSelectedLightWireframe}"
                                          ToolTip="Show the radius or cone for the selected light, and direction arrows for a selected directional light."/>
                                <CheckBox Content="Show emitters" Margin="4,1"
                                          IsChecked="{Binding ShowEmitters}"
                                          ToolTip="Show emitter effects and their selection icons in the viewport. Clear to hide both."/>
                                <CheckBox Content="Show emitter VFX" Margin="18,1,4,5"
                                          IsChecked="{Binding ShowEmitterVfx}"
                                          IsEnabled="{Binding ShowEmitters}"
                                          ToolTip="Render placed emitters with their in-game shaders. Clear to show only their selection icons while Show emitters is enabled."/>
                                <CheckBox Content="Show decal actors" Margin="4,1"
                                          IsChecked="{Binding ShowDecalActors}"
                                          ToolTip="Render DecalActor receiver geometry with its in-game material shaders."/>
                                <CheckBox Content="Show lens flare icons" Margin="4,1"
                                          IsChecked="{Binding ShowLensFlareIcons}"
                                          ToolTip="Show selection icons for lens flare sources. Clear to hide the icons while keeping the flare effects visible."/>
                                <CheckBox Content="Show points of interest" Margin="4,1,4,5"
                                          IsChecked="{Binding ShowPointsOfInterest}">
                                    <CheckBox.ToolTip>
                                        <ToolTip x:Name="PointOfInterestToolTip"
                                                 Content="Show hit-testable markers for SFXPointOfInterest actors."
                                                 Padding="5,3" OverridesDefaultStyle="True">
                                            <ToolTip.Template>
                                                <ControlTemplate TargetType="{x:Type ToolTip}">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToolTip.Template>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <CheckBox Content="Show pathing" Margin="4,1"
                                          IsChecked="{Binding ShowPathing}"
                                          ToolTip="Draw PathNodes and ReachSpec connections for all loaded levels."/>
                                <CheckBox Content="Show cover" Margin="4,1,4,5"
                                          IsChecked="{Binding ShowCover}"
                                          ToolTip="Draw CoverLinks, cover slots, and their facing directions for all loaded levels. Vaultable slots and mantle connections are magenta."/>
                            </StackPanel>
                            </ScrollViewer>
                        </xctk:DropDownButton.DropDownContent>
                    </xctk:DropDownButton>
                    <xctk:DropDownButton Content="Navigation" MaxDropDownHeight="520" CloseOnFocusLoss="False"
                                         BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                         DropDownContentBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                        <xctk:DropDownButton.DropDownContent>
                            <Border Padding="6" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                <StackPanel Width="285">
                                    <TextBlock Text="Automatic pathing and cover" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock Text="Generation is centered on the camera. A radius of 0 scans all loaded collision. Results are appended to the active ME3/LE3 package after confirmation; existing navigation is preserved."
                                               TextWrapping="Wrap" Margin="0,0,0,7"/>
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="105"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Pawn radius" VerticalAlignment="Center"/>
                                    <xctk:SingleUpDown Grid.Row="0" Grid.Column="1" Value="{Binding NavigationPawnRadius}" Minimum="1" Increment="1" FormatString="F0" Margin="2"/>
                                    <TextBlock Grid.Row="1" Text="Pawn half-height (UE3)" VerticalAlignment="Center"/>
                                    <xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding NavigationPawnHeight}" Minimum="1" Increment="4" FormatString="F0" Margin="2"/>
                                    <TextBlock Grid.Row="2" Text="Grid spacing" VerticalAlignment="Center"/>
                                    <xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding NavigationGridSpacing}" Minimum="16" Increment="16" FormatString="F0" Margin="2"/>
                                    <TextBlock Grid.Row="3" Text="Connection distance" VerticalAlignment="Center"/>
                                    <xctk:SingleUpDown Grid.Row="3" Grid.Column="1" Value="{Binding NavigationConnectionDistance}" Minimum="16" Increment="16" FormatString="F0" Margin="2"/>
                                    <TextBlock Grid.Row="4" Text="Maximum slope (deg)" VerticalAlignment="Center"/>
                                    <xctk:SingleUpDown Grid.Row="4" Grid.Column="1" Value="{Binding NavigationMaximumSlope}" Minimum="1" Maximum="89" Increment="1" FormatString="F0" Margin="2"/>
                                    <TextBlock Grid.Row="5" Text="Maximum step up" VerticalAlignment="Center"/>
                                    <xctk:SingleUpDown Grid.Row="5" Grid.Column="1" Value="{Binding NavigationMaximumStepUp}" Minimum="0" Increment="1" FormatString="F0" Margin="2"/>
                                    <TextBlock Grid.Row="6" Text="Maximum step down" VerticalAlignment="Center"/>
                                    <xctk:SingleUpDown Grid.Row="6" Grid.Column="1" Value="{Binding NavigationMaximumStepDown}" Minimum="0" Increment="1" FormatString="F0" Margin="2"/>
                                    <TextBlock Grid.Row="7" Text="Maximum safe drop" VerticalAlignment="Center"/>
                                    <xctk:SingleUpDown Grid.Row="7" Grid.Column="1" Value="{Binding NavigationMaximumDrop}" Minimum="0" Increment="4" FormatString="F0" Margin="2"/>
                                    <TextBlock Grid.Row="8" Text="Generation radius" VerticalAlignment="Center"/>
                                    <xctk:SingleUpDown Grid.Row="8" Grid.Column="1" Value="{Binding NavigationGenerationRadius}" Minimum="0" Increment="500" FormatString="F0" Margin="2"/>
                                    </Grid>
                                    <CheckBox Content="Generate cover links and slots" IsChecked="{Binding GenerateCover}" Margin="0,6,0,6"/>
                                    <Button Content="Generate navigation" Command="{Binding GenerateNavigationCommand}" Padding="8,4"
                                            ToolTip="Build collision, detect walkable space and cover, then serialize PathNodes, ReachSpecs, CoverLinks, and CoverSlotMarkers."/>
                                </StackPanel>
                            </Border>
                        </xctk:DropDownButton.DropDownContent>
                    </xctk:DropDownButton>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <ToggleButton Content="Top Down" ToolTip="Toggle top-down orthographic view (Numpad 5)" IsChecked="{Binding IsOrthographicView}"/>
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsOrthographicView, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Hide everything above this height, to see beneath a level's ceilings. Starts at the camera's height when Top Down is turned on.">
                        <TextBlock Text="Clip height" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <xctk:SingleUpDown Width="90" Value="{Binding TopDownClipHeight}" Increment="100" FormatString="F0" ButtonSpinnerLocation="Left"
                                           VerticalContentAlignment="Center" AutomationProperties.Name="Top-down clip height"/>
                    </StackPanel>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <CheckBox Content="Z Cutoff" VerticalAlignment="Center" Margin="2,0,4,0"
                              IsChecked="{Binding ZCutoffEnabled}"
                              ToolTip="Hide all actors at or above the specified Z value"/>
                    <xctk:SingleUpDown Width="90" Value="{Binding ZCutoff}" Increment="100"
                                       ButtonSpinnerLocation="Left" FormatString="F0"
                                       VerticalContentAlignment="Center"
                                       IsEnabled="{Binding ZCutoffEnabled}"
                                       ToolTip="Z position cutoff — actors at or above this height are hidden"/>
                </ToolBar>
                <ToolBar ToolBarTray.IsLocked="True" OverflowMode="Never">
                    <!--upstream: gizmo mode, local axes, viewport lighting and camera speed-->
                    <RadioButton GroupName="ToolbarWidgetMode" Content="Move" IsChecked="{Binding IsTranslateMode}" ToolTip="Translate the selected actor" VerticalAlignment="Center" Margin="2,0"/>
                    <RadioButton GroupName="ToolbarWidgetMode" Content="Rotate" IsChecked="{Binding IsRotateMode}" ToolTip="Rotate the selected actor" VerticalAlignment="Center" Margin="2,0"/>
                    <RadioButton GroupName="ToolbarWidgetMode" Content="Scale" IsChecked="{Binding IsScaleMode}" ToolTip="Scale the selected actor" VerticalAlignment="Center" Margin="2,0"/>
                    <RadioButton GroupName="ToolbarWidgetMode" Content="Uniform" IsChecked="{Binding IsUniformScaleMode}" ToolTip="Scale uniformly" VerticalAlignment="Center" Margin="2,0"/>
                    <ToggleButton Content="Local" IsChecked="{Binding UseLocalCoordsForWidget}" ToolTip="Use local transform axes (L). Off uses world axes." Margin="4,0,0,0"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <MenuItem x:Name="LightingMenu" Header="{Binding LightingMenuHeader}" Padding="6,2" ToolTip="Choose viewport lighting and isolate lightmaps or runtime lighting.">
                            <MenuItem x:Name="LevelLightingMenuItem" Header="Level lighting" IsChecked="{Binding IsLevelLighting, Mode=OneWay}" Command="{Binding SetLightingModeCommand}" CommandParameter="{x:Static scene3D:ViewportLightingMode.Level}" StaysOpenOnClick="True" ToolTip="Use the level's lightmaps and runtime lighting. Unsupported materials use neutral lighting."/>
                            <MenuItem x:Name="PreviewLightingMenuItem" Header="Preview lighting" IsChecked="{Binding IsPreviewLighting, Mode=OneWay}" Command="{Binding SetLightingModeCommand}" CommandParameter="{x:Static scene3D:ViewportLightingMode.Preview}" StaysOpenOnClick="True" ToolTip="Preview direct lighting and approximate shadows from the current level lights and geometry, without sampling existing lightmaps and shadowmaps. Eligibility follows the selected assignment policy. Does not include baked bounced lighting. Unsupported materials use neutral lighting."/>
                            <MenuItem Header="Preview / bake assignments">
                                <MenuItem Header="Preserve existing assignments" IsChecked="{Binding PreserveAssignments, Mode=OneWay}" Command="{Binding SetAssignmentPolicyCommand}" CommandParameter="{x:Static lightmass:LightAssignmentPolicy.PreserveExistingAssignments}" StaysOpenOnClick="True"/>
                                <MenuItem Header="Recompute assignments" IsChecked="{Binding RecomputeAssignments, Mode=OneWay}" Command="{Binding SetAssignmentPolicyCommand}" CommandParameter="{x:Static lightmass:LightAssignmentPolicy.RecomputeAssignments}" StaysOpenOnClick="True"/>
                            </MenuItem>
                            <MenuItem x:Name="NeutralLightingMenuItem" Header="Neutral lighting" IsChecked="{Binding IsNeutralLighting, Mode=OneWay}" Command="{Binding SetLightingModeCommand}" CommandParameter="{x:Static scene3D:ViewportLightingMode.Neutral}" StaysOpenOnClick="True" ToolTip="Use a neutral light to inspect materials and geometry, independent of the level's lights and lightmaps."/>
                            <MenuItem x:Name="UnlitMenuItem" Header="Unlit" IsChecked="{Binding IsUnlit, Mode=OneWay}" Command="{Binding SetLightingModeCommand}" CommandParameter="{x:Static scene3D:ViewportLightingMode.Unlit}" StaysOpenOnClick="True" ToolTip="Show material colors without lighting."/>
                            <Separator/>
                            <MenuItem x:Name="DynamicLightingMenuItem" Header="Runtime lighting" IsCheckable="True" IsChecked="{Binding UseDynamicLighting}" IsEnabled="{Binding IsLevelLighting}" StaysOpenOnClick="True" ToolTip="Include lighting evaluated at runtime, including lights with precomputed shadowmaps. Lights baked into a lightmap remain part of that lightmap."/>
                            <MenuItem x:Name="LightMapsMenuItem" Header="Lightmaps" IsCheckable="True" IsChecked="{Binding UseLightMaps}" IsEnabled="{Binding IsLevelLighting}" StaysOpenOnClick="True" ToolTip="Include baked texture and vertex lighting. Turn off Runtime lighting to view lightmaps alone."/>
                        </MenuItem>
                    </Menu>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="How fast the camera flies, in units per second, with W A S D Q E. The scroll wheel and left or middle dragging scale with it. Hold Shift with the keys or the wheel to go ten times faster.">
                        <TextBlock Text="Camera speed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <xctk:SingleUpDown Width="80" Value="{Binding CameraSpeed}" Minimum="1" DefaultValue="500" DisplayDefaultValueOnEmptyText="True" Increment="250" FormatString="F0"
                                           ButtonSpinnerLocation="Left" VerticalContentAlignment="Center" AutomationProperties.Name="Camera speed"/>
                    </StackPanel>
                </ToolBar>
            </WrapPanel>

            <Border DockPanel.Dock="Top" Background="#351519" BorderBrush="#F05252" BorderThickness="0,0,0,2" Padding="20,16" Margin="0,0,0,4"
                    Visibility="{Binding IsBakePreview, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="BAKED LIGHTING PREVIEW" Foreground="#FF6464" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>

            <StatusBar Height="23" DockPanel.Dock="Bottom">
                <sharedToolControls:StatusBarGameIDIndicator Visibility="{Binding HasAnyFileOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 GameType="{Binding Game}" Margin="0,-4"/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusBar_LeftMostText"/>
                </StatusBarItem>
                <sharedToolControls:PackageMountWarning Package="{Binding Pcc}" />
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <!--the selected actor, and the file it's in-->
                        <TextBlock Margin="0,0,12,0" ToolTip="{Binding SelectedActor.OwningFile.FilePath}"><Run Text="{Binding SelectedActor.ActorName, Mode=OneWay, TargetNullValue=''}"/><Run Text="{Binding SelectedActor.OwningFileName, Mode=OneWay, StringFormat=' ({0})', TargetNullValue=''}"/></TextBlock>
                        <TextBlock Text="{Binding CurrentModeName}" Margin="0,0,12,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Visibility="{Binding HasAnyFileOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Name="StatusBar_RightSide_LastSaved" Text="{Binding Pcc.LastSaved, StringFormat='Last saved at {0}'}" Foreground="Gray"
                                   Visibility="{Binding Pcc, Converter={StaticResource NullVisibilityConverter}}"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="300"/>
                </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="80" Width="300"/>
                    <ColumnDefinition MinWidth="5" MaxWidth="5"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition x:Name="DetailsSplitterColumn" MinWidth="5" MaxWidth="5"/>
                    <ColumnDefinition x:Name="DetailsColumn" MinWidth="80" Width="340"/>
                </Grid.ColumnDefinitions>


                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TabControl Grid.Column="0" Padding="0">
                    <TabItem Header="World Outliner" IsSelected="True">
                <DockPanel>
                    <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0" Height="24">
                        <xctk:WatermarkTextBox Watermark="UIndex" Name="Goto_TextBox" Width="70" KeyUp="Goto_TextBox_KeyUp" IsEnabled="{Binding HasAnyFileOpen}"  VerticalContentAlignment="Center"/>
                        <Button Content="Goto #" Click="GotoButton_Clicked" IsEnabled="{Binding HasAnyFileOpen}" Style="{StaticResource {x:Type Button}}" Padding="7,0"/>
                        <Button Content="Add File..." Command="{Binding AddFilesCommand}" Style="{StaticResource {x:Type Button}}" Padding="7,0" Margin="4,0,0,0"
                                ToolTip="Add another level file to the scene (Ctrl+Shift+O)"/>
                    </StackPanel>
                    <xctk:WatermarkTextBox DockPanel.Dock="Top" Watermark="Search actors..." Name="ActorFilter_TextBox" Margin="5,2,5,2" Height="22"
                                           TextChanged="ActorFilter_TextBox_TextChanged" IsEnabled="{Binding HasAnyFileOpen}" VerticalContentAlignment="Center"
                                           ToolTip="Search actor names, tags, classes, subtitles, categories, or #UIndex"/>
                    <DockPanel DockPanel.Dock="Top" Margin="5,0,5,2">
                        <Button DockPanel.Dock="Right" Content="Collapse all" Click="CollapseOutlinerGroups_Clicked" IsEnabled="{Binding HasAnyFileOpen}" Padding="5,0"
                                ToolTip="Collapse all outliner categories and level groups"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Group by" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <RadioButton GroupName="OutlinerGrouping" Content="Level" IsChecked="{Binding GroupActorsByLevel}" Margin="0,0,6,0" VerticalAlignment="Center"
                                         ToolTip="Group actors by their level package"/>
                            <RadioButton GroupName="OutlinerGrouping" Content="Category" IsChecked="{Binding GroupActorsByCategory}" VerticalAlignment="Center"
                                         ToolTip="Group actors by category across all loaded levels. Each category's eye shows or hides it in the viewport (volumes, lights, effects helpers and others start hidden)."/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Actors.BindableCount, StringFormat='{}{0} actors loaded'}" Margin="5,2" FontSize="11"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding TextBelowActors}" TextWrapping="Wrap"/>

                    <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding ActorsView}" Name="MeshExportsList" SelectedItem="{Binding SelectedActor}" HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.CanContentScroll="True"
                             IsVisibleChanged="MeshExportsList_IsVisibleChanged"
                             MouseDoubleClick="MeshExportsList_MouseDoubleClick"
                             ContextMenuOpening="MeshExportsList_ContextMenuOpening">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander Style="{StaticResource OutlinerGroupExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                              Header="{TemplateBinding Content}" HeaderTemplate="{TemplateBinding ContentTemplate}">
                                                        <Expander.DataContext>
                                                            <MultiBinding Converter="{StaticResource OutlinerGroupStateConverter}" Mode="OneWay">
                                                                <Binding Path="Content" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                                <Binding Path="Data" Source="{StaticResource bindingProxy}"/>
                                                            </MultiBinding>
                                                        </Expander.DataContext>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource OutlinerCategoryHeader}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBottomLevel}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OutlinerLevelHeader}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type local:ActorProxy}">
                                <Grid HorizontalAlignment="Stretch" Margin="0" x:Name="ExportContainer" Background="Transparent" ToolTip="{Binding CoverageToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="0,0,4,0" Padding="2" VerticalAlignment="Center"
                                            Command="{Binding Data.OpenActorInPackageEditorCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding}"
                                            ToolTip="Open in Package Editor" AutomationProperties.Name="Open in Package Editor"
                                            Background="Transparent" BorderThickness="0" Focusable="False">
                                        <Image Source="{StaticResource iconPackageEditor16}" Width="14" Height="14">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                            <Setter Property="Opacity" Value="0.35"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Button>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IndexLabel}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" ToolTip="Export index"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DisplayText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DisplaySubtitle}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplaySubtitle}"
                                               Visibility="{Binding DisplaySubtitle, Converter={StaticResource NullVisibilityConverter}}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="true">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" TargetName="ExportContainer"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPendingChange}" Value="true">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" TargetName="ExportContainer"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>
                    </TabItem>
                    <TabItem Header="Place Actors" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                        <local:PlaceActorsPanel/>
                    </TabItem>
                    <TabItem Header="Terrain" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                        <local:TerrainPanel/>
                    </TabItem>
                    <TabItem Header="Problems">
                        <local:ProblemsPanel/>
                    </TabItem>
                </TabControl>

                <scene3D:SceneRenderControl Grid.Column="2" x:Name="SceneViewer" MaximumFramesPerSecond="60"
                                            PreviewMouseDown="SceneViewer_PreviewMouseDownForMaterialPicking"
                                            PreviewMouseMove="VolumeDrawing_MouseMove"
                                            PreviewMouseUp="SceneViewer_PreviewMouseUpForMaterialPicking" />
                <Border Grid.Column="2" Panel.ZIndex="10" VerticalAlignment="Top" Margin="8" Padding="8" CornerRadius="4"
                        HorizontalAlignment="Left" Width="760" MaxWidth="{Binding ActualWidth, ElementName=SceneViewer}"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        BorderBrush="DeepSkyBlue" BorderThickness="1"
                        Visibility="{Binding IsDrawingVolume, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding VolumeDrawingTitle}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding VolumeDrawTarget, StringFormat='Target: {0}'}" TextTrimming="CharacterEllipsis"/>
                        <Expander Header="Drawing options" IsExpanded="True">
                        <StackPanel>
                        <StackPanel Visibility="{Binding IsEditingVolume, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}">
                        <TextBlock Text="Left-click corners; drag to edit. Right-drag / WASD navigates. Drag the yellow handle to extrude." TextWrapping="Wrap" Margin="0,3"/>
                        <WrapPanel Margin="0,3">
                            <TextBox Text="{Binding VolumeDrawing.Name, UpdateSourceTrigger=PropertyChanged}" Width="135" Margin="0,0,6,0" ToolTip="New volume name"/>
                            <ComboBox SelectedIndex="{Binding VolumeDrawing.KindIndex}" Width="135" Margin="0,0,6,0">
                                <ComboBoxItem Content="Blocking volume"/><ComboBoxItem Content="Trigger volume"/>
                            </ComboBox>
                            <ComboBox SelectedIndex="{Binding VolumeDrawing.PlaneIndex}" Width="95" ToolTip="Work plane">
                                <ComboBoxItem Content="XY floor"/><ComboBoxItem Content="XZ wall"/><ComboBoxItem Content="YZ wall"/><ComboBoxItem Content="Surface"/>
                            </ComboBox>
                        </WrapPanel>
                        <WrapPanel Margin="0,3">
                            <TextBlock Text="Origin X" VerticalAlignment="Center"/>
                            <xctk:SingleUpDown Value="{Binding VolumeDrawing.X}" Width="85" Increment="25" Margin="3,0,6,0"/>
                            <TextBlock Text="Y" VerticalAlignment="Center"/>
                            <xctk:SingleUpDown Value="{Binding VolumeDrawing.Y}" Width="85" Increment="25" Margin="3,0,6,0"/>
                            <TextBlock Text="Z" VerticalAlignment="Center"/>
                            <xctk:SingleUpDown Value="{Binding VolumeDrawing.Z}" Width="85" Increment="25" Margin="3,0,6,0"/>
                            <Button Content="Pick surface" Click="PickVolumeSurface_Click" Padding="4,2" Margin="0,0,4,0"/>
                            <Button Content="At selection" Click="VolumeAtSelection_Click" Padding="4,2"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,3">
                            <TextBlock Text="Pitch" VerticalAlignment="Center"/>
                            <xctk:SingleUpDown Value="{Binding VolumeDrawing.Pitch}" Width="65" Increment="5" Margin="3,0,6,0"/>
                            <TextBlock Text="Yaw" VerticalAlignment="Center"/>
                            <xctk:SingleUpDown Value="{Binding VolumeDrawing.Yaw}" Width="65" Increment="5" Margin="3,0,6,0"/>
                            <TextBlock Text="Roll" VerticalAlignment="Center"/>
                            <xctk:SingleUpDown Value="{Binding VolumeDrawing.Roll}" Width="65" Increment="5" Margin="3,0,6,0"/>
                            <TextBlock Text="Height" VerticalAlignment="Center"/>
                            <xctk:SingleUpDown Value="{Binding VolumeDrawing.Height}" Width="80" Increment="25" Minimum="0.1" Margin="3,0,6,0"/>
                            <TextBlock Text="Grid" VerticalAlignment="Center"/>
                            <xctk:SingleUpDown Value="{Binding VolumeDrawing.Step}" Width="65" Increment="5" Minimum="0.01" Maximum="100000" Margin="3,0,6,0"/>
                        </WrapPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsEditingVolume, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Select and drag vertex markers in the loaded level. Convex pieces stay closed. Cancel leaves the existing actor and shared geometry untouched." TextWrapping="Wrap" Margin="0,3"/>
                            <WrapPanel Margin="0,3" IsEnabled="{Binding HasSelectedVolumeVertex}">
                                <TextBlock Text="Vertex X" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown Value="{Binding VolumeVertexX}" Width="95" Increment="10" Margin="3,0,6,0"/>
                                <TextBlock Text="Y" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown Value="{Binding VolumeVertexY}" Width="95" Increment="10" Margin="3,0,6,0"/>
                                <TextBlock Text="Z" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown Value="{Binding VolumeVertexZ}" Width="95" Increment="10" Margin="3,0,6,0"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,3">
                                <TextBlock Text="Drag along" VerticalAlignment="Center"/>
                                <ComboBox SelectedIndex="{Binding VolumeEditAxis}" Width="115" Margin="4,0,10,0">
                                    <ComboBoxItem Content="View plane"/><ComboBoxItem Content="World X"/><ComboBoxItem Content="World Y"/><ComboBoxItem Content="World Z"/>
                                </ComboBox>
                                <TextBlock Text="Snap step" VerticalAlignment="Center"/>
                                <xctk:SingleUpDown Value="{Binding VolumeDrawing.Step}" Width="70" Increment="5" Minimum="0.01" Maximum="100000" Margin="4,0,0,0"/>
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel Margin="0,3">
                            <CheckBox Content="Snap" IsChecked="{Binding VolumeDrawing.Snap}" Margin="0,0,8,0"/>
                            <CheckBox Content="X-ray draft" IsChecked="{Binding VolumeDrawing.Xray}" Margin="0,0,8,0"/>
                            <Button Content="{Binding VolumeUndoLabel}" Click="UndoVolumeCorner_Click" Padding="4,2" Margin="0,0,6,0"/>
                            <Button Content="{Binding VolumeCommitLabel}" Click="FinishVolumeDrawing_Click" IsEnabled="{Binding CanFinishVolume}" Padding="4,2" Margin="0,0,6,0"/>
                            <Button Content="Cancel" Click="CancelVolumeDrawing_Click" Padding="4,2"/>
                        </WrapPanel>
                        </StackPanel>
                        </Expander>
                        <TextBlock Text="{Binding VolumeDrawStatus}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="4" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*" MinHeight="180"/>
                    </Grid.RowDefinitions>
                    <ComboBox Grid.Row="0" Margin="2,2,2,0" Height="24"
                              ItemsSource="{Binding PropertiesExportList}"
                              SelectedItem="{Binding SelectedPropertiesExport}"
                              IsEnabled="{Binding SelectedActor, Converter={StaticResource NullEnabledConverter}}"
                              ToolTip="Select the actor or one of its child objects to inspect and edit">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{DynamicResource AudemusDataFont}" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}: {1} ({2})">
                                            <Binding Path="UIndex"/>
                                            <Binding Path="ObjectName.Instanced"/>
                                            <Binding Path="ClassName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TabControl Grid.Row="1" x:Name="PropertiesTabControl">
                        <TabItem Header="Properties">
                            <exportLoaderControls:InterpreterExportLoader x:Name="LevelEditorInterpreter" HideHexBox="True"
                                                                          ReloadPropertyDataAfterWrite="False"/>
                        </TabItem>
                        <TabItem Header="Metadata">
                            <exportLoaderControls:EntryMetadataExportLoader x:Name="LevelEditorMetadata"/>
                        </TabItem>
                    </TabControl>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                    <!--upstream: what the selected actor is, and why it's drawn as it is-->
                    <StackPanel Margin="7,5,7,0" Visibility="{Binding SelectedActor, Converter={StaticResource NullVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedActor.CoverageLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedActor.CoverageReason}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        <TextBlock Text="Read-only package" Foreground="{StaticResource EditorDirty}" Margin="0,3,0,0"
                                   Visibility="{Binding SelectedActor.OwningFile.IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                    </StackPanel>
                    <GroupBox Header="Camera" Margin="5,5,5,0" BorderThickness="2" Padding="5"
                              IsEnabled="{Binding HasAnyFileOpen}"
                              Visibility="Collapsed">
                        <StackPanel>
                            <Grid HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="↖" Width="32" Height="32" Margin="2"
                                        Tag="1,-1" Click="CameraMoveXYButton_Click" ToolTip="Move forward and left"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="↑" Width="32" Height="32" Margin="2"
                                        Tag="1,0" Click="CameraMoveXYButton_Click" ToolTip="Move forward"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="↗" Width="32" Height="32" Margin="2"
                                        Tag="1,1" Click="CameraMoveXYButton_Click" ToolTip="Move forward and right"/>

                                <Button Grid.Row="1" Grid.Column="0" Content="←" Width="32" Height="32" Margin="2"
                                        Tag="0,-1" Click="CameraMoveXYButton_Click" ToolTip="Move left"/>
                                <Border Grid.Row="1" Grid.Column="1" Width="32" Height="32" Margin="2" Background="Transparent"
                                        Cursor="SizeAll"
                                        MouseLeftButtonDown="CameraRotatePad_MouseLeftButtonDown"
                                        MouseMove="CameraRotatePad_MouseMove"
                                        MouseLeftButtonUp="CameraRotatePad_MouseLeftButtonUp">
                                    <Ellipse Width="16" Height="16"
                                             Stroke="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" StrokeThickness="3"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Row="1" Grid.Column="2" Content="→" Width="32" Height="32" Margin="2"
                                        Tag="0,1" Click="CameraMoveXYButton_Click" ToolTip="Move right"/>

                                <Button Grid.Row="2" Grid.Column="0" Content="↙" Width="32" Height="32" Margin="2"
                                        Tag="-1,-1" Click="CameraMoveXYButton_Click" ToolTip="Move back and left"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="↓" Width="32" Height="32" Margin="2"
                                        Tag="-1,0" Click="CameraMoveXYButton_Click" ToolTip="Move back"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="↘" Width="32" Height="32" Margin="2"
                                        Tag="-1,1" Click="CameraMoveXYButton_Click" ToolTip="Move back and right"/>
                            </Grid>

                            <StackPanel HorizontalAlignment="Left">
                                <Button Content="[ Z ↑ ]" Width="72" Margin="0,0,0,4" FontFamily="{DynamicResource AudemusDataFont}" FontSize="{DynamicResource AudemusDataFontSize}"
                                        Tag="1" Click="CameraMoveZButton_Click" ToolTip="Move up"/>
                                <Border Width="72" Padding="6,2" BorderThickness="1" HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                    <TextBlock Text="[ 0 ]" HorizontalAlignment="Center" FontFamily="{DynamicResource AudemusDataFont}" FontSize="{DynamicResource AudemusDataFontSize}"/>
                                </Border>
                                <Button Content="[ Z ↓ ]" Width="72" Margin="0,4,0,0" FontFamily="{DynamicResource AudemusDataFont}" FontSize="{DynamicResource AudemusDataFontSize}"
                                        Tag="-1" Click="CameraMoveZButton_Click" ToolTip="Move down"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Snap" Margin="5,5,5,0" BorderThickness="2" Padding="5"
                              DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="Translate" VerticalAlignment="Center"
                                      IsChecked="{Binding TranslateSnapEnabled}" Margin="0,2,0,2"/>
                            <xctk:SingleUpDown Grid.Row="0" Grid.Column="1" Value="{Binding TranslateSnapValue}"
                                               Minimum="0.001" FormatString="F1" ButtonSpinnerLocation="Left"
                                               ToolTip="Snap step in world units" Margin="5,2,0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="units" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" Content="Rotation" VerticalAlignment="Center"
                                      IsChecked="{Binding RotateSnapEnabled}" Margin="0,2,0,2"/>
                            <xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RotateSnapValue}"
                                               Minimum="0.1" Maximum="180" FormatString="F1" ButtonSpinnerLocation="Left"
                                               ToolTip="Snap step in degrees" Margin="5,2,0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="°" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <CheckBox Grid.Row="2" Grid.Column="0" Content="Scale" VerticalAlignment="Center"
                                      IsChecked="{Binding ScaleSnapEnabled}" Margin="0,2,0,2"/>
                            <xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ScaleSnapValue}"
                                               Minimum="0.01" FormatString="F1" ButtonSpinnerLocation="Left"
                                               ToolTip="Snap step as percent (10 = 0.1 per step)" Margin="5,2,0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                    </GroupBox>
                    <WrapPanel x:Name="wrapPanel" IsEnabled="{Binding ., Converter={StaticResource NullEnabledConverter}}" DataContext="{Binding SelectedActor}">
                    <GroupBox Header="Light" Margin="5,0,5,5" BorderThickness="2" Padding="5"
                              Visibility="{Binding HasLightSettings, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasLightRadius, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text=" Radius:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding LightRadius}" Minimum="0" Increment="16"
                                                   ButtonSpinnerLocation="Left" FormatString="F2" Width="100"/>
                            </StackPanel>
                            <Grid Height="24" Margin="0,5,0,0"
                                  Visibility="{Binding HasLightRadius, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ToolTip="Drag left or right to adjust light radius in 16-unit steps">
                                <Border Height="8" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                <Border Width="2" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Background="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" IsHitTestVisible="False"/>
                                <Thumb x:Name="LightRadiusScrubThumb" Width="24" Height="20" HorizontalAlignment="Center"
                                       DragStarted="LightRadiusScrubThumb_DragStarted"
                                       DragDelta="LightRadiusScrubThumb_DragDelta"
                                       DragCompleted="LightRadiusScrubThumb_DragCompleted"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text=" Brightness:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding Brightness}" Minimum="0" Increment="0.25"
                                                   ButtonSpinnerLocation="Left" FormatString="F2" Width="100"/>
                            </StackPanel>
                            <Grid Height="24" Margin="0,5,0,0"
                                  ToolTip="Drag left or right to adjust light brightness in 0.25 steps">
                                <Border Height="8" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                <Border Width="2" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Background="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" IsHitTestVisible="False"/>
                                <Thumb Width="24" Height="20" HorizontalAlignment="Center"
                                       DragStarted="LightBrightnessScrubThumb_DragStarted"
                                       DragDelta="LightBrightnessScrubThumb_DragDelta"
                                       DragCompleted="LightBrightnessScrubThumb_DragCompleted"/>
                            </Grid>
                            <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                                <TextBlock Text=" Light Color" Margin="0,0,0,2"/>
                                <xctk:ColorPicker SelectedColor="{Binding LightColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="0,5,0,0"
                                        Visibility="{Binding HasBouncedModulationColor, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text=" Bounced Modulation Color" Margin="0,0,0,2"/>
                                <xctk:ColorPicker SelectedColor="{Binding LightEnv_BouncedModulationColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Content="Apply bounced modulation color to live light"
                                      Margin="0,5,0,0"
                                      IsChecked="{Binding ApplyBouncedModulationColor, Mode=TwoWay}"
                                      Visibility="{Binding CanApplyBouncedModulationColor, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <StackPanel Orientation="Vertical" Margin="0,5,0,0"
                                        Visibility="{Binding HasConeAngles, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" Inner Cone Angle:  " VerticalAlignment="Center" />
                                    <xctk:SingleUpDown Value="{Binding InnerConeAngle}" Minimum="0" Maximum="89.9"
                                                        Increment="1" ButtonSpinnerLocation="Left" FormatString="F2" Width="80"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text=" Outer Cone Angle:  " VerticalAlignment="Center" />
                                    <xctk:SingleUpDown Value="{Binding OuterConeAngle}" Minimum="0" Maximum="89.9"
                                                        Increment="1" ButtonSpinnerLocation="Left" FormatString="F2" Width="80"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasConeAngles, Converter={StaticResource BoolToVisibilityConverter}}">
                                <UniformGrid Rows="1" Columns="3" Margin="0,0,0,4">
                                    <RadioButton Content="Inner" Tag="InnerConeAngle" GroupName="LightDialProperty" IsChecked="True"
                                                 HorizontalContentAlignment="Center" Checked="LightDialProperty_Checked"/>
                                    <RadioButton Content="Outer" Tag="OuterConeAngle" GroupName="LightDialProperty"
                                                 HorizontalContentAlignment="Center" Checked="LightDialProperty_Checked"/>
                                    <RadioButton Content="Both" Tag="ConeAngles" GroupName="LightDialProperty"
                                                 HorizontalContentAlignment="Center" Checked="LightDialProperty_Checked"/>
                                </UniformGrid>
                                <Grid x:Name="LightValueDial" Width="120" Height="120" HorizontalAlignment="Center" Cursor="Hand"
                                      MouseLeftButtonDown="LightValueDial_MouseLeftButtonDown"
                                      MouseMove="LightValueDial_MouseMove"
                                      MouseLeftButtonUp="LightValueDial_MouseLeftButtonUp"
                                      LostMouseCapture="LightValueDial_LostMouseCapture"
                                      ToolTip="Drag around the circle to adjust the selected light value">
                                    <Ellipse Margin="4" StrokeThickness="4"
                                             Stroke="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                             Fill="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <Line x:Name="LightValueDialIndicator" X1="60" Y1="60" X2="60" Y2="10" StrokeThickness="3"
                                          Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" IsHitTestVisible="False">
                                        <Line.RenderTransform>
                                            <RotateTransform CenterX="60" CenterY="60"/>
                                        </Line.RenderTransform>
                                    </Line>
                                    <Ellipse Width="10" Height="10"
                                             Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" IsHitTestVisible="False"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                        Visibility="{Binding HasLightAffectsClassification, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text=" Light Affects Classification:  " VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding LightAffectsClassificationValues}"
                                          SelectedItem="{Binding LightAffectsClassification, Mode=TwoWay}"
                                          MinWidth="180" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="0,5,0,0"
                                        Visibility="{Binding HasOtherLevelsToAffect, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text=" Other Levels To Affect:" Margin="0,0,0,3"/>
                                <ListBox x:Name="OtherLevelsListBox"
                                         ItemsSource="{Binding OtherLevelsToAffect}"
                                         MaxHeight="80"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <xctk:WatermarkTextBox x:Name="NewOtherLevel_TextBox"
                                                           Watermark="Level name..."
                                                           Width="140"
                                                           VerticalContentAlignment="Center"/>
                                    <Button Content="Add" Margin="3,0,0,0" Padding="6,1"
                                            Click="AddOtherLevel_Click"/>
                                    <Button Content="Remove" Margin="3,0,0,0" Padding="6,1"
                                            Click="RemoveOtherLevel_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Actor Position" Margin="5,0,5,5" BorderThickness="2" Padding="5">
                        <StackPanel Orientation="Vertical">
                            <Button Content="Snap to Camera" Margin="0,0,0,5" Padding="6,2" HorizontalAlignment="Left"
                                    Command="{Binding DataContext.SnapActorToCameraCommand, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                    ToolTip="Move this actor to the camera's current position"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}"/>
                                    <xctk:SingleUpDown Name="xPosUpDown" Value="{Binding XPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="3,0,3,0">
                                    <TextBlock Text="Y:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}"/>
                                    <xctk:SingleUpDown Name="yPosUpDown" Value="{Binding YPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Z:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}"/>
                                    <xctk:SingleUpDown Name="zPosUpDown" Value="{Binding ZPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0, 5, 0, 0" Orientation="Horizontal">
                                <TextBlock Text=" Increment:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Minimum="0" ButtonSpinnerLocation="Left" FormatString="F3"/>
                            </StackPanel>
                            <UniformGrid Rows="1" Columns="3" Margin="0,8,0,4">
                                <RadioButton Content="X" Tag="X" GroupName="ActorLocationScrubAxis" IsChecked="True"
                                             HorizontalContentAlignment="Center" Checked="ActorLocationScrubAxis_Checked"/>
                                <RadioButton Content="Y" Tag="Y" GroupName="ActorLocationScrubAxis"
                                             HorizontalContentAlignment="Center" Checked="ActorLocationScrubAxis_Checked"/>
                                <RadioButton Content="Z" Tag="Z" GroupName="ActorLocationScrubAxis"
                                             HorizontalContentAlignment="Center" Checked="ActorLocationScrubAxis_Checked"/>
                            </UniformGrid>
                            <Grid Height="24" ToolTip="Drag left or right to move the selected actor continuously along the selected axis">
                                <Border Height="8" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                <Border Width="2" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Background="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" IsHitTestVisible="False"/>
                                <Thumb x:Name="ActorLocationScrubThumb" Width="24" Height="20" HorizontalAlignment="Center"
                                       DragStarted="ActorLocationScrubThumb_DragStarted"
                                       DragDelta="ActorLocationScrubThumb_DragDelta"
                                       DragCompleted="ActorLocationScrubThumb_DragCompleted"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Actor Rotation" Margin="5,0,5,5" BorderThickness="2">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=" Roll:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}" />
                                <xctk:SingleUpDown Name="rollUpDown" Value="{Binding RollDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left"/>
                                <TextBlock Text=" Pitch:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}" />
                                <xctk:SingleUpDown Name="pitchUpDown" Value="{Binding PitchDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left"/>
                                <TextBlock Text=" Yaw:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}" />
                                <xctk:SingleUpDown Name="yawUpDown" Value="{Binding YawDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left"/>
                            </StackPanel>
                            <StackPanel Margin="0, 5, 0, 0" Orientation="Horizontal">
                                <TextBlock Text=" Increment:  " VerticalAlignment="Center" />
                                <xctk:IntegerUpDown Value="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Minimum="0" ButtonSpinnerLocation="Left"/>
                            </StackPanel>
                            <UniformGrid Rows="1" Columns="3" Margin="0,8,0,4">
                                <RadioButton Content="Pitch" Tag="Pitch" GroupName="ActorRotationDialAxis" IsChecked="True"
                                             HorizontalContentAlignment="Center" Checked="ActorRotationDialAxis_Checked"/>
                                <RadioButton Content="Roll" Tag="Roll" GroupName="ActorRotationDialAxis"
                                             HorizontalContentAlignment="Center" Checked="ActorRotationDialAxis_Checked"/>
                                <RadioButton Content="Yaw" Tag="Yaw" GroupName="ActorRotationDialAxis"
                                             HorizontalContentAlignment="Center" Checked="ActorRotationDialAxis_Checked"/>
                            </UniformGrid>
                            <Grid x:Name="ActorRotationDial" Width="120" Height="120" HorizontalAlignment="Center" Cursor="Hand"
                                  MouseLeftButtonDown="ActorRotationDial_MouseLeftButtonDown"
                                  MouseMove="ActorRotationDial_MouseMove"
                                  MouseLeftButtonUp="ActorRotationDial_MouseLeftButtonUp"
                                  LostMouseCapture="ActorRotationDial_LostMouseCapture"
                                  ToolTip="Drag around the circle to rotate the selected actor on the selected axis">
                                <Ellipse Margin="4" StrokeThickness="4"
                                         Stroke="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                         Fill="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                <Line x:Name="ActorRotationDialIndicator" X1="60" Y1="60" X2="60" Y2="10" StrokeThickness="3"
                                      Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" IsHitTestVisible="False">
                                    <Line.RenderTransform>
                                        <RotateTransform CenterX="60" CenterY="60"/>
                                    </Line.RenderTransform>
                                </Line>
                                <Ellipse Width="10" Height="10"
                                         Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" IsHitTestVisible="False"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Actor DrawScale" Margin="5,0,5,5" BorderThickness="2" >
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" Scale:  " VerticalAlignment="Center" />
                                    <xctk:SingleUpDown Name="scaleUpDown" Value="{Binding DrawScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"  ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" X:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}" />
                                    <xctk:SingleUpDown Name="xScaleUpDown" Value="{Binding XScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"  ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" Y:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}" />
                                    <xctk:SingleUpDown Name="yScaleUpDown" Value="{Binding YScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"  ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" Z:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}" />
                                    <xctk:SingleUpDown Name="zScaleUpDown" Value="{Binding ZScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0, 5, 0, 0" Orientation="Horizontal">
                                <TextBlock Text=" Increment:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Minimum="0" ButtonSpinnerLocation="Left" FormatString="F3"/>
                            </StackPanel>
                            <StackPanel Margin="0,5,0,0">
                                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,4">
                                    <RadioButton Content="X" Tag="X" GroupName="ActorScaleScrubAxis" IsChecked="True"
                                                 HorizontalContentAlignment="Center" Checked="ActorScaleScrubAxis_Checked"/>
                                    <RadioButton Content="Y" Tag="Y" GroupName="ActorScaleScrubAxis"
                                                 HorizontalContentAlignment="Center" Checked="ActorScaleScrubAxis_Checked"/>
                                    <RadioButton Content="Z" Tag="Z" GroupName="ActorScaleScrubAxis"
                                                 HorizontalContentAlignment="Center" Checked="ActorScaleScrubAxis_Checked"/>
                                    <RadioButton Content="All" Tag="All" GroupName="ActorScaleScrubAxis"
                                                 HorizontalContentAlignment="Center" Checked="ActorScaleScrubAxis_Checked"/>
                                </UniformGrid>
                                <Grid Height="24" ToolTip="Drag left or right to scale the selected actor continuously on the selected axes">
                                    <Border Height="8" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                    <Border Width="2" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Background="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" IsHitTestVisible="False"/>
                                    <Thumb Width="24" Height="20" HorizontalAlignment="Center"
                                           DragStarted="ActorScaleScrubThumb_DragStarted"
                                           DragDelta="ActorScaleScrubThumb_DragDelta"
                                           DragCompleted="ActorScaleScrubThumb_DragCompleted"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    </WrapPanel>
                    <!--upstream detail panels: mesh and material choices, decal, spline, the light's channels and shadows, and actor lighting-->
                    <local:MeshPanel/>
                    <local:DecalPanel/>
                    <local:SplinePanel/>
                    <local:LightPanel/>
                    <local:ActorLightingPanel/>
                        </StackPanel>
                    </ScrollViewer>

                    <exportLoaderControls:ActorPreviewControl x:Name="LevelLiveMaterialEditor"
                                                              Grid.RowSpan="4" Panel.ZIndex="10"
                                                              IsMaterialEditorOnly="True"
                                                              Visibility="{Binding IsLevelMaterialEditorOpen, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                </Grid>

                <Grid Grid.Column="2" Grid.ColumnSpan="3" Panel.ZIndex="11"
                      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                      Visibility="{Binding IsLevelMorphEditorOpen, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Padding="6,4" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="X" Width="24" Height="24" Padding="0"
                                    Click="CloseLevelMorphEditor_Click" ToolTip="Close morph editor"/>
                            <TextBlock Text="{Binding LevelMorphEditorTitle, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <exportLoaderControls:ActorPreviewControl x:Name="LevelMorphEditor" Grid.Row="1"
                                                              OpenMorphEditorOnLoad="True"
                                                              IsMorphEditorOnly="True"/>
                </Grid>

                <Grid Grid.Column="0" Grid.ColumnSpan="5" Visibility="{Binding ShowLandingPage, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <TabControl x:Name="RecentSetTabs" ItemsSource="{Binding RecentSetGroups}"
                                    SelectedItem="{Binding SelectedRecentSetGroup, Mode=TwoWay}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="8">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Header}" Margin="8,2"/>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                    <Grid MinHeight="40">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLevelPresets}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <TextBlock Text="No recent level sets in this tab." HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <sharedToolControls:RecentItemsPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="3" Padding="3" MinHeight="26" ToolTip="{Binding TooltipText}"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.OpenRecentSetCommand, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                                            CommandParameter="{Binding}" ContextMenuOpening="RecentSetButton_ContextMenuOpening">
                                                        <Button.ContextMenu>
                                                            <ContextMenu/>
                                                        </Button.ContextMenu>
                                                        <Grid HorizontalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Source="{Binding Game, Converter={StaticResource GameToImageIconConverter}}" Height="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasMultipleLevels}" Value="True">
                                                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                                                <Setter Property="TextTrimming" Value="None"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                        <ContentControl>
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Content" Value="{Binding PinnedFilesControl, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <DockPanel LastChildFill="True">
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLevelPresets}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Style>
                                            <DockPanel DockPanel.Dock="Top" Margin="3,3,3,8" LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="Manage level presets..." Padding="10,4" Margin="8,0,0,0"
                                                        Click="LevelPresets_Click" ToolTip="Create a preset by choosing level files, or edit existing presets"/>
                                                <xctk:WatermarkTextBox Watermark="Search level presets"
                                                    Text="{Binding LevelPresetSearchText, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}, UpdateSourceTrigger=PropertyChanged}"
                                                    VerticalContentAlignment="Center" MinWidth="120"/>
                                            </DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Margin="8,0,8,8" TextWrapping="Wrap"
                                                       Text="{Binding LevelPresetsLoadError, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LevelPresetsLoadError, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Grid>
                                                <TextBlock Text="No matching level presets. Use Manage level presets to add levels from a file picker."
                                                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LevelPresetsView.IsEmpty, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ListBox ItemsSource="{Binding LevelPresetsView, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                                         SelectedItem="{Binding SelectedLevelPreset, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}, Mode=TwoWay}"
                                                         MaxHeight="405" BorderThickness="0" Background="Transparent"
                                                         HorizontalContentAlignment="Stretch" VerticalAlignment="Top" Padding="0"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel LastChildFill="True">
                                                                <Button DockPanel.Dock="Right" Content="Camera locations…"
                                                                        Click="LevelPresetCameraLocations_Click" Padding="8,4" Margin="3" MinHeight="39"
                                                                        ToolTip="Choose, search, or edit named camera locations before opening these levels"/>
                                                                <Button Click="OpenLevelPreset_Click" Margin="3" Padding="8,4" MinHeight="39"
                                                                        ToolTip="{Binding TooltipText}" HorizontalContentAlignment="Stretch"
                                                                        ContextMenuOpening="LevelPresetButton_ContextMenuOpening">
                                                                    <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                                                                    <DockPanel>
                                                                        <Image DockPanel.Dock="Left" Margin="0,0,8,0" Source="{Binding Game, Converter={StaticResource GameToImageIconConverter}}"
                                                                               Height="20" Width="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Summary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
            </Grid>
        </DockPanel>
    </xctk:BusyIndicator>
</misc:NotifyPropertyChangedWindowBase>
