<bases:WPFBase
        x:Class="LegendaryExplorer.Tools.LevelEditor.LevelEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.LevelEditor"
        xmlns:scene3D="clr-namespace:LegendaryExplorer.Tools.LevelEditor.Scene3D"
        xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
        xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sharedToolControls="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        xmlns:packages="clr-namespace:LegendaryExplorerCore.Packages;assembly=LegendaryExplorerCore"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
        Icon="pack://application:,,,/Tools/Icons/16x16/LiveLevelEditor_Icon_16.ico"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        AllowDrop="True"
        Loaded="LevelEditor_Loaded"
        Closing="LevelEditor_Closing"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="LevelEditor" Height="800" Width="1000">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullEnabledConverter x:Key="NullEnabledConverter"/>
        <converters:BoolEnabledConverter x:Key="BoolEnabledConverter"/>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <converters:ObjectStructPropertyTypeConverter x:Key="ObjectStructPropertyTypeConverter"/>
        <converters:EntryFileTypeConverter x:Key="EntryFileTypeConverter"/>
        <converters:EntryFileTypeIconPathConverter x:Key="EntryFileTypeIconPathConverter"/>
        <converters:EmbeddedFileToolTipConverter x:Key="EmbeddedFileToolTipConverter"/>
        <converters:GameTypeConverter x:Key="GameTypeConverter"/>
        <converters:GameToImageIconConverter x:Key="GameToImageIconConverter"/>
        <sharedUi:BindingProxy x:Key="bindingProxy" Data="{Binding}"/>
        <converters:UnsavedChangesForegroundConverter x:Key="UnsavedChangesForegroundConverter"/>
        <TextDecorationCollection x:Key="XTextDeco">
            <TextDecoration Location="Underline" PenOffset="2">
                <TextDecoration.Pen>
                    <Pen Brush="Red" Thickness="3"/>
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>
        <TextDecorationCollection x:Key="YTextDeco">
            <TextDecoration Location="Underline" PenOffset="2">
                <TextDecoration.Pen>
                    <Pen Brush="#00C91D" Thickness="3"/>
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>
        <TextDecorationCollection x:Key="ZTextDeco">
            <TextDecoration Location="Underline" PenOffset="2">
                <TextDecoration.Pen>
                    <Pen Brush="Blue" Thickness="3"/>
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding AddFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="F" Command="{Binding FocusSelectedCommand}"/>
        <KeyBinding Key="L" Modifiers="Shift" Command="{Binding ToggleLocalCoordsCommand}"/>
    </Window.InputBindings>
    <xctk:BusyIndicator IsBusy="{Binding Path=IsBusy}" BusyContent="{Binding BusyText}">
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File" Padding="4" >
                    <MenuItem Header="Open" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" ToolTip="Open a level file (replaces current)"/>
                    <MenuItem Header="Add File..." Command="{Binding AddFileCommand}" InputGestureText="Ctrl+Shift+O" ToolTip="Add another level file to the scene"/>
                    <MenuItem Header="Load Related Levels" Command="{Binding LoadRelatedLevelsCommand}" ToolTip="Load all related level files for the current level" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <Separator />
                    <MenuItem Header="Save All" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S" ToolTip="Save all open files in-place" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" ToolTip="Save selected file to another location" IsEnabled="{Binding HasAnyFileOpen}"/>
                    <MenuItem Header="Open file location" Command="{Binding OpenCurrentFileLocationCommand}" ToolTip="{Binding CurrentPackageFilePath, StringFormat=Open containing folder for {0}}"/>
                    <MenuItem Header="Copy file name" Command="{Binding CopyCurrentFileNameCommand}"/>
                    <Separator />
                    <MenuItem Name="Recents_MenuItem" Header="Recent" IsEnabled="false"/>
                </MenuItem>
            </Menu>
            <WrapPanel DockPanel.Dock="Top">
                <ToolBar ToolBarTray.IsLocked="True" OverflowMode="Never">
                    <Button Content="Commit Changes" ToolTip="Commit changes made in Level Editor (does not save the file to disk!)" Command="{Binding CommitChangesCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="true">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Name="UndoMenuItem" Click="Undo_Clicked" ToolTip="Undo (Ctrl-Z)" IsEnabled="{Binding CanUndo, Converter={StaticResource BoolEnabledConverter}, Mode=OneWay}">
                        <fa:ImageAwesome Icon="Solid_Undo" Width="16"/>
                    </Button>
                    <Button Name="RedoMenuItem" Click="Redo_Clicked" ToolTip="Redo (Ctrl-Y)" IsEnabled="{Binding CanRedo, Converter={StaticResource BoolEnabledConverter}, Mode=OneWay}">
                        <fa:ImageAwesome Icon="Solid_Redo" Width="16"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <RadioButton GroupName="WidgetMode" ToolTip="Translate" Command="{Binding ToggleTranslateCommand}" IsChecked="True">
                        Translate
                    </RadioButton>
                    <RadioButton GroupName="WidgetMode" ToolTip="Rotate" Command="{Binding ToggleRotateCommand}">
                        Rotate
                    </RadioButton>
                    <RadioButton GroupName="WidgetMode" ToolTip="Scale" Command="{Binding ToggleScaleCommand}">
                        Scale
                    </RadioButton>
                    <RadioButton GroupName="WidgetMode" ToolTip="Uniform Scale" Command="{Binding ToggleUniformScaleCommand}">
                        Uniform Scale
                    </RadioButton>
                    <Separator Name="SaveToggle_Separator" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <ToggleButton Content="Local Coords" ToolTip="Use local coordinates for the transform widget" IsChecked="{Binding UseLocalCoordsForWidget}"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <ToggleButton Content="Show Collision" ToolTip="Show collision meshes" IsChecked="{Binding ShowCollision}"/>
                    <ToggleButton Content="Show Light Icons" ToolTip="Show selection icons for light actors" IsChecked="{Binding ShowLightIcons}"/>
                    <ToggleButton Content="Show Volumes" ToolTip="Show volume wireframes" IsChecked="{Binding ShowVolumes}"/>
                    <ToggleButton Content="Show Volumetric Meshes" IsChecked="{Binding ShowVolumetrics}"
                                  ToolTip="Volumetrics are large spheroids used for fog, dust, etc. Since LEX can't display those effects, they just get in the way."/>
                    <ToggleButton Content="Unlit" ToolTip="Display the scene without lighting" IsChecked="{Binding Unlit}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="X:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraPositionX_TextBox" Width="72"
                                     Text="{Binding CameraPositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraPositionBoxes_KeyUp"
                                     GotKeyboardFocus="CameraPositionBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraPositionBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Consolas"
                                     ToolTip="Camera X position"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="X,1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase X position"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="X,-1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease X position"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Y:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraPositionY_TextBox" Width="72"
                                     Text="{Binding CameraPositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraPositionBoxes_KeyUp"
                                     GotKeyboardFocus="CameraPositionBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraPositionBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Consolas"
                                     ToolTip="Camera Y position"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="Y,1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase Y position"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="Y,-1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease Y position"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Z:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraPositionZ_TextBox" Width="72"
                                     Text="{Binding CameraPositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraPositionBoxes_KeyUp"
                                     GotKeyboardFocus="CameraPositionBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraPositionBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Consolas"
                                     ToolTip="Camera Z position"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="Z,1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase Z position"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="Z,-1" Click="CameraPositionAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease Z position"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Step:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <xctk:SingleUpDown Width="70" Value="{Binding CameraPositionStep}" Minimum="0.01"
                                           ButtonSpinnerLocation="Left" FormatString="F2"
                                           VerticalContentAlignment="Center" ToolTip="Camera position adjustment step"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="Rot" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="X:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraRotationX_TextBox" Width="72"
                                     Text="{Binding CameraRotationX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraRotationBoxes_KeyUp"
                                     GotKeyboardFocus="CameraRotationBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraRotationBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Consolas"
                                     ToolTip="Camera X rotation (Roll, degrees)"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="X,1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase X rotation"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="X,-1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease X rotation"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Y:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraRotationY_TextBox" Width="72"
                                     Text="{Binding CameraRotationY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraRotationBoxes_KeyUp"
                                     GotKeyboardFocus="CameraRotationBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraRotationBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Consolas"
                                     ToolTip="Camera Y rotation (Pitch, degrees)"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="Y,1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase Y rotation"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="Y,-1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease Y rotation"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Z:" Margin="0,0,4,0" VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBox x:Name="CameraRotationZ_TextBox" Width="72"
                                     Text="{Binding CameraRotationZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyUp="CameraRotationBoxes_KeyUp"
                                     GotKeyboardFocus="CameraRotationBoxes_GotKeyboardFocus"
                                     LostKeyboardFocus="CameraRotationBoxes_LostKeyboardFocus"
                                     GotFocus="CoordinateEditor_GotFocus"
                                     IsEnabled="{Binding HasAnyFileOpen}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Consolas"
                                     ToolTip="Camera Z rotation (Yaw, degrees)"/>
                            <StackPanel Margin="2,0,0,0">
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▲"
                                        Tag="Z,1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Increase Z rotation"/>
                                <Button Width="16" Height="11" Padding="0" FontSize="8" Content="▼"
                                        Tag="Z,-1" Click="CameraRotationAdjustButton_Click"
                                        IsEnabled="{Binding HasAnyFileOpen}" ToolTip="Decrease Z rotation"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Step:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <xctk:SingleUpDown Width="70" Value="{Binding CameraRotationStep}" Minimum="0.1"
                                           ButtonSpinnerLocation="Left" FormatString="F2"
                                           VerticalContentAlignment="Center" ToolTip="Camera rotation adjustment step in degrees"/>
                    </StackPanel>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <xctk:DropDownButton Content="View options">
                        <xctk:DropDownButton.DropDownContent>
                            <scene3D:SceneControlOptionsControl/>
                        </xctk:DropDownButton.DropDownContent>
                    </xctk:DropDownButton>
                </ToolBar>
            </WrapPanel>

            <StatusBar Height="23" DockPanel.Dock="Bottom">
                <sharedToolControls:StatusBarGameIDIndicator Visibility="{Binding HasAnyFileOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 GameType="{Binding Game}" Margin="0,-4"/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusBar_LeftMostText" Text="Select package file to load"/>
                </StatusBarItem>
                <StatusBarItem Visibility="{Binding SelectedActor, Converter={StaticResource NullVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedActor.Export.ObjectName.Instanced, StringFormat='Selected: {0}'}" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
                </StatusBarItem>
                <StatusBarItem Visibility="{Binding HasAnyFileOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding CurrentModeName, StringFormat='Mode: {0}'}" Foreground="Gray"/>
                </StatusBarItem>
            </StatusBar>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="80" Width="300"/>
                    <ColumnDefinition MinWidth="5" MaxWidth="5"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition MinWidth="5" MaxWidth="5"/>
                    <ColumnDefinition MinWidth="80" Width="340"/>
                </Grid.ColumnDefinitions>


                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

                <DockPanel Grid.Column="0" >
                    <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0" Height="24">
                        <xctk:WatermarkTextBox Watermark="UIndex" Name="Goto_TextBox" Width="70" KeyUp="Goto_TextBox_KeyUp" IsEnabled="{Binding HasAnyFileOpen}"  VerticalContentAlignment="Center"/>
                        <Button Content="Goto #" Click="GotoButton_Clicked" IsEnabled="{Binding HasAnyFileOpen}" Style="{StaticResource {x:Type Button}}" Padding="7,0"/>
                    </StackPanel>
                    <xctk:WatermarkTextBox DockPanel.Dock="Top" Watermark="Search actors..." Name="ActorFilter_TextBox" Margin="5,2,5,2" Height="22"
                                           KeyUp="ActorFilter_TextBox_KeyUp" IsEnabled="{Binding HasAnyFileOpen}" VerticalContentAlignment="Center"/>

                    <DockPanel DockPanel.Dock="Top" Margin="5,0,5,2"
                               Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                               Visibility="{Binding ActiveFile, Converter={StaticResource NullVisibilityConverter}}">
                        <Button DockPanel.Dock="Right" Content="X" Padding="4,0" Margin="2,0"
                                Command="{Binding CloseFileCommand}"
                                CommandParameter="{Binding ActiveFile}" ToolTip="Close this file" FontSize="10"/>
                        <Button DockPanel.Dock="Right" Content="Save" Padding="4,0" Margin="2,0"
                                Command="{Binding SaveSingleFileCommand}"
                                CommandParameter="{Binding ActiveFile}" ToolTip="Save this file" FontSize="10"/>
                        <Button DockPanel.Dock="Right" Content="Commit" Padding="4,0" Margin="2,0"
                                Command="{Binding CommitSingleFileCommand}"
                                CommandParameter="{Binding ActiveFile}" ToolTip="Commit Level Editor changes for this file" FontSize="10"/>
                        <ToggleButton DockPanel.Dock="Right" Padding="2,0" Margin="2,0"
                                      IsChecked="{Binding ActiveFile.IsReadOnly, Mode=TwoWay}"
                                      ToolTip="Toggle read-only — actors cannot be edited when enabled">
                            <Grid Width="12" Height="12">
                                <fa:ImageAwesome Icon="Solid_Lock" Width="12"
                                                 Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <fa:ImageAwesome Icon="Solid_LockOpen" Width="12"
                                                 Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Not'}"/>
                            </Grid>
                        </ToggleButton>
                        <TextBlock Text="{Binding ActiveFile.FileName}" FontWeight="Bold" Padding="4,2" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding TextBelowActors}" TextWrapping="Wrap"/>

                    <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding ActorsView}" Name="MeshExportsList" SelectedItem="{Binding SelectedActor}" HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             ContextMenuOpening="MeshExportsList_ContextMenuOpening">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel x:Name="FileGroupHeader" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="0,2,0,0">
                                            <Button DockPanel.Dock="Right" Content="X" Padding="4,0" Margin="2,0"
                                                    Command="{Binding Data.CloseFileCommand, Source={StaticResource bindingProxy}}"
                                                    CommandParameter="{Binding Name}" ToolTip="Close this file" FontSize="10"/>
                                            <Button DockPanel.Dock="Right" Content="Save" Padding="4,0" Margin="2,0"
                                                    Command="{Binding Data.SaveSingleFileCommand, Source={StaticResource bindingProxy}}"
                                                    CommandParameter="{Binding Name}" ToolTip="Save this file" FontSize="10"/>
                                            <Button DockPanel.Dock="Right" Content="Commit" Padding="4,0" Margin="2,0"
                                                    Command="{Binding Data.CommitSingleFileCommand, Source={StaticResource bindingProxy}}"
                                                    CommandParameter="{Binding Name}" ToolTip="Commit Level Editor changes for this file" FontSize="10"/>
                                            <ToggleButton DockPanel.Dock="Right" Padding="2,0" Margin="2,0"
                                                          IsChecked="{Binding Name.IsReadOnly, Mode=TwoWay}"
                                                          ToolTip="Toggle read-only — actors cannot be edited when enabled">
                                                <Grid Width="12" Height="12">
                                                    <fa:ImageAwesome Icon="Solid_Lock" Width="12"
                                                                     Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <fa:ImageAwesome Icon="Solid_LockOpen" Width="12"
                                                                     Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Not'}"/>
                                                </Grid>
                                            </ToggleButton>
                                            <TextBlock Text="{Binding Name.FileName, Mode=OneTime}" FontWeight="Bold" Padding="4,2" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type local:ActorProxy}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0" x:Name="ExportContainer">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Export.UIndex, Mode=OneTime}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" ToolTip="Export index"/>
                                            <TextBlock Text="{Binding DisplayText, Mode=OneTime}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="true">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" TargetName="ExportContainer"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>

                <scene3D:SceneRenderControl Grid.Column="2" x:Name="SceneViewer" />


                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ComboBox Grid.Row="0" Margin="2,2,2,0" Height="24"
                              ItemsSource="{Binding PropertiesExportList}"
                              SelectedItem="{Binding SelectedPropertiesExport}"
                              IsEnabled="{Binding SelectedActor, Converter={StaticResource NullEnabledConverter}}"
                              ToolTip="Select the actor or one of its components to inspect">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}: {1} ({2})">
                                            <Binding Path="UIndex"/>
                                            <Binding Path="ObjectName.Instanced"/>
                                            <Binding Path="ClassName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TabControl Grid.Row="1" x:Name="PropertiesTabControl">
                        <TabItem Header="Properties">
                            <exportLoaderControls:InterpreterExportLoader x:Name="LevelEditorInterpreter" HideHexBox="True"/>
                        </TabItem>
                        <TabItem Header="Metadata">
                            <exportLoaderControls:EntryMetadataExportLoader x:Name="LevelEditorMetadata"/>
                        </TabItem>
                    </TabControl>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                    <GroupBox Header="Camera" Margin="5,5,5,0" BorderThickness="2" Padding="5"
                              IsEnabled="{Binding HasAnyFileOpen}"
                              Visibility="Collapsed">
                        <StackPanel>
                            <Grid HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="↖" Width="32" Height="32" Margin="2"
                                        Tag="1,-1" Click="CameraMoveXYButton_Click" ToolTip="Move forward and left"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="↑" Width="32" Height="32" Margin="2"
                                        Tag="1,0" Click="CameraMoveXYButton_Click" ToolTip="Move forward"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="↗" Width="32" Height="32" Margin="2"
                                        Tag="1,1" Click="CameraMoveXYButton_Click" ToolTip="Move forward and right"/>

                                <Button Grid.Row="1" Grid.Column="0" Content="←" Width="32" Height="32" Margin="2"
                                        Tag="0,-1" Click="CameraMoveXYButton_Click" ToolTip="Move left"/>
                                <Border Grid.Row="1" Grid.Column="1" Width="32" Height="32" Margin="2" Background="Transparent"
                                        Cursor="SizeAll"
                                        MouseLeftButtonDown="CameraRotatePad_MouseLeftButtonDown"
                                        MouseMove="CameraRotatePad_MouseMove"
                                        MouseLeftButtonUp="CameraRotatePad_MouseLeftButtonUp">
                                    <Ellipse Width="16" Height="16"
                                             Stroke="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" StrokeThickness="3"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Row="1" Grid.Column="2" Content="→" Width="32" Height="32" Margin="2"
                                        Tag="0,1" Click="CameraMoveXYButton_Click" ToolTip="Move right"/>

                                <Button Grid.Row="2" Grid.Column="0" Content="↙" Width="32" Height="32" Margin="2"
                                        Tag="-1,-1" Click="CameraMoveXYButton_Click" ToolTip="Move back and left"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="↓" Width="32" Height="32" Margin="2"
                                        Tag="-1,0" Click="CameraMoveXYButton_Click" ToolTip="Move back"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="↘" Width="32" Height="32" Margin="2"
                                        Tag="-1,1" Click="CameraMoveXYButton_Click" ToolTip="Move back and right"/>
                            </Grid>

                            <StackPanel HorizontalAlignment="Left">
                                <Button Content="[ Z ↑ ]" Width="72" Margin="0,0,0,4" FontFamily="Consolas"
                                        Tag="1" Click="CameraMoveZButton_Click" ToolTip="Move up"/>
                                <Border Width="72" Padding="6,2" BorderThickness="1" HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                    <TextBlock Text="[ 0 ]" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                </Border>
                                <Button Content="[ Z ↓ ]" Width="72" Margin="0,4,0,0" FontFamily="Consolas"
                                        Tag="-1" Click="CameraMoveZButton_Click" ToolTip="Move down"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Snap" Margin="5,5,5,0" BorderThickness="2" Padding="5"
                              DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Translate -->
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="Translate" VerticalAlignment="Center"
                                      IsChecked="{Binding TranslateSnapEnabled}" Margin="0,2,0,2"/>
                            <xctk:SingleUpDown Grid.Row="0" Grid.Column="1" Value="{Binding TranslateSnapValue}"
                                               Minimum="0.001" FormatString="F1" ButtonSpinnerLocation="Left"
                                               ToolTip="Snap step in world units" Margin="5,2,0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="units" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <!-- Rotation -->
                            <CheckBox Grid.Row="1" Grid.Column="0" Content="Rotation" VerticalAlignment="Center"
                                      IsChecked="{Binding RotateSnapEnabled}" Margin="0,2,0,2"/>
                            <xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RotateSnapValue}"
                                               Minimum="0.1" Maximum="180" FormatString="F1" ButtonSpinnerLocation="Left"
                                               ToolTip="Snap step in degrees" Margin="5,2,0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="°" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <!-- Scale -->
                            <CheckBox Grid.Row="2" Grid.Column="0" Content="Scale" VerticalAlignment="Center"
                                      IsChecked="{Binding ScaleSnapEnabled}" Margin="0,2,0,2"/>
                            <xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ScaleSnapValue}"
                                               Minimum="0.01" FormatString="F1" ButtonSpinnerLocation="Left"
                                               ToolTip="Snap step as percent (10 = 0.1 per step)" Margin="5,2,0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                    </GroupBox>
                    <WrapPanel x:Name="wrapPanel" IsEnabled="{Binding ., Converter={StaticResource NullEnabledConverter}}" DataContext="{Binding SelectedActor}">
                    <GroupBox Header="Light" Margin="5,0,5,5" BorderThickness="2" Padding="5"
                              Visibility="{Binding HasLightSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasLightRadius, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text=" Radius:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding LightRadius}" Minimum="0" Increment="16"
                                                   ButtonSpinnerLocation="Left" FormatString="F2" Width="100"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text=" Brightness:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding Brightness}" Minimum="0" Increment="0.25"
                                                   ButtonSpinnerLocation="Left" FormatString="F2" Width="100"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                                <TextBlock Text=" Light Color" Margin="0,0,0,2"/>
                                <xctk:ColorPicker SelectedColor="{Binding LightColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="0,5,0,0"
                                        Visibility="{Binding HasBouncedModulationColor, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text=" Bounced Modulation Color" Margin="0,0,0,2"/>
                                <xctk:ColorPicker SelectedColor="{Binding LightEnv_BouncedModulationColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Content="Apply bounced modulation color to live light"
                                      Margin="0,5,0,0"
                                      IsChecked="{Binding ApplyBouncedModulationColor, Mode=TwoWay}"
                                      Visibility="{Binding CanApplyBouncedModulationColor, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                        Visibility="{Binding HasConeAngles, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text=" Inner:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding InnerConeAngle}" Minimum="0" Maximum="89.9"
                                                   Increment="1" ButtonSpinnerLocation="Left" FormatString="F2" Width="80"/>
                                <TextBlock Text=" Outer:  " VerticalAlignment="Center" Margin="8,0,0,0" />
                                <xctk:SingleUpDown Value="{Binding OuterConeAngle}" Minimum="0" Maximum="89.9"
                                                   Increment="1" ButtonSpinnerLocation="Left" FormatString="F2" Width="80"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Actor Position" Margin="5,0,5,5" BorderThickness="2" Padding="5">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}"/>
                                    <xctk:SingleUpDown Name="xPosUpDown" Value="{Binding XPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="3,0,3,0">
                                    <TextBlock Text="Y:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}"/>
                                    <xctk:SingleUpDown Name="yPosUpDown" Value="{Binding YPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Z:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}"/>
                                    <xctk:SingleUpDown Name="zPosUpDown" Value="{Binding ZPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0, 5, 0, 0" Orientation="Horizontal">
                                <TextBlock Text=" Increment:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Minimum="0" ButtonSpinnerLocation="Left" FormatString="F3"/>
                            </StackPanel>

                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Actor Rotation" Margin="5,0,5,5" BorderThickness="2">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=" Roll:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}" />
                                <xctk:SingleUpDown Name="rollUpDown" Value="{Binding RollDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left"/>
                                <TextBlock Text=" Pitch:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}" />
                                <xctk:SingleUpDown Name="pitchUpDown" Value="{Binding PitchDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left"/>
                                <TextBlock Text=" Yaw:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}" />
                                <xctk:SingleUpDown Name="yawUpDown" Value="{Binding YawDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left"/>
                            </StackPanel>
                            <StackPanel Margin="0, 5, 0, 0" Orientation="Horizontal">
                                <TextBlock Text=" Increment:  " VerticalAlignment="Center" />
                                <xctk:IntegerUpDown Value="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Minimum="0" ButtonSpinnerLocation="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Actor DrawScale" Margin="5,0,5,5" BorderThickness="2" >
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" Scale:  " VerticalAlignment="Center" />
                                    <xctk:SingleUpDown Name="scaleUpDown" Value="{Binding DrawScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"  ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" X:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}" />
                                    <xctk:SingleUpDown Name="xScaleUpDown" Value="{Binding XScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"  ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" Y:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}" />
                                    <xctk:SingleUpDown Name="yScaleUpDown" Value="{Binding YScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"  ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=" Z:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}" />
                                    <xctk:SingleUpDown Name="zScaleUpDown" Value="{Binding ZScale}"
                                                                   Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0, 5, 0, 0" Orientation="Horizontal">
                                <TextBlock Text=" Increment:  " VerticalAlignment="Center" />
                                <xctk:SingleUpDown Value="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}" Minimum="0" ButtonSpinnerLocation="Left" FormatString="F3"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Visibility="{Binding HasAnyFileOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Not'}"
                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <TextBlock Margin="5" Text="Welcome to Level Editor" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Margin="5" TextWrapping="Wrap">
                This is a work in progress, and only displays some of the actors in a level.
                If you have issues with Level Editor, please report them to one of the following places:
                <LineBreak/>
            - <Hyperlink NavigateUri="{Binding Path=(misc:AppLinks.ME3TweaksDiscordInviteURL), Mode=OneTime}" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" misc:HyperlinkExtensions.IsExternal="True">
                <Run Text="The ME3Tweaks Discord (#Legendary_Explorer channel)"/>
            </Hyperlink>                                <LineBreak/>
                 - The issues list on GitHub at
                <Hyperlink NavigateUri="{Binding Path=(misc:AppLinks.BugReportURL), Mode=OneTime}" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" misc:HyperlinkExtensions.IsExternal="True">
                    <Run Text="{Binding Path=(misc:AppLinks.BugReportURL), Mode=OneTime}"/>
                </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="Recent level sets" TextAlignment="Center" FontSize="20" FontWeight="Light" Margin="10"
                               Visibility="{Binding RecentSets.Count, Converter={StaticResource NullVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{Binding RecentSets}" HorizontalAlignment="Left" Width="560">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="252" Margin="3" Padding="3" ToolTip="{Binding TooltipText}"
                                        Command="{Binding DataContext.OpenRecentSetCommand, RelativeSource={RelativeSource AncestorType={x:Type local:LevelEditor}}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding Game, Converter={StaticResource GameToImageIconConverter}}" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DockPanel>
    </xctk:BusyIndicator>
</bases:WPFBase>
