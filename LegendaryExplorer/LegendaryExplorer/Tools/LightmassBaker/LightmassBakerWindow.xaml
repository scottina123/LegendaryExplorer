<bases:TrackingNotifyPropertyChangedWindowBase x:Class="LegendaryExplorer.Tools.LightmassBaker.LightmassBakerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        mc:Ignorable="d"
        Icon="pack://application:,,,/Tools/Icons/16x16/LightmassBaker_Icon_16.ico"
        Title="Lightmass Baker" Width="900" Height="760" MinWidth="640" MinHeight="520"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top" IsEnabled="{Binding IsIdle}">
            <MenuItem Header="_File">
                <MenuItem Header="New Job" Click="NewJob_Click"/>
                <MenuItem Header="Open Job..." Click="OpenJob_Click"/>
                <MenuItem Header="Save Job As..." Click="SaveJob_Click"
                          ToolTip="Save the file list and settings as a job, which can also be baked without opening LEX: LegendaryExplorer.exe --bake-lighting job.json"/>
            </MenuItem>
        </Menu>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Bakes static lighting for LE1, LE2 and LE3 levels as UE3's Lightmass does, with LEX's own solver on the GPU or CPU, or with UDK's Lightmass. Existing lightmaps keep their type; missing mappings are allocated where geometry and cooked shaders support them. Inspect the baked lighting before choosing Save or Discard. Add every level that makes up the scene: Add Streaming Levels follows their streaming references. Untick Bake for files that should only cast shadows and bounce light."/>

            <DockPanel Grid.Row="1" IsEnabled="{Binding IsIdle}">
                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" Width="150">
                    <Button Content="Add Files..." Click="AddFiles_Click" Margin="0,0,0,4" Padding="4,2"/>
                    <Button Content="Add Streaming Levels" Click="AddStreamingLevels_Click" Margin="0,0,0,4" Padding="4,2"
                            ToolTip="Adds the levels streamed by files in the list, including LE1 area files. They're looked for next to the source level first, then among the game's files."/>
                    <Button Content="Remove" Click="Remove_Click" Margin="0,0,0,4" Padding="4,2"/>
                    <Button Content="Clear" Click="Clear_Click" Margin="0,0,0,4" Padding="4,2"/>
                </StackPanel>
                <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Files}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Bake" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Editable, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              ToolTip="Ticked: the file's lightmaps are rebaked and it's saved. Unticked: it only casts shadows and bounces light."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" IsReadOnly="True" Width="Auto"/>
                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Grid Grid.Row="2" Margin="0,10,0,0" IsEnabled="{Binding IsIdle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Solver" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Solvers}" SelectedValue="{Binding Solver}" SelectedValuePath="Choice" DisplayMemberPath="Label"
                          Margin="0,0,6,6" HorizontalAlignment="Left" MinWidth="160"
                          ToolTip="GPU and CPU bake with LEX's own solver, which needs no UDK and follows UE3 Lightmass as closely as it can. UDK Lightmass bakes with UDK's UnrealLightmass.exe through Swarm, the reference the others are compared to.">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Quality" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}" Margin="0,0,6,6" HorizontalAlignment="Left" MinWidth="160"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Save to" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,6,6">
                    <CheckBox DockPanel.Dock="Left" Content="The original files" IsChecked="{Binding SaveInPlace}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SaveToFolder}"
                             ToolTip="The folder the baked files are saved to, under their own names."/>
                </DockPanel>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click" IsEnabled="{Binding SaveToFolder}" Padding="8,2" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Texture cache" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TfcName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                         ToolTip="Name of the texture file cache (TFC) for the streamed lightmap textures. For a DLC mod, Textures_DLC_MOD_YourMod. The cache is saved beside the baked files. An existing cache of this name is added to, not replaced."/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="UDK Binaries" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="{Binding UsesUdk}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UdkBinaries, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" IsEnabled="{Binding UsesUdk}"
                         ToolTip="UDK's Binaries folder, for the UDK Lightmass solver only. Requires SwarmAgent.exe version 1.7.6517, included with the February 2015 UDK."/>
                <Button Grid.Row="4" Grid.Column="2" Content="Browse..." Click="BrowseUdk_Click" Padding="8,2" IsEnabled="{Binding UsesUdk}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Assignments" VerticalAlignment="Center" Margin="0,6,10,0"/>
                <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding AssignmentPolicies}" SelectedValue="{Binding AssignmentPolicy}" SelectedValuePath="Key" DisplayMemberPath="Value" Margin="0,6,6,0" HorizontalAlignment="Left" MinWidth="160"
                          ToolTip="Preserve existing assignments keeps historical restrictions. Recompute assignments uses current settings and geometry. Both allocate missing mappings where supported."/>

                <CheckBox Grid.Row="6" Grid.Column="1" Content="Use precomputed shadows on all meshes" IsChecked="{Binding UsePrecomputedShadowsOnAllMeshes}" Margin="0,8,6,0"
                          ToolTip="Turns on Use precomputed shadows (bUsePrecomputedShadows) for every static mesh in the levels being baked before the bake. A mesh without it isn't baked, so nothing of it is written to the texture cache. Meshes baked by Scottina's Lightmass Baker also get Accepts lights turned back on, since Lightmass leaves out a mesh that doesn't accept lights. The settings are saved with the baked levels."/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Lightmap size" VerticalAlignment="Center" Margin="0,8,10,0"/>
                <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding LightmapSizes}" SelectedValue="{Binding LightmapSize}" SelectedValuePath="Key" DisplayMemberPath="Value"
                          Margin="0,8,6,0" HorizontalAlignment="Left" MinWidth="160"
                          ToolTip="How much larger the static mesh and BSP texture lightmaps are made than they are now, up to 2048 texels. By default it follows the quality: Preview keeps the current size, Medium 1.5x, High 2x, Production 4x. Any size other than 1x bakes at the new size and writes new lightmap textures, removing the old ones from the levels."/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Texture format" VerticalAlignment="Center" Margin="0,8,10,0"/>
                <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding TextureFormats}" SelectedValue="{Binding TextureFormatChoice}" SelectedValuePath="Key" DisplayMemberPath="Value"
                          Margin="0,8,6,0" HorizontalAlignment="Left" MinWidth="160"
                          ToolTip="Format of the colour lightmap textures. DXT1 is the game's own (smallest, most loss). BC7 is twice DXT1's size with far less loss. ARGB is uncompressed (eight times DXT1's size, no loss)."/>
            </Grid>

            <TextBlock Grid.Row="3" Text="{Binding Problems}" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="4" Text="{Binding Warnings}" Foreground="DarkGoldenrod" TextWrapping="Wrap" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DockPanel Grid.Row="5" Margin="0,10,0,6">
                <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" Padding="12,4" Margin="5,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Discard" Click="Discard_Click" IsEnabled="{Binding CanReview}" Padding="12,4" Margin="5,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Save Lighting" Click="SaveBake_Click" IsEnabled="{Binding CanReview}" Padding="12,4" Margin="5,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Preview" Click="Preview_Click" IsEnabled="{Binding CanReview}" Padding="12,4" Margin="5,0,0,0"
                        ToolTip="Inspect the baked lighting. Close the preview window to save or discard."/>
                <Button DockPanel.Dock="Right" Content="Bake" Click="Bake_Click" IsEnabled="{Binding CanBake}" Padding="20,4"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <DockPanel Grid.Row="6">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="{Binding BakeState}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding BakeProgress, Mode=OneWay}" IsIndeterminate="{Binding IsBaking}"
                                 Height="12" AutomationProperties.Name="Bake progress" AutomationProperties.ItemStatus="{Binding BakeState}"/>
                </StackPanel>
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</bases:TrackingNotifyPropertyChangedWindowBase>
