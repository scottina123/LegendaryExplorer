<bases:WPFBase x:Class="LegendaryExplorer.Tools.Meshplorer.MeshplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
        xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
        xmlns:controls="clr-namespace:LegendaryExplorer.SharedUI.Controls"
        xmlns:sharedToolControls="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:packages="clr-namespace:LegendaryExplorerCore.Packages;assembly=LegendaryExplorerCore"
        xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.Meshplorer"
        mc:Ignorable="d"
        Icon="pack://application:,,,/Tools/Icons/16x16/MeshExplorer_Icon_16.ico"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        AllowDrop="True"
        PreviewMouseDown="Meshplorer_CommitRenameOnOutsideClick"
        Closing="MeshplorerWPF_Closing"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Mesh Explorer" Height="550" Width="1200" Loaded="MeshplorerWPF_OnLoaded">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullEnabledConverter x:Key="NullEnabledConverter"/>
        <converters:BoolEnabledConverter x:Key="BoolEnabledConverter"/>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <converters:ObjectStructPropertyTypeConverter x:Key="ObjectStructPropertyTypeConverter"/>
        <converters:EntryFileTypeConverter x:Key="EntryFileTypeConverter"/>
        <converters:EntryFileTypeIconPathConverter x:Key="EntryFileTypeIconPathConverter"/>
        <converters:EmbeddedFileToolTipConverter x:Key="EmbeddedFileToolTipConverter"/>
        <converters:GameTypeConverter x:Key="GameTypeConverter"/>
        <sharedUi:BindingProxy x:Key="bindingProxy" Data="{Binding}"/>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <!--<KeyBinding Key="F" Modifiers="Control" Command="{Binding FindCommand}"/>
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding GotoCommand}"/>-->
    </Window.InputBindings>
    <xctk:BusyIndicator IsBusy="{Binding Path=IsBusy}" BusyContent="{Binding BusyText}">
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File" Padding="4" >
                    <MenuItem Header="Open" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" ToolTip="Open a package file"/>
                    <MenuItem Header="Save"  Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S" ToolTip="Save package file in-place" IsEnabled="{Binding Pcc, Converter={StaticResource NullEnabledConverter}}"/>
                    <MenuItem Header="Save as" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" ToolTip="Save package file to another location" IsEnabled="{Binding Pcc, Converter={StaticResource NullEnabledConverter}}"/>
                    <MenuItem Header="Open file location" Command="{Binding OpenCurrentFileLocationCommand}" ToolTip="{Binding CurrentPackageFilePath, StringFormat=Open containing folder for {0}}"/>
                    <MenuItem Header="Copy file name" Command="{Binding CopyCurrentFileNameCommand}"/>
                    <Separator />
                    <MenuItem Name="Recents_MenuItem" Header="Recent" IsEnabled="false"/>
                </MenuItem>

                <MenuItem Header="Tools" Padding="4">
                    <MenuItem Header="Import New Mesh from UDK" Command="{Binding ImportFromUDKCommand}"/>
                    <MenuItem Header="Replace Mesh from UDK" ToolTip="Replaces an entire mesh from UDK (.upk file)" Command="{Binding ReplaceFromUDKCommand}"/>
                    <MenuItem Header="Replace single LOD from UDK" ToolTip="Replaces a single LOD from UDK (.upk file). Use this if full replacement is wonky"  Command="{Binding ReplaceLODFromUDKCommand}"/>
                    <MenuItem Header="Export Mesh to UDK" Command="{Binding ExportToUDKCommand}"/>
                    <MenuItem Header="Convert Skeletal Mesh to Static Mesh" Command="{Binding ConvertToStaticMeshCommand}"/>
                    <MenuItem Header="Export Mesh to PSK with UModel" Command="{Binding ExportToPSKUModelCommand}"/>
                    <MenuItem Header="Export Mesh to PSK (Experimental)" Command="{Binding ExportToPSKCommand}"/>
                    <MenuItem Header="Export as glTF wihtout textures (Experimental)" Command="{Binding ExportToGltfCommand}"/>
                    <MenuItem Header="Export as glTF with textures (Experimental)" Command="{Binding ExportToGltfTexturesCommand}"/>
                    <MenuItem Header="Replace from glTF (Experimental)" Command="{Binding ReplaceFromGltfCommand}"/>
                    <MenuItem Header="Import new mesh(es) from glTF (Experimental)" Command="{Binding ImportNewFromGltfCommand}"/>
                </MenuItem>
                <MenuItem Header="Import Meshes" Padding="4" Command="{Binding ImportFromAssetDatabaseCommand}"
                          ToolTip="Import skeletal or static meshes from the Asset Database into this PCC."/>
            </Menu>
            <StatusBar Height="23" DockPanel.Dock="Bottom">
                <sharedToolControls:StatusBarGameIDIndicator Visibility="{Binding Pcc, Converter={StaticResource NullVisibilityConverter}}"
                                                 GameType="{Binding Pcc, Converter={StaticResource GameTypeConverter}}" Margin="0,-4"/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusBar_LeftMostText"/>
                </StatusBarItem>
                <sharedToolControls:PackageMountWarning Package="{Binding Pcc}" />
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="StatusBar_RightSide_LastSaved" Text="{Binding Pcc.LastSaved, StringFormat='Last saved at {0}'}" Foreground="Gray"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="280" Width="280"/>
                    <ColumnDefinition MinWidth="5" MaxWidth="5"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition MinWidth="5" MaxWidth="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                <sharedToolControls:RecentsControl x:Name="RecentsController" Grid.Column="2" Grid.ColumnSpan="3"
                                                  Visibility="{Binding Pcc, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type bases:WPFBase}}, Converter={StaticResource NullVisibilityConverter}, ConverterParameter='Reversed'}"/>

                <DockPanel Grid.Row="0" Grid.Column="0"
                           Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                           IsHitTestVisible="{Binding IsRendererBusy, Converter={StaticResource BoolEnabledConverter}, ConverterParameter='Not'}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <CheckBox Content="Brushes" IsChecked="{Binding ShowBrushes}"/>
                        <CheckBox Content="SkeletalMeshes" Margin="5,0" IsChecked="{Binding ShowSkeletalMeshes}"/>
                        <CheckBox Content="StaticMeshes" IsChecked="{Binding ShowStaticMeshes}"/>
                    </StackPanel>
                    <controls:SearchBox x:Name="MeshSearchBox" DockPanel.Dock="Top" Margin="5,0,5,5"
                                        WatermarkText="Search meshes"
                                        TextChanged="MeshSearchBox_OnTextChanged"/>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="5">
                        <Button x:Name="ImportMeshFromUdkButton" Content="Import from UDK" Margin="0,0,3,0" Padding="4,3"
                                Command="{Binding ImportFromUDKCommand}"
                                ToolTip="Import a new mesh from a UDK (.upk) file into this package."/>
                        <Button x:Name="ImportMeshFromGltfButton" Content="Import from glTF" Margin="3,0,0,0" Padding="4,3"
                                Command="{Binding ImportNewFromGltfCommand}"
                                ToolTip="Import new mesh(es) from a glTF (.gltf or .glb) file into this package (experimental)."/>
                    </UniformGrid>
                    <ListBox  ItemsSource="{Binding MeshExports}" Name="MeshExportsList" SelectedItem="{Binding CurrentExport}" 
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseLeftButtonDown="MeshExportsList_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="MeshExportsList_PreviewMouseLeftButtonUp"
                              MouseMove="MeshExportsList_MouseMove" LostMouseCapture="MeshExportsList_LostMouseCapture"
                              PreviewDragOver="MeshExportsList_PreviewDragOver" PreviewDrop="MeshExportsList_PreviewDrop"
                              ToolTip="Drag a mesh to another Meshplorer window to clone it into a PCC for the same game."
                              Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Import New Mesh from UDK" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ImportFromUDKCommand}" Icon="{StaticResource UDKMenuIcon}"/>
                                <MenuItem Header="Import new mesh(es) from glTF (Experimental)" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ImportNewFromGltfCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type packages:ExportEntry}">
                                <Grid HorizontalAlignment="Stretch" Margin="0" x:Name="ExportContainer">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <fa:ImageAwesome x:Name="FAImageIcon" Width="18" Height="18" Margin="2,0,4,0"/>
                                    <StackPanel Grid.Column="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding UIndex}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" ToolTip="Export index"/>
                                            <Grid>
                                                <TextBlock x:Name="MeshNameDisplay" Text="{Binding ObjectName.Instanced}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ObjectName.Instanced}"/>
                                                <StackPanel x:Name="MeshNameEditorPanel" Visibility="Collapsed"
                                                            PreviewKeyDown="MeshNameEditor_PreviewKeyDown"
                                                            LostKeyboardFocus="MeshNameEditor_LostKeyboardFocus"
                                                            Unloaded="MeshNameEditor_Unloaded">
                                                    <TextBox x:Name="MeshNameEditor" MinWidth="100" VerticalAlignment="Center" Padding="2,0"
                                                             ToolTip="Edit the mesh name. Enter to apply, Escape to cancel."/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Index:" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <xctk:IntegerUpDown x:Name="MeshNameIndexEditor" Width="70" Minimum="0" Maximum="2147483647"
                                                                       DefaultValue="0" DisplayDefaultValueOnEmptyText="True" VerticalAlignment="Center"
                                                                       ToolTip="Object index, matching Package Editor. 0 means no suffix; 1 displays _0; 2 displays _1. Enter to apply, Escape to cancel."/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DockPanel>
                                        <TextBlock Text="{Binding ParentFullPath}" VerticalAlignment="Center" Foreground="Gray"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ParentFullPath}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="MeshRowActions" Grid.Column="2" Orientation="Horizontal" Margin="4,0,2,0" VerticalAlignment="Center">
                                        <Button x:Name="ImportMeshLodButton" Width="24" Height="24" Padding="3" Margin="0,0,2,0"
                                                Command="{Binding ReplaceLODFromUDKCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MeshplorerWindow}}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Import mesh as a single LOD from a UDK (.upk) file into this skeletal mesh."
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="{Binding ObjectName.Instanced, StringFormat=Import a single LOD for {0}}">
                                            <fa:ImageAwesome Icon="Solid_FileImport" Width="16" Height="16" Foreground="{DynamicResource IconForegroundBrush}"/>
                                        </Button>
                                        <Button x:Name="OpenMeshInPackageEditorButton" Width="24" Height="24" Padding="3"
                                                Command="{Binding OpenMeshInPackageEditorCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MeshplorerWindow}}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Open this mesh in Package Editor."
                                                AutomationProperties.Name="{Binding ObjectName.Instanced, StringFormat=Open {0} in Package Editor}">
                                            <Image Source="{StaticResource iconPackageEditor16}" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="MeshNameEditorPanel" Property="Visibility" Value="Visible">
                                        <Setter TargetName="MeshRowActions" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Path=EntryHasPendingChanges}" Value="true">
                                        <Setter Property="Background" Value="#50D4A020" TargetName="ExportContainer"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=ClassName}" Value="SkeletalMesh">
                                        <Setter Property="Icon" Value="Solid_Skull" TargetName="FAImageIcon"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=ClassName}" Value="StaticMesh">
                                        <Setter Property="Icon" Value="Solid_Archway" TargetName="FAImageIcon"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=ClassName}" Value="BrushComponent">
                                        <Setter Property="Icon" Value="Brands_Codepen" TargetName="FAImageIcon"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                            <ContextMenu x:Key="MyMenu">
                                <MenuItem Header="Rename" ToolTip="Edit this mesh's name inline" Click="RenameMesh_Click"/>
                                <MenuItem Header="Change index" ToolTip="Edit this mesh's Object index, matching Package Editor" Click="ChangeMeshIndex_Click"/>
                                <MenuItem Header="Clone Tree" ToolTip="Clone this mesh and all children" Click="CloneMeshTree_Click"/>
                                <MenuItem Header="Trash entry and children" ToolTip="Convert this mesh and its children into empty data" Click="TrashMeshTree_Click"/>
                                <Separator/>
                                <MenuItem Icon="{StaticResource PackageEditorMenuIcon}" Header="Open in Package Editor" ToolTip="Opens this mesh in Package Editor"
                                          Command="{Binding Source={StaticResource bindingProxy}, Path=Data.OpenMeshInPackageEditorCommand}" CommandParameter="{Binding}"/>
                                <MenuItem Header="Replace Mesh from UDK" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ReplaceFromUDKCommand}" Icon="{StaticResource UDKMenuIcon}"/>
                                <MenuItem Header="Replace single LOD from UDK" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ReplaceLODFromUDKCommand}"
                                          ToolTip="Replaces a single LOD from UDK (.upk file). Use this if full replacement is wonky" Icon="{StaticResource UDKMenuIcon}"/>
                                <MenuItem Header="Export Mesh to UDK" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ExportToUDKCommand}" Icon="{StaticResource UDKMenuIcon}"/>
                                <MenuItem Header="Export Mesh to PSK with UModel" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ExportToPSKUModelCommand}"
                                          sharedUi:Bindings.VisibilityToEnabled="True" Icon="{StaticResource UModelMenuIcon}"/>
                                <MenuItem Header="Export Mesh to PSK (Experimental)" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ExportToPSKCommand}"/>
                                <MenuItem Header="Convert ME3 Skeletal Mesh to ME3 Static Mesh" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ConvertToStaticMeshCommand}"/>
                                <MenuItem Header="Export as glTF without textures (Experimental)" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ExportToGltfCommand}"/>
                                <MenuItem Header="Export as glTF with textures (Experimental)" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ExportToGltfTexturesCommand}"/>
                                <MenuItem Header="Replace from glTF (Experimental)" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ReplaceFromGltfCommand}"/>
                                <MenuItem Header="Import new mesh(es) from glTF (Experimental)" Command="{Binding Source={StaticResource bindingProxy}, Path=Data.ImportNewFromGltfCommand}"/>
                            </ContextMenu>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="ContextMenu" Value="{StaticResource MyMenu}"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>

                </DockPanel>
                <Grid Grid.Column="2" Visibility="{Binding Pcc, Converter={StaticResource NullVisibilityConverter}, FallbackValue=Collapsed}" 
                      IsEnabled="{Binding IsRendererBusy, Converter={StaticResource BoolEnabledConverter}, ConverterParameter='Not'}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition MinHeight="5" MaxHeight="5" Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <exportLoaderControls:InterpreterExportLoader x:Name="InterpreterTab_Interpreter" HideHexBox="True"/>
                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>
                    <exportLoaderControls:BinaryInterpreterWPF x:Name="BinaryInterpreterTab_BinaryInterpreter" Grid.Row="2" HideHexBox="True" AlwaysLoadRegardlessOfSize="True" HostingControl="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"  Visibility="{Binding Pcc, Converter={StaticResource NullVisibilityConverter}, FallbackValue=Collapsed}"/>
                <DockPanel Grid.Column="4" Visibility="{Binding Pcc, Converter={StaticResource NullVisibilityConverter}}">
                    <exportLoaderControls:MeshRenderer x:Name="Mesh3DViewer">
                        <exportLoaderControls:MeshRenderer.AdditionalToolbarContent>
                            <Button AutomationProperties.AutomationId="OpenAnimationPreviewButton" Margin="2,0" VerticalAlignment="Center"
                                    Content="Open animation preview..." Click="OpenAnimationPreview_Click" Padding="6,2"
                                    IsEnabled="{Binding IsBusy, RelativeSource={RelativeSource AncestorType={x:Type exportLoaderControls:MeshRenderer}}, Converter={StaticResource BoolEnabledConverter}, ConverterParameter=Not}"
                                    Visibility="{Binding IsSkeletalMesh, RelativeSource={RelativeSource AncestorType={x:Type exportLoaderControls:MeshRenderer}}, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="Browse and preview animations from this game's Asset Database"/>
                        </exportLoaderControls:MeshRenderer.AdditionalToolbarContent>
                    </exportLoaderControls:MeshRenderer>
                </DockPanel>
            </Grid>
        </DockPanel>
    </xctk:BusyIndicator>
</bases:WPFBase>
