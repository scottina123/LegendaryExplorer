<Window x:Class="LegendaryExplorer.Tools.Meshplorer.DrawModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Draw Model" Width="1100" Height="760" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Draw a volume" FontSize="20" Margin="0,0,0,6"/>
            <TextBlock Text="Click corners in perimeter order in the XY view. Drag corners to move them; right-click to undo. Set the base Z and extrusion height, then create the Model." TextWrapping="Wrap" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Name" VerticalAlignment="Center"/>
                <TextBox x:Name="ModelName" Text="DrawnModel" Width="180" Margin="6,0,16,0"/>

            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Origin X" VerticalAlignment="Center"/>
                <TextBox x:Name="OriginX" Text="0" Width="80" Margin="5,0,12,0" TextChanged="SettingsChanged"/>
                <TextBlock Text="Origin Y" VerticalAlignment="Center"/>
                <TextBox x:Name="OriginY" Text="0" Width="80" Margin="5,0,12,0" TextChanged="SettingsChanged"/>
                <TextBlock Text="Base Z" VerticalAlignment="Center"/>
                <TextBox x:Name="BaseZ" Text="0" Width="80" Margin="5,0,12,0" TextChanged="SettingsChanged"/>
                <TextBlock Text="Height" VerticalAlignment="Center"/>
                <TextBox x:Name="ExtrusionHeight" Text="200" Width="80" Margin="5,0,12,0" TextChanged="SettingsChanged"/>
                <TextBlock Text="Grid / snap" VerticalAlignment="Center"/>
                <TextBox x:Name="GridStep" Text="50" Width="65" Margin="5,0,12,0" TextChanged="SettingsChanged"/>
                <CheckBox x:Name="Snap" Content="Snap" IsChecked="True" VerticalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="DrawStatus" TextWrapping="Wrap" MinHeight="32"/>
            <TextBlock Text="Creates Model and Polys exports in the open package. To use it in game, assign the Model to a brush/volume and configure its BrushComponent and collision. Save the package when finished." TextWrapping="Wrap" Margin="0,4,0,10"/>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Width="90" Margin="0,0,8,0"/>
                    <Button x:Name="CreateButton" Content="Create Model" Width="120" Click="Create_Click" IsEnabled="False"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Undo corner" Click="Undo_Click" Padding="10,4" Margin="0,0,8,0"/>
                    <Button Content="Clear" Click="Clear_Click" Padding="10,4" Margin="0,0,8,0"/>
                    <Button Content="Rectangle" Click="Rectangle_Click" Padding="10,4"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <GroupBox Header="XY drawing plane — +X right, +Y up">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="Drawing" Width="640" Height="480" Background="#20242A" ClipToBounds="True"
                            MouseLeftButtonDown="Drawing_MouseDown" MouseMove="Drawing_MouseMove"
                            MouseLeftButtonUp="Drawing_MouseUp" MouseRightButtonDown="Drawing_Undo"/>
                </Viewbox>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Extruded preview" Margin="8,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
                        <Button Content="Reset view" Click="ResetPreview_Click" Padding="6,3"/>
                        <TextBlock Text="Drag to rotate • wheel to zoom" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid x:Name="PreviewSurface" Background="Transparent" ClipToBounds="True"
                          MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove"
                          MouseLeftButtonUp="Preview_MouseUp" LostMouseCapture="Preview_LostMouseCapture" MouseWheel="Preview_MouseWheel">
                    <Viewport3D x:Name="Preview" IsHitTestVisible="False">
                    <Viewport3D.Camera><PerspectiveCamera Position="2,-2.5,2" LookDirection="-2,2.5,-2" UpDirection="0,0,1" FieldOfView="45"/></Viewport3D.Camera>
                    </Viewport3D>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
