                                        <TextBlock Text="String ID:" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedTlkString.StringID, TargetNullValue=''}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Resolved From:" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedTlkString.SourceName, TargetNullValue=''}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Usages:" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedTlkString.Usages.Count, TargetNullValue='0'}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Value:" FontWeight="Bold"/>
