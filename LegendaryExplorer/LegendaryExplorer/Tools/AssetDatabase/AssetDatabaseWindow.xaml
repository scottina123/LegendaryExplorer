                                                           FilterText="{Binding UsageFilterText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           UsagesSource="{Binding SelectedTlkString.Usages}"
                                                           HeaderToolTip="Every file that uses this TLK string&#x0a;Right click to open in the relevant tool.">
