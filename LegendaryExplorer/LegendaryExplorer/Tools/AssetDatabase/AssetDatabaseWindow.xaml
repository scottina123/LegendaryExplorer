                                </StackPanel>
                            </Border>
                            <assetDatabase:AssetUsagesPanel x:Name="actorsUsagesPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                                                           FilterText="{Binding UsageFilterText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           UsagesSource="{Binding SelectedItem.Usages, ElementName=lstbx_Actors}"
                                                           HeaderToolTip="Every file that contains this actor&#x0a;Right click to open in Package Editor">
                                <assetDatabase:AssetUsagesPanel.UsageContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open in Package Editor" Command="{Binding OpenUsagePkgCommand}" ToolTip="Open this actor in Package Editor."/>
                                        <MenuItem Header="Open in Windows Explorer" Command="{Binding OpenInWindowsExplorerCommand}" ToolTip="Opens this file in Windows Explorer."/>
                                    </ContextMenu>
                                </assetDatabase:AssetUsagesPanel.UsageContextMenu>
                            </assetDatabase:AssetUsagesPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Gesture Tracks" TabIndex="13">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                 <ColumnDefinition MinWidth="500" Width="3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gesture Tracks" Style="{StaticResource ColumnHeaderStyle}" ToolTip="BioEvtSysTrackGesture exports and their BioGestureData entries." Grid.Row="0" Grid.Column="0"/>
                             <ScrollViewer Grid.Row="1" Grid.ColumnSpan="4" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="4,2">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="Starting Pose Set:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <xctk:WatermarkTextBox Width="180" Margin="0,0,12,0"
                                                               Watermark="Any value"
                                                               Text="{Binding GestureStartingPoseSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="..." Padding="6,1" Margin="-8,0,12,0" Tag="StartingPoseSet" Click="BrowseGestureFilterValue_Click" ToolTip="Browse starting pose set names"/>
                                        <TextBlock Text="Starting Pose Anim:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <xctk:WatermarkTextBox Width="180" Margin="0,0,12,0"
                                                               Watermark="Any value"
                                                               Text="{Binding GestureStartingPoseAnim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="..." Padding="6,1" Margin="-8,0,12,0" Tag="StartingPoseAnim" Click="BrowseGestureFilterValue_Click" ToolTip="Browse starting pose animation names"/>
                                         <TextBlock Text="Node TLK:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                         <xctk:WatermarkTextBox Width="240" Margin="0,0,12,0"
                                                                Watermark="Text or StrRef"
                                                                Text="{Binding GestureNodeTlkFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="Add Gesture Group" Padding="8,2" Click="AddGestureCriterion_Click"
                                                ToolTip="Require another BioGestureData entry to match."/>
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding GestureCriteria}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <WrapPanel VerticalAlignment="Center" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding GroupLabel}" FontWeight="SemiBold" Width="72" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Pose Set:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="140" Margin="0,0,8,0" Watermark="Any" Text="{Binding PoseSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-4,0,8,0" Tag="PoseSet" CommandParameter="{Binding}" Click="BrowseGestureCriterionValue_Click" ToolTip="Browse pose set names"/>
                                                    <TextBlock Text="Pose Anim:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="140" Margin="0,0,8,0" Watermark="Any" Text="{Binding PoseAnim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-4,0,8,0" Tag="PoseAnim" CommandParameter="{Binding}" Click="BrowseGestureCriterionValue_Click" ToolTip="Browse pose animation names"/>
                                                    <TextBlock Text="Gesture Set:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="140" Margin="0,0,8,0" Watermark="Any" Text="{Binding GestureSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-4,0,8,0" Tag="GestureSet" CommandParameter="{Binding}" Click="BrowseGestureCriterionValue_Click" ToolTip="Browse gesture set names"/>
                                                    <TextBlock Text="Gesture Anim:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="140" Margin="0,0,8,0" Watermark="Any" Text="{Binding GestureAnim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-4,0,8,0" Tag="GestureAnim" CommandParameter="{Binding}" Click="BrowseGestureCriterionValue_Click" ToolTip="Browse gesture animation names"/>
                                                    <TextBlock Text="Transition Set:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="140" Margin="0,0,8,0" Watermark="Any" Text="{Binding TransitionSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-4,0,8,0" Tag="TransitionSet" CommandParameter="{Binding}" Click="BrowseGestureCriterionValue_Click" ToolTip="Browse transition set names"/>
                                                    <TextBlock Text="Transition Anim:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <xctk:WatermarkTextBox Width="140" Margin="0,0,8,0" Watermark="Any" Text="{Binding TransitionAnim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="..." Padding="5,1" Margin="-4,0,8,0" Tag="TransitionAnim" CommandParameter="{Binding}" Click="BrowseGestureCriterionValue_Click" ToolTip="Browse transition animation names"/>
                                                    <Button Content="Remove" Padding="8,2" Tag="{Binding}" Click="RemoveGestureCriterion_Click"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </WrapPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                             <controls:ListBoxScroll x:Name="lstbx_GestureTracks" MinWidth="300" Grid.Row="2" Grid.Column="0"
                                                     SelectionChanged="lstbx_GestureTracks_SelectionChanged">
                                <controls:ListBoxScroll.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TrackName}"/>
                                                <TextBlock FontSize="10" Text=" (" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="10" Text="{Binding Gestures.Count}" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="10" Text=" gestures)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding NodeTlkString}" FontSize="10" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:ListBoxScroll.ItemTemplate>
                                <controls:ListBoxScroll.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModHighlightItemStyle}"/>
                                </controls:ListBoxScroll.ItemContainerStyle>
                            </controls:ListBoxScroll>
                            <TextBlock Text="Gesture Data" Style="{StaticResource ColumnHeaderStyle}" ToolTip="Starting pose and BioGestureData values." Grid.Row="0" Grid.Column="1"/>
                            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0.65" Grid.Row="2" Grid.Column="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Starting Pose" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedItem.StartingPoseSet, ElementName=lstbx_GestureTracks, StringFormat=Set: {0}}"/>
                                        <TextBlock Text="{Binding SelectedItem.StartingPoseAnim, ElementName=lstbx_GestureTracks, StringFormat=Anim: {0}}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding SelectedItem.Gestures, ElementName=lstbx_GestureTracks}" AlternationCount="10000">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), StringFormat=Gesture {0}}"/>
                                                        <TextBlock Text="{Binding PoseSet, StringFormat=Pose Set: {0}}"/>
                                                        <TextBlock Text="{Binding PoseAnim, StringFormat=Pose Anim: {0}}"/>
                                                        <TextBlock Text="{Binding GestureSet, StringFormat=Gesture Set: {0}}"/>
                                                        <TextBlock Text="{Binding GestureAnim, StringFormat=Gesture Anim: {0}}"/>
                                                        <TextBlock Text="{Binding TransitionSet, StringFormat=Transition Set: {0}}"/>
                                                        <TextBlock Text="{Binding TransitionAnim, StringFormat=Transition Anim: {0}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                             <TextBlock Text="Gesture Preview" Style="{StaticResource ColumnHeaderStyle}" ToolTip="Toggle the gesture track preview on or off" Grid.Row="0" Grid.Column="2"/>
                             <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0.7" Grid.Row="2" Grid.Column="2">
                                 <DockPanel Margin="3">
                                     <ToggleButton x:Name="btn_GesturePreviewToggle" Content="Toggle Gesture Preview" MaxHeight="30" ClickMode="Release"
                                                   Click="btn_GesturePreviewToggle_Click" IsChecked="False" DockPanel.Dock="Bottom"/>
                                     <exportLoaderControls:GesturePreviewExportLoader x:Name="GesturePreviewControl"/>
                                 </DockPanel>
                             </Border>
                             <assetDatabase:AssetUsagesPanel x:Name="gestureTracksUsagesPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="3"
                                                           FilterText="{Binding UsageFilterText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           UsagesSource="{Binding SelectedItem.Usages, ElementName=lstbx_GestureTracks}"
                                                           HeaderToolTip="The package containing this gesture track&#x0a;Right click to open in Package Editor">
                                <assetDatabase:AssetUsagesPanel.UsageContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open in Package Editor" Command="{Binding OpenUsagePkgCommand}" ToolTip="Open this gesture track in Package Editor."/>
                                        <MenuItem Header="Open in Windows Explorer" Command="{Binding OpenInWindowsExplorerCommand}" ToolTip="Open this package in Windows Explorer."/>
                                    </ContextMenu>
                                </assetDatabase:AssetUsagesPanel.UsageContextMenu>
                            </assetDatabase:AssetUsagesPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Track Props" TabIndex="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Track Props" Style="{StaticResource ColumnHeaderStyle}" ToolTip="Prop and action names found in track property keys." Grid.Row="0" Grid.Column="0"/>
                            <controls:ListBoxScroll x:Name="lstbx_TrackProps" MinWidth="300" Grid.Row="1" Grid.Column="0">
                                <controls:ListBoxScroll.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PropName, StringFormat=nmProp: {0}}"/>
                                            <TextBlock Text="{Binding ActionName, StringFormat=nmAction: {0}}" FontSize="10" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:ListBoxScroll.ItemTemplate>
                                <controls:ListBoxScroll.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModHighlightItemStyle}"/>
                                </controls:ListBoxScroll.ItemContainerStyle>
                            </controls:ListBoxScroll>
                            <TextBlock Text="Details" Style="{StaticResource ColumnHeaderStyle}" ToolTip="Track property details." Grid.Row="0" Grid.Column="1"/>
                            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0.65" Grid.Row="1" Grid.Column="1">
                                <StackPanel Margin="5">
                                    <TextBlock Text="nmProp:" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedItem.PropName, ElementName=lstbx_TrackProps}" TextWrapping="Wrap"/>
                                    <TextBlock Text="nmAction:" Margin="0,8,0,2"/>
                                    <TextBlock Text="{Binding SelectedItem.ActionName, ElementName=lstbx_TrackProps}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Usages:" Margin="0,8,0,2"/>
                                    <TextBlock Text="{Binding SelectedItem.Usages.Count, ElementName=lstbx_TrackProps}"/>
                                </StackPanel>
                            </Border>
                            <assetDatabase:AssetUsagesPanel x:Name="trackPropsUsagesPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                                           FilterText="{Binding UsageFilterText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           UsagesSource="{Binding SelectedItem.Usages, ElementName=lstbx_TrackProps}"
                                                           HeaderToolTip="Every package containing this prop action&#x0a;Right click to open in Package Editor">
                                <assetDatabase:AssetUsagesPanel.UsageContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open in Package Editor" Command="{Binding OpenUsagePkgCommand}" ToolTip="Open this prop action in Package Editor."/>
                                        <MenuItem Header="Open in Windows Explorer" Command="{Binding OpenInWindowsExplorerCommand}" ToolTip="Open this package in Windows Explorer."/>
                                    </ContextMenu>
                                </assetDatabase:AssetUsagesPanel.UsageContextMenu>
                            </assetDatabase:AssetUsagesPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </DockPanel>
        <xctk:BusyIndicator.BusyContentTemplate>
            <DataTemplate>
                <Border DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyHeader}" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Text="{Binding BusyText}"/>
                        <ProgressBar Value="{Binding OverallProgressValue}" Maximum="{Binding OverallProgressMaximum}" IsIndeterminate="{Binding BusyBarInd}"  Margin="0,5,0,0" Height="15" />
                        <ItemsControl ItemsSource="{Binding AllGamesScanProgress}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Cancel" HorizontalAlignment="center" Margin="0,5,0,0" Padding="3"  Command="{Binding CancelDumpCommand}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </xctk:BusyIndicator.BusyContentTemplate>
        <xctk:BusyIndicator.ProgressBarStyle>
            <Style TargetType="ProgressBar" >
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
        </xctk:BusyIndicator.ProgressBarStyle>
    </xctk:BusyIndicator>
</bases:TrackingNotifyPropertyChangedWindowBase>
