                                      ItemsSource="{Binding DisplayedTlkStrings}"
                                      SelectedItem="{Binding SelectedTlkString, Mode=TwoWay}"
                                      Grid.Row="2"
                                      Grid.Column="0"
                                      Style="{StaticResource NoFocusBorderListViewStyle}"
                                      ItemContainerStyle="{DynamicResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource FileLVHeader}">
                                        <GridViewColumn DisplayMemberBinding="{Binding StringID}" Width="120" Header="TLK String Ref"/>
                                        <GridViewColumn DisplayMemberBinding="{Binding DisplayValue}" Width="420" Header="Line"/>
                                        <GridViewColumn DisplayMemberBinding="{Binding SourceName}" Width="220" Header="Source"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
