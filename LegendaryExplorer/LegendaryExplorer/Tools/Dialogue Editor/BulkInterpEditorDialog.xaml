<Window x:Class="LegendaryExplorer.DialogueEditor.BulkInterpEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        mc:Ignorable="d"
        Title="Bulk Interp Group Editor" 
        Height="600" Width="800" 
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Interp Groups in this InterpData" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="Edit the values below and click Apply to save changes. Group name changes will also update the associated SeqAct_Interp variable links. Find/Replace values in the Bulk Edit section will be applied before saving." 
                       TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding InterpGroupItems}" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="Cell"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Export" Binding="{Binding ExportName}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Class" Binding="{Binding ExportClass}" IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="Group Name" Binding="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                <DataGridTextColumn Header="m_nmSFXFindActor" Binding="{Binding SFXFindActor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                <DataGridTextColumn Header="m_nmFindActor" Binding="{Binding TrackFindActor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                <DataGridCheckBoxColumn Header="Modified" Binding="{Binding IsModified, Mode=OneWay}" IsReadOnly="True" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bulk Edit Section -->
        <GroupBox Grid.Row="2" Header="Bulk Edit" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Find:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="FindTextBox" Margin="5"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Replace:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="ReplaceTextBox" Width="150" Margin="5"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="5">
                    <CheckBox x:Name="ReplaceGroupName" Content="Group Name" IsChecked="True" Margin="5,0"/>
                    <CheckBox x:Name="ReplaceSFXFindActor" Content="m_nmSFXFindActor" IsChecked="True" Margin="5,0"/>
                    <CheckBox x:Name="ReplaceTrackFindActor" Content="Track m_nmFindActor" IsChecked="True" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Apply Changes" Click="Apply_Click" Padding="15,5" Margin="5"/>
            <Button Content="Close" Click="Cancel_Click" Padding="15,5" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
