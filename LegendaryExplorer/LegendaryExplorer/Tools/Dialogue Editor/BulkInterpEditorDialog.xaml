<Window x:Class="LegendaryExplorer.DialogueEditor.BulkInterpEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        mc:Ignorable="d"
        Title="Bulk Interp Group Editor" 
        Height="600" Width="800" 
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Closing="BulkInterpEditorDialog_Closing"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="BulkInterpModifiedCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="16" Height="16">
                            <Border x:Name="Box"
                                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    BorderThickness="1" />
                            <Path x:Name="CheckMark"
                                  Data="M 2 8 L 6 12 L 14 3"
                                  Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Interp Groups in this InterpData" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="Edit the values below and click Apply to save changes. Group name changes will also update the associated SeqAct_Interp variable links. Find/Replace values in the Bulk Edit section will be applied before saving." 
                       TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding InterpGroupItems}" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="Cell"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Export" Binding="{Binding ExportName}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Class" Binding="{Binding ExportClass}" IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="Group Name" Binding="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                <DataGridTextColumn Header="m_nmSFXFindActor" Binding="{Binding SFXFindActor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                <DataGridTextColumn Header="m_nmFindActor" Binding="{Binding TrackFindActor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                <DataGridTemplateColumn Header="Modified" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsModified, Mode=OneWay}" Style="{StaticResource BulkInterpModifiedCheckBoxStyle}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bulk Edit Section -->
        <GroupBox Grid.Row="2" Header="Bulk Edit" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Find" FontWeight="SemiBold" Margin="0,0,10,2"/>
                    <TextBlock Grid.Column="1" Text="Replace" FontWeight="SemiBold" Margin="0,0,10,2"/>
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NameReplacements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding DataContext.FindNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding Find, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Replace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,10,0"/>
                                    <Button Grid.Column="2" Content="Remove" Click="RemoveReplacement_Click" Padding="8,2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
                    <Button Content="Add replacement" Click="AddReplacement_Click" Padding="8,2" Margin="0,0,10,0"/>
                    <CheckBox x:Name="RememberReplacementsCheckBox"
                              Content="Remember replacements and row count across sessions"
                              IsChecked="{Binding RememberReplacements, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5">
                    <CheckBox x:Name="ReplaceGroupName" Content="Group Name" IsChecked="True" Margin="5,0"/>
                    <CheckBox x:Name="ReplaceSFXFindActor" Content="m_nmSFXFindActor" IsChecked="True" Margin="5,0"/>
                    <CheckBox x:Name="ReplaceTrackFindActor" Content="Track m_nmFindActor" IsChecked="True" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Apply Changes" Click="Apply_Click" Padding="15,5" Margin="5"/>
            <Button Content="Close" Click="Cancel_Click" Padding="15,5" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
