<Window x:Class="LegendaryExplorer.DialogueEditor.BulkDialogueNodeCreatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Dialogue Node Creator"
        Height="760"
        Width="760"
        MinHeight="450"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Text="Generate independent inclusive Entry and Reply TLK ranges, then edit or clear individual values before creating the nodes. Blank cells are skipped."
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Margin="0,0,8,0" Header="Entry range">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="First:" />
                    <TextBox x:Name="FirstEntryTlkTextBox" Grid.Column="1" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center" Text="Last:" />
                    <TextBox x:Name="LastEntryTlkTextBox" Grid.Column="3" />
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="1" Margin="0,0,8,0" Header="Reply range">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="First:" />
                    <TextBox x:Name="FirstReplyTlkTextBox" Grid.Column="1" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center" Text="Last:" />
                    <TextBox x:Name="LastReplyTlkTextBox" Grid.Column="3" />
                </Grid>
            </GroupBox>
            <Button Grid.Column="2" MinWidth="90" Click="GenerateRange_Click" Content="Generate" />
        </Grid>

        <GroupBox Grid.Row="2" Margin="0,0,0,10" Header="Custom InterpGroups">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,6"
                           Text="Add any extra groups required by each generated InterpData. Leave a field blank to omit that property."
                           TextWrapping="Wrap" />
                <DataGrid x:Name="CustomGroupsGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding CustomGroups}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="True"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Group Name"
                                            Binding="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*" />
                        <DataGridTextColumn Header="m_nmSFXFindActor"
                                            Binding="{Binding SFXFindActor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Margin="0,6,0,0" Orientation="Horizontal">
                    <Button MinWidth="130"
                            Margin="0,0,6,0"
                            Click="AddCustomGroup_Click"
                            Content="Add Custom Group" />
                    <Button MinWidth="150"
                            Click="RemoveCustomGroup_Click"
                            Content="Remove Selected Group" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid x:Name="TlkGrid"
                  Grid.Row="3"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Entry TLK"
                                    Binding="{Binding EntryTlk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                    Width="*" />
                <DataGridTextColumn Header="Reply TLK"
                                    Binding="{Binding ReplyTlk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" MinWidth="100" Margin="0,0,6,0" Click="ClearEntryColumn_Click" Content="Clear Entries" />
            <Button Grid.Column="1" MinWidth="100" Click="ClearReplyColumn_Click" Content="Clear Replies" />
            <Button Grid.Column="3" MinWidth="90" Margin="0,0,6,0" Click="Create_Click" IsDefault="True" Content="Create Nodes" />
            <Button Grid.Column="4" MinWidth="90" Click="Cancel_Click" IsCancel="True" Content="Cancel" />
        </Grid>
    </Grid>
</Window>
