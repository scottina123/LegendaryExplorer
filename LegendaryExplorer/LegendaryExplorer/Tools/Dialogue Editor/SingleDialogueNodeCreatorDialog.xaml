<Window x:Class="LegendaryExplorer.DialogueEditor.SingleDialogueNodeCreatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Dialogue Node with Sequence"
        Height="260"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   Text="Enter the values used to create the node and its sequence data."
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="1"
                   Margin="0,0,8,8"
                   VerticalAlignment="Center"
                   Text="TLK StringRef:" />
        <Grid Grid.Row="1"
              Margin="120,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TlkTextBox"
                     TextChanged="TlkTextBox_TextChanged" />
            <Button Grid.Column="1"
                    Width="28"
                    Margin="6,0,0,0"
                    Click="FindTlkText_Click"
                    Content="..."
                    ToolTip="Find a StringRef by text in the loaded TLKs" />
        </Grid>
        <TextBlock x:Name="TlkPreviewTextBlock"
                   Grid.Row="2"
                   Margin="120,0,0,8"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="3"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Text="Owner actor name:" />
        <TextBox x:Name="OwnerFindActorTextBox"
                  Grid.Row="3"
                 Margin="120,0,0,0" />
        <StackPanel Grid.Row="5"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="90"
                    Margin="0,0,8,0"
                    Click="Create_Click"
                    Content="Create"
                    IsDefault="True" />
            <Button MinWidth="90"
                    Click="Cancel_Click"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
