<misc:NotifyPropertyChangedControlBase x:Class="LegendaryExplorer.Tools.PlotEditor.CodexMapView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:local="clr-namespace:LegendaryExplorer.Tools.PlotEditor"
    xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
    xmlns:controls="clr-namespace:LegendaryExplorer.SharedUI.Controls"
    xmlns:Converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
	mc:Ignorable="d"
	DataContext="{Binding RelativeSource={RelativeSource Self}}"
	d:DesignHeight="600" d:DesignWidth="800">
	<!-- UserControl Resources -->
    <UserControl.Resources>
        <Converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <Converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="{x:Type ListBox}" x:Key="ListBoxStyle" BasedOn="{StaticResource {x:Type ListBox}}">
            <Style.Triggers>
                <Trigger Property="HasItems" Value="True">
                    <Setter Property="SelectedIndex" Value="0" />
                </Trigger>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="SelectedIndex" Value="-1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CodexStringTextboxStyle" TargetType="{x:Type TextBox}">
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResolvedTextContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResolvedTextMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                                <TextBlock x:Name="GestureText"
                                           Grid.Column="1"
                                           Margin="24,0,12,0"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           Opacity="0.75"
                                           Text="{TemplateBinding InputGestureText}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                <Setter TargetName="GestureText" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="InputGestureText" Value="">
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResolvedCodexTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource CodexStringTextboxStyle}">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Style="{StaticResource ResolvedTextContextMenuStyle}">
                        <MenuItem Header="Copy"
                                  Style="{StaticResource ResolvedTextMenuItemStyle}"
                                  Command="{x:Static ApplicationCommands.Copy}"
                                  InputGestureText="Ctrl+C"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Select All"
                                  Style="{StaticResource ResolvedTextMenuItemStyle}"
                                  Command="{x:Static ApplicationCommands.SelectAll}"
                                  InputGestureText="Ctrl+A"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodexTreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:CodexSectionTreeItem}" ItemsSource="{Binding Pages}">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{Binding CodexSection.Key, StringFormat='Section \{0\}'}"/>
                <TextBlock Text="{Binding CodexSection.Value.TitleAsString}" TextWrapping="Wrap" FontSize="10" Visibility="{Binding CodexSection.Value.TitleAsString, Converter={StaticResource NullVisibilityConverter}}"/>
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Change Id" Click="ChangeCodexSectionId_Click" IsEnabled="{Binding IsEditable}"/>
                        <MenuItem Header="Copy" Click="CopyCodexSection_Click" IsEnabled="{Binding IsEditable}"/>
                        <MenuItem Header="Remove" Click="RemoveCodexSection_Click" IsEnabled="{Binding IsEditable}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type local:CodexPageTreeItem}">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{Binding CodexPage.Key, StringFormat='Page \{0\}'}"/>
                <TextBlock Text="{Binding CodexPage.Value.TitleAsString}" TextWrapping="Wrap" FontSize="10" Visibility="{Binding CodexPage.Value.TitleAsString, Converter={StaticResource NullVisibilityConverter}}"/>
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Change Id" Click="ChangeCodexPageId_Click"/>
                        <MenuItem Header="Copy" Click="CopyCodexPage_Click"/>
                        <MenuItem Header="Remove" Click="RemoveCodexPage_Click"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Content -->
	<Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="100" Width="300" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:SearchBox Grid.Row="0" Margin="0,0,0,5"
                                WatermarkText="Search title/description IDs or text"
                                TextChanged="CodexSearchBox_TextChanged"/>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedCodexTreeTabIndex}">
                <TabItem Header="Primary">
                    <TreeView x:Name="PrimaryCodexTreeView"
                              Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                              ItemsSource="{Binding PrimaryCodexTreeItems}"
                              SelectedItemChanged="CodexTreeView_SelectedItemChanged"
                              ItemContainerStyle="{StaticResource CodexTreeViewItemStyle}" />
                </TabItem>
                <TabItem Header="Secondary">
                    <TreeView x:Name="SecondaryCodexTreeView"
                              Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                              ItemsSource="{Binding SecondaryCodexTreeItems}"
                              SelectedItemChanged="CodexTreeView_SelectedItemChanged"
                              ItemContainerStyle="{StaticResource CodexTreeViewItemStyle}" />
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Add Section" Click="AddCodexSection_Click"/>
                <Button Grid.Column="2" Content="Add Page" Click="AddCodexPage_Click"/>
                <Button Grid.Column="4" Content="Remove" Click="RemoveSelectedCodexItem_Click" IsEnabled="{Binding CanRemoveSelectedCodexItem}"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Margin="-3,0"
                      BorderThickness="3,0"
                      BorderBrush="Transparent"
                      HorizontalAlignment="Stretch" />

        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="5,0,0,0">
            <TextBlock Text="Select a codex section or page."
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Visibility="{Binding CanRemoveSelectedCodexItem, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}" />

            <Grid Visibility="{Binding IsCodexSectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition MaxWidth="650" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Instance Version:" Grid.Column="0" Grid.Row="0" />
                <xctk:IntegerUpDown Grid.Column="1" Grid.Row="0" Margin="0,5"
                    Text="{Binding Path=SelectedCodexSection.Value.InstanceVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"
                    IsEnabled="{Binding IsSelectedCodexSectionEditable}" />

                <Label Content="Title:" Grid.Column="0" Grid.Row="1" />
                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                    <xctk:IntegerUpDown x:Name="CodexSectionTitleTlk" Margin="0,5"
                        Value="{Binding Path=SelectedCodexSection.Value.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" ValueChanged="txt_ValueChanged"
                        IsEnabled="{Binding IsSelectedCodexSectionEditable}"/>
                    <Button Margin="5" Padding="5,0" Content="..." Click="FindTlkString_Click" Tag="{Binding ElementName=CodexSectionTitleTlk}" ToolTip="Find a StringRef by text in the loaded TLKs" IsEnabled="{Binding IsSelectedCodexSectionEditable}"/>
                </StackPanel>
                <TextBox Name="txt_cdxSecTitle" Grid.Column="2" Grid.Row="1" IsReadOnly="True" Style="{StaticResource ResolvedCodexTextBoxStyle}"
                         VerticalAlignment="Center" Margin="10,5" Padding="3,3" HorizontalContentAlignment="Left"/>

                <Label Content="Description:" Grid.Column="0" Grid.Row="2" />
                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
                    <xctk:IntegerUpDown x:Name="CodexSectionDescriptionTlk" Margin="0,5"
                        Value="{Binding Path=SelectedCodexSection.Value.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" ValueChanged="txt_ValueChanged"
                        IsEnabled="{Binding IsSelectedCodexSectionEditable}"/>
                    <Button Margin="5" Padding="5,0" Content="..." Click="FindTlkString_Click" Tag="{Binding ElementName=CodexSectionDescriptionTlk}" ToolTip="Find a StringRef by text in the loaded TLKs" IsEnabled="{Binding IsSelectedCodexSectionEditable}"/>
                </StackPanel>
                <TextBox Name="txt_cdxSecDesc" Grid.Column="2" Grid.Row="2" IsReadOnly="True" Style="{StaticResource ResolvedCodexTextBoxStyle}"
                         Grid.RowSpan="5" TextAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" MaxLines="8" Padding="3,3" Margin="10,5"
                         HorizontalContentAlignment="Left" VerticalScrollBarVisibility="Auto"/>

                <Label Content="Texture Index:" Grid.Column="0" Grid.Row="3" />
                <xctk:IntegerUpDown Grid.Column="1" Grid.Row="3" Margin="0,5"
                    Text="{Binding Path=SelectedCodexSection.Value.TextureIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"
                    IsEnabled="{Binding IsSelectedCodexSectionEditable}" />

                <Label Content="Priority:" Grid.Column="0" Grid.Row="4" />
                <xctk:IntegerUpDown Grid.Column="1" Grid.Row="4" Margin="0,5"
                    Text="{Binding Path=SelectedCodexSection.Value.Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"
                    IsEnabled="{Binding IsSelectedCodexSectionEditable}" />

                <Label Content="Is Primary:" Grid.Column="0" Grid.Row="5" />
                <CheckBox Grid.Column="1" Grid.Row="5" Margin="0,5"
                    IsChecked="{Binding Path=SelectedCodexSection.Value.IsPrimary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Checked="CodexSectionIsPrimary_Changed"
                    Unchecked="CodexSectionIsPrimary_Changed"
                    Width="100" VerticalAlignment="Center"
                    IsEnabled="{Binding IsSelectedCodexSectionEditable}"/>

                <Label Content="Sound Object:" Grid.Column="0" Grid.Row="6" />
                <xctk:IntegerUpDown Grid.Column="1" Grid.Row="6" Margin="0,5"
                    Text="{Binding Path=SelectedCodexSection.Value.CodexSound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"
                    IsEnabled="{Binding IsSelectedCodexSectionEditable}" />

                <TextBlock Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="2"
                           Margin="0,10,10,0"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="{Binding SelectedCodexSectionReadOnlyMessage}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasSelectedCodexSectionReadOnlyMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <Grid Visibility="{Binding IsCodexPageSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition MaxWidth="650" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Instance Version:" Grid.Column="0" Grid.Row="0" />
                <xctk:IntegerUpDown Grid.Column="1" Grid.Row="0" Margin="0,5"
                    Text="{Binding Path=SelectedCodexPage.Value.InstanceVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />

                <Label Content="Title:" Grid.Column="0" Grid.Row="1" />
                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                    <xctk:IntegerUpDown x:Name="CodexPageTitleTlk" Margin="0,5"
                        Value="{Binding Path=SelectedCodexPage.Value.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" ValueChanged="txt_ValueChanged"/>
                    <Button Margin="5" Padding="5,0" Content="..." Click="FindTlkString_Click" Tag="{Binding ElementName=CodexPageTitleTlk}" ToolTip="Find a StringRef by text in the loaded TLKs"/>
                </StackPanel>
                <TextBox Name="txt_cdxPgeTitle" Grid.Column="2" Grid.Row="1" IsReadOnly="True" Style="{StaticResource ResolvedCodexTextBoxStyle}"
                         VerticalAlignment="Center" Padding="3,3" Margin="10,5" HorizontalContentAlignment="Left"/>

                <Label Content="Description:" Grid.Column="0" Grid.Row="2" />
                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
                    <xctk:IntegerUpDown x:Name="CodexPageDescriptionTlk" Margin="0,5"
                        Value="{Binding Path=SelectedCodexPage.Value.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" ValueChanged="txt_ValueChanged"/>
                    <Button Margin="5" Padding="5,0" Content="..." Click="FindTlkString_Click" Tag="{Binding ElementName=CodexPageDescriptionTlk}" ToolTip="Find a StringRef by text in the loaded TLKs"/>
                </StackPanel>
                <TextBox Name="txt_cdxPgeDesc" Grid.Column="2" Grid.Row="2" IsReadOnly="True" Style="{StaticResource ResolvedCodexTextBoxStyle}"
                         Grid.RowSpan="3" TextAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Padding="3,3" Margin="10,5"
                         HorizontalContentAlignment="Left" VerticalScrollBarVisibility="Auto"/>

                <Label Content="Texture Index:" Grid.Column="0" Grid.Row="3" />
                <xctk:IntegerUpDown Grid.Column="1" Grid.Row="3" Margin="0,5"
                    Text="{Binding Path=SelectedCodexPage.Value.TextureIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />

                <Label Content="Priority:" Grid.Column="0" Grid.Row="4" />
                <xctk:IntegerUpDown Grid.Column="1" Grid.Row="4" Margin="0,5"
                    Text="{Binding Path=SelectedCodexPage.Value.Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />

                <Label Content="Section:" Grid.Column="0" Grid.Row="5" />
                <xctk:IntegerUpDown Grid.Column="1" Grid.Row="5" Margin="0,5"
                    Text="{Binding Path=SelectedCodexPage.Value.Section, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" ValueChanged="CodexPageSection_ValueChanged"/>
                <ComboBox Grid.Column="2" Grid.Row="5"
                          Margin="10,5"
                          ItemsSource="{Binding VanillaCodexSectionOptions}"
                          SelectedValue="{Binding Path=SelectedCodexPage.Value.Section, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Key"
                          IsEnabled="{Binding HasVanillaCodexSectionOptions}"
                          IsTextSearchEnabled="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Value.TitleAsString}" TextWrapping="Wrap" />
                                <TextBlock Margin="6,0,0,0"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding Key, StringFormat='({0})'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Label Content="Audio Event:" Grid.Column="0" Grid.Row="6" VerticalAlignment="Top" />
                <TextBox Grid.Column="1" Grid.Row="6" Grid.ColumnSpan="2"
                         Margin="0,5,10,5"
                         Padding="3,3"
                         IsReadOnly="True"
                         Style="{StaticResource ResolvedCodexTextBoxStyle}"
                         Text="{Binding CurrentCodexPageWwiseEventDisplay}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Top"
                         HorizontalContentAlignment="Left" />

                <WrapPanel Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,5,0,0">
                    <Button Content="Add Audio" Click="AddCodexPageAudio_Click" IsEnabled="{Binding CanAddCodexPageAudio}" Margin="0,0,5,5"/>
                    <Button Content="Play Audio" Click="PlayCodexPageAudio_Click" IsEnabled="{Binding HasCodexPageAudioReference}" Margin="0,0,5,5"/>
                    <Button Content="Stop Audio" Click="StopCodexPageAudio_Click" IsEnabled="{Binding CanStopCodexPageAudio}" Margin="0,0,5,5"/>
                    <Button Content="Replace Audio" Click="ReplaceCodexPageAudio_Click" IsEnabled="{Binding HasCodexPageAudioReference}" Margin="0,0,5,5"/>
                    <Button Content="Extract Audio" Click="ExtractCodexPageAudio_Click" IsEnabled="{Binding HasCodexPageAudioReference}" Margin="0,0,5,5"/>
                    <Button Content="Remove Audio" Click="RemoveCodexPageAudio_Click" IsEnabled="{Binding HasCodexPageAudioReference}" Margin="0,0,5,5"/>
                </WrapPanel>
            </Grid>
        </Grid>
	</Grid>
</misc:NotifyPropertyChangedControlBase>
