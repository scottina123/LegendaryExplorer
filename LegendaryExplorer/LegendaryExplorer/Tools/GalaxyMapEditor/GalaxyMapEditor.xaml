<bases:WPFBase
        x:Class="LegendaryExplorer.Tools.GalaxyMapEditor.GalaxyMapEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.GalaxyMapEditor"
        xmlns:scene3D="clr-namespace:LegendaryExplorer.Tools.LevelEditor.Scene3D"
        xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
        xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sharedToolControls="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        AllowDrop="True"
        Loaded="GalaxyMapEditor_Loaded"
        Closing="GalaxyMapEditor_Closing"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Galaxy Map Editor" Height="800" Width="1200">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullEnabledConverter x:Key="NullEnabledConverter"/>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <converters:GameTypeConverter x:Key="GameTypeConverter"/>
        <converters:GameToImageIconConverter x:Key="GameToImageIconConverter"/>
        <sharedUi:BindingProxy x:Key="bindingProxy" Data="{Binding}"/>
        <TextDecorationCollection x:Key="XTextDeco">
            <TextDecoration Location="Underline" PenOffset="2">
                <TextDecoration.Pen>
                    <Pen Brush="Red" Thickness="3"/>
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>
        <TextDecorationCollection x:Key="YTextDeco">
            <TextDecoration Location="Underline" PenOffset="2">
                <TextDecoration.Pen>
                    <Pen Brush="#00C91D" Thickness="3"/>
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>
        <TextDecorationCollection x:Key="ZTextDeco">
            <TextDecoration Location="Underline" PenOffset="2">
                <TextDecoration.Pen>
                    <Pen Brush="Blue" Thickness="3"/>
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="F" Command="{Binding FocusSelectedCommand}"/>
        <KeyBinding Key="Backspace" Command="{Binding NavigateUpCommand}"/>
        <KeyBinding Key="Return" Command="{Binding NavigateIntoCommand}"/>
    </Window.InputBindings>
    <xctk:BusyIndicator IsBusy="{Binding IsBusy}" BusyContent="{Binding BusyText}">
        <DockPanel>
            <!-- Menu -->
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File" Padding="4">
                    <MenuItem Header="Open" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                    <Separator/>
                    <MenuItem Header="Save" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S" IsEnabled="{Binding HasFileOpen}"/>
                    <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" IsEnabled="{Binding HasFileOpen}"/>
                </MenuItem>
            </Menu>

            <!-- Toolbar -->
            <WrapPanel DockPanel.Dock="Top">
                <ToolBar ToolBarTray.IsLocked="True" OverflowMode="Never">
                    <Button Content="Commit Changes" ToolTip="Write position changes back to exports" Command="{Binding CommitChangesCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="true">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <Button Content="⬆ Navigate Up" ToolTip="Go back to parent level (Backspace)" Command="{Binding NavigateUpCommand}"/>
                    <TextBlock Text="{Binding BreadcrumbText}" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold"
                               Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
                    <Separator Visibility="Collapsed" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <RadioButton Visibility="Collapsed" GroupName="WidgetMode" ToolTip="Translate" Command="{Binding ToggleTranslateCommand}" IsChecked="True">
                        Translate
                    </RadioButton>
                    <RadioButton Visibility="Collapsed" GroupName="WidgetMode" ToolTip="Rotate" Command="{Binding ToggleRotateCommand}">
                        Rotate
                    </RadioButton>
                    <RadioButton Visibility="Collapsed" GroupName="WidgetMode" ToolTip="Scale" Command="{Binding ToggleScaleCommand}">
                        Scale
                    </RadioButton>
                    <RadioButton Visibility="Collapsed" GroupName="WidgetMode" ToolTip="Uniform Scale" Command="{Binding ToggleUniformScaleCommand}">
                        Uniform Scale
                    </RadioButton>
                    <Separator Visibility="Collapsed" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <ToggleButton Visibility="Collapsed" Content="Local Coords" ToolTip="Use local coordinates for the transform widget" IsChecked="{Binding UseLocalCoordsForWidget}"/>
                </ToolBar>
            </WrapPanel>

            <!-- Status bar -->
            <StatusBar Height="23" DockPanel.Dock="Bottom">
                <sharedToolControls:StatusBarGameIDIndicator Visibility="{Binding HasFileOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                                                             GameType="{Binding Game}" Margin="0,-4"/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusBar_LeftMostText" Text="Open a galaxy map package to begin"/>
                </StatusBarItem>
                <StatusBarItem Visibility="{Binding SelectedObject, Converter={StaticResource NullVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedObject.Export.ObjectName.Instanced, StringFormat='Selected: {0}'}"
                               Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
                </StatusBarItem>
                <StatusBarItem Visibility="{Binding HasFileOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding CurrentModeName, StringFormat='Mode: {0}'}" Foreground="Gray"/>
                </StatusBarItem>
            </StatusBar>

            <!-- Main content -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="80" Width="280"/>
                    <ColumnDefinition MinWidth="5" MaxWidth="5"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition MinWidth="5" MaxWidth="5"/>
                    <ColumnDefinition MinWidth="80" Width="340"/>
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

                <!-- Left panel: object list -->
                <DockPanel Grid.Column="0">
                    <xctk:WatermarkTextBox DockPanel.Dock="Top" Watermark="Filter objects..."
                                           x:Name="FilterTextBox" Margin="5,2,5,2" Height="22"
                                           KeyUp="FilterTextBox_KeyUp" IsEnabled="{Binding HasFileOpen}"
                                           VerticalContentAlignment="Center"/>

                    <TextBlock DockPanel.Dock="Top" Margin="5,2" FontWeight="Bold"
                               Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                               Text="{Binding BreadcrumbText}"
                               Visibility="{Binding HasFileOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding CurrentObjectsView}"
                             x:Name="ObjectsList" SelectedItem="{Binding SelectedObject}"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="ObjectsList_MouseDoubleClick"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type local:GalaxyMapObjectProxy}">
                                <Border x:Name="ObjectItemBorder" Margin="2" Padding="1" CornerRadius="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ObjectUIndexText" Text="{Binding Export.UIndex, Mode=OneTime}" VerticalAlignment="Center"
                                                       Margin="0,0,5,0" FontWeight="Bold" ToolTip="Export UIndex"/>
                                            <TextBlock x:Name="ObjectNameText" Text="{Binding Export.ObjectName.Instanced, Mode=OneTime}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ObjectClassText" Text="{Binding Export.ClassName, Mode=OneTime, StringFormat=' ({0})'}"
                                                       VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                                            <TextBlock x:Name="ObjectNavigateText" Text=" ▶" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                                       FontWeight="Bold"
                                                       Visibility="{Binding CanNavigateInto, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       ToolTip="Double-click to navigate into"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ObjectSubtitleText" Text="{Binding ListDisplaySubtitle}" Margin="24,0,0,0" Foreground="Gray" FontSize="11"
                                                   Visibility="{Binding HasListDisplaySubtitle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Export.EntryHasPendingChanges}" Value="True">
                                        <Setter TargetName="ObjectItemBorder" Property="Background" Value="#3327AE60"/>
                                        <Setter TargetName="ObjectUIndexText" Property="Foreground" Value="#6DFF9E"/>
                                        <Setter TargetName="ObjectNameText" Property="Foreground" Value="#6DFF9E"/>
                                        <Setter TargetName="ObjectClassText" Property="Foreground" Value="#9CFFBF"/>
                                        <Setter TargetName="ObjectSubtitleText" Property="Foreground" Value="#9CFFBF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                            <ContextMenu x:Key="ObjectContextMenu">
                                <MenuItem Header="Focus Camera" Command="{Binding Data.FocusSelectedCommand, Source={StaticResource bindingProxy}}" InputGestureText="F"/>
                                <MenuItem Header="Navigate Into" Command="{Binding Data.NavigateIntoCommand, Source={StaticResource bindingProxy}}" InputGestureText="Enter"/>
                                <Separator/>
                                <MenuItem Header="Open in Package Editor" Command="{Binding Data.OpenInPackageEditorCommand, Source={StaticResource bindingProxy}}"/>
                            </ContextMenu>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="ContextMenu" Value="{StaticResource ObjectContextMenu}"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>

                <!-- Center: 3D viewport -->
                <scene3D:SceneRenderControl Grid.Column="2" x:Name="SceneViewer"/>

                <!-- Right panel: properties + transforms -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="5,5,5,0"
                               Visibility="{Binding SelectedObject, Converter={StaticResource NullVisibilityConverter}}">
                        <TextBlock Text="Editing:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding EditableExports}"
                                  SelectedItem="{Binding SelectedEditableExport}"
                                  DisplayMemberPath="DisplayText"
                                  MinWidth="160"/>
                    </DockPanel>

                    <TabControl Grid.Row="1" x:Name="PropertiesTabControl">
                        <TabItem Header="Properties">
                            <exportLoaderControls:InterpreterExportLoader x:Name="GalaxyMapInterpreter" HideHexBox="True"/>
                        </TabItem>
                        <TabItem Header="Metadata">
                            <exportLoaderControls:EntryMetadataExportLoader x:Name="GalaxyMapMetadata"/>
                        </TabItem>
                    </TabControl>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel IsEnabled="{Binding SelectedObject, Converter={StaticResource NullEnabledConverter}}"
                                    DataContext="{Binding SelectedObject}">

                            <!-- Galaxy Map Position editor (PosX / PosY integer properties) -->
                            <GroupBox Header="Galaxy Map Position" Margin="5,5,5,5" BorderThickness="2" Padding="5">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PosX:  " VerticalAlignment="Center"/>
                                        <xctk:IntegerUpDown Value="{Binding GalaxyMapPosX}"
                                                            Increment="{Binding GalaxyMapPosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                            ButtonSpinnerLocation="Left" MinWidth="80"/>
                                        <TextBlock Text="  PosY:  " VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <xctk:IntegerUpDown Value="{Binding GalaxyMapPosY}"
                                                            Increment="{Binding GalaxyMapPosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                            ButtonSpinnerLocation="Left" MinWidth="80"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock Text=" Increment:  " VerticalAlignment="Center"/>
                                        <xctk:IntegerUpDown Value="{Binding GalaxyMapPosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                            Minimum="1" ButtonSpinnerLocation="Left"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!--
                            Hidden: Object Position / Rotation / DrawScale boxes (kept for potential future use)

                            <GroupBox Header="Object Position" Margin="5,5,5,5" BorderThickness="2" Padding="5">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="X:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}"/>
                                            <xctk:SingleUpDown Value="{Binding XPos}"
                                                               Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                               ButtonSpinnerLocation="Left" FormatString="F3"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="3,0,3,0">
                                            <TextBlock Text="Y:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}"/>
                                            <xctk:SingleUpDown Value="{Binding YPos}"
                                                               Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                               ButtonSpinnerLocation="Left" FormatString="F3"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Z:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}"/>
                                            <xctk:SingleUpDown Value="{Binding ZPos}"
                                                               Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                               ButtonSpinnerLocation="Left" FormatString="F3"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock Text=" Increment:  " VerticalAlignment="Center"/>
                                        <xctk:SingleUpDown Value="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                           Minimum="0" ButtonSpinnerLocation="Left" FormatString="F3"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Object Rotation" Margin="5,0,5,5" BorderThickness="2" Padding="5">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text=" Roll:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}"/>
                                        <xctk:SingleUpDown Value="{Binding RollDegrees}"
                                                           Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                           ButtonSpinnerLocation="Left"/>
                                        <TextBlock Text=" Pitch:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}"/>
                                        <xctk:SingleUpDown Value="{Binding PitchDegrees}"
                                                           Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                           ButtonSpinnerLocation="Left"/>
                                        <TextBlock Text=" Yaw:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}"/>
                                        <xctk:SingleUpDown Value="{Binding YawDegrees}"
                                                           Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                           ButtonSpinnerLocation="Left"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Object DrawScale" Margin="5,0,5,5" BorderThickness="2" Padding="5">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text=" Scale:  " VerticalAlignment="Center"/>
                                        <xctk:SingleUpDown Value="{Binding DrawScale}"
                                                           Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                           ButtonSpinnerLocation="Left" FormatString="F3"/>
                                        <TextBlock Text=" X:  " VerticalAlignment="Center" TextDecorations="{StaticResource XTextDeco}"/>
                                        <xctk:SingleUpDown Value="{Binding XScale}"
                                                           Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                           ButtonSpinnerLocation="Left" FormatString="F3"/>
                                        <TextBlock Text=" Y:  " VerticalAlignment="Center" TextDecorations="{StaticResource YTextDeco}"/>
                                        <xctk:SingleUpDown Value="{Binding YScale}"
                                                           Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                           ButtonSpinnerLocation="Left" FormatString="F3"/>
                                        <TextBlock Text=" Z:  " VerticalAlignment="Center" TextDecorations="{StaticResource ZTextDeco}"/>
                                        <xctk:SingleUpDown Value="{Binding ZScale}"
                                                           Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType={x:Type local:GalaxyMapEditor}}}"
                                                           ButtonSpinnerLocation="Left" FormatString="F3"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Welcome overlay when no file is open -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="5"
                            Visibility="{Binding HasFileOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Not'}"
                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <TextBlock Margin="10" Text="Galaxy Map Editor" FontWeight="Bold" FontSize="18" TextWrapping="Wrap"/>
                    <TextBlock Margin="10,0,10,10" TextWrapping="Wrap">
                        Open a galaxy map package file (e.g. BioD_Nor_Galaxy.pcc for ME3) to view and edit the galaxy map hierarchy.
                        <LineBreak/><LineBreak/>
                        Features:
                        <LineBreak/>• Navigate into clusters and solar systems by double-clicking
                        <LineBreak/>• Move planets, stars, and other objects in the 3D viewport
                        <LineBreak/>• Edit positions, rotations, and scales numerically
                        <LineBreak/>• View and edit properties via the Properties panel
                        <LineBreak/><LineBreak/>
                        You can also drag and drop a package file onto this window.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DockPanel>
    </xctk:BusyIndicator>
</bases:WPFBase>
