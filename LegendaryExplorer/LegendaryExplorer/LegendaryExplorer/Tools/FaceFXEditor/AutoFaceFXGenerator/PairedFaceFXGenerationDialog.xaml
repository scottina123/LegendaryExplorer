<Window x:Class="LegendaryExplorer.Tools.FaceFXEditor.AutoFaceFXGenerator.PairedFaceFXGenerationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.FaceFXEditor.AutoFaceFXGenerator"
        mc:Ignorable="d"
        Title="Male and Female FaceFX Generation"
        Height="515" Width="820"
        MinHeight="515" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance Type={x:Type local:PairedFaceFXGenerationDialog}, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryColorBrush}" Padding="10">
            <StackPanel>
                <TextBlock Text="Male and Female FaceFX Generation" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Configure both sets of new FaceFX lines together" FontSize="12" Foreground="White" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Padding="10">
                <GroupBox.Header>
                    <CheckBox Content="Generate female FaceFX"
                              IsChecked="{Binding Female.Generate}"
                              IsEnabled="{Binding Female.IsAvailable}"
                              FontWeight="SemiBold"/>
                </GroupBox.Header>
                <StackPanel IsEnabled="{Binding Female.Generate}">
                    <TextBlock Text="{Binding Female.LineCountText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Margin="0,0,0,10" Visibility="{Binding Female.TargetVisibility}">
                        <TextBlock Text="Target:" FontSize="12" Opacity="0.8"/>
                        <TextBlock Text="{Binding Female.TargetText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="Species:" Width="105"/>
                        <ComboBox ItemsSource="{Binding Female.AvailableSpecies}"
                                  SelectedItem="{Binding Female.SelectedSpecies}"
                                  Width="210" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="Intensity Scale:" Width="105"/>
                        <Slider Value="{Binding Female.LipSyncIntensity}" Minimum="0.1" Maximum="2.0"
                                Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Female.LipSyncIntensity, StringFormat={}{0:F1}}"
                                   Width="40" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                    <CheckBox Content="Generate Blink Animation"
                              IsChecked="{Binding Female.GenerateBlinkAnimation}"
                              Margin="5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5"
                                IsEnabled="{Binding Female.GenerateBlinkAnimation}">
                        <Label Content="Blink Frequency:" Width="105"/>
                        <Slider Value="{Binding Female.BlinkFrequency}" Minimum="0.1" Maximum="0.5"
                                Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Female.BlinkFrequency, StringFormat={}{0:F2}/s}"
                                   Width="50" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Padding="10">
                <GroupBox.Header>
                    <CheckBox Content="Generate male FaceFX"
                              IsChecked="{Binding Male.Generate}"
                              IsEnabled="{Binding Male.IsAvailable}"
                              FontWeight="SemiBold"/>
                </GroupBox.Header>
                <StackPanel IsEnabled="{Binding Male.Generate}">
                    <TextBlock Text="{Binding Male.LineCountText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Margin="0,0,0,10" Visibility="{Binding Male.TargetVisibility}">
                        <TextBlock Text="Target:" FontSize="12" Opacity="0.8"/>
                        <TextBlock Text="{Binding Male.TargetText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="Species:" Width="105"/>
                        <ComboBox ItemsSource="{Binding Male.AvailableSpecies}"
                                  SelectedItem="{Binding Male.SelectedSpecies}"
                                  Width="210" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Label Content="Intensity Scale:" Width="105"/>
                        <Slider Value="{Binding Male.LipSyncIntensity}" Minimum="0.1" Maximum="2.0"
                                Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Male.LipSyncIntensity, StringFormat={}{0:F1}}"
                                   Width="40" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                    <CheckBox Content="Generate Blink Animation"
                              IsChecked="{Binding Male.GenerateBlinkAnimation}"
                              Margin="5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5"
                                IsEnabled="{Binding Male.GenerateBlinkAnimation}">
                        <Label Content="Blink Frequency:" Width="105"/>
                        <Slider Value="{Binding Male.BlinkFrequency}" Minimum="0.1" Maximum="0.5"
                                Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Male.BlinkFrequency, StringFormat={}{0:F2}/s}"
                                   Width="50" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,2">
                <TextBlock Text="Lines with TLK text will have animations generated; lines without TLK text will be skipped."
                           FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" Padding="10" CornerRadius="3">
                    <TextBlock Text="⚠ This operation cannot be undone." TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderColorBrush}" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Generate Selected" Width="120" Margin="0,0,10,0"
                        Click="GenerateButton_Click" IsDefault="True" IsEnabled="{Binding CanGenerate}"/>
                <Button Content="Cancel" Width="100" Click="CancelButton_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
