<misc:NotifyPropertyChangedControlBase x:Class="LegendaryExplorer.Tools.FaceFXEditor.AutoFaceFXGenerator.FaceFXEmotionPreviewControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:shared="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls"
        Loaded="Preview_Loaded">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <WrapPanel>
                <Button Content="Choose Head Mesh…" Click="ChooseHeadMesh_Click" Padding="8,4" Margin="0,0,5,4"/>
                <Button Content="Open Head PCC…" Click="OpenHeadPcc_Click" Padding="8,4" Margin="0,0,0,4"/>
            </WrapPanel>
            <TextBlock Text="{Binding HeadMeshLabel}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <Button Content="Choose FaceFX Rig…" Click="ChooseRig_Click" Padding="8,4" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding RigLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <shared:AnimationPreviewControl x:Name="headPreview" Grid.Row="2" MinHeight="150" ShowPlaybackControls="False"/>
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,7"/>
        <Slider Grid.Row="4" x:Name="audioTimeline" Minimum="0" Maximum="{Binding Duration}"
                Value="{Binding Position, Mode=TwoWay}" IsMoveToPointEnabled="True"
                SmallChange="0.01" LargeChange="0.1" ToolTip="Scrub audio and facial animation (seconds)"/>
        <DockPanel Grid.Row="5" Margin="0,6,0,0">
            <Button Content="{Binding PlayText}" Click="PlayPause_Click" Padding="14,4" Margin="0,0,5,0"/>
            <Button Content="Stop" Click="Stop_Click" Padding="14,4" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</misc:NotifyPropertyChangedControlBase>
