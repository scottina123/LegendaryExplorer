<Window x:Class="LegendaryExplorer.Tools.FaceFXEditor.AutoFaceFXGenerator.AutoFaceFXGenerationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Height="760" Width="1020" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        d:DataContext="{d:DesignInstance Type={x:Type local:AutoFaceFXGenerationDialog}, IsDesignTimeCreatable=False}"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.FaceFXEditor.AutoFaceFXGenerator">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibilityConverter"/>
        <BorderGapMaskConverter x:Key="BorderGapMaskConverter"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="6"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1" Grid.RowSpan="3"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <Border.OpacityMask>
                                    <MultiBinding ConverterParameter="7" Converter="{StaticResource BorderGapMaskConverter}">
                                        <Binding ElementName="Header" Path="ActualWidth"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                    </MultiBinding>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="Header" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                    Padding="3,1,3,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="true"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"
                                              Margin="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent" SnapsToDevicePixels="true">
                            <BulletDecorator.Bullet>
                                <Border x:Name="CheckBorder" Width="14" Height="14"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1">
                                    <Path x:Name="CheckMark" Width="10" Height="10"
                                          Stretch="Uniform" Visibility="Collapsed"
                                          Fill="{TemplateBinding Foreground}"
                                          Data="M 0 2.5 L 2.5 5 L 7 0"/>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" 
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" 
                                        Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <Setter TargetName="CheckMark" Property="Fill" 
                                        Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,2"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource PrimaryColorBrush}" Padding="10">
            <StackPanel>
                <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding DialogDescription}" FontSize="12" Foreground="White" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- Line Info -->
                <GroupBox Header="Line Information">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Line Name:" Width="100"/>
                            <TextBlock Text="{Binding LineName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="TLK ID:" Width="100"/>
                            <TextBlock Text="{Binding TLKID}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Audio Duration:" Width="100"/>
                            <TextBlock Text="{Binding AudioDurationText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Text Input -->
                <GroupBox Header="Dialogue Text" Visibility="{Binding ShowLipSyncOptions, Converter={StaticResource BooleanVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Enter the dialogue text to generate lip sync animations:" 
                                   FontStyle="Italic" FontSize="11" Margin="5,2" Opacity="0.8" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding TLKText, Mode=TwoWay}" TextWrapping="Wrap" 
                                 Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Margin="5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Generation Options -->
                <GroupBox Header="Generation Options">
                    <StackPanel>
                        <StackPanel Margin="5">
                            <Label Content="Species:"/>
                            <local:SearchableSelectionList ItemsSource="{Binding AvailableSpecies}"
                                                           SelectedItem="{Binding SelectedSpecies}"
                                                           SearchWatermark="Search species..."
                                                           Height="115"/>
                        </StackPanel>
                        
                        <StackPanel Visibility="{Binding ShowLipSyncOptions, Converter={StaticResource BooleanVisibilityConverter}}">
                        <CheckBox Content="Generate Blink Animation" IsChecked="{Binding GenerateBlinkAnimation}"/>
                        <CheckBox Content="Generate Eyebrow Animation" IsChecked="{Binding GenerateEyebrowAnimation}"/>
                        <CheckBox Content="Generate Head Movement" IsChecked="{Binding GenerateHeadMovement}"/>
                        
                        <Separator Margin="5,10"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Intensity Scale:" Width="120"/>
                            <Slider Value="{Binding LipSyncIntensity}" Minimum="0.1" Maximum="2.0" 
                                    Width="150" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LipSyncIntensity, StringFormat={}{0:F1}}" 
                                       Width="40" VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Blink Frequency:" Width="120"/>
                            <Slider Value="{Binding BlinkFrequency}" Minimum="0.1" Maximum="0.5" 
                                    Width="150" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BlinkFrequency, StringFormat={}{0:F2}/s}"
                                       Width="50" VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Emotion Options -->
                <GroupBox Header="Emotion Expression">
                    <StackPanel>
                        <TextBlock Text="Add an emotional expression to the animation:" 
                                   FontStyle="Italic" FontSize="11" Margin="5,2" Opacity="0.8" TextWrapping="Wrap"/>
                        
                        <StackPanel Margin="5">
                            <Label Content="Emotion:"/>
                            <local:SearchableSelectionList ItemsSource="{Binding AvailableEmotions}"
                                                           SelectedItem="{Binding SelectedEmotion}"
                                                           SearchWatermark="Search emotions..."
                                                           Height="145"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="5,0">
                            <Label Content="Intensity:" Width="80"/>
                            <Slider Value="{Binding EmotionIntensity}" Minimum="0.0" Maximum="1.0" 
                                    Width="150" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EmotionIntensity, StringFormat={}{0:P0}}" 
                                       Width="50" VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>

                        <CheckBox Content="Add emotion only (preserve all existing animation)"
                                  IsChecked="{Binding AddEmotionToExistingLine}"
                                  Visibility="{Binding CanChooseGenerationMode, Converter={StaticResource BooleanVisibilityConverter}}"
                                  Margin="85,6,5,4"/>

                    </StackPanel>
                </GroupBox>

                <!-- Warning -->
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" 
                        Padding="10" Margin="5" CornerRadius="3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding GenerationWarningText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <GroupBox Grid.Row="1" Grid.Column="1" Header="Head and Audio Preview" Margin="5,10,10,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <CheckBox Content="Insert emotion at a specific time" IsChecked="{Binding UseCustomEmotionRange}" Margin="5,10,5,4"/>
                    <Grid IsEnabled="{Binding UseCustomEmotionRange}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Content="Start (seconds):"/>
                        <TextBox x:Name="emotionStartInput" Grid.Column="1" Text="{Binding EmotionStartTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="5" VerticalContentAlignment="Center"/>
                        <Button x:Name="usePlayheadForStart" Grid.Column="2" Content="Use playhead" Click="UsePlayheadForStart_Click" Margin="5" Padding="8,3"/>
                        <Label Grid.Row="1" Content="End (seconds):"/>
                        <TextBox x:Name="emotionEndInput" Grid.Row="1" Grid.Column="1" Text="{Binding EmotionEndTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="5" VerticalContentAlignment="Center"/>
                        <Button x:Name="usePlayheadForEnd" Grid.Row="1" Grid.Column="2" Content="Use playhead" Click="UsePlayheadForEnd_Click" Margin="5" Padding="8,3"/>
                    </Grid>
                    <TextBlock Text="The expression fades in at the start and out at the end. Preview it with the audio before applying."
                               TextWrapping="Wrap" Margin="5,7"/>
                </StackPanel>
                <local:FaceFXEmotionPreviewControl x:Name="emotionPreview"/>
            </DockPanel>
        </GroupBox>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderColorBrush}" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Preview Emotion" Width="135" Margin="0,0,10,0" Click="PreviewEmotion_Click"/>
                <Button Content="{Binding GenerateButtonText}" Width="115" Margin="0,0,10,0"
                        Click="GenerateButton_Click" IsDefault="True"/>
                <Button Content="Cancel" Width="100" Click="CancelButton_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
