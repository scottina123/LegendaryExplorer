<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="DarkBackground">#FFFFFFFF</Color>
    <Color x:Key="DarkBackgroundAlt">#FFF3F3F3</Color>
    <Color x:Key="DarkControl">#FFF0F0F0</Color>
    <Color x:Key="DarkControlLight">#FFFFFFFF</Color>
    <Color x:Key="DarkControlDark">#FFE1E1E1</Color>
    <Color x:Key="DarkText">#FF1A1A1A</Color>
    <Color x:Key="DarkTextSecondary">#FF5F6368</Color>
    <Color x:Key="DarkTextDisabled">#FF8A8A8A</Color>
    <Color x:Key="DarkHighlight">#FFCCE8FF</Color>
    <Color x:Key="DarkHighlightText">#FF000000</Color>
    <Color x:Key="DarkBorder">#FFB8B8B8</Color>
    <Color x:Key="DarkSelectionInactive">#FFE1E1E1</Color>
    <Color x:Key="DarkAccent">#FF0078D4</Color>
    <Color x:Key="DarkPanel">#FFF3F3F3</Color>
    <Color x:Key="DarkPanelRaised">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource DarkBackgroundAlt}"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource DarkText}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource DarkBackground}"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="{StaticResource DarkText}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorder}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource DarkTextSecondary}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource DarkPanel}"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource DarkPanelRaised}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource DarkAccent}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource DarkBackground}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource DarkControl}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource DarkControlLight}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{StaticResource DarkControlDark}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="{StaticResource DarkBorder}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource DarkText}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource DarkText}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource DarkTextDisabled}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource DarkHighlight}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource DarkHighlightText}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource DarkSelectionInactive}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource DarkText}"/>
</ResourceDictionary>
